[20:57:17.770]    // Pre-defined
[20:57:17.770]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[20:57:17.770]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[20:57:17.770]    __dp=0x00000000
[20:57:17.770]    __ap=0x00000000
[20:57:17.770]    __traceout=0x00000000      (Trace Disabled)
[20:57:17.770]    __errorcontrol=0x00000000  (Skip Errors="False")
