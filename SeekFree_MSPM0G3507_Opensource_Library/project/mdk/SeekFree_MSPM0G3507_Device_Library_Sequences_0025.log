[20:57:17.740]    <control if="(ACCESS_POINT_VAL & 0x00E00000) == 0" while="" timeout="0" info="">
[20:57:17.740]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[20:57:17.740]        // =>  TRUE
[20:57:17.740]      <block atomic="false" info="">
[20:57:17.740]        WriteAP(0x00, 0x190008);
[20:57:17.740]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[20:57:17.740]        WriteAP(0xF0, 0x01);
[20:57:17.740]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[20:57:17.740]      </block>
[20:57:17.740]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[20:57:17.740]    </control>
[20:57:17.740]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
[20:57:17.740]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[20:57:17.740]        // =>  FALSE
[20:57:17.740]      // skip if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[20:57:17.740]    </control>
[20:57:17.740]    <block atomic="false" info="">
[20:57:17.740]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[20:57:17.749]        // -> [ReadAP(0x00000000) => 0x0079002F]   (__dp=0x00000000, __ap=0x00000004)
[20:57:17.749]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[20:57:17.749]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[20:57:17.749]      __ap = 0; //lets make sure we reset the access point selection
[20:57:17.749]        // -> [__ap <= 0x00000000]
[20:57:17.749]    </block>
