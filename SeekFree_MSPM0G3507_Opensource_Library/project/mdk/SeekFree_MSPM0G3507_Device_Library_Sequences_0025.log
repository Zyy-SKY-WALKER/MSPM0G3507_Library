[20:57:17.770]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[20:57:17.770]    <block atomic="false" info="">
[20:57:17.770]      __var deviceID = 0;
[20:57:17.770]        // -> [deviceID <= 0x00000000]
[20:57:17.770]      __var version = 0;
[20:57:17.770]        // -> [version <= 0x00000000]
[20:57:17.770]      __var partNum = 0;
[20:57:17.770]        // -> [partNum <= 0x00000000]
[20:57:17.770]      __var manuf = 0;
[20:57:17.770]        // -> [manuf <= 0x00000000]
[20:57:17.770]      __var isMSPM0G1X0X_G3X0X = 0;
[20:57:17.770]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:57:17.770]      __var isProduction = 0;
[20:57:17.770]        // -> [isProduction <= 0x00000000]
[20:57:17.770]      __var continueId = 0;
[20:57:17.770]        // -> [continueId <= 0x00000000]
[20:57:17.770]      deviceID =   Read32(0x41C40004);
[20:57:17.783]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:57:17.783]        // -> [deviceID <= 0x2BB8802F]
[20:57:17.783]      version = deviceID >> 28;
[20:57:17.783]        // -> [version <= 0x00000002]
[20:57:17.783]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:57:17.783]        // -> [partNum <= 0x0000BB88]
[20:57:17.783]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:57:17.783]        // -> [manuf <= 0x00000017]
[20:57:17.783]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:57:17.783]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:57:17.783]      isProduction = (version > 0);
[20:57:17.783]        // -> [isProduction <= 0x00000001]
[20:57:17.783]    </block>
[20:57:17.783]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
