[16:45:52.061]          // if-block "!hasDormant"
[16:45:52.061]            // =>  TRUE
[16:45:52.061]          <block atomic="false" info="">
[16:45:52.061]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[16:45:52.061]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:45:52.061]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[16:45:52.061]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[16:45:52.061]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[16:45:52.061]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:45:52.061]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
