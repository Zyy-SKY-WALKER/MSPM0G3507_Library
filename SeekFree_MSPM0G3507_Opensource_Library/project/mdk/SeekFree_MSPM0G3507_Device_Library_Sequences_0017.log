[18:23:15.626]          // if-block "hasDormant"
[18:23:15.626]            // =>  FALSE
[18:23:15.626]          // skip if-block "hasDormant"
[18:23:15.626]        </control>
[18:23:15.626]        <control if="!hasDormant" while="" timeout="0" info="">
[18:23:15.626]          // if-block "!hasDormant"
[18:23:15.626]            // =>  TRUE
[18:23:15.626]          <block atomic="false" info="">
[18:23:15.626]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:23:15.626]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:23:15.626]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:23:15.626]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:23:15.626]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:23:15.626]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:23:15.626]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
