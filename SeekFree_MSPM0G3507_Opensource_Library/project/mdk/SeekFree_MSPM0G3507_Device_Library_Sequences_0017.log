[18:29:43.265]        // -> [partNum <= 0x00000000]
[18:29:43.265]      __var manuf = 0;
[18:29:43.265]        // -> [manuf <= 0x00000000]
[18:29:43.265]      __var isMSPM0G1X0X_G3X0X = 0;
[18:29:43.265]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[18:29:43.265]      __var isProduction = 0;
[18:29:43.265]        // -> [isProduction <= 0x00000000]
[18:29:43.265]      __var continueId = 0;
[18:29:43.265]        // -> [continueId <= 0x00000000]
[18:29:43.265]      deviceID =   Read32(0x41C40004);
