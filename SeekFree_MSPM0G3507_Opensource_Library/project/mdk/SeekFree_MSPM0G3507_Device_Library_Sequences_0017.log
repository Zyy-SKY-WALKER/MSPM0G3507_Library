[18:29:43.162]            // =>  TRUE
[18:29:43.162]          <block atomic="false" info="">
[18:29:43.162]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:29:43.166]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
