[18:25:47.588]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[18:25:47.588]    <block atomic="false" info="">
[18:25:47.588]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[18:25:47.588]        // -> [isSWJ <= 0x00000001]
[18:25:47.588]      __var hasDormant = __protocol & 0x00020000;
[18:25:47.588]        // -> [hasDormant <= 0x00000000]
[18:25:47.588]      __var protType   = __protocol & 0x0000FFFF;
[18:25:47.588]        // -> [protType <= 0x00000002]
