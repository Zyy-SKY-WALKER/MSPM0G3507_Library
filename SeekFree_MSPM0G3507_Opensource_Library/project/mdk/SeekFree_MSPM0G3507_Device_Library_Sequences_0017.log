[18:25:47.594]      // skip if-block "protType == 1"
[18:25:47.594]    </control>
[18:25:47.594]    <control if="protType == 2" while="" timeout="0" info="">
[18:25:47.594]      // if-block "protType == 2"
[18:25:47.594]        // =>  TRUE
[18:25:47.594]      <control if="isSWJ" while="" timeout="0" info="">
[18:25:47.594]        // if-block "isSWJ"
[18:25:47.594]          // =>  TRUE
[18:25:47.594]        <control if="hasDormant" while="" timeout="0" info="">
[18:25:47.594]          // if-block "hasDormant"
[18:25:47.594]            // =>  FALSE
[18:25:47.594]          // skip if-block "hasDormant"
[18:25:47.594]        </control>
[18:25:47.594]        <control if="!hasDormant" while="" timeout="0" info="">
[18:25:47.594]          // if-block "!hasDormant"
[18:25:47.594]            // =>  TRUE
[18:25:47.594]          <block atomic="false" info="">
[18:25:47.594]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:25:47.597]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:25:47.597]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:25:47.597]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:25:47.597]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:25:47.597]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:25:47.597]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[18:25:47.603]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[18:25:47.603]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:25:47.605]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:25:47.605]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:25:47.607]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:25:47.607]          </block>
[18:25:47.607]          // end if-block "!hasDormant"
[18:25:47.607]        </control>
[18:25:47.607]        // end if-block "isSWJ"
[18:25:47.607]      </control>
