[18:23:15.635]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:23:15.635]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:23:15.635]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:23:15.635]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:23:15.635]          </block>
[18:23:15.635]          // end if-block "!hasDormant"
[18:23:15.635]        </control>
[18:23:15.635]        // end if-block "isSWJ"
[18:23:15.635]      </control>
