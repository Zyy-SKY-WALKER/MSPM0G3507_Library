[18:31:15.855]          // if-block "!hasDormant"
[18:31:15.855]            // =>  TRUE
[18:31:15.855]          <block atomic="false" info="">
[18:31:15.855]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:31:15.855]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:31:15.855]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:31:15.855]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:31:15.855]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:31:15.866]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:31:15.866]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
