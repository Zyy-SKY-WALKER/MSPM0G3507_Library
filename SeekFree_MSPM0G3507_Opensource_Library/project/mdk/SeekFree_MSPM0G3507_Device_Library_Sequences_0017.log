[18:31:15.879]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[18:31:15.879]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
