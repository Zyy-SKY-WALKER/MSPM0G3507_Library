[18:23:15.728]        // -> [manuf <= 0x00000000]
[18:23:15.728]      __var isMSPM0G1X0X_G3X0X = 0;
[18:23:15.728]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[18:23:15.728]      __var isProduction = 0;
[18:23:15.728]        // -> [isProduction <= 0x00000000]
[18:23:15.728]      __var continueId = 0;
