[12:26:17.625]            // =>  TRUE
[12:26:17.625]          <block atomic="false" info="">
[12:26:17.625]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[12:26:17.632]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
