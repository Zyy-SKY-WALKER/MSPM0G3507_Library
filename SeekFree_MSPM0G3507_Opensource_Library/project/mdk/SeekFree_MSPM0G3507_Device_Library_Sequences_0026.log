[11:04:47.902]      __var deviceID = 0;
[11:04:47.902]        // -> [deviceID <= 0x00000000]
[11:04:47.902]      __var version = 0;
[11:04:47.902]        // -> [version <= 0x00000000]
[11:04:47.902]      __var partNum = 0;
[11:04:47.902]        // -> [partNum <= 0x00000000]
[11:04:47.902]      __var manuf = 0;
[11:04:47.902]        // -> [manuf <= 0x00000000]
[11:04:47.902]      __var isMSPM0G1X0X_G3X0X = 0;
[11:04:47.902]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[11:04:47.902]      __var isProduction = 0;
[11:04:47.902]        // -> [isProduction <= 0x00000000]
[11:04:47.902]      __var continueId = 0;
[11:04:47.902]        // -> [continueId <= 0x00000000]
[11:04:47.902]      deviceID =   Read32(0x41C40004);
[11:04:47.912]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[11:04:47.912]        // -> [deviceID <= 0x2BB8802F]
[11:04:47.912]      version = deviceID >> 28;
[11:04:47.912]        // -> [version <= 0x00000002]
[11:04:47.912]      partNum = (deviceID & 0x0FFFF000) >> 12;
[11:04:47.912]        // -> [partNum <= 0x0000BB88]
[11:04:47.912]      manuf = (deviceID & 0x00000FFE) >> 1;
[11:04:47.912]        // -> [manuf <= 0x00000017]
[11:04:47.912]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[11:04:47.912]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[11:04:47.912]      isProduction = (version > 0);
[11:04:47.912]        // -> [isProduction <= 0x00000001]
[11:04:47.912]    </block>
[11:04:47.912]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
