[11:29:33.920]      __var SW_DP_ABORT       = 0x0;
[11:29:33.920]        // -> [SW_DP_ABORT <= 0x00000000]
[11:29:33.920]      __var DP_CTRL_STAT      = 0x4;
[11:29:33.920]        // -> [DP_CTRL_STAT <= 0x00000004]
[11:29:33.920]      __var DP_SELECT         = 0x8;
[11:29:33.920]        // -> [DP_SELECT <= 0x00000008]
[11:29:33.920]      __var powered_down      = 0;
