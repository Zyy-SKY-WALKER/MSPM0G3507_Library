[13:15:55.513]    <control if="(ACCESS_POINT_VAL & 0x00E00000) == 0" while="" timeout="0" info="">
[13:15:55.513]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[13:15:55.513]        // =>  TRUE
[13:15:55.513]      <block atomic="false" info="">
[13:15:55.513]        WriteAP(0x00, 0x190008);
[13:15:55.513]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[13:15:55.513]        WriteAP(0xF0, 0x01);
[13:15:55.523]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[13:15:55.523]      </block>
[13:15:55.523]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[13:15:55.523]    </control>
[13:15:55.523]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
[13:15:55.523]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[13:15:55.523]        // =>  FALSE
[13:15:55.523]      // skip if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[13:15:55.523]    </control>
[13:15:55.523]    <block atomic="false" info="">
[13:15:55.523]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[13:15:55.527]        // -> [ReadAP(0x00000000) => 0x0079002F]   (__dp=0x00000000, __ap=0x00000004)
[13:15:55.528]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[13:15:55.528]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[13:15:55.528]      __ap = 0; //lets make sure we reset the access point selection
[13:15:55.528]        // -> [__ap <= 0x00000000]
[13:15:55.528]    </block>
