[11:49:36.229]        // -> [partNum <= 0x00000000]
[11:49:36.229]      __var manuf = 0;
[11:49:36.229]        // -> [manuf <= 0x00000000]
[11:49:36.229]      __var isMSPM0G1X0X_G3X0X = 0;
[11:49:36.229]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[11:49:36.229]      __var isProduction = 0;
[11:49:36.229]        // -> [isProduction <= 0x00000000]
[11:49:36.229]      __var continueId = 0;
[11:49:36.229]        // -> [continueId <= 0x00000000]
[11:49:36.229]      deviceID =   Read32(0x41C40004);
[11:49:36.234]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[11:49:36.234]        // -> [deviceID <= 0x2BB8802F]
[11:49:36.234]      version = deviceID >> 28;
[11:49:36.234]        // -> [version <= 0x00000002]
[11:49:36.234]      partNum = (deviceID & 0x0FFFF000) >> 12;
[11:49:36.234]        // -> [partNum <= 0x0000BB88]
[11:49:36.234]      manuf = (deviceID & 0x00000FFE) >> 1;
[11:49:36.234]        // -> [manuf <= 0x00000017]
[11:49:36.234]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[11:49:36.234]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[11:49:36.234]      isProduction = (version > 0);
[11:49:36.234]        // -> [isProduction <= 0x00000001]
[11:49:36.234]    </block>
[11:49:36.234]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
