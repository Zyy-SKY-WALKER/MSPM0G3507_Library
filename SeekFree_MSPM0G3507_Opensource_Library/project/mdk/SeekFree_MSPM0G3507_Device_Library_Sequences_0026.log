[11:29:33.902]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[11:29:33.902]    <block atomic="false" info="">
[11:29:33.902]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[11:29:33.902]        // -> [isSWJ <= 0x00000001]
