[12:29:53.749]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[12:29:53.749]    <block atomic="false" info="">
[12:29:53.749]      __var deviceID = 0;
[12:29:53.749]        // -> [deviceID <= 0x00000000]
[12:29:53.749]      __var version = 0;
[12:29:53.749]        // -> [version <= 0x00000000]
[12:29:53.749]      __var partNum = 0;
[12:29:53.749]        // -> [partNum <= 0x00000000]
[12:29:53.749]      __var manuf = 0;
[12:29:53.749]        // -> [manuf <= 0x00000000]
[12:29:53.749]      __var isMSPM0G1X0X_G3X0X = 0;
[12:29:53.749]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[12:29:53.749]      __var isProduction = 0;
[12:29:53.749]        // -> [isProduction <= 0x00000000]
[12:29:53.749]      __var continueId = 0;
[12:29:53.751]        // -> [continueId <= 0x00000000]
[12:29:53.751]      deviceID =   Read32(0x41C40004);
[12:29:53.757]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[12:29:53.757]        // -> [deviceID <= 0x2BB8802F]
[12:29:53.757]      version = deviceID >> 28;
[12:29:53.757]        // -> [version <= 0x00000002]
[12:29:53.757]      partNum = (deviceID & 0x0FFFF000) >> 12;
[12:29:53.757]        // -> [partNum <= 0x0000BB88]
[12:29:53.757]      manuf = (deviceID & 0x00000FFE) >> 1;
[12:29:53.757]        // -> [manuf <= 0x00000017]
[12:29:53.757]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[12:29:53.757]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[12:29:53.757]      isProduction = (version > 0);
[12:29:53.757]        // -> [isProduction <= 0x00000001]
[12:29:53.757]    </block>
[12:29:53.757]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[12:29:53.757]      // if-block "!isMSPM0G1X0X_G3X0X"
[12:29:53.757]        // =>  FALSE
[12:29:53.757]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[12:29:53.757]    </control>
