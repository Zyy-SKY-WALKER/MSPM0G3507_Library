[11:29:33.920]      WriteDP(DP_SELECT, 0x00000000);
[11:29:33.925]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[11:29:33.927]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[11:29:33.927]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[11:29:33.927]        // -> [powered_down <= 0x00000001]
