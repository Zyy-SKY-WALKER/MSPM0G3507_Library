[13:15:55.553]        // -> [manuf <= 0x00000000]
[13:15:55.553]      __var isMSPM0G1X0X_G3X0X = 0;
[13:15:55.553]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[13:15:55.553]      __var isProduction = 0;
[13:15:55.553]        // -> [isProduction <= 0x00000000]
