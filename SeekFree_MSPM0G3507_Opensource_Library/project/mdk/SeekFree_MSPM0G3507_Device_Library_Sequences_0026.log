[11:29:33.902]        // if-block "isSWJ"
[11:29:33.902]          // =>  TRUE
[11:29:33.902]        <control if="hasDormant" while="" timeout="0" info="">
[11:29:33.902]          // if-block "hasDormant"
[11:29:33.902]            // =>  FALSE
[11:29:33.902]          // skip if-block "hasDormant"
[11:29:33.902]        </control>
[11:29:33.902]        <control if="!hasDormant" while="" timeout="0" info="">
[11:29:33.902]          // if-block "!hasDormant"
[11:29:33.902]            // =>  TRUE
[11:29:33.902]          <block atomic="false" info="">
[11:29:33.902]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[11:29:33.905]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[11:29:33.905]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[11:29:33.907]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[11:29:33.907]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[11:29:33.909]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[11:29:33.909]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
