[11:29:33.936]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[11:29:33.936]        // while-condition  =>  FALSE
[11:29:33.936]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[11:29:33.936]      </control>
