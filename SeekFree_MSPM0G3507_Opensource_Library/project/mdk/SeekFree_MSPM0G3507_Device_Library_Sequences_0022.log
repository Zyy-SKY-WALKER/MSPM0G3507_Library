[17:36:05.285]          <block atomic="false" info="">
[17:36:05.285]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:36:05.287]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
