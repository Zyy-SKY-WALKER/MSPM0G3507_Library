[13:35:56.709]        </control>
[13:35:56.709]        <control if="!hasDormant" while="" timeout="0" info="">
[13:35:56.709]          // if-block "!hasDormant"
[13:35:56.709]            // =>  TRUE
[13:35:56.709]          <block atomic="false" info="">
[13:35:56.709]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[13:35:56.709]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[13:35:56.709]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[13:35:56.709]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[13:35:56.709]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
