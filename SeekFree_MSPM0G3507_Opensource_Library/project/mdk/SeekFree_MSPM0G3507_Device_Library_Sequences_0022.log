[13:35:56.721]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[13:35:56.723]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[13:35:56.723]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[13:35:56.725]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
