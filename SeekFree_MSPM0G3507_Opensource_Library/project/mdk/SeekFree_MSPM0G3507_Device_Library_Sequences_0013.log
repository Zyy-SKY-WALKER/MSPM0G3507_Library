[15:01:29.708]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[15:01:29.708]    <block atomic="false" info="">
[15:01:29.708]      __var deviceID = 0;
[15:01:29.708]        // -> [deviceID <= 0x00000000]
[15:01:29.708]      __var version = 0;
[15:01:29.708]        // -> [version <= 0x00000000]
[15:01:29.708]      __var partNum = 0;
[15:01:29.708]        // -> [partNum <= 0x00000000]
[15:01:29.708]      __var manuf = 0;
[15:01:29.708]        // -> [manuf <= 0x00000000]
[15:01:29.708]      __var isMSPM0G1X0X_G3X0X = 0;
[15:01:29.708]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:01:29.708]      __var isProduction = 0;
[15:01:29.708]        // -> [isProduction <= 0x00000000]
[15:01:29.708]      __var continueId = 0;
[15:01:29.708]        // -> [continueId <= 0x00000000]
[15:01:29.708]      deviceID =   Read32(0x41C40004);
[15:01:29.713]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:01:29.713]        // -> [deviceID <= 0x2BB8802F]
[15:01:29.713]      version = deviceID >> 28;
[15:01:29.713]        // -> [version <= 0x00000002]
[15:01:29.713]      partNum = (deviceID & 0x0FFFF000) >> 12;
[15:01:29.713]        // -> [partNum <= 0x0000BB88]
[15:01:29.713]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:01:29.713]        // -> [manuf <= 0x00000017]
[15:01:29.713]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:01:29.713]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:01:29.713]      isProduction = (version > 0);
[15:01:29.713]        // -> [isProduction <= 0x00000001]
[15:01:29.713]    </block>
[15:01:29.713]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[15:01:29.713]      // if-block "!isMSPM0G1X0X_G3X0X"
[15:01:29.713]        // =>  FALSE
[15:01:29.713]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[15:01:29.713]    </control>
