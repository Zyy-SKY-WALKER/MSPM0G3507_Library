[15:07:07.805]      // skip if-block "protType == 1"
[15:07:07.805]    </control>
[15:07:07.805]    <control if="protType == 2" while="" timeout="0" info="">
[15:07:07.805]      // if-block "protType == 2"
[15:07:07.805]        // =>  TRUE
[15:07:07.805]      <control if="isSWJ" while="" timeout="0" info="">
[15:07:07.805]        // if-block "isSWJ"
[15:07:07.806]          // =>  TRUE
[15:07:07.806]        <control if="hasDormant" while="" timeout="0" info="">
[15:07:07.806]          // if-block "hasDormant"
[15:07:07.806]            // =>  FALSE
[15:07:07.806]          // skip if-block "hasDormant"
[15:07:07.806]        </control>
[15:07:07.806]        <control if="!hasDormant" while="" timeout="0" info="">
[15:07:07.806]          // if-block "!hasDormant"
[15:07:07.806]            // =>  TRUE
[15:07:07.806]          <block atomic="false" info="">
[15:07:07.806]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:07:07.806]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:07:07.806]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:07:07.806]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:07:07.806]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:07:07.811]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:07:07.811]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:07:07.814]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:07:07.814]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:07:07.815]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:07:07.815]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:07:07.819]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:07:07.819]          </block>
[15:07:07.819]          // end if-block "!hasDormant"
[15:07:07.819]        </control>
[15:07:07.819]        // end if-block "isSWJ"
[15:07:07.819]      </control>
