[15:07:07.805]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:07:07.805]    <block atomic="false" info="">
[15:07:07.805]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:07:07.805]        // -> [isSWJ <= 0x00000001]
[15:07:07.805]      __var hasDormant = __protocol & 0x00020000;
[15:07:07.805]        // -> [hasDormant <= 0x00000000]
