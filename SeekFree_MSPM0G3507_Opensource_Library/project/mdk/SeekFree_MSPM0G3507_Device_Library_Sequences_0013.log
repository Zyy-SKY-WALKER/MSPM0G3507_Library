[15:15:01.966]          // if-block "hasDormant"
[15:15:01.966]            // =>  FALSE
[15:15:01.966]          // skip if-block "hasDormant"
[15:15:01.966]        </control>
[15:15:01.966]        <control if="!hasDormant" while="" timeout="0" info="">
[15:15:01.966]          // if-block "!hasDormant"
[15:15:01.966]            // =>  TRUE
[15:15:01.966]          <block atomic="false" info="">
[15:15:01.966]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:15:01.966]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:15:01.966]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:15:01.971]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:15:01.971]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:15:01.971]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:15:01.971]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:15:01.976]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:15:01.976]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:15:01.976]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:15:01.976]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:15:01.976]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:15:01.976]          </block>
