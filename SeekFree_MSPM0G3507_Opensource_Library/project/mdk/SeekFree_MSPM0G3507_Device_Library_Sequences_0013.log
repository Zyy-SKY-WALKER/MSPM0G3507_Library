[15:07:07.825]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[15:07:07.825]    <block atomic="false" info="">
[15:07:07.825]      __var SW_DP_ABORT       = 0x0;
[15:07:07.825]        // -> [SW_DP_ABORT <= 0x00000000]
[15:07:07.825]      __var DP_CTRL_STAT      = 0x4;
[15:07:07.825]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:07:07.825]      __var DP_SELECT         = 0x8;
[15:07:07.825]        // -> [DP_SELECT <= 0x00000008]
[15:07:07.825]      __var powered_down      = 0;
[15:07:07.825]        // -> [powered_down <= 0x00000000]
[15:07:07.825]      WriteDP(DP_SELECT, 0x00000000);
[15:07:07.830]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:07:07.830]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[15:07:07.832]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[15:07:07.832]        // -> [powered_down <= 0x00000001]
[15:07:07.832]    </block>
[15:07:07.832]    <control if="powered_down" while="" timeout="0" info="">
[15:07:07.832]      // if-block "powered_down"
[15:07:07.832]        // =>  TRUE
[15:07:07.832]      <block atomic="false" info="">
[15:07:07.832]        Message(0, "Debug/System power-up request sent");
[15:07:07.832]        WriteDP(DP_CTRL_STAT, 0x50000000);
[15:07:07.836]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[15:07:07.836]      </block>
[15:07:07.836]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[15:07:07.836]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[15:07:07.836]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[15:07:07.836]        // while-condition  =>  FALSE
[15:07:07.836]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[15:07:07.836]      </control>
[15:07:07.836]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[15:07:07.836]        // if-block "(__protocol & 0xFFFF) == 1"
[15:07:07.836]          // =>  FALSE
[15:07:07.836]        // skip if-block "(__protocol & 0xFFFF) == 1"
[15:07:07.836]      </control>
[15:07:07.836]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[15:07:07.836]        // if-block "(__protocol & 0xFFFF) == 2"
[15:07:07.836]          // =>  TRUE
[15:07:07.836]        <block atomic="false" info="">
[15:07:07.836]          Message(0, "executing SWD power up");
[15:07:07.840]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:07:07.840]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[15:07:07.840]          WriteDP(SW_DP_ABORT, 0x0000001E);
[15:07:07.840]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[15:07:07.840]        </block>
[15:07:07.845]        // end if-block "(__protocol & 0xFFFF) == 2"
