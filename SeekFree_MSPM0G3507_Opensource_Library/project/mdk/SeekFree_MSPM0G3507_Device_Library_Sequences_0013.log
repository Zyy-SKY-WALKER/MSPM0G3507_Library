[15:05:06.574]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:05:06.574]    <block atomic="false" info="">
[15:05:06.574]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:05:06.574]        // -> [isSWJ <= 0x00000001]
[15:05:06.574]      __var hasDormant = __protocol & 0x00020000;
[15:05:06.574]        // -> [hasDormant <= 0x00000000]
[15:05:06.574]      __var protType   = __protocol & 0x0000FFFF;
[15:05:06.574]        // -> [protType <= 0x00000002]
[15:05:06.574]    </block>
[15:05:06.574]    <control if="protType == 1" while="" timeout="0" info="">
[15:05:06.575]      // if-block "protType == 1"
[15:05:06.575]        // =>  FALSE
[15:05:06.575]      // skip if-block "protType == 1"
[15:05:06.575]    </control>
[15:05:06.575]    <control if="protType == 2" while="" timeout="0" info="">
[15:05:06.575]      // if-block "protType == 2"
[15:05:06.575]        // =>  TRUE
[15:05:06.575]      <control if="isSWJ" while="" timeout="0" info="">
[15:05:06.575]        // if-block "isSWJ"
[15:05:06.575]          // =>  TRUE
[15:05:06.575]        <control if="hasDormant" while="" timeout="0" info="">
[15:05:06.575]          // if-block "hasDormant"
[15:05:06.575]            // =>  FALSE
[15:05:06.575]          // skip if-block "hasDormant"
[15:05:06.575]        </control>
[15:05:06.575]        <control if="!hasDormant" while="" timeout="0" info="">
[15:05:06.575]          // if-block "!hasDormant"
[15:05:06.575]            // =>  TRUE
[15:05:06.575]          <block atomic="false" info="">
[15:05:06.575]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:05:06.575]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:05:06.575]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:05:06.581]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:05:06.581]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:05:06.581]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:05:06.581]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:05:06.586]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:05:06.586]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:05:06.586]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:05:06.586]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:05:06.591]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:05:06.591]          </block>
[15:05:06.591]          // end if-block "!hasDormant"
[15:05:06.591]        </control>
[15:05:06.591]        // end if-block "isSWJ"
[15:05:06.591]      </control>
[15:05:06.591]      <control if="!isSWJ" while="" timeout="0" info="">
[15:05:06.591]        // if-block "!isSWJ"
[15:05:06.591]          // =>  FALSE
[15:05:06.591]        // skip if-block "!isSWJ"
[15:05:06.591]      </control>
[15:05:06.591]      <block atomic="false" info="">
[15:05:06.591]        ReadDP(0x0);
[15:05:06.591]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[15:05:06.591]      </block>
[15:05:06.591]      // end if-block "protType == 2"
[15:05:06.591]    </control>
[15:05:06.591]  </sequence>
