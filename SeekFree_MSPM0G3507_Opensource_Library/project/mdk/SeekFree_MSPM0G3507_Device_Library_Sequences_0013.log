[15:05:06.596]        // -> [SW_DP_ABORT <= 0x00000000]
[15:05:06.596]      __var DP_CTRL_STAT      = 0x4;
[15:05:06.601]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:05:06.601]      __var DP_SELECT         = 0x8;
[15:05:06.601]        // -> [DP_SELECT <= 0x00000008]
[15:05:06.601]      __var powered_down      = 0;
[15:05:06.601]        // -> [powered_down <= 0x00000000]
[15:05:06.601]      WriteDP(DP_SELECT, 0x00000000);
[15:05:06.601]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:05:06.601]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[15:05:06.601]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[15:05:06.601]        // -> [powered_down <= 0x00000001]
[15:05:06.601]    </block>
[15:05:06.601]    <control if="powered_down" while="" timeout="0" info="">
[15:05:06.601]      // if-block "powered_down"
[15:05:06.601]        // =>  TRUE
[15:05:06.601]      <block atomic="false" info="">
[15:05:06.601]        Message(0, "Debug/System power-up request sent");
[15:05:06.606]        WriteDP(DP_CTRL_STAT, 0x50000000);
[15:05:06.611]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[15:05:06.611]      </block>
[15:05:06.611]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[15:05:06.611]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[15:05:06.611]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[15:05:06.611]        // while-condition  =>  FALSE
[15:05:06.611]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[15:05:06.611]      </control>
[15:05:06.611]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[15:05:06.611]        // if-block "(__protocol & 0xFFFF) == 1"
[15:05:06.611]          // =>  FALSE
[15:05:06.611]        // skip if-block "(__protocol & 0xFFFF) == 1"
[15:05:06.611]      </control>
[15:05:06.611]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[15:05:06.611]        // if-block "(__protocol & 0xFFFF) == 2"
[15:05:06.611]          // =>  TRUE
[15:05:06.611]        <block atomic="false" info="">
[15:05:06.611]          Message(0, "executing SWD power up");
[15:05:06.619]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:05:06.621]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[15:05:06.621]          WriteDP(SW_DP_ABORT, 0x0000001E);
[15:05:06.623]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[15:05:06.623]        </block>
[15:05:06.623]        // end if-block "(__protocol & 0xFFFF) == 2"
[15:05:06.623]      </control>
[15:05:06.623]      // end if-block "powered_down"
[15:05:06.623]    </control>
[15:05:06.623]    <block atomic="false" info="">
[15:05:06.625]      __var DEBUG_PORT_VAL    = 0;
[15:05:06.625]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[15:05:06.625]      __var ACCESS_POINT_VAL  = 0;
[15:05:06.625]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[15:05:06.625]      __ap = 1; 
[15:05:06.625]        // -> [__ap <= 0x00000001]
[15:05:06.625]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[15:05:06.630]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[15:05:06.630]      __ap = 4;
[15:05:06.630]        // -> [__ap <= 0x00000004]
[15:05:06.630]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[15:05:06.635]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[15:05:06.635]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[15:05:06.635]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
