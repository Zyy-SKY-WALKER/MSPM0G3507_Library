[15:05:06.701]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[15:05:06.701]    <block atomic="false" info="">
[15:05:06.701]      __var deviceID = 0;
[15:05:06.701]        // -> [deviceID <= 0x00000000]
[15:05:06.701]      __var version = 0;
[15:05:06.701]        // -> [version <= 0x00000000]
[15:05:06.701]      __var partNum = 0;
[15:05:06.701]        // -> [partNum <= 0x00000000]
[15:05:06.701]      __var manuf = 0;
[15:05:06.701]        // -> [manuf <= 0x00000000]
[15:05:06.701]      __var isMSPM0G1X0X_G3X0X = 0;
[15:05:06.701]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:05:06.701]      __var isProduction = 0;
[15:05:06.701]        // -> [isProduction <= 0x00000000]
[15:05:06.701]      __var continueId = 0;
[15:05:06.701]        // -> [continueId <= 0x00000000]
[15:05:06.701]      deviceID =   Read32(0x41C40004);
[15:05:06.709]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:05:06.709]        // -> [deviceID <= 0x2BB8802F]
[15:05:06.709]      version = deviceID >> 28;
[15:05:06.709]        // -> [version <= 0x00000002]
[15:05:06.709]      partNum = (deviceID & 0x0FFFF000) >> 12;
[15:05:06.709]        // -> [partNum <= 0x0000BB88]
[15:05:06.709]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:05:06.709]        // -> [manuf <= 0x00000017]
[15:05:06.709]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:05:06.709]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:05:06.709]      isProduction = (version > 0);
[15:05:06.709]        // -> [isProduction <= 0x00000001]
[15:05:06.709]    </block>
[15:05:06.709]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[15:05:06.709]      // if-block "!isMSPM0G1X0X_G3X0X"
[15:05:06.709]        // =>  FALSE
[15:05:06.709]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[15:05:06.709]    </control>
