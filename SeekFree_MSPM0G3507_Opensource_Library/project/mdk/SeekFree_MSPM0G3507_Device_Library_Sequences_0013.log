[15:11:48.976]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:11:48.976]      __var isProduction = 0;
[15:11:48.976]        // -> [isProduction <= 0x00000000]
[15:11:48.976]      __var continueId = 0;
[15:11:48.976]        // -> [continueId <= 0x00000000]
[15:11:48.976]      deviceID =   Read32(0x41C40004);
