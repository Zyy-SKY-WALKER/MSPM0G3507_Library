[15:05:06.571]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[15:05:06.571]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[15:05:06.571]    __dp=0x00000000
