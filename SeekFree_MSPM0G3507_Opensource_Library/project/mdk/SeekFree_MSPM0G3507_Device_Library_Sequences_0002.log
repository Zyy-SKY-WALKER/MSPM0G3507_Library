[18:22:01.730]      manuf = (deviceID & 0x00000FFE) >> 1;
[18:22:01.739]        // -> [manuf <= 0x00000017]
[18:22:01.739]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[18:22:01.739]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[18:22:01.739]      isProduction = (version > 0);
[18:22:01.739]        // -> [isProduction <= 0x00000001]
