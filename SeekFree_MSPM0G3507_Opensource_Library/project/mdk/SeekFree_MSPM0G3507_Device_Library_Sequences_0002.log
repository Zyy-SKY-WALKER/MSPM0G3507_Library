[18:14:42.868]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[18:14:42.868]    <block atomic="false" info="">
[18:14:42.868]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[18:14:42.868]        // -> [isSWJ <= 0x00000001]
[18:14:42.868]      __var hasDormant = __protocol & 0x00020000;
[18:14:42.868]        // -> [hasDormant <= 0x00000000]
[18:14:42.868]      __var protType   = __protocol & 0x0000FFFF;
[18:14:42.868]        // -> [protType <= 0x00000002]
[18:14:42.868]    </block>
[18:14:42.868]    <control if="protType == 1" while="" timeout="0" info="">
[18:14:42.868]      // if-block "protType == 1"
[18:14:42.868]        // =>  FALSE
[18:14:42.868]      // skip if-block "protType == 1"
[18:14:42.868]    </control>
[18:14:42.868]    <control if="protType == 2" while="" timeout="0" info="">
[18:14:42.868]      // if-block "protType == 2"
[18:14:42.868]        // =>  TRUE
[18:14:42.868]      <control if="isSWJ" while="" timeout="0" info="">
[18:14:42.868]        // if-block "isSWJ"
[18:14:42.868]          // =>  TRUE
[18:14:42.868]        <control if="hasDormant" while="" timeout="0" info="">
[18:14:42.868]          // if-block "hasDormant"
[18:14:42.868]            // =>  FALSE
[18:14:42.868]          // skip if-block "hasDormant"
[18:14:42.868]        </control>
[18:14:42.868]        <control if="!hasDormant" while="" timeout="0" info="">
[18:14:42.868]          // if-block "!hasDormant"
[18:14:42.868]            // =>  TRUE
[18:14:42.868]          <block atomic="false" info="">
[18:14:42.868]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:14:42.868]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:14:42.868]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:14:42.868]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:14:42.868]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:14:42.880]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:14:42.880]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[18:14:42.882]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[18:14:42.882]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:14:42.883]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:14:42.883]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:14:42.883]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:14:42.883]          </block>
[18:14:42.883]          // end if-block "!hasDormant"
[18:14:42.883]        </control>
[18:14:42.883]        // end if-block "isSWJ"
[18:14:42.883]      </control>
[18:14:42.883]      <control if="!isSWJ" while="" timeout="0" info="">
[18:14:42.883]        // if-block "!isSWJ"
[18:14:42.883]          // =>  FALSE
[18:14:42.883]        // skip if-block "!isSWJ"
[18:14:42.883]      </control>
