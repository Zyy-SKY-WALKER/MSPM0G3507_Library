[18:25:28.263]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[18:25:28.263]    <block atomic="false" info="">
[18:25:28.263]      __var deviceID = 0;
[18:25:28.263]        // -> [deviceID <= 0x00000000]
[18:25:28.263]      __var version = 0;
[18:25:28.263]        // -> [version <= 0x00000000]
[18:25:28.263]      __var partNum = 0;
[18:25:28.263]        // -> [partNum <= 0x00000000]
[18:25:28.263]      __var manuf = 0;
[18:25:28.263]        // -> [manuf <= 0x00000000]
[18:25:28.263]      __var isMSPM0G1X0X_G3X0X = 0;
[18:25:28.263]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[18:25:28.263]      __var isProduction = 0;
[18:25:28.263]        // -> [isProduction <= 0x00000000]
[18:25:28.263]      __var continueId = 0;
[18:25:28.263]        // -> [continueId <= 0x00000000]
[18:25:28.263]      deviceID =   Read32(0x41C40004);
[18:25:28.263]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[18:25:28.263]        // -> [deviceID <= 0x2BB8802F]
[18:25:28.273]      version = deviceID >> 28;
[18:25:28.273]        // -> [version <= 0x00000002]
[18:25:28.273]      partNum = (deviceID & 0x0FFFF000) >> 12;
[18:25:28.273]        // -> [partNum <= 0x0000BB88]
[18:25:28.273]      manuf = (deviceID & 0x00000FFE) >> 1;
[18:25:28.273]        // -> [manuf <= 0x00000017]
[18:25:28.273]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[18:25:28.273]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[18:25:28.273]      isProduction = (version > 0);
[18:25:28.273]        // -> [isProduction <= 0x00000001]
[18:25:28.273]    </block>
[18:25:28.273]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
