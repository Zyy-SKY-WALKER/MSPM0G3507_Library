[18:25:28.140]          // if-block "hasDormant"
[18:25:28.140]            // =>  FALSE
[18:25:28.140]          // skip if-block "hasDormant"
[18:25:28.140]        </control>
[18:25:28.140]        <control if="!hasDormant" while="" timeout="0" info="">
[18:25:28.140]          // if-block "!hasDormant"
[18:25:28.140]            // =>  TRUE
[18:25:28.140]          <block atomic="false" info="">
[18:25:28.140]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:25:28.147]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:25:28.147]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:25:28.151]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:25:28.151]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:25:28.154]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:25:28.154]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[18:25:28.155]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[18:25:28.155]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:25:28.155]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:25:28.155]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:25:28.160]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:25:28.160]          </block>
