[18:22:01.730]        // -> [partNum <= 0x00000000]
[18:22:01.730]      __var manuf = 0;
[18:22:01.730]        // -> [manuf <= 0x00000000]
[18:22:01.730]      __var isMSPM0G1X0X_G3X0X = 0;
[18:22:01.730]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[18:22:01.730]      __var isProduction = 0;
[18:22:01.730]        // -> [isProduction <= 0x00000000]
[18:22:01.730]      __var continueId = 0;
[18:22:01.730]        // -> [continueId <= 0x00000000]
[18:22:01.730]      deviceID =   Read32(0x41C40004);
[18:22:01.730]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[18:22:01.730]        // -> [deviceID <= 0x2BB8802F]
[18:22:01.730]      version = deviceID >> 28;
