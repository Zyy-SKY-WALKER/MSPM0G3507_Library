[18:24:18.254]        // -> [partNum <= 0x00000000]
[18:24:18.254]      __var manuf = 0;
[18:24:18.254]        // -> [manuf <= 0x00000000]
[18:24:18.254]      __var isMSPM0G1X0X_G3X0X = 0;
