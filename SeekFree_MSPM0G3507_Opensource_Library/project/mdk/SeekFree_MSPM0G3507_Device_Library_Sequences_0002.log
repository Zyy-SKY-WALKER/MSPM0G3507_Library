[18:00:49.925]        // if-block "(__protocol & 0xFFFF) == 2"
[18:00:49.925]          // =>  TRUE
[18:00:49.925]        <block atomic="false" info="">
[18:00:49.925]          Message(0, "executing SWD power up");
[18:00:49.926]          WriteDP(DP_CTRL_STAT, 0x50000F00);
