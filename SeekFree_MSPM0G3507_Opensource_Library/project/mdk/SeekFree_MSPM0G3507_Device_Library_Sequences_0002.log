[18:25:28.129]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[18:25:28.140]    <block atomic="false" info="">
[18:25:28.140]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[18:25:28.140]        // -> [isSWJ <= 0x00000001]
