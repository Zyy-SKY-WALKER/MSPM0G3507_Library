[18:00:49.910]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[18:00:49.910]    <block atomic="false" info="">
[18:00:49.910]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[18:00:49.910]        // -> [isSWJ <= 0x00000001]
[18:00:49.910]      __var hasDormant = __protocol & 0x00020000;
