[18:14:42.889]      __var DP_CTRL_STAT      = 0x4;
[18:14:42.889]        // -> [DP_CTRL_STAT <= 0x00000004]
[18:14:42.889]      __var DP_SELECT         = 0x8;
[18:14:42.889]        // -> [DP_SELECT <= 0x00000008]
[18:14:42.889]      __var powered_down      = 0;
[18:14:42.889]        // -> [powered_down <= 0x00000000]
[18:14:42.889]      WriteDP(DP_SELECT, 0x00000000);
[18:14:42.889]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[18:14:42.889]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
