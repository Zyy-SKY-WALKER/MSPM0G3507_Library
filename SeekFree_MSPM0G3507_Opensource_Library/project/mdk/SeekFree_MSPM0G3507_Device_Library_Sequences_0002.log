[18:00:49.910]      // if-block "protType == 2"
[18:00:49.910]        // =>  TRUE
[18:00:49.910]      <control if="isSWJ" while="" timeout="0" info="">
[18:00:49.910]        // if-block "isSWJ"
[18:00:49.910]          // =>  TRUE
[18:00:49.910]        <control if="hasDormant" while="" timeout="0" info="">
[18:00:49.910]          // if-block "hasDormant"
[18:00:49.910]            // =>  FALSE
[18:00:49.910]          // skip if-block "hasDormant"
[18:00:49.910]        </control>
[18:00:49.910]        <control if="!hasDormant" while="" timeout="0" info="">
[18:00:49.910]          // if-block "!hasDormant"
[18:00:49.910]            // =>  TRUE
[18:00:49.910]          <block atomic="false" info="">
[18:00:49.910]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:00:49.912]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:00:49.912]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:00:49.913]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:00:49.913]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:00:49.913]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:00:49.913]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[18:00:49.914]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[18:00:49.914]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:00:49.915]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:00:49.915]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:00:49.915]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:00:49.915]          </block>
[18:00:49.915]          // end if-block "!hasDormant"
[18:00:49.915]        </control>
[18:00:49.915]        // end if-block "isSWJ"
[18:00:49.915]      </control>
