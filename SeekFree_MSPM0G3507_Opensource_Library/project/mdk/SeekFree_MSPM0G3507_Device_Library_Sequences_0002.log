[18:14:42.883]        ReadDP(0x0);
[18:14:42.889]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[18:14:42.889]      </block>
[18:14:42.889]      // end if-block "protType == 2"
[18:14:42.889]    </control>
[18:14:42.889]  </sequence>
