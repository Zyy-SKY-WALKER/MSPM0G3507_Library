[18:00:49.950]      __var isMSPM0G1X0X_G3X0X = 0;
[18:00:49.950]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[18:00:49.950]      __var isProduction = 0;
[18:00:49.950]        // -> [isProduction <= 0x00000000]
[18:00:49.950]      __var continueId = 0;
[18:00:49.950]        // -> [continueId <= 0x00000000]
[18:00:49.950]      deviceID =   Read32(0x41C40004);
[18:00:49.962]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[18:00:49.962]        // -> [deviceID <= 0x2BB8802F]
[18:00:49.962]      version = deviceID >> 28;
[18:00:49.962]        // -> [version <= 0x00000002]
[18:00:49.962]      partNum = (deviceID & 0x0FFFF000) >> 12;
[18:00:49.962]        // -> [partNum <= 0x0000BB88]
[18:00:49.962]      manuf = (deviceID & 0x00000FFE) >> 1;
[18:00:49.962]        // -> [manuf <= 0x00000017]
[18:00:49.962]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[18:00:49.962]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[18:00:49.962]      isProduction = (version > 0);
[18:00:49.962]        // -> [isProduction <= 0x00000001]
[18:00:49.962]    </block>
[18:00:49.962]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
