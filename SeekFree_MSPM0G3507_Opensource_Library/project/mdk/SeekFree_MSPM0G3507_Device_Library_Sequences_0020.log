[19:01:34.627]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:01:34.627]    <block atomic="false" info="">
[19:01:34.627]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:01:34.627]        // -> [isSWJ <= 0x00000001]
