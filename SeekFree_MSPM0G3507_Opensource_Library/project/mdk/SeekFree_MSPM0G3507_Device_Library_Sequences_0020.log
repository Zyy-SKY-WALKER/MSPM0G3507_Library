[19:27:59.057]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[19:27:59.057]    <block atomic="false" info="">
[19:27:59.057]      __var SW_DP_ABORT       = 0x0;
[19:27:59.057]        // -> [SW_DP_ABORT <= 0x00000000]
[19:27:59.057]      __var DP_CTRL_STAT      = 0x4;
[19:27:59.057]        // -> [DP_CTRL_STAT <= 0x00000004]
[19:27:59.057]      __var DP_SELECT         = 0x8;
[19:27:59.057]        // -> [DP_SELECT <= 0x00000008]
[19:27:59.057]      __var powered_down      = 0;
[19:27:59.057]        // -> [powered_down <= 0x00000000]
[19:27:59.057]      WriteDP(DP_SELECT, 0x00000000);
[19:27:59.061]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:27:59.061]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:27:59.063]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:27:59.063]        // -> [powered_down <= 0x00000001]
[19:27:59.063]    </block>
[19:27:59.063]    <control if="powered_down" while="" timeout="0" info="">
[19:27:59.063]      // if-block "powered_down"
[19:27:59.063]        // =>  TRUE
[19:27:59.063]      <block atomic="false" info="">
[19:27:59.063]        Message(0, "Debug/System power-up request sent");
[19:27:59.065]        WriteDP(DP_CTRL_STAT, 0x50000000);
[19:27:59.067]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[19:27:59.068]      </block>
[19:27:59.068]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[19:27:59.068]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[19:27:59.069]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[19:27:59.070]        // while-condition  =>  FALSE
[19:27:59.070]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[19:27:59.070]      </control>
[19:27:59.070]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[19:27:59.070]        // if-block "(__protocol & 0xFFFF) == 1"
[19:27:59.070]          // =>  FALSE
[19:27:59.070]        // skip if-block "(__protocol & 0xFFFF) == 1"
[19:27:59.070]      </control>
[19:27:59.070]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[19:27:59.070]        // if-block "(__protocol & 0xFFFF) == 2"
[19:27:59.070]          // =>  TRUE
[19:27:59.070]        <block atomic="false" info="">
[19:27:59.070]          Message(0, "executing SWD power up");
[19:27:59.071]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[19:27:59.074]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[19:27:59.075]          WriteDP(SW_DP_ABORT, 0x0000001E);
[19:27:59.076]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[19:27:59.076]        </block>
[19:27:59.076]        // end if-block "(__protocol & 0xFFFF) == 2"
[19:27:59.076]      </control>
[19:27:59.076]      // end if-block "powered_down"
