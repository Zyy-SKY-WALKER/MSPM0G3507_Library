[19:27:59.057]  <debugvars>
[19:27:59.057]    // Pre-defined
[19:27:59.057]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[19:27:59.057]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
