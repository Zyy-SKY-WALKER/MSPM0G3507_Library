[19:27:59.035]        // =>  TRUE
[19:27:59.035]      <control if="isSWJ" while="" timeout="0" info="">
[19:27:59.035]        // if-block "isSWJ"
[19:27:59.035]          // =>  TRUE
[19:27:59.035]        <control if="hasDormant" while="" timeout="0" info="">
[19:27:59.035]          // if-block "hasDormant"
[19:27:59.035]            // =>  FALSE
[19:27:59.035]          // skip if-block "hasDormant"
[19:27:59.035]        </control>
[19:27:59.035]        <control if="!hasDormant" while="" timeout="0" info="">
[19:27:59.035]          // if-block "!hasDormant"
[19:27:59.035]            // =>  TRUE
[19:27:59.035]          <block atomic="false" info="">
[19:27:59.035]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:27:59.035]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:27:59.035]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:27:59.035]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:27:59.041]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:27:59.041]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:27:59.041]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:27:59.041]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:27:59.041]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:27:59.046]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:27:59.046]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:27:59.046]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:27:59.046]          </block>
[19:27:59.046]          // end if-block "!hasDormant"
[19:27:59.046]        </control>
[19:27:59.046]        // end if-block "isSWJ"
[19:27:59.046]      </control>
