[19:27:59.030]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:27:59.035]    <block atomic="false" info="">
[19:27:59.035]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:27:59.035]        // -> [isSWJ <= 0x00000001]
[19:27:59.035]      __var hasDormant = __protocol & 0x00020000;
[19:27:59.035]        // -> [hasDormant <= 0x00000000]
