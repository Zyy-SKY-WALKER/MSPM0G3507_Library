[19:01:34.627]      // if-block "protType == 2"
[19:01:34.627]        // =>  TRUE
[19:01:34.627]      <control if="isSWJ" while="" timeout="0" info="">
[19:01:34.627]        // if-block "isSWJ"
[19:01:34.627]          // =>  TRUE
[19:01:34.627]        <control if="hasDormant" while="" timeout="0" info="">
[19:01:34.627]          // if-block "hasDormant"
[19:01:34.629]            // =>  FALSE
[19:01:34.629]          // skip if-block "hasDormant"
[19:01:34.629]        </control>
[19:01:34.629]        <control if="!hasDormant" while="" timeout="0" info="">
[19:01:34.629]          // if-block "!hasDormant"
[19:01:34.629]            // =>  TRUE
[19:01:34.629]          <block atomic="false" info="">
[19:01:34.629]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:01:34.629]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:01:34.629]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:01:34.629]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:01:34.629]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:01:34.629]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:01:34.629]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:01:34.638]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:01:34.638]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:01:34.642]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:01:34.642]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:01:34.644]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:01:34.644]          </block>
[19:01:34.644]          // end if-block "!hasDormant"
[19:01:34.644]        </control>
[19:01:34.644]        // end if-block "isSWJ"
[19:01:34.644]      </control>
