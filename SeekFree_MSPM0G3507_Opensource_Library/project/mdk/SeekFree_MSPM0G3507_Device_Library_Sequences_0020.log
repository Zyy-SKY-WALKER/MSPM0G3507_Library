[19:01:34.743]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:01:34.743]    <block atomic="false" info="">
[19:01:34.743]      __var deviceID = 0;
[19:01:34.743]        // -> [deviceID <= 0x00000000]
[19:01:34.743]      __var version = 0;
[19:01:34.743]        // -> [version <= 0x00000000]
[19:01:34.743]      __var partNum = 0;
[19:01:34.743]        // -> [partNum <= 0x00000000]
[19:01:34.743]      __var manuf = 0;
[19:01:34.743]        // -> [manuf <= 0x00000000]
[19:01:34.743]      __var isMSPM0G1X0X_G3X0X = 0;
[19:01:34.743]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:01:34.743]      __var isProduction = 0;
[19:01:34.743]        // -> [isProduction <= 0x00000000]
[19:01:34.743]      __var continueId = 0;
[19:01:34.743]        // -> [continueId <= 0x00000000]
[19:01:34.743]      deviceID =   Read32(0x41C40004);
[19:01:34.752]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:01:34.752]        // -> [deviceID <= 0x2BB8802F]
[19:01:34.752]      version = deviceID >> 28;
[19:01:34.752]        // -> [version <= 0x00000002]
[19:01:34.752]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:01:34.754]        // -> [partNum <= 0x0000BB88]
[19:01:34.754]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:01:34.754]        // -> [manuf <= 0x00000017]
[19:01:34.754]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:01:34.754]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:01:34.754]      isProduction = (version > 0);
[19:01:34.754]        // -> [isProduction <= 0x00000001]
[19:01:34.754]    </block>
[19:01:34.754]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
