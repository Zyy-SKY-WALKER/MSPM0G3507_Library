[20:35:17.735]      __var deviceID = 0;
[20:35:17.735]        // -> [deviceID <= 0x00000000]
[20:35:17.735]      __var version = 0;
[20:35:17.735]        // -> [version <= 0x00000000]
[20:35:17.735]      __var partNum = 0;
[20:35:17.735]        // -> [partNum <= 0x00000000]
[20:35:17.735]      __var manuf = 0;
[20:35:17.735]        // -> [manuf <= 0x00000000]
[20:35:17.735]      __var isMSPM0G1X0X_G3X0X = 0;
[20:35:17.735]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:35:17.735]      __var isProduction = 0;
[20:35:17.735]        // -> [isProduction <= 0x00000000]
[20:35:17.735]      __var continueId = 0;
[20:35:17.735]        // -> [continueId <= 0x00000000]
[20:35:17.735]      deviceID =   Read32(0x41C40004);
[20:35:17.745]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:35:17.745]        // -> [deviceID <= 0x2BB8802F]
[20:35:17.745]      version = deviceID >> 28;
[20:35:17.745]        // -> [version <= 0x00000002]
[20:35:17.745]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:35:17.745]        // -> [partNum <= 0x0000BB88]
[20:35:17.745]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:35:17.745]        // -> [manuf <= 0x00000017]
[20:35:17.745]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:35:17.745]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:35:17.745]      isProduction = (version > 0);
[20:35:17.745]        // -> [isProduction <= 0x00000001]
[20:35:17.745]    </block>
