[20:35:17.704]      <block atomic="false" info="">
[20:35:17.704]        WriteAP(0x00, 0x190008);
[20:35:17.704]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[20:35:17.704]        WriteAP(0xF0, 0x01);
[20:35:17.714]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[20:35:17.714]      </block>
[20:35:17.714]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[20:35:17.714]    </control>
[20:35:17.714]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
