[16:05:00.460]        <block atomic="false" info="">
[16:05:00.460]          Message(0, "executing SWD power up");
[16:05:00.460]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[16:05:00.464]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
