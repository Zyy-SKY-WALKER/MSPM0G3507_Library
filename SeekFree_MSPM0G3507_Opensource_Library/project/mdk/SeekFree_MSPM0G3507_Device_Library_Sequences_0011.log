[17:07:25.891]        // -> [partNum <= 0x00000000]
[17:07:25.891]      __var manuf = 0;
[17:07:25.891]        // -> [manuf <= 0x00000000]
[17:07:25.891]      __var isMSPM0G1X0X_G3X0X = 0;
[17:07:25.891]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:07:25.891]      __var isProduction = 0;
[17:07:25.891]        // -> [isProduction <= 0x00000000]
[17:07:25.891]      __var continueId = 0;
