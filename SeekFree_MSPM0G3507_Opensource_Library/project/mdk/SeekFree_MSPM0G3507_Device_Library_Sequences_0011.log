[18:48:29.350]      // skip if-block "protType == 1"
[18:48:29.351]    </control>
[18:48:29.351]    <control if="protType == 2" while="" timeout="0" info="">
[18:48:29.351]      // if-block "protType == 2"
[18:48:29.351]        // =>  TRUE
[18:48:29.351]      <control if="isSWJ" while="" timeout="0" info="">
[18:48:29.351]        // if-block "isSWJ"
[18:48:29.351]          // =>  TRUE
[18:48:29.351]        <control if="hasDormant" while="" timeout="0" info="">
[18:48:29.351]          // if-block "hasDormant"
[18:48:29.351]            // =>  FALSE
[18:48:29.351]          // skip if-block "hasDormant"
[18:48:29.351]        </control>
[18:48:29.351]        <control if="!hasDormant" while="" timeout="0" info="">
[18:48:29.351]          // if-block "!hasDormant"
[18:48:29.351]            // =>  TRUE
[18:48:29.351]          <block atomic="false" info="">
[18:48:29.351]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:48:29.354]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:48:29.354]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:48:29.356]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:48:29.356]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:48:29.358]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:48:29.358]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[18:48:29.360]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[18:48:29.360]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:48:29.362]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:48:29.362]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:48:29.364]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:48:29.364]          </block>
[18:48:29.364]          // end if-block "!hasDormant"
[18:48:29.364]        </control>
[18:48:29.364]        // end if-block "isSWJ"
[18:48:29.364]      </control>
[18:48:29.364]      <control if="!isSWJ" while="" timeout="0" info="">
[18:48:29.364]        // if-block "!isSWJ"
[18:48:29.364]          // =>  FALSE
[18:48:29.364]        // skip if-block "!isSWJ"
[18:48:29.365]      </control>
