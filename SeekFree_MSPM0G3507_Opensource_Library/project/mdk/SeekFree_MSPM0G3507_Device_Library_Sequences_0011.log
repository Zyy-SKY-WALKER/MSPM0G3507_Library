[15:03:00.720]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[15:03:00.720]    <block atomic="false" info="">
[15:03:00.720]      __var deviceID = 0;
[15:03:00.720]        // -> [deviceID <= 0x00000000]
[15:03:00.720]      __var version = 0;
[15:03:00.720]        // -> [version <= 0x00000000]
[15:03:00.720]      __var partNum = 0;
[15:03:00.720]        // -> [partNum <= 0x00000000]
[15:03:00.720]      __var manuf = 0;
[15:03:00.720]        // -> [manuf <= 0x00000000]
[15:03:00.720]      __var isMSPM0G1X0X_G3X0X = 0;
[15:03:00.720]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:03:00.720]      __var isProduction = 0;
[15:03:00.720]        // -> [isProduction <= 0x00000000]
[15:03:00.720]      __var continueId = 0;
[15:03:00.720]        // -> [continueId <= 0x00000000]
[15:03:00.720]      deviceID =   Read32(0x41C40004);
[15:03:00.730]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:03:00.730]        // -> [deviceID <= 0x2BB8802F]
[15:03:00.730]      version = deviceID >> 28;
[15:03:00.730]        // -> [version <= 0x00000002]
[15:03:00.730]      partNum = (deviceID & 0x0FFFF000) >> 12;
[15:03:00.730]        // -> [partNum <= 0x0000BB88]
[15:03:00.730]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:03:00.730]        // -> [manuf <= 0x00000017]
[15:03:00.730]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:03:00.730]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:03:00.730]      isProduction = (version > 0);
[15:03:00.730]        // -> [isProduction <= 0x00000001]
[15:03:00.730]    </block>
[15:03:00.730]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[15:03:00.730]      // if-block "!isMSPM0G1X0X_G3X0X"
[15:03:00.730]        // =>  FALSE
[15:03:00.730]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[15:03:00.730]    </control>
[15:03:00.730]    <control if="continueId == 4" while="" timeout="0" info="">
[15:03:00.730]      // if-block "continueId == 4"
[15:03:00.730]        // =>  FALSE
[15:03:00.730]      // skip if-block "continueId == 4"
[15:03:00.730]    </control>
[15:03:00.730]    <control if="!isProduction" while="" timeout="0" info="">
[15:03:00.730]      // if-block "!isProduction"
[15:03:00.730]        // =>  FALSE
[15:03:00.730]      // skip if-block "!isProduction"
[15:03:00.730]    </control>
[15:03:00.730]  </sequence>
