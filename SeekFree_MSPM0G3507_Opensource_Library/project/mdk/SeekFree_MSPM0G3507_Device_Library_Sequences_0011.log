[18:58:17.566]        // -> [manuf <= 0x00000017]
[18:58:17.566]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[18:58:17.566]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
