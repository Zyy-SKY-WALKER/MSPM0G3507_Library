[17:07:25.898]        // -> [partNum <= 0x0000BB88]
[17:07:25.898]      manuf = (deviceID & 0x00000FFE) >> 1;
[17:07:25.898]        // -> [manuf <= 0x00000017]
[17:07:25.898]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:07:25.898]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:07:25.898]      isProduction = (version > 0);
[17:07:25.898]        // -> [isProduction <= 0x00000001]
[17:07:25.898]    </block>
[17:07:25.898]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
