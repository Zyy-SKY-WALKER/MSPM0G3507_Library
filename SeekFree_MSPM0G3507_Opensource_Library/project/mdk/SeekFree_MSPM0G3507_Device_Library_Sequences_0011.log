[18:48:29.350]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[18:48:29.350]    <block atomic="false" info="">
[18:48:29.350]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[18:48:29.350]        // -> [isSWJ <= 0x00000001]
[18:48:29.350]      __var hasDormant = __protocol & 0x00020000;
[18:48:29.350]        // -> [hasDormant <= 0x00000000]
[18:48:29.350]      __var protType   = __protocol & 0x0000FFFF;
[18:48:29.350]        // -> [protType <= 0x00000002]
[18:48:29.350]    </block>
[18:48:29.350]    <control if="protType == 1" while="" timeout="0" info="">
[18:48:29.350]      // if-block "protType == 1"
