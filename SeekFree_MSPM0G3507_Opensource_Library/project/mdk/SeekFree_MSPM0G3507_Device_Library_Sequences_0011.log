[16:03:19.033]        </control>
[16:03:19.033]        <control if="!hasDormant" while="" timeout="0" info="">
[16:03:19.033]          // if-block "!hasDormant"
[16:03:19.033]            // =>  TRUE
[16:03:19.033]          <block atomic="false" info="">
[16:03:19.033]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[16:03:19.036]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:03:19.036]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[16:03:19.039]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[16:03:19.039]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[16:03:19.041]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
