[18:48:29.365]        ReadDP(0x0);
[18:48:29.367]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[18:48:29.367]      </block>
[18:48:29.368]      // end if-block "protType == 2"
[18:48:29.368]    </control>
[18:48:29.368]  </sequence>
