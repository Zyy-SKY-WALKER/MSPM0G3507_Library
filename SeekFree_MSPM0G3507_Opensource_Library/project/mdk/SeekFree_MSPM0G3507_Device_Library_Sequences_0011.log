[15:03:00.720]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[15:03:00.720]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[15:03:00.720]    __dp=0x00000000
[15:03:00.720]    __ap=0x00000000
[15:03:00.720]    __traceout=0x00000000      (Trace Disabled)
