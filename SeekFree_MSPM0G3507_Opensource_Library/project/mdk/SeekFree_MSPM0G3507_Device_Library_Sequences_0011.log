[16:03:19.032]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[16:03:19.032]    <block atomic="false" info="">
[16:03:19.032]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[16:03:19.032]        // -> [isSWJ <= 0x00000001]
