[15:03:00.570]      // if-block "protType == 1"
[15:03:00.570]        // =>  FALSE
[15:03:00.570]      // skip if-block "protType == 1"
[15:03:00.570]    </control>
[15:03:00.570]    <control if="protType == 2" while="" timeout="0" info="">
[15:03:00.570]      // if-block "protType == 2"
[15:03:00.570]        // =>  TRUE
[15:03:00.570]      <control if="isSWJ" while="" timeout="0" info="">
[15:03:00.570]        // if-block "isSWJ"
[15:03:00.570]          // =>  TRUE
[15:03:00.570]        <control if="hasDormant" while="" timeout="0" info="">
[15:03:00.570]          // if-block "hasDormant"
[15:03:00.570]            // =>  FALSE
[15:03:00.570]          // skip if-block "hasDormant"
[15:03:00.570]        </control>
[15:03:00.570]        <control if="!hasDormant" while="" timeout="0" info="">
[15:03:00.570]          // if-block "!hasDormant"
[15:03:00.570]            // =>  TRUE
[15:03:00.570]          <block atomic="false" info="">
[15:03:00.570]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:03:00.570]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:03:00.570]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:03:00.570]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:03:00.570]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:03:00.570]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:03:00.570]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:03:00.580]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:03:00.580]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:03:00.580]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:03:00.580]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:03:00.590]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:03:00.590]          </block>
[15:03:00.590]          // end if-block "!hasDormant"
[15:03:00.590]        </control>
[15:03:00.590]        // end if-block "isSWJ"
[15:03:00.590]      </control>
[15:03:00.590]      <control if="!isSWJ" while="" timeout="0" info="">
[15:03:00.590]        // if-block "!isSWJ"
[15:03:00.590]          // =>  FALSE
[15:03:00.590]        // skip if-block "!isSWJ"
[15:03:00.590]      </control>
[15:03:00.590]      <block atomic="false" info="">
[15:03:00.590]        ReadDP(0x0);
[15:03:00.590]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[15:03:00.590]      </block>
[15:03:00.590]      // end if-block "protType == 2"
[15:03:00.590]    </control>
