[20:02:58.448]          // if-block "!hasDormant"
[20:02:58.448]            // =>  TRUE
[20:02:58.448]          <block atomic="false" info="">
[20:02:58.448]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:02:58.451]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:02:58.451]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:02:58.456]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:02:58.456]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:02:58.460]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:02:58.460]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[20:02:58.462]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[20:02:58.462]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[20:02:58.466]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:02:58.466]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:02:58.468]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
