[15:53:50.650]          // if-block "!hasDormant"
[15:53:50.650]            // =>  TRUE
[15:53:50.650]          <block atomic="false" info="">
[15:53:50.650]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:53:50.650]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:53:50.650]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:53:50.650]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:53:50.650]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
