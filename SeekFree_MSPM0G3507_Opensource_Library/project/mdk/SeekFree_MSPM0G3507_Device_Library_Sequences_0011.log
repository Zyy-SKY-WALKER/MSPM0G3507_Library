[15:03:00.668]        WriteAP(0x00, 0x190008);
[15:03:00.670]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[15:03:00.672]        WriteAP(0xF0, 0x01);
[15:03:00.682]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[15:03:00.682]      </block>
[15:03:00.682]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
