[17:03:44.823]          // if-block "hasDormant"
[17:03:44.823]            // =>  FALSE
[17:03:44.823]          // skip if-block "hasDormant"
[17:03:44.823]        </control>
[17:03:44.823]        <control if="!hasDormant" while="" timeout="0" info="">
[17:03:44.823]          // if-block "!hasDormant"
[17:03:44.823]            // =>  TRUE
[17:03:44.823]          <block atomic="false" info="">
[17:03:44.823]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:03:44.825]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:03:44.825]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:03:44.827]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:03:44.827]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
