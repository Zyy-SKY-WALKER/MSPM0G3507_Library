[16:05:00.413]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[16:05:00.413]    <block atomic="false" info="">
[16:05:00.413]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[16:05:00.413]        // -> [isSWJ <= 0x00000001]
