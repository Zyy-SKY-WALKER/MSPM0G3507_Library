[16:05:00.450]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[16:05:00.450]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[16:05:00.450]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[16:05:00.450]        // -> [powered_down <= 0x00000001]
