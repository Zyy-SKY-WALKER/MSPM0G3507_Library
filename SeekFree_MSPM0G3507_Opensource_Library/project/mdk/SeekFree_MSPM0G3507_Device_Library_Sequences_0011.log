[15:53:50.649]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:53:50.649]    <block atomic="false" info="">
[15:53:50.649]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:53:50.649]        // -> [isSWJ <= 0x00000001]
[15:53:50.649]      __var hasDormant = __protocol & 0x00020000;
[15:53:50.650]        // -> [hasDormant <= 0x00000000]
