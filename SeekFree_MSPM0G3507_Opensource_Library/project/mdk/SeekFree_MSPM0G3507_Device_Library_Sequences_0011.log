[15:52:36.903]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[15:52:36.903]    <block atomic="false" info="">
[15:52:36.903]      __var deviceID = 0;
[15:52:36.903]        // -> [deviceID <= 0x00000000]
[15:52:36.903]      __var version = 0;
[15:52:36.903]        // -> [version <= 0x00000000]
[15:52:36.903]      __var partNum = 0;
[15:52:36.903]        // -> [partNum <= 0x00000000]
[15:52:36.903]      __var manuf = 0;
[15:52:36.903]        // -> [manuf <= 0x00000000]
[15:52:36.903]      __var isMSPM0G1X0X_G3X0X = 0;
[15:52:36.903]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:52:36.903]      __var isProduction = 0;
[15:52:36.903]        // -> [isProduction <= 0x00000000]
[15:52:36.903]      __var continueId = 0;
[15:52:36.904]        // -> [continueId <= 0x00000000]
[15:52:36.904]      deviceID =   Read32(0x41C40004);
[15:52:36.910]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:52:36.910]        // -> [deviceID <= 0x2BB8802F]
[15:52:36.910]      version = deviceID >> 28;
[15:52:36.910]        // -> [version <= 0x00000002]
[15:52:36.910]      partNum = (deviceID & 0x0FFFF000) >> 12;
[15:52:36.910]        // -> [partNum <= 0x0000BB88]
[15:52:36.910]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:52:36.911]        // -> [manuf <= 0x00000017]
[15:52:36.911]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:52:36.911]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:52:36.911]      isProduction = (version > 0);
[15:52:36.911]        // -> [isProduction <= 0x00000001]
[15:52:36.911]    </block>
[15:52:36.911]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
