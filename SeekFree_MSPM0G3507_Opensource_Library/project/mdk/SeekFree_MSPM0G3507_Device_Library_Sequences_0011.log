[17:07:25.798]      __var DP_CTRL_STAT      = 0x4;
[17:07:25.798]        // -> [DP_CTRL_STAT <= 0x00000004]
[17:07:25.798]      __var DP_SELECT         = 0x8;
[17:07:25.798]        // -> [DP_SELECT <= 0x00000008]
[17:07:25.798]      __var powered_down      = 0;
[17:07:25.798]        // -> [powered_down <= 0x00000000]
[17:07:25.798]      WriteDP(DP_SELECT, 0x00000000);
[17:07:25.798]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[17:07:25.798]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[17:07:25.798]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[17:07:25.798]        // -> [powered_down <= 0x00000001]
[17:07:25.798]    </block>
[17:07:25.798]    <control if="powered_down" while="" timeout="0" info="">
[17:07:25.798]      // if-block "powered_down"
[17:07:25.798]        // =>  TRUE
[17:07:25.798]      <block atomic="false" info="">
[17:07:25.798]        Message(0, "Debug/System power-up request sent");
[17:07:25.798]        WriteDP(DP_CTRL_STAT, 0x50000000);
