[15:03:00.559]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:03:00.559]    <block atomic="false" info="">
[15:03:00.559]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:03:00.559]        // -> [isSWJ <= 0x00000001]
[15:03:00.570]      __var hasDormant = __protocol & 0x00020000;
[15:03:00.570]        // -> [hasDormant <= 0x00000000]
[15:03:00.570]      __var protType   = __protocol & 0x0000FFFF;
[15:03:00.570]        // -> [protType <= 0x00000002]
[15:03:00.570]    </block>
