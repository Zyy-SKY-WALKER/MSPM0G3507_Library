[18:58:17.525]      <block atomic="false" info="">
[18:58:17.525]        WriteAP(0x00, 0x190008);
[18:58:17.527]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[18:58:17.527]        WriteAP(0xF0, 0x01);
[18:58:17.531]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[18:58:17.531]      </block>
[18:58:17.531]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[18:58:17.531]    </control>
[18:58:17.531]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
