[16:05:00.418]          // if-block "hasDormant"
[16:05:00.418]            // =>  FALSE
[16:05:00.418]          // skip if-block "hasDormant"
[16:05:00.418]        </control>
[16:05:00.418]        <control if="!hasDormant" while="" timeout="0" info="">
[16:05:00.418]          // if-block "!hasDormant"
[16:05:00.418]            // =>  TRUE
[16:05:00.418]          <block atomic="false" info="">
[16:05:00.418]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[16:05:00.418]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:05:00.418]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[16:05:00.424]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[16:05:00.424]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[16:05:00.428]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:05:00.428]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
