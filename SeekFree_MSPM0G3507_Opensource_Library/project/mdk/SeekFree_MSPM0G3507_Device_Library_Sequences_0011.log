[16:05:00.543]        // -> [partNum <= 0x00000000]
[16:05:00.543]      __var manuf = 0;
[16:05:00.543]        // -> [manuf <= 0x00000000]
[16:05:00.543]      __var isMSPM0G1X0X_G3X0X = 0;
[16:05:00.543]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[16:05:00.543]      __var isProduction = 0;
[16:05:00.548]        // -> [isProduction <= 0x00000000]
[16:05:00.548]      __var continueId = 0;
[16:05:00.548]        // -> [continueId <= 0x00000000]
[16:05:00.548]      deviceID =   Read32(0x41C40004);
[16:05:00.553]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[16:05:00.553]        // -> [deviceID <= 0x2BB8802F]
[16:05:00.553]      version = deviceID >> 28;
[16:05:00.553]        // -> [version <= 0x00000002]
[16:05:00.553]      partNum = (deviceID & 0x0FFFF000) >> 12;
[16:05:00.553]        // -> [partNum <= 0x0000BB88]
[16:05:00.553]      manuf = (deviceID & 0x00000FFE) >> 1;
[16:05:00.553]        // -> [manuf <= 0x00000017]
[16:05:00.553]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[16:05:00.553]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[16:05:00.553]      isProduction = (version > 0);
[16:05:00.553]        // -> [isProduction <= 0x00000001]
[16:05:00.553]    </block>
[16:05:00.553]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
