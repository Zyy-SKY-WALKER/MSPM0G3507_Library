[17:07:25.812]          // =>  TRUE
[17:07:25.812]        <block atomic="false" info="">
[17:07:25.812]          Message(0, "executing SWD power up");
[17:07:25.812]          WriteDP(DP_CTRL_STAT, 0x50000F00);
