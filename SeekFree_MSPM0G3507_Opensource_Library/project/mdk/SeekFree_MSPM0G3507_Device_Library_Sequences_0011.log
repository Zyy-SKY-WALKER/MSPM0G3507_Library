[15:03:00.590]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[15:03:00.590]    <block atomic="false" info="">
[15:03:00.599]      __var SW_DP_ABORT       = 0x0;
[15:03:00.599]        // -> [SW_DP_ABORT <= 0x00000000]
[15:03:00.599]      __var DP_CTRL_STAT      = 0x4;
[15:03:00.599]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:03:00.599]      __var DP_SELECT         = 0x8;
[15:03:00.599]        // -> [DP_SELECT <= 0x00000008]
[15:03:00.599]      __var powered_down      = 0;
[15:03:00.599]        // -> [powered_down <= 0x00000000]
[15:03:00.599]      WriteDP(DP_SELECT, 0x00000000);
[15:03:00.602]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:03:00.602]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[15:03:00.604]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[15:03:00.604]        // -> [powered_down <= 0x00000001]
[15:03:00.604]    </block>
[15:03:00.604]    <control if="powered_down" while="" timeout="0" info="">
[15:03:00.604]      // if-block "powered_down"
[15:03:00.604]        // =>  TRUE
[15:03:00.604]      <block atomic="false" info="">
[15:03:00.604]        Message(0, "Debug/System power-up request sent");
[15:03:00.614]        WriteDP(DP_CTRL_STAT, 0x50000000);
[15:03:00.616]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[15:03:00.616]      </block>
[15:03:00.616]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[15:03:00.617]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[15:03:00.620]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[15:03:00.620]        // while-condition  =>  FALSE
[15:03:00.620]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[15:03:00.620]      </control>
[15:03:00.620]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[15:03:00.620]        // if-block "(__protocol & 0xFFFF) == 1"
[15:03:00.620]          // =>  FALSE
[15:03:00.620]        // skip if-block "(__protocol & 0xFFFF) == 1"
[15:03:00.620]      </control>
[15:03:00.620]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[15:03:00.620]        // if-block "(__protocol & 0xFFFF) == 2"
[15:03:00.620]          // =>  TRUE
[15:03:00.620]        <block atomic="false" info="">
[15:03:00.620]          Message(0, "executing SWD power up");
[15:03:00.629]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:03:00.631]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[15:03:00.631]          WriteDP(SW_DP_ABORT, 0x0000001E);
[15:03:00.633]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[15:03:00.633]        </block>
[15:03:00.633]        // end if-block "(__protocol & 0xFFFF) == 2"
[15:03:00.633]      </control>
[15:03:00.633]      // end if-block "powered_down"
[15:03:00.633]    </control>
[15:03:00.633]    <block atomic="false" info="">
[15:03:00.634]      __var DEBUG_PORT_VAL    = 0;
[15:03:00.634]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[15:03:00.634]      __var ACCESS_POINT_VAL  = 0;
[15:03:00.634]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[15:03:00.634]      __ap = 1; 
[15:03:00.634]        // -> [__ap <= 0x00000001]
[15:03:00.634]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[15:03:00.638]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[15:03:00.638]      __ap = 4;
[15:03:00.638]        // -> [__ap <= 0x00000004]
[15:03:00.638]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[15:03:00.642]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[15:03:00.643]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[15:03:00.643]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[15:03:00.647]    </block>
[15:03:00.648]    <block atomic="false" info="">
[15:03:00.648]      __var nReset = 0x80;
[15:03:00.648]        // -> [nReset <= 0x00000080]
[15:03:00.648]      __var canReadPins = 0;
[15:03:00.648]        // -> [canReadPins <= 0x00000000]
