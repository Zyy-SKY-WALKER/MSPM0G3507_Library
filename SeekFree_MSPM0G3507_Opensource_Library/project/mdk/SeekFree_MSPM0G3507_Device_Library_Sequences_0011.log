[15:01:01.249]        // -> [partNum <= 0x00000000]
[15:01:01.249]      __var manuf = 0;
[15:01:01.249]        // -> [manuf <= 0x00000000]
[15:01:01.249]      __var isMSPM0G1X0X_G3X0X = 0;
[15:01:01.249]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:01:01.249]      __var isProduction = 0;
[15:01:01.249]        // -> [isProduction <= 0x00000000]
[15:01:01.249]      __var continueId = 0;
[15:01:01.249]        // -> [continueId <= 0x00000000]
[15:01:01.249]      deviceID =   Read32(0x41C40004);
[15:01:01.259]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:01:01.259]        // -> [deviceID <= 0x2BB8802F]
[15:01:01.259]      version = deviceID >> 28;
[15:01:01.259]        // -> [version <= 0x00000002]
[15:01:01.259]      partNum = (deviceID & 0x0FFFF000) >> 12;
[15:01:01.259]        // -> [partNum <= 0x0000BB88]
[15:01:01.259]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:01:01.259]        // -> [manuf <= 0x00000017]
[15:01:01.259]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:01:01.259]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:01:01.259]      isProduction = (version > 0);
[15:01:01.259]        // -> [isProduction <= 0x00000001]
