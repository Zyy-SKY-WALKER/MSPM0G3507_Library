[05:13:20.158]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[05:13:20.158]    <block atomic="false" info="">
[05:13:20.158]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[05:13:20.158]        // -> [isSWJ <= 0x00000001]
[05:13:20.158]      __var hasDormant = __protocol & 0x00020000;
[05:13:20.158]        // -> [hasDormant <= 0x00000000]
[05:13:20.158]      __var protType   = __protocol & 0x0000FFFF;
[05:13:20.158]        // -> [protType <= 0x00000002]
[05:13:20.158]    </block>
[05:13:20.158]    <control if="protType == 1" while="" timeout="0" info="">
