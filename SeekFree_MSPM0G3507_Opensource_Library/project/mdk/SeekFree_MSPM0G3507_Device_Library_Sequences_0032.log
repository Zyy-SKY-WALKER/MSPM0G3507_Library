[04:25:44.646]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[04:25:44.646]    <block atomic="false" info="">
[04:25:44.646]      __var deviceID = 0;
[04:25:44.646]        // -> [deviceID <= 0x00000000]
[04:25:44.646]      __var version = 0;
[04:25:44.646]        // -> [version <= 0x00000000]
[04:25:44.646]      __var partNum = 0;
[04:25:44.646]        // -> [partNum <= 0x00000000]
[04:25:44.646]      __var manuf = 0;
[04:25:44.646]        // -> [manuf <= 0x00000000]
[04:25:44.646]      __var isMSPM0G1X0X_G3X0X = 0;
[04:25:44.646]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[04:25:44.646]      __var isProduction = 0;
[04:25:44.646]        // -> [isProduction <= 0x00000000]
[04:25:44.646]      __var continueId = 0;
[04:25:44.646]        // -> [continueId <= 0x00000000]
[04:25:44.646]      deviceID =   Read32(0x41C40004);
[04:25:44.654]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[04:25:44.654]        // -> [deviceID <= 0x2BB8802F]
[04:25:44.654]      version = deviceID >> 28;
[04:25:44.656]        // -> [version <= 0x00000002]
[04:25:44.656]      partNum = (deviceID & 0x0FFFF000) >> 12;
[04:25:44.656]        // -> [partNum <= 0x0000BB88]
[04:25:44.656]      manuf = (deviceID & 0x00000FFE) >> 1;
[04:25:44.656]        // -> [manuf <= 0x00000017]
[04:25:44.656]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[04:25:44.656]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[04:25:44.656]      isProduction = (version > 0);
[04:25:44.656]        // -> [isProduction <= 0x00000001]
[04:25:44.656]    </block>
[04:25:44.656]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[04:25:44.656]      // if-block "!isMSPM0G1X0X_G3X0X"
[04:25:44.656]        // =>  FALSE
[04:25:44.656]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[04:25:44.656]    </control>
