[05:43:11.963]        WriteAP(0xF0, 0x01);
[05:43:11.963]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[05:43:11.963]      </block>
[05:43:11.963]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[05:43:11.963]    </control>
