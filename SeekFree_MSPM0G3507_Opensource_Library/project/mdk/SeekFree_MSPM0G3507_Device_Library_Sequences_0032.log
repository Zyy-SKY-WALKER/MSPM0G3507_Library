[05:44:33.718]  **********  Sequence "DebugPortSetup"  (Context="Connect", Pname="", info="")
[05:44:33.718]  
[05:44:33.723]  <debugvars>
[05:44:33.723]    // Pre-defined
[05:44:33.723]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[05:44:33.723]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
