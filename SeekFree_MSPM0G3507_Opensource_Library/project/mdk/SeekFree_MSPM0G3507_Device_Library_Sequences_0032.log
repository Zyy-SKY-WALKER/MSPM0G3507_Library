[04:27:50.556]  
[04:27:50.556]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[04:27:50.556]    <block atomic="false" info="">
[04:27:50.556]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[04:27:50.556]        // -> [isSWJ <= 0x00000001]
[04:27:50.556]      __var hasDormant = __protocol & 0x00020000;
[04:27:50.556]        // -> [hasDormant <= 0x00000000]
[04:27:50.556]      __var protType   = __protocol & 0x0000FFFF;
[04:27:50.556]        // -> [protType <= 0x00000002]
[04:27:50.556]    </block>
[04:27:50.556]    <control if="protType == 1" while="" timeout="0" info="">
[04:27:50.556]      // if-block "protType == 1"
[04:27:50.556]        // =>  FALSE
[04:27:50.556]      // skip if-block "protType == 1"
[04:27:50.556]    </control>
[04:27:50.556]    <control if="protType == 2" while="" timeout="0" info="">
[04:27:50.556]      // if-block "protType == 2"
[04:27:50.556]        // =>  TRUE
[04:27:50.556]      <control if="isSWJ" while="" timeout="0" info="">
[04:27:50.556]        // if-block "isSWJ"
[04:27:50.556]          // =>  TRUE
[04:27:50.556]        <control if="hasDormant" while="" timeout="0" info="">
[04:27:50.556]          // if-block "hasDormant"
[04:27:50.556]            // =>  FALSE
[04:27:50.556]          // skip if-block "hasDormant"
[04:27:50.556]        </control>
[04:27:50.556]        <control if="!hasDormant" while="" timeout="0" info="">
[04:27:50.556]          // if-block "!hasDormant"
[04:27:50.556]            // =>  TRUE
[04:27:50.556]          <block atomic="false" info="">
[04:27:50.556]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[04:27:50.556]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[04:27:50.556]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[04:27:50.561]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[04:27:50.561]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[04:27:50.563]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[04:27:50.563]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[04:27:50.563]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[04:27:50.563]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[04:27:50.566]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[04:27:50.566]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[04:27:50.568]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[04:27:50.568]          </block>
[04:27:50.568]          // end if-block "!hasDormant"
[04:27:50.568]        </control>
[04:27:50.568]        // end if-block "isSWJ"
[04:27:50.568]      </control>
[04:27:50.570]      <control if="!isSWJ" while="" timeout="0" info="">
[04:27:50.570]        // if-block "!isSWJ"
[04:27:50.570]          // =>  FALSE
[04:27:50.570]        // skip if-block "!isSWJ"
[04:27:50.570]      </control>
[04:27:50.570]      <block atomic="false" info="">
[04:27:50.570]        ReadDP(0x0);
[04:27:50.571]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[04:27:50.571]      </block>
[04:27:50.571]      // end if-block "protType == 2"
[04:27:50.573]    </control>
[04:27:50.573]  </sequence>
