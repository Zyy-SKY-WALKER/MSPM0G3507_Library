[04:29:31.782]  
[04:29:31.782]  <debugvars>
[04:29:31.782]    // Pre-defined
[04:29:31.782]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[04:29:31.782]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[04:29:31.782]    __dp=0x00000000
