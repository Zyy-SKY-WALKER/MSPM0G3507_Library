[05:36:02.884]        // =>  TRUE
[05:36:02.884]      <control if="isSWJ" while="" timeout="0" info="">
[05:36:02.884]        // if-block "isSWJ"
[05:36:02.884]          // =>  TRUE
[05:36:02.884]        <control if="hasDormant" while="" timeout="0" info="">
[05:36:02.884]          // if-block "hasDormant"
[05:36:02.884]            // =>  FALSE
[05:36:02.884]          // skip if-block "hasDormant"
[05:36:02.884]        </control>
[05:36:02.884]        <control if="!hasDormant" while="" timeout="0" info="">
[05:36:02.884]          // if-block "!hasDormant"
[05:36:02.884]            // =>  TRUE
[05:36:02.884]          <block atomic="false" info="">
[05:36:02.884]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[05:36:02.887]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:36:02.887]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[05:36:02.889]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[05:36:02.889]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[05:36:02.891]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:36:02.891]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[05:36:02.893]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[05:36:02.893]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[05:36:02.895]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:36:02.895]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[05:36:02.898]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[05:36:02.898]          </block>
[05:36:02.898]          // end if-block "!hasDormant"
[05:36:02.898]        </control>
[05:36:02.898]        // end if-block "isSWJ"
[05:36:02.898]      </control>
