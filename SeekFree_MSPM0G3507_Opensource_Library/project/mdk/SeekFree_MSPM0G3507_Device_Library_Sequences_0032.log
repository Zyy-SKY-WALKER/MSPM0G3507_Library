[05:37:17.994]        // -> [partNum <= 0x00000000]
[05:37:17.994]      __var manuf = 0;
[05:37:17.994]        // -> [manuf <= 0x00000000]
[05:37:17.994]      __var isMSPM0G1X0X_G3X0X = 0;
[05:37:17.994]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[05:37:17.994]      __var isProduction = 0;
[05:37:17.994]        // -> [isProduction <= 0x00000000]
[05:37:17.994]      __var continueId = 0;
[05:37:17.994]        // -> [continueId <= 0x00000000]
[05:37:17.994]      deviceID =   Read32(0x41C40004);
[05:37:18.004]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[05:37:18.004]        // -> [deviceID <= 0x2BB8802F]
[05:37:18.004]      version = deviceID >> 28;
[05:37:18.004]        // -> [version <= 0x00000002]
[05:37:18.004]      partNum = (deviceID & 0x0FFFF000) >> 12;
[05:37:18.004]        // -> [partNum <= 0x0000BB88]
[05:37:18.004]      manuf = (deviceID & 0x00000FFE) >> 1;
[05:37:18.004]        // -> [manuf <= 0x00000017]
[05:37:18.004]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[05:37:18.004]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[05:37:18.004]      isProduction = (version > 0);
[05:37:18.004]        // -> [isProduction <= 0x00000001]
[05:37:18.004]    </block>
