[04:25:44.579]        // -> [SW_DP_ABORT <= 0x00000000]
[04:25:44.579]      __var DP_CTRL_STAT      = 0x4;
[04:25:44.579]        // -> [DP_CTRL_STAT <= 0x00000004]
[04:25:44.579]      __var DP_SELECT         = 0x8;
[04:25:44.579]        // -> [DP_SELECT <= 0x00000008]
[04:25:44.579]      __var powered_down      = 0;
[04:25:44.579]        // -> [powered_down <= 0x00000000]
[04:25:44.579]      WriteDP(DP_SELECT, 0x00000000);
[04:25:44.579]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[04:25:44.579]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
