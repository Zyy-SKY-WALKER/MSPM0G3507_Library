[04:27:50.651]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[04:27:50.651]    <block atomic="false" info="">
[04:27:50.651]      __var deviceID = 0;
[04:27:50.651]        // -> [deviceID <= 0x00000000]
[04:27:50.651]      __var version = 0;
[04:27:50.651]        // -> [version <= 0x00000000]
[04:27:50.651]      __var partNum = 0;
[04:27:50.651]        // -> [partNum <= 0x00000000]
[04:27:50.651]      __var manuf = 0;
[04:27:50.651]        // -> [manuf <= 0x00000000]
[04:27:50.651]      __var isMSPM0G1X0X_G3X0X = 0;
[04:27:50.651]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[04:27:50.651]      __var isProduction = 0;
[04:27:50.651]        // -> [isProduction <= 0x00000000]
[04:27:50.651]      __var continueId = 0;
[04:27:50.651]        // -> [continueId <= 0x00000000]
[04:27:50.651]      deviceID =   Read32(0x41C40004);
[04:27:50.658]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[04:27:50.658]        // -> [deviceID <= 0x2BB8802F]
[04:27:50.658]      version = deviceID >> 28;
[04:27:50.658]        // -> [version <= 0x00000002]
[04:27:50.658]      partNum = (deviceID & 0x0FFFF000) >> 12;
[04:27:50.658]        // -> [partNum <= 0x0000BB88]
[04:27:50.658]      manuf = (deviceID & 0x00000FFE) >> 1;
[04:27:50.658]        // -> [manuf <= 0x00000017]
[04:27:50.658]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[04:27:50.658]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[04:27:50.658]      isProduction = (version > 0);
[04:27:50.658]        // -> [isProduction <= 0x00000001]
[04:27:50.658]    </block>
[04:27:50.658]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[04:27:50.658]      // if-block "!isMSPM0G1X0X_G3X0X"
[04:27:50.658]        // =>  FALSE
[04:27:50.658]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[04:27:50.658]    </control>
