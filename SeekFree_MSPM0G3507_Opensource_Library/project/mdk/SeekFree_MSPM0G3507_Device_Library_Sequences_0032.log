[05:23:08.726]        // -> [manuf <= 0x00000017]
[05:23:08.726]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[05:23:08.726]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[05:23:08.726]      isProduction = (version > 0);
