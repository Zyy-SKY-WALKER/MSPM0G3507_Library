[05:44:33.748]  **********  Sequence "DebugPortStart"  (Context="Connect", Pname="", info="")
[05:44:33.748]  
[05:44:33.750]  <debugvars>
[05:44:33.750]    // Pre-defined
[05:44:33.750]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[05:44:33.750]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[05:44:33.750]    __dp=0x00000000
[05:44:33.750]    __ap=0x00000000
[05:44:33.750]    __traceout=0x00000000      (Trace Disabled)
[05:44:33.750]    __errorcontrol=0x00000000  (Skip Errors="False")
[05:44:33.750]    __FlashAddr=0x00000000
[05:44:33.750]    __FlashLen=0x00000000
[05:44:33.750]    __FlashArg=0x00000000
[05:44:33.750]    __FlashOp=0x00000000
[05:44:33.750]    __Result=0x00000000
[05:44:33.750]  </debugvars>
[05:44:33.750]  
[05:44:33.750]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[05:44:33.750]    <block atomic="false" info="">
[05:44:33.750]      __var SW_DP_ABORT       = 0x0;
[05:44:33.750]        // -> [SW_DP_ABORT <= 0x00000000]
[05:44:33.750]      __var DP_CTRL_STAT      = 0x4;
[05:44:33.750]        // -> [DP_CTRL_STAT <= 0x00000004]
[05:44:33.750]      __var DP_SELECT         = 0x8;
[05:44:33.752]        // -> [DP_SELECT <= 0x00000008]
[05:44:33.752]      __var powered_down      = 0;
[05:44:33.752]        // -> [powered_down <= 0x00000000]
[05:44:33.752]      WriteDP(DP_SELECT, 0x00000000);
[05:44:33.753]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[05:44:33.753]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[05:44:33.755]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[05:44:33.755]        // -> [powered_down <= 0x00000001]
[05:44:33.755]    </block>
[05:44:33.755]    <control if="powered_down" while="" timeout="0" info="">
[05:44:33.755]      // if-block "powered_down"
[05:44:33.755]        // =>  TRUE
[05:44:33.755]      <block atomic="false" info="">
[05:44:33.755]        Message(0, "Debug/System power-up request sent");
[05:44:33.758]        WriteDP(DP_CTRL_STAT, 0x50000000);
[05:44:33.760]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[05:44:33.760]      </block>
[05:44:33.760]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[05:44:33.760]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[05:44:33.762]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[05:44:33.762]        // while-condition  =>  FALSE
[05:44:33.762]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[05:44:33.762]      </control>
[05:44:33.762]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[05:44:33.762]        // if-block "(__protocol & 0xFFFF) == 1"
[05:44:33.762]          // =>  FALSE
[05:44:33.762]        // skip if-block "(__protocol & 0xFFFF) == 1"
[05:44:33.762]      </control>
[05:44:33.762]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[05:44:33.762]        // if-block "(__protocol & 0xFFFF) == 2"
[05:44:33.762]          // =>  TRUE
[05:44:33.762]        <block atomic="false" info="">
[05:44:33.762]          Message(0, "executing SWD power up");
[05:44:33.764]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[05:44:33.767]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[05:44:33.767]          WriteDP(SW_DP_ABORT, 0x0000001E);
[05:44:33.767]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[05:44:33.769]        </block>
