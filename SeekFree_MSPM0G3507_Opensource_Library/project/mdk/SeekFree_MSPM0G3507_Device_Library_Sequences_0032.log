[04:27:50.576]        // -> [SW_DP_ABORT <= 0x00000000]
[04:27:50.576]      __var DP_CTRL_STAT      = 0x4;
[04:27:50.576]        // -> [DP_CTRL_STAT <= 0x00000004]
[04:27:50.576]      __var DP_SELECT         = 0x8;
[04:27:50.576]        // -> [DP_SELECT <= 0x00000008]
[04:27:50.576]      __var powered_down      = 0;
[04:27:50.576]        // -> [powered_down <= 0x00000000]
[04:27:50.578]      WriteDP(DP_SELECT, 0x00000000);
[04:27:50.578]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[04:27:50.578]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[04:27:50.581]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[04:27:50.581]        // -> [powered_down <= 0x00000001]
[04:27:50.581]    </block>
[04:27:50.581]    <control if="powered_down" while="" timeout="0" info="">
