[04:27:50.597]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[04:27:50.597]      __ap = 4;
[04:27:50.597]        // -> [__ap <= 0x00000004]
[04:27:50.597]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[04:27:50.601]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[04:27:50.601]        // -> [ACCESS_POINT_VAL <= 0x00080027]
