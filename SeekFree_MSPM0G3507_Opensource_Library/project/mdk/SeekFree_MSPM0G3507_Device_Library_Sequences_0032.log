[02:16:02.770]  **********  Sequence "DebugPortSetup"  (Context="Connect", Pname="", info="")
[02:16:02.770]  
[02:16:02.770]  <debugvars>
[02:16:02.770]    // Pre-defined
[02:16:02.770]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[02:16:02.770]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[02:16:02.770]    __dp=0x00000000
