[05:44:33.723]  
[05:44:33.723]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[05:44:33.723]    <block atomic="false" info="">
[05:44:33.723]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[05:44:33.723]        // -> [isSWJ <= 0x00000001]
[05:44:33.723]      __var hasDormant = __protocol & 0x00020000;
[05:44:33.723]        // -> [hasDormant <= 0x00000000]
[05:44:33.723]      __var protType   = __protocol & 0x0000FFFF;
[05:44:33.723]        // -> [protType <= 0x00000002]
[05:44:33.723]    </block>
[05:44:33.723]    <control if="protType == 1" while="" timeout="0" info="">
[05:44:33.723]      // if-block "protType == 1"
[05:44:33.723]        // =>  FALSE
[05:44:33.723]      // skip if-block "protType == 1"
[05:44:33.723]    </control>
[05:44:33.723]    <control if="protType == 2" while="" timeout="0" info="">
[05:44:33.723]      // if-block "protType == 2"
[05:44:33.723]        // =>  TRUE
[05:44:33.723]      <control if="isSWJ" while="" timeout="0" info="">
[05:44:33.723]        // if-block "isSWJ"
[05:44:33.723]          // =>  TRUE
[05:44:33.723]        <control if="hasDormant" while="" timeout="0" info="">
[05:44:33.723]          // if-block "hasDormant"
[05:44:33.723]            // =>  FALSE
[05:44:33.723]          // skip if-block "hasDormant"
[05:44:33.723]        </control>
[05:44:33.723]        <control if="!hasDormant" while="" timeout="0" info="">
[05:44:33.723]          // if-block "!hasDormant"
[05:44:33.723]            // =>  TRUE
[05:44:33.723]          <block atomic="false" info="">
[05:44:33.723]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[05:44:33.728]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:44:33.728]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[05:44:33.728]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[05:44:33.728]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[05:44:33.732]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:44:33.732]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[05:44:33.732]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[05:44:33.732]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[05:44:33.739]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:44:33.740]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[05:44:33.740]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[05:44:33.740]          </block>
[05:44:33.740]          // end if-block "!hasDormant"
[05:44:33.740]        </control>
[05:44:33.743]        // end if-block "isSWJ"
[05:44:33.743]      </control>
[05:44:33.743]      <control if="!isSWJ" while="" timeout="0" info="">
[05:44:33.743]        // if-block "!isSWJ"
[05:44:33.743]          // =>  FALSE
[05:44:33.743]        // skip if-block "!isSWJ"
[05:44:33.743]      </control>
[05:44:33.743]      <block atomic="false" info="">
[05:44:33.743]        ReadDP(0x0);
[05:44:33.745]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[05:44:33.745]      </block>
[05:44:33.745]      // end if-block "protType == 2"
[05:44:33.745]    </control>
[05:44:33.745]  </sequence>
