[02:16:02.820]        // -> [__ap <= 0x00000001]
[02:16:02.820]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[02:16:02.825]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[02:16:02.825]      __ap = 4;
[02:16:02.825]        // -> [__ap <= 0x00000004]
[02:16:02.825]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[02:16:02.830]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[02:16:02.830]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[02:16:02.830]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
