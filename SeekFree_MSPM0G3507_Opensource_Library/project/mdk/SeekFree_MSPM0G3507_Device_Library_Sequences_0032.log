[04:29:31.782]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[04:29:31.782]    <block atomic="false" info="">
[04:29:31.782]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[04:29:31.782]        // -> [isSWJ <= 0x00000001]
[04:29:31.782]      __var hasDormant = __protocol & 0x00020000;
[04:29:31.782]        // -> [hasDormant <= 0x00000000]
[04:29:31.782]      __var protType   = __protocol & 0x0000FFFF;
[04:29:31.782]        // -> [protType <= 0x00000002]
[04:29:31.782]    </block>
[04:29:31.782]    <control if="protType == 1" while="" timeout="0" info="">
[04:29:31.782]      // if-block "protType == 1"
[04:29:31.782]        // =>  FALSE
[04:29:31.782]      // skip if-block "protType == 1"
[04:29:31.782]    </control>
[04:29:31.782]    <control if="protType == 2" while="" timeout="0" info="">
[04:29:31.782]      // if-block "protType == 2"
[04:29:31.782]        // =>  TRUE
[04:29:31.782]      <control if="isSWJ" while="" timeout="0" info="">
[04:29:31.782]        // if-block "isSWJ"
[04:29:31.782]          // =>  TRUE
[04:29:31.782]        <control if="hasDormant" while="" timeout="0" info="">
[04:29:31.782]          // if-block "hasDormant"
[04:29:31.782]            // =>  FALSE
[04:29:31.782]          // skip if-block "hasDormant"
[04:29:31.782]        </control>
[04:29:31.782]        <control if="!hasDormant" while="" timeout="0" info="">
[04:29:31.782]          // if-block "!hasDormant"
[04:29:31.782]            // =>  TRUE
[04:29:31.782]          <block atomic="false" info="">
[04:29:31.782]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[04:29:31.782]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[04:29:31.782]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[04:29:31.787]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[04:29:31.787]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[04:29:31.787]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[04:29:31.787]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[04:29:31.794]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[04:29:31.794]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[04:29:31.796]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[04:29:31.796]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[04:29:31.796]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[04:29:31.796]          </block>
[04:29:31.798]          // end if-block "!hasDormant"
[04:29:31.798]        </control>
[04:29:31.798]        // end if-block "isSWJ"
[04:29:31.798]      </control>
[04:29:31.798]      <control if="!isSWJ" while="" timeout="0" info="">
[04:29:31.798]        // if-block "!isSWJ"
[04:29:31.798]          // =>  FALSE
[04:29:31.798]        // skip if-block "!isSWJ"
[04:29:31.798]      </control>
[04:29:31.798]      <block atomic="false" info="">
[04:29:31.798]        ReadDP(0x0);
[04:29:31.798]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[04:29:31.798]      </block>
[04:29:31.798]      // end if-block "protType == 2"
[04:29:31.798]    </control>
[04:29:31.798]  </sequence>
