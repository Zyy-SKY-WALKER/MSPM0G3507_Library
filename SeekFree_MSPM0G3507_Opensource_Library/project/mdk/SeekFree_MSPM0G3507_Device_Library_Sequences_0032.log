[05:44:00.237]        // if-block "(__protocol & 0xFFFF) == 2"
[05:44:00.237]          // =>  TRUE
[05:44:00.237]        <block atomic="false" info="">
[05:44:00.237]          Message(0, "executing SWD power up");
[05:44:00.237]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[05:44:00.242]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[05:44:00.242]          WriteDP(SW_DP_ABORT, 0x0000001E);
[05:44:00.242]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[05:44:00.242]        </block>
[05:44:00.242]        // end if-block "(__protocol & 0xFFFF) == 2"
[05:44:00.242]      </control>
[05:44:00.242]      // end if-block "powered_down"
[05:44:00.242]    </control>
[05:44:00.242]    <block atomic="false" info="">
