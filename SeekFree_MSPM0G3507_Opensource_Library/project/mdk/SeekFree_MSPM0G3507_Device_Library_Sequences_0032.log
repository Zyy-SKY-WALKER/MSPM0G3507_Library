[04:25:44.591]          // =>  TRUE
[04:25:44.591]        <block atomic="false" info="">
[04:25:44.591]          Message(0, "executing SWD power up");
[04:25:44.591]          WriteDP(DP_CTRL_STAT, 0x50000F00);
