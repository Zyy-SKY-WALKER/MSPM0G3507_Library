[05:44:00.223]        // -> [SW_DP_ABORT <= 0x00000000]
[05:44:00.223]      __var DP_CTRL_STAT      = 0x4;
[05:44:00.223]        // -> [DP_CTRL_STAT <= 0x00000004]
[05:44:00.223]      __var DP_SELECT         = 0x8;
[05:44:00.223]        // -> [DP_SELECT <= 0x00000008]
[05:44:00.223]      __var powered_down      = 0;
[05:44:00.223]        // -> [powered_down <= 0x00000000]
[05:44:00.223]      WriteDP(DP_SELECT, 0x00000000);
[05:44:00.228]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[05:44:00.228]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[05:44:00.228]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[05:44:00.228]        // -> [powered_down <= 0x00000001]
[05:44:00.228]    </block>
[05:44:00.228]    <control if="powered_down" while="" timeout="0" info="">
[05:44:00.228]      // if-block "powered_down"
[05:44:00.228]        // =>  TRUE
[05:44:00.228]      <block atomic="false" info="">
[05:44:00.228]        Message(0, "Debug/System power-up request sent");
[05:44:00.228]        WriteDP(DP_CTRL_STAT, 0x50000000);
[05:44:00.232]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[05:44:00.232]      </block>
[05:44:00.232]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
