[04:27:50.551]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[04:27:50.551]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[04:27:50.551]    __dp=0x00000000
