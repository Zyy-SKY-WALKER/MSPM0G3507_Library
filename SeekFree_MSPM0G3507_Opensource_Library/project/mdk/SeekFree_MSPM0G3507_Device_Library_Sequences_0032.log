[05:37:17.911]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[05:37:17.911]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
