[04:27:50.588]          // =>  TRUE
[04:27:50.588]        <block atomic="false" info="">
[04:27:50.588]          Message(0, "executing SWD power up");
[04:27:50.588]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[04:27:50.591]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[04:27:50.591]          WriteDP(SW_DP_ABORT, 0x0000001E);
[04:27:50.593]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[04:27:50.593]        </block>
[04:27:50.593]        // end if-block "(__protocol & 0xFFFF) == 2"
[04:27:50.593]      </control>
[04:27:50.593]      // end if-block "powered_down"
[04:27:50.593]    </control>
[04:27:50.593]    <block atomic="false" info="">
