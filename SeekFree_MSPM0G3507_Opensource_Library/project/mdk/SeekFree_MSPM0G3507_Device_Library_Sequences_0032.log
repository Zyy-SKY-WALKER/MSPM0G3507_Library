[05:44:00.242]      __ap = 1; 
[05:44:00.242]        // -> [__ap <= 0x00000001]
[05:44:00.242]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[05:44:00.247]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[05:44:00.247]      __ap = 4;
[05:44:00.247]        // -> [__ap <= 0x00000004]
