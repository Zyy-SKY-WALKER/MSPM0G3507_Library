[02:16:02.893]        // -> [partNum <= 0x00000000]
[02:16:02.893]      __var manuf = 0;
[02:16:02.893]        // -> [manuf <= 0x00000000]
[02:16:02.893]      __var isMSPM0G1X0X_G3X0X = 0;
