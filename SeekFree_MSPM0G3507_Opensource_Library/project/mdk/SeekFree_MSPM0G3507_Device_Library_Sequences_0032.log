[05:43:11.995]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[05:43:11.995]    <block atomic="false" info="">
[05:43:11.995]      __var deviceID = 0;
[05:43:11.995]        // -> [deviceID <= 0x00000000]
[05:43:11.995]      __var version = 0;
[05:43:11.995]        // -> [version <= 0x00000000]
[05:43:11.995]      __var partNum = 0;
[05:43:11.995]        // -> [partNum <= 0x00000000]
[05:43:11.995]      __var manuf = 0;
[05:43:11.995]        // -> [manuf <= 0x00000000]
[05:43:11.995]      __var isMSPM0G1X0X_G3X0X = 0;
[05:43:11.995]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[05:43:11.995]      __var isProduction = 0;
[05:43:11.995]        // -> [isProduction <= 0x00000000]
[05:43:11.995]      __var continueId = 0;
[05:43:11.995]        // -> [continueId <= 0x00000000]
[05:43:11.995]      deviceID =   Read32(0x41C40004);
[05:43:12.000]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[05:43:12.000]        // -> [deviceID <= 0x2BB8802F]
[05:43:12.000]      version = deviceID >> 28;
[05:43:12.000]        // -> [version <= 0x00000002]
[05:43:12.000]      partNum = (deviceID & 0x0FFFF000) >> 12;
[05:43:12.006]        // -> [partNum <= 0x0000BB88]
[05:43:12.006]      manuf = (deviceID & 0x00000FFE) >> 1;
[05:43:12.006]        // -> [manuf <= 0x00000017]
[05:43:12.006]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[05:43:12.006]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[05:43:12.006]      isProduction = (version > 0);
[05:43:12.006]        // -> [isProduction <= 0x00000001]
[05:43:12.006]    </block>
[05:43:12.006]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[05:43:12.006]      // if-block "!isMSPM0G1X0X_G3X0X"
[05:43:12.006]        // =>  FALSE
[05:43:12.006]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[05:43:12.006]    </control>
[05:43:12.006]    <control if="continueId == 4" while="" timeout="0" info="">
[05:43:12.006]      // if-block "continueId == 4"
[05:43:12.006]        // =>  FALSE
[05:43:12.006]      // skip if-block "continueId == 4"
[05:43:12.006]    </control>
[05:43:12.006]    <control if="!isProduction" while="" timeout="0" info="">
[05:43:12.006]      // if-block "!isProduction"
[05:43:12.006]        // =>  FALSE
[05:43:12.006]      // skip if-block "!isProduction"
[05:43:12.006]    </control>
