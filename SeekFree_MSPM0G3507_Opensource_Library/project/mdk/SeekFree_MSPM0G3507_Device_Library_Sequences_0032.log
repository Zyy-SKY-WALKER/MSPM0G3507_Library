[04:25:44.646]  <debugvars>
[04:25:44.646]    // Pre-defined
[04:25:44.646]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[04:25:44.646]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[04:25:44.646]    __dp=0x00000000
