[04:37:26.967]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[04:37:26.967]    <block atomic="false" info="">
[04:37:26.967]      __var deviceID = 0;
[04:37:26.967]        // -> [deviceID <= 0x00000000]
[04:37:26.967]      __var version = 0;
[04:37:26.967]        // -> [version <= 0x00000000]
[04:37:26.967]      __var partNum = 0;
[04:37:26.967]        // -> [partNum <= 0x00000000]
[04:37:26.967]      __var manuf = 0;
[04:37:26.967]        // -> [manuf <= 0x00000000]
[04:37:26.967]      __var isMSPM0G1X0X_G3X0X = 0;
[04:37:26.967]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[04:37:26.967]      __var isProduction = 0;
[04:37:26.967]        // -> [isProduction <= 0x00000000]
[04:37:26.967]      __var continueId = 0;
[04:37:26.967]        // -> [continueId <= 0x00000000]
[04:37:26.967]      deviceID =   Read32(0x41C40004);
[04:37:26.972]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[04:37:26.972]        // -> [deviceID <= 0x2BB8802F]
[04:37:26.972]      version = deviceID >> 28;
[04:37:26.972]        // -> [version <= 0x00000002]
[04:37:26.972]      partNum = (deviceID & 0x0FFFF000) >> 12;
[04:37:26.972]        // -> [partNum <= 0x0000BB88]
[04:37:26.972]      manuf = (deviceID & 0x00000FFE) >> 1;
[04:37:26.972]        // -> [manuf <= 0x00000017]
[04:37:26.972]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[04:37:26.972]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[04:37:26.972]      isProduction = (version > 0);
[04:37:26.972]        // -> [isProduction <= 0x00000001]
[04:37:26.972]    </block>
[04:37:26.972]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[04:37:26.972]      // if-block "!isMSPM0G1X0X_G3X0X"
[04:37:26.972]        // =>  FALSE
[04:37:26.972]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[04:37:26.972]    </control>
[04:37:26.972]    <control if="continueId == 4" while="" timeout="0" info="">
[04:37:26.972]      // if-block "continueId == 4"
[04:37:26.972]        // =>  FALSE
[04:37:26.972]      // skip if-block "continueId == 4"
[04:37:26.972]    </control>
[04:37:26.972]    <control if="!isProduction" while="" timeout="0" info="">
[04:37:26.972]      // if-block "!isProduction"
[04:37:26.972]        // =>  FALSE
[04:37:26.972]      // skip if-block "!isProduction"
[04:37:26.972]    </control>
[04:37:26.972]  </sequence>
