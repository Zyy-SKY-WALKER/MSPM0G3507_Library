[02:16:02.770]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[02:16:02.770]    <block atomic="false" info="">
[02:16:02.770]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[02:16:02.770]        // -> [isSWJ <= 0x00000001]
[02:16:02.770]      __var hasDormant = __protocol & 0x00020000;
[02:16:02.770]        // -> [hasDormant <= 0x00000000]
[02:16:02.770]      __var protType   = __protocol & 0x0000FFFF;
[02:16:02.770]        // -> [protType <= 0x00000002]
[02:16:02.770]    </block>
[02:16:02.770]    <control if="protType == 1" while="" timeout="0" info="">
[02:16:02.770]      // if-block "protType == 1"
[02:16:02.770]        // =>  FALSE
[02:16:02.770]      // skip if-block "protType == 1"
[02:16:02.770]    </control>
[02:16:02.770]    <control if="protType == 2" while="" timeout="0" info="">
[02:16:02.770]      // if-block "protType == 2"
[02:16:02.770]        // =>  TRUE
[02:16:02.770]      <control if="isSWJ" while="" timeout="0" info="">
[02:16:02.770]        // if-block "isSWJ"
[02:16:02.770]          // =>  TRUE
[02:16:02.770]        <control if="hasDormant" while="" timeout="0" info="">
[02:16:02.770]          // if-block "hasDormant"
[02:16:02.770]            // =>  FALSE
[02:16:02.770]          // skip if-block "hasDormant"
[02:16:02.770]        </control>
[02:16:02.770]        <control if="!hasDormant" while="" timeout="0" info="">
[02:16:02.770]          // if-block "!hasDormant"
[02:16:02.770]            // =>  TRUE
[02:16:02.770]          <block atomic="false" info="">
[02:16:02.770]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[02:16:02.777]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:16:02.777]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[02:16:02.777]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[02:16:02.777]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[02:16:02.777]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:16:02.777]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[02:16:02.777]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[02:16:02.777]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[02:16:02.788]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:16:02.788]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[02:16:02.790]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[02:16:02.790]          </block>
[02:16:02.790]          // end if-block "!hasDormant"
[02:16:02.790]        </control>
[02:16:02.790]        // end if-block "isSWJ"
[02:16:02.790]      </control>
[02:16:02.790]      <control if="!isSWJ" while="" timeout="0" info="">
[02:16:02.790]        // if-block "!isSWJ"
[02:16:02.790]          // =>  FALSE
[02:16:02.790]        // skip if-block "!isSWJ"
[02:16:02.790]      </control>
[02:16:02.790]      <block atomic="false" info="">
[02:16:02.790]        ReadDP(0x0);
[02:16:02.790]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[02:16:02.790]      </block>
[02:16:02.790]      // end if-block "protType == 2"
[02:16:02.790]    </control>
[02:16:02.790]  </sequence>
