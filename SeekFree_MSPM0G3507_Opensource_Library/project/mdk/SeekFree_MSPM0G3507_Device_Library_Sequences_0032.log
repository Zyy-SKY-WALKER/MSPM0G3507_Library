[05:36:02.976]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[05:36:02.976]    <block atomic="false" info="">
[05:36:02.976]      __var deviceID = 0;
[05:36:02.976]        // -> [deviceID <= 0x00000000]
