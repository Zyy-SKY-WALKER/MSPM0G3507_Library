[04:37:26.873]            // =>  TRUE
[04:37:26.873]          <block atomic="false" info="">
[04:37:26.873]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[04:37:26.873]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
