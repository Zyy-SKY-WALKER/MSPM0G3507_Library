[02:16:02.903]        // -> [partNum <= 0x0000BB88]
[02:16:02.903]      manuf = (deviceID & 0x00000FFE) >> 1;
[02:16:02.903]        // -> [manuf <= 0x00000017]
[02:16:02.903]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
