[05:22:46.291]        // -> [isProduction <= 0x00000000]
[05:22:46.291]      __var continueId = 0;
[05:22:46.291]        // -> [continueId <= 0x00000000]
[05:22:46.291]      deviceID =   Read32(0x41C40004);
