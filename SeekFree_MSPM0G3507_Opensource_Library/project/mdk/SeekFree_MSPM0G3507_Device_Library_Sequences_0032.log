[05:25:56.511]      __var deviceID = 0;
[05:25:56.511]        // -> [deviceID <= 0x00000000]
[05:25:56.511]      __var version = 0;
[05:25:56.511]        // -> [version <= 0x00000000]
[05:25:56.511]      __var partNum = 0;
[05:25:56.511]        // -> [partNum <= 0x00000000]
[05:25:56.511]      __var manuf = 0;
[05:25:56.511]        // -> [manuf <= 0x00000000]
[05:25:56.511]      __var isMSPM0G1X0X_G3X0X = 0;
[05:25:56.511]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[05:25:56.511]      __var isProduction = 0;
[05:25:56.511]        // -> [isProduction <= 0x00000000]
[05:25:56.511]      __var continueId = 0;
[05:25:56.511]        // -> [continueId <= 0x00000000]
[05:25:56.511]      deviceID =   Read32(0x41C40004);
[05:25:56.516]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[05:25:56.516]        // -> [deviceID <= 0x2BB8802F]
[05:25:56.516]      version = deviceID >> 28;
[05:25:56.516]        // -> [version <= 0x00000002]
[05:25:56.516]      partNum = (deviceID & 0x0FFFF000) >> 12;
[05:25:56.516]        // -> [partNum <= 0x0000BB88]
[05:25:56.516]      manuf = (deviceID & 0x00000FFE) >> 1;
[05:25:56.516]        // -> [manuf <= 0x00000017]
[05:25:56.516]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[05:25:56.516]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[05:25:56.516]      isProduction = (version > 0);
[05:25:56.516]        // -> [isProduction <= 0x00000001]
[05:25:56.516]    </block>
