[05:44:00.202]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[05:44:00.202]    <block atomic="false" info="">
[05:44:00.202]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[05:44:00.202]        // -> [isSWJ <= 0x00000001]
[05:44:00.202]      __var hasDormant = __protocol & 0x00020000;
[05:44:00.202]        // -> [hasDormant <= 0x00000000]
[05:44:00.202]      __var protType   = __protocol & 0x0000FFFF;
[05:44:00.202]        // -> [protType <= 0x00000002]
[05:44:00.202]    </block>
[05:44:00.202]    <control if="protType == 1" while="" timeout="0" info="">
[05:44:00.202]      // if-block "protType == 1"
[05:44:00.202]        // =>  FALSE
[05:44:00.202]      // skip if-block "protType == 1"
[05:44:00.202]    </control>
[05:44:00.202]    <control if="protType == 2" while="" timeout="0" info="">
[05:44:00.202]      // if-block "protType == 2"
[05:44:00.202]        // =>  TRUE
[05:44:00.202]      <control if="isSWJ" while="" timeout="0" info="">
[05:44:00.202]        // if-block "isSWJ"
[05:44:00.202]          // =>  TRUE
[05:44:00.202]        <control if="hasDormant" while="" timeout="0" info="">
[05:44:00.202]          // if-block "hasDormant"
[05:44:00.202]            // =>  FALSE
[05:44:00.202]          // skip if-block "hasDormant"
[05:44:00.202]        </control>
[05:44:00.202]        <control if="!hasDormant" while="" timeout="0" info="">
[05:44:00.202]          // if-block "!hasDormant"
[05:44:00.202]            // =>  TRUE
[05:44:00.202]          <block atomic="false" info="">
[05:44:00.202]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[05:44:00.208]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:44:00.208]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[05:44:00.208]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[05:44:00.208]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[05:44:00.208]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:44:00.208]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[05:44:00.212]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[05:44:00.212]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[05:44:00.212]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:44:00.212]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[05:44:00.217]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[05:44:00.217]          </block>
[05:44:00.217]          // end if-block "!hasDormant"
[05:44:00.217]        </control>
[05:44:00.217]        // end if-block "isSWJ"
[05:44:00.217]      </control>
[05:44:00.217]      <control if="!isSWJ" while="" timeout="0" info="">
[05:44:00.217]        // if-block "!isSWJ"
[05:44:00.217]          // =>  FALSE
[05:44:00.217]        // skip if-block "!isSWJ"
[05:44:00.217]      </control>
[05:44:00.217]      <block atomic="false" info="">
[05:44:00.217]        ReadDP(0x0);
[05:44:00.217]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[05:44:00.217]      </block>
[05:44:00.217]      // end if-block "protType == 2"
[05:44:00.217]    </control>
[05:44:00.217]  </sequence>
