[02:15:29.314]    __FlashOp=0x00000000
[02:15:29.314]    __Result=0x00000000
[02:15:29.314]  </debugvars>
[02:15:29.314]  
[02:15:29.314]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[02:15:29.314]    <block atomic="false" info="">
[02:15:29.314]      __var deviceID = 0;
[02:15:29.314]        // -> [deviceID <= 0x00000000]
[02:15:29.314]      __var version = 0;
[02:15:29.314]        // -> [version <= 0x00000000]
[02:15:29.314]      __var partNum = 0;
[02:15:29.314]        // -> [partNum <= 0x00000000]
[02:15:29.314]      __var manuf = 0;
[02:15:29.314]        // -> [manuf <= 0x00000000]
[02:15:29.314]      __var isMSPM0G1X0X_G3X0X = 0;
[02:15:29.314]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[02:15:29.314]      __var isProduction = 0;
[02:15:29.314]        // -> [isProduction <= 0x00000000]
[02:15:29.314]      __var continueId = 0;
[02:15:29.314]        // -> [continueId <= 0x00000000]
[02:15:29.314]      deviceID =   Read32(0x41C40004);
[02:15:29.324]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[02:15:29.324]        // -> [deviceID <= 0x2BB8802F]
[02:15:29.324]      version = deviceID >> 28;
[02:15:29.324]        // -> [version <= 0x00000002]
[02:15:29.324]      partNum = (deviceID & 0x0FFFF000) >> 12;
[02:15:29.324]        // -> [partNum <= 0x0000BB88]
[02:15:29.324]      manuf = (deviceID & 0x00000FFE) >> 1;
[02:15:29.324]        // -> [manuf <= 0x00000017]
[02:15:29.324]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[02:15:29.324]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[02:15:29.324]      isProduction = (version > 0);
[02:15:29.324]        // -> [isProduction <= 0x00000001]
[02:15:29.324]    </block>
[02:15:29.324]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[02:15:29.324]      // if-block "!isMSPM0G1X0X_G3X0X"
[02:15:29.324]        // =>  FALSE
[02:15:29.324]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[02:15:29.324]    </control>
[02:15:29.324]    <control if="continueId == 4" while="" timeout="0" info="">
[02:15:29.324]      // if-block "continueId == 4"
[02:15:29.324]        // =>  FALSE
[02:15:29.324]      // skip if-block "continueId == 4"
[02:15:29.324]    </control>
[02:15:29.324]    <control if="!isProduction" while="" timeout="0" info="">
[02:15:29.324]      // if-block "!isProduction"
[02:15:29.324]        // =>  FALSE
[02:15:29.324]      // skip if-block "!isProduction"
[02:15:29.324]    </control>
[02:15:29.324]  </sequence>
