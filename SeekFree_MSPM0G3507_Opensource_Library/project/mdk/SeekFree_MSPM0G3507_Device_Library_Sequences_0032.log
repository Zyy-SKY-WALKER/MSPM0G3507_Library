[04:29:31.803]  **********  Sequence "DebugPortStart"  (Context="Connect", Pname="", info="")
[04:29:31.803]  
[04:29:31.803]  <debugvars>
[04:29:31.803]    // Pre-defined
[04:29:31.803]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[04:29:31.803]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[04:29:31.803]    __dp=0x00000000
[04:29:31.803]    __ap=0x00000000
[04:29:31.803]    __traceout=0x00000000      (Trace Disabled)
[04:29:31.803]    __errorcontrol=0x00000000  (Skip Errors="False")
