[04:25:44.558]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[04:25:44.558]    <block atomic="false" info="">
[04:25:44.558]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[04:25:44.558]        // -> [isSWJ <= 0x00000001]
[04:25:44.558]      __var hasDormant = __protocol & 0x00020000;
[04:25:44.558]        // -> [hasDormant <= 0x00000000]
[04:25:44.558]      __var protType   = __protocol & 0x0000FFFF;
[04:25:44.558]        // -> [protType <= 0x00000002]
[04:25:44.558]    </block>
[04:25:44.558]    <control if="protType == 1" while="" timeout="0" info="">
[04:25:44.558]      // if-block "protType == 1"
[04:25:44.558]        // =>  FALSE
[04:25:44.558]      // skip if-block "protType == 1"
[04:25:44.558]    </control>
[04:25:44.558]    <control if="protType == 2" while="" timeout="0" info="">
[04:25:44.558]      // if-block "protType == 2"
[04:25:44.558]        // =>  TRUE
[04:25:44.558]      <control if="isSWJ" while="" timeout="0" info="">
[04:25:44.558]        // if-block "isSWJ"
[04:25:44.558]          // =>  TRUE
[04:25:44.558]        <control if="hasDormant" while="" timeout="0" info="">
[04:25:44.558]          // if-block "hasDormant"
[04:25:44.558]            // =>  FALSE
[04:25:44.558]          // skip if-block "hasDormant"
[04:25:44.558]        </control>
[04:25:44.558]        <control if="!hasDormant" while="" timeout="0" info="">
[04:25:44.558]          // if-block "!hasDormant"
[04:25:44.558]            // =>  TRUE
[04:25:44.558]          <block atomic="false" info="">
[04:25:44.558]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[04:25:44.563]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[04:25:44.563]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[04:25:44.563]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[04:25:44.563]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[04:25:44.563]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[04:25:44.568]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[04:25:44.568]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[04:25:44.568]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[04:25:44.568]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[04:25:44.568]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[04:25:44.573]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[04:25:44.573]          </block>
[04:25:44.573]          // end if-block "!hasDormant"
[04:25:44.573]        </control>
[04:25:44.573]        // end if-block "isSWJ"
[04:25:44.573]      </control>
[04:25:44.573]      <control if="!isSWJ" while="" timeout="0" info="">
[04:25:44.573]        // if-block "!isSWJ"
[04:25:44.573]          // =>  FALSE
