[05:36:02.907]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[05:36:02.907]    <block atomic="false" info="">
[05:36:02.907]      __var SW_DP_ABORT       = 0x0;
[05:36:02.907]        // -> [SW_DP_ABORT <= 0x00000000]
[05:36:02.907]      __var DP_CTRL_STAT      = 0x4;
[05:36:02.907]        // -> [DP_CTRL_STAT <= 0x00000004]
[05:36:02.907]      __var DP_SELECT         = 0x8;
[05:36:02.907]        // -> [DP_SELECT <= 0x00000008]
[05:36:02.907]      __var powered_down      = 0;
[05:36:02.907]        // -> [powered_down <= 0x00000000]
[05:36:02.907]      WriteDP(DP_SELECT, 0x00000000);
[05:36:02.909]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[05:36:02.909]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[05:36:02.911]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[05:36:02.911]        // -> [powered_down <= 0x00000001]
[05:36:02.911]    </block>
[05:36:02.911]    <control if="powered_down" while="" timeout="0" info="">
[05:36:02.911]      // if-block "powered_down"
[05:36:02.911]        // =>  TRUE
[05:36:02.911]      <block atomic="false" info="">
[05:36:02.911]        Message(0, "Debug/System power-up request sent");
[05:36:02.913]        WriteDP(DP_CTRL_STAT, 0x50000000);
[05:36:02.913]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[05:36:02.917]      </block>
[05:36:02.917]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[05:36:02.917]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[05:36:02.918]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[05:36:02.918]        // while-condition  =>  FALSE
[05:36:02.918]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[05:36:02.918]      </control>
[05:36:02.919]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[05:36:02.919]        // if-block "(__protocol & 0xFFFF) == 1"
[05:36:02.919]          // =>  FALSE
[05:36:02.919]        // skip if-block "(__protocol & 0xFFFF) == 1"
[05:36:02.919]      </control>
[05:36:02.919]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[05:36:02.919]        // if-block "(__protocol & 0xFFFF) == 2"
[05:36:02.919]          // =>  TRUE
[05:36:02.919]        <block atomic="false" info="">
[05:36:02.919]          Message(0, "executing SWD power up");
[05:36:02.921]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[05:36:02.921]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[05:36:02.921]          WriteDP(SW_DP_ABORT, 0x0000001E);
[05:36:02.925]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[05:36:02.925]        </block>
[05:36:02.925]        // end if-block "(__protocol & 0xFFFF) == 2"
[05:36:02.925]      </control>
[05:36:02.925]      // end if-block "powered_down"
[05:36:02.925]    </control>
[05:36:02.925]    <block atomic="false" info="">
[05:36:02.925]      __var DEBUG_PORT_VAL    = 0;
[05:36:02.925]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[05:36:02.925]      __var ACCESS_POINT_VAL  = 0;
[05:36:02.925]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[05:36:02.925]      __ap = 1; 
[05:36:02.925]        // -> [__ap <= 0x00000001]
[05:36:02.925]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[05:36:02.929]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[05:36:02.929]      __ap = 4;
[05:36:02.931]        // -> [__ap <= 0x00000004]
[05:36:02.931]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[05:36:02.935]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[05:36:02.935]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[05:36:02.935]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[05:36:02.937]    </block>
[05:36:02.937]    <block atomic="false" info="">
[05:36:02.937]      __var nReset = 0x80;
[05:36:02.937]        // -> [nReset <= 0x00000080]
[05:36:02.937]      __var canReadPins = 0;
[05:36:02.937]        // -> [canReadPins <= 0x00000000]
[05:36:02.937]      canReadPins = (DAP_SWJ_Pins(0x00, nReset, 0) != 0xFFFFFFFF);
[05:36:02.939]        // -> [DAP_SWJ_Pins(0x00, 0x80, 0) => 0x0F]   (Out: nRESET=0  =>  In: SWCLK/TCK=1, SWDIO/TMS=1, TDI=1, TDO=1, nTRST=0, nRESET=0)
[05:36:02.939]        // -> [canReadPins <= 0x00000001]
[05:36:02.939]    </block>
[05:36:02.939]    <control if="" while="1" timeout="200" info="">
[05:36:02.939]      // while "1"  (timeout="200")
[05:36:02.939]      // while-condition  =>  TRUE
[05:36:02.939]      // while "1"  (timeout="200")
[05:36:02.939]      // while-condition  =>  TRUE
[05:36:02.939]      // while "1"  (timeout="200")
[05:36:02.939]      // while-condition  =>  TRUE
[05:36:02.939]      // while "1"  (timeout="200")
[05:36:02.941]      // while-condition  =>  TRUE
[05:36:02.941]      // while "1"  (timeout="200")
[05:36:02.941]      // while  =>  TIMEOUT
[05:36:02.941]      // end while "1"
[05:36:02.941]    </control>
[05:36:02.941]    <control if="canReadPins" while="" timeout="0" info="">
