[05:37:17.958]      <block atomic="false" info="">
[05:37:17.958]        WriteAP(0x00, 0x190008);
[05:37:17.963]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[05:37:17.963]        WriteAP(0xF0, 0x01);
[05:37:17.963]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[05:37:17.963]      </block>
[05:37:17.968]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[05:37:17.968]    </control>
