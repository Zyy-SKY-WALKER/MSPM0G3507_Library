[03:34:58.917]        // -> [deviceID <= 0x2BB8802F]
[03:34:58.917]      version = deviceID >> 28;
[03:34:58.917]        // -> [version <= 0x00000002]
[03:34:58.917]      partNum = (deviceID & 0x0FFFF000) >> 12;
[03:34:58.917]        // -> [partNum <= 0x0000BB88]
[03:34:58.917]      manuf = (deviceID & 0x00000FFE) >> 1;
[03:34:58.917]        // -> [manuf <= 0x00000017]
[03:34:58.917]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[03:34:58.917]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[03:34:58.917]      isProduction = (version > 0);
[03:34:58.917]        // -> [isProduction <= 0x00000001]
