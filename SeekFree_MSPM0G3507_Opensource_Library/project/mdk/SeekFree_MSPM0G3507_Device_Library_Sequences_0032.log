[05:23:08.716]        // -> [partNum <= 0x00000000]
[05:23:08.716]      __var manuf = 0;
[05:23:08.716]        // -> [manuf <= 0x00000000]
[05:23:08.716]      __var isMSPM0G1X0X_G3X0X = 0;
[05:23:08.716]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[05:23:08.716]      __var isProduction = 0;
[05:23:08.716]        // -> [isProduction <= 0x00000000]
[05:23:08.716]      __var continueId = 0;
[05:23:08.716]        // -> [continueId <= 0x00000000]
