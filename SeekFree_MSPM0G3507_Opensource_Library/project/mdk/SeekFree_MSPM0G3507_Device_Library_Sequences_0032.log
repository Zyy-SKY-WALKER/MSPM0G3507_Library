[05:37:17.890]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[05:37:17.890]    <block atomic="false" info="">
[05:37:17.890]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[05:37:17.890]        // -> [isSWJ <= 0x00000001]
[05:37:17.890]      __var hasDormant = __protocol & 0x00020000;
[05:37:17.890]        // -> [hasDormant <= 0x00000000]
[05:37:17.890]      __var protType   = __protocol & 0x0000FFFF;
[05:37:17.890]        // -> [protType <= 0x00000002]
[05:37:17.890]    </block>
[05:37:17.890]    <control if="protType == 1" while="" timeout="0" info="">
