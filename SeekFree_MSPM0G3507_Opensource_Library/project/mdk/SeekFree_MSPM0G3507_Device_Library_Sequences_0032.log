[05:37:17.890]    </control>
[05:37:17.890]    <control if="protType == 2" while="" timeout="0" info="">
[05:37:17.890]      // if-block "protType == 2"
[05:37:17.890]        // =>  TRUE
[05:37:17.890]      <control if="isSWJ" while="" timeout="0" info="">
[05:37:17.890]        // if-block "isSWJ"
[05:37:17.890]          // =>  TRUE
[05:37:17.890]        <control if="hasDormant" while="" timeout="0" info="">
[05:37:17.890]          // if-block "hasDormant"
[05:37:17.890]            // =>  FALSE
[05:37:17.890]          // skip if-block "hasDormant"
[05:37:17.890]        </control>
[05:37:17.890]        <control if="!hasDormant" while="" timeout="0" info="">
[05:37:17.890]          // if-block "!hasDormant"
[05:37:17.890]            // =>  TRUE
[05:37:17.890]          <block atomic="false" info="">
[05:37:17.890]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[05:37:17.890]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:37:17.890]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[05:37:17.895]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[05:37:17.895]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[05:37:17.895]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:37:17.895]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[05:37:17.895]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[05:37:17.900]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[05:37:17.900]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:37:17.900]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[05:37:17.904]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[05:37:17.904]          </block>
[05:37:17.904]          // end if-block "!hasDormant"
[05:37:17.904]        </control>
[05:37:17.904]        // end if-block "isSWJ"
[05:37:17.904]      </control>
[05:37:17.904]      <control if="!isSWJ" while="" timeout="0" info="">
[05:37:17.904]        // if-block "!isSWJ"
[05:37:17.904]          // =>  FALSE
[05:37:17.904]        // skip if-block "!isSWJ"
[05:37:17.904]      </control>
[05:37:17.904]      <block atomic="false" info="">
[05:37:17.904]        ReadDP(0x0);
[05:37:17.905]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[05:37:17.905]      </block>
[05:37:17.905]      // end if-block "protType == 2"
[05:37:17.905]    </control>
[05:37:17.905]  </sequence>
