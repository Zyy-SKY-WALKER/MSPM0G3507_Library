[05:44:00.197]  <debugvars>
[05:44:00.202]    // Pre-defined
[05:44:00.202]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[05:44:00.202]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[05:44:00.202]    __dp=0x00000000
