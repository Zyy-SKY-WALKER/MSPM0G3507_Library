[05:23:08.623]      <control if="isSWJ" while="" timeout="0" info="">
[05:23:08.623]        // if-block "isSWJ"
[05:23:08.623]          // =>  TRUE
[05:23:08.623]        <control if="hasDormant" while="" timeout="0" info="">
[05:23:08.623]          // if-block "hasDormant"
[05:23:08.623]            // =>  FALSE
[05:23:08.623]          // skip if-block "hasDormant"
[05:23:08.623]        </control>
[05:23:08.623]        <control if="!hasDormant" while="" timeout="0" info="">
[05:23:08.623]          // if-block "!hasDormant"
[05:23:08.623]            // =>  TRUE
[05:23:08.623]          <block atomic="false" info="">
[05:23:08.623]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[05:23:08.624]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:23:08.624]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[05:23:08.624]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[05:23:08.624]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[05:23:08.629]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:23:08.629]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[05:23:08.629]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[05:23:08.629]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[05:23:08.634]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:23:08.634]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[05:23:08.634]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[05:23:08.634]          </block>
