[04:25:44.620]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[04:25:44.625]        // -> [ReadAP(0x00000000) => 0x0079002F]   (__dp=0x00000000, __ap=0x00000004)
[04:25:44.625]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[04:25:44.625]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
