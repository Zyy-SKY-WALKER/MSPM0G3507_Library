[02:15:29.314]  <debugvars>
[02:15:29.314]    // Pre-defined
[02:15:29.314]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[02:15:29.314]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[02:15:29.314]    __dp=0x00000000
[02:15:29.314]    __ap=0x00000000
[02:15:29.314]    __traceout=0x00000000      (Trace Disabled)
[02:15:29.314]    __errorcontrol=0x00000000  (Skip Errors="False")
