[05:13:20.163]      // skip if-block "protType == 1"
[05:13:20.163]    </control>
[05:13:20.163]    <control if="protType == 2" while="" timeout="0" info="">
[05:13:20.163]      // if-block "protType == 2"
[05:13:20.163]        // =>  TRUE
[05:13:20.163]      <control if="isSWJ" while="" timeout="0" info="">
[05:13:20.163]        // if-block "isSWJ"
[05:13:20.163]          // =>  TRUE
[05:13:20.163]        <control if="hasDormant" while="" timeout="0" info="">
[05:13:20.163]          // if-block "hasDormant"
[05:13:20.163]            // =>  FALSE
[05:13:20.163]          // skip if-block "hasDormant"
[05:13:20.163]        </control>
[05:13:20.163]        <control if="!hasDormant" while="" timeout="0" info="">
[05:13:20.163]          // if-block "!hasDormant"
[05:13:20.163]            // =>  TRUE
[05:13:20.163]          <block atomic="false" info="">
[05:13:20.163]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[05:13:20.166]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:13:20.166]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[05:13:20.166]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[05:13:20.168]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[05:13:20.169]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:13:20.169]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[05:13:20.169]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[05:13:20.169]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[05:13:20.174]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[05:13:20.174]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[05:13:20.174]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[05:13:20.174]          </block>
