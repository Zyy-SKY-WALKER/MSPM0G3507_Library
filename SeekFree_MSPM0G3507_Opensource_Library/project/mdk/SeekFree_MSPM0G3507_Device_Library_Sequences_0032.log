[05:36:02.898]          // =>  FALSE
[05:36:02.898]        // skip if-block "!isSWJ"
[05:36:02.898]      </control>
[05:36:02.898]      <block atomic="false" info="">
[05:36:02.898]        ReadDP(0x0);
[05:36:02.901]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[05:36:02.901]      </block>
