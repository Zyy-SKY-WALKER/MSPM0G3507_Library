[05:36:02.976]        // -> [partNum <= 0x00000000]
[05:36:02.976]      __var manuf = 0;
[05:36:02.976]        // -> [manuf <= 0x00000000]
[05:36:02.976]      __var isMSPM0G1X0X_G3X0X = 0;
[05:36:02.976]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[05:36:02.976]      __var isProduction = 0;
[05:36:02.976]        // -> [isProduction <= 0x00000000]
[05:36:02.976]      __var continueId = 0;
[05:36:02.976]        // -> [continueId <= 0x00000000]
[05:36:02.976]      deviceID =   Read32(0x41C40004);
[05:36:02.983]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[05:36:02.984]        // -> [deviceID <= 0x2BB8802F]
[05:36:02.984]      version = deviceID >> 28;
[05:36:02.984]        // -> [version <= 0x00000002]
[05:36:02.984]      partNum = (deviceID & 0x0FFFF000) >> 12;
[05:36:02.984]        // -> [partNum <= 0x0000BB88]
[05:36:02.984]      manuf = (deviceID & 0x00000FFE) >> 1;
[05:36:02.984]        // -> [manuf <= 0x00000017]
[05:36:02.984]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[05:36:02.984]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[05:36:02.984]      isProduction = (version > 0);
[05:36:02.984]        // -> [isProduction <= 0x00000001]
[05:36:02.984]    </block>
[05:36:02.984]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
