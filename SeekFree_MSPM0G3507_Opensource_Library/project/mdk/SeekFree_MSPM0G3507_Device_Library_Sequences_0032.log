[02:16:02.797]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[02:16:02.797]    <block atomic="false" info="">
[02:16:02.797]      __var SW_DP_ABORT       = 0x0;
[02:16:02.797]        // -> [SW_DP_ABORT <= 0x00000000]
[02:16:02.797]      __var DP_CTRL_STAT      = 0x4;
[02:16:02.797]        // -> [DP_CTRL_STAT <= 0x00000004]
[02:16:02.797]      __var DP_SELECT         = 0x8;
[02:16:02.797]        // -> [DP_SELECT <= 0x00000008]
[02:16:02.797]      __var powered_down      = 0;
[02:16:02.797]        // -> [powered_down <= 0x00000000]
[02:16:02.797]      WriteDP(DP_SELECT, 0x00000000);
[02:16:02.797]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[02:16:02.797]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[02:16:02.797]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[02:16:02.797]        // -> [powered_down <= 0x00000001]
[02:16:02.797]    </block>
[02:16:02.797]    <control if="powered_down" while="" timeout="0" info="">
[02:16:02.797]      // if-block "powered_down"
[02:16:02.797]        // =>  TRUE
[02:16:02.797]      <block atomic="false" info="">
[02:16:02.797]        Message(0, "Debug/System power-up request sent");
[02:16:02.797]        WriteDP(DP_CTRL_STAT, 0x50000000);
[02:16:02.808]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[02:16:02.808]      </block>
[02:16:02.808]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[02:16:02.808]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[02:16:02.813]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[02:16:02.813]        // while-condition  =>  FALSE
[02:16:02.813]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[02:16:02.813]      </control>
[02:16:02.813]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[02:16:02.813]        // if-block "(__protocol & 0xFFFF) == 1"
[02:16:02.813]          // =>  FALSE
[02:16:02.813]        // skip if-block "(__protocol & 0xFFFF) == 1"
[02:16:02.813]      </control>
[02:16:02.813]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[02:16:02.813]        // if-block "(__protocol & 0xFFFF) == 2"
[02:16:02.813]          // =>  TRUE
[02:16:02.813]        <block atomic="false" info="">
[02:16:02.813]          Message(0, "executing SWD power up");
[02:16:02.813]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[02:16:02.818]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[02:16:02.818]          WriteDP(SW_DP_ABORT, 0x0000001E);
[02:16:02.820]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[02:16:02.820]        </block>
[02:16:02.820]        // end if-block "(__protocol & 0xFFFF) == 2"
[02:16:02.820]      </control>
[02:16:02.820]      // end if-block "powered_down"
[02:16:02.820]    </control>
[02:16:02.820]    <block atomic="false" info="">
[02:16:02.820]      __var DEBUG_PORT_VAL    = 0;
