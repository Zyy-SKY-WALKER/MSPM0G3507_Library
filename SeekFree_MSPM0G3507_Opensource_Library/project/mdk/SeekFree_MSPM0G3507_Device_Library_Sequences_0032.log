[04:27:50.586]          // =>  FALSE
[04:27:50.586]        // skip if-block "(__protocol & 0xFFFF) == 1"
[04:27:50.588]      </control>
[04:27:50.588]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
