[05:44:00.304]  <debugvars>
[05:44:00.304]    // Pre-defined
[05:44:00.304]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[05:44:00.304]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[05:44:00.304]    __dp=0x00000000
[05:44:00.304]    __ap=0x00000000
