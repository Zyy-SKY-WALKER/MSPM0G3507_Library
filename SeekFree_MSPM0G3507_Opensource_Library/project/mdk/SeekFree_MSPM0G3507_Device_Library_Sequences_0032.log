[05:36:02.882]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[05:36:02.882]    <block atomic="false" info="">
[05:36:02.882]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[05:36:02.882]        // -> [isSWJ <= 0x00000001]
[05:36:02.882]      __var hasDormant = __protocol & 0x00020000;
[05:36:02.882]        // -> [hasDormant <= 0x00000000]
