[00:34:50.104]        // =>  TRUE
[00:34:50.104]      <control if="isSWJ" while="" timeout="0" info="">
[00:34:50.104]        // if-block "isSWJ"
[00:34:50.104]          // =>  TRUE
[00:34:50.104]        <control if="hasDormant" while="" timeout="0" info="">
[00:34:50.104]          // if-block "hasDormant"
[00:34:50.105]            // =>  FALSE
[00:34:50.105]          // skip if-block "hasDormant"
[00:34:50.105]        </control>
[00:34:50.105]        <control if="!hasDormant" while="" timeout="0" info="">
[00:34:50.105]          // if-block "!hasDormant"
[00:34:50.105]            // =>  TRUE
[00:34:50.105]          <block atomic="false" info="">
[00:34:50.105]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:34:50.107]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:34:50.107]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[00:34:50.109]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[00:34:50.109]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[00:34:50.110]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:34:50.110]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[00:34:50.112]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[00:34:50.112]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[00:34:50.114]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:34:50.114]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[00:34:50.116]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[00:34:50.116]          </block>
