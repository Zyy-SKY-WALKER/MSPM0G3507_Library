[03:19:59.604]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[03:19:59.609]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
