[03:19:59.706]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[03:19:59.706]    <block atomic="false" info="">
[03:19:59.706]      __var deviceID = 0;
[03:19:59.706]        // -> [deviceID <= 0x00000000]
[03:19:59.706]      __var version = 0;
[03:19:59.706]        // -> [version <= 0x00000000]
[03:19:59.706]      __var partNum = 0;
[03:19:59.706]        // -> [partNum <= 0x00000000]
[03:19:59.706]      __var manuf = 0;
[03:19:59.706]        // -> [manuf <= 0x00000000]
[03:19:59.706]      __var isMSPM0G1X0X_G3X0X = 0;
[03:19:59.706]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[03:19:59.706]      __var isProduction = 0;
[03:19:59.706]        // -> [isProduction <= 0x00000000]
[03:19:59.706]      __var continueId = 0;
[03:19:59.706]        // -> [continueId <= 0x00000000]
[03:19:59.706]      deviceID =   Read32(0x41C40004);
[03:19:59.711]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[03:19:59.711]        // -> [deviceID <= 0x2BB8802F]
[03:19:59.711]      version = deviceID >> 28;
[03:19:59.711]        // -> [version <= 0x00000002]
[03:19:59.711]      partNum = (deviceID & 0x0FFFF000) >> 12;
[03:19:59.711]        // -> [partNum <= 0x0000BB88]
[03:19:59.711]      manuf = (deviceID & 0x00000FFE) >> 1;
[03:19:59.711]        // -> [manuf <= 0x00000017]
[03:19:59.711]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[03:19:59.711]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[03:19:59.711]      isProduction = (version > 0);
[03:19:59.711]        // -> [isProduction <= 0x00000001]
[03:19:59.711]    </block>
[03:19:59.711]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[03:19:59.711]      // if-block "!isMSPM0G1X0X_G3X0X"
[03:19:59.711]        // =>  FALSE
[03:19:59.711]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[03:19:59.711]    </control>
