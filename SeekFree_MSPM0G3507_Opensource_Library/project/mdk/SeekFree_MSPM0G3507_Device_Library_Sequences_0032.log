[05:24:16.315]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[05:24:16.315]    <block atomic="false" info="">
[05:24:16.315]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[05:24:16.315]        // -> [isSWJ <= 0x00000001]
[05:24:16.315]      __var hasDormant = __protocol & 0x00020000;
[05:24:16.315]        // -> [hasDormant <= 0x00000000]
