[03:34:58.907]      __var isProduction = 0;
[03:34:58.907]        // -> [isProduction <= 0x00000000]
[03:34:58.907]      __var continueId = 0;
[03:34:58.907]        // -> [continueId <= 0x00000000]
[03:34:58.907]      deviceID =   Read32(0x41C40004);
