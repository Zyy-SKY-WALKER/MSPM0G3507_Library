[05:23:08.621]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[05:23:08.621]    <block atomic="false" info="">
[05:23:08.621]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[05:23:08.621]        // -> [isSWJ <= 0x00000001]
[05:23:08.621]      __var hasDormant = __protocol & 0x00020000;
[05:23:08.621]        // -> [hasDormant <= 0x00000000]
