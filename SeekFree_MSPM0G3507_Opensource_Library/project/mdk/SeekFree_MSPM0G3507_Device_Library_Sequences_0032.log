[05:44:00.304]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[05:44:00.304]    <block atomic="false" info="">
[05:44:00.310]      __var deviceID = 0;
[05:44:00.310]        // -> [deviceID <= 0x00000000]
[05:44:00.310]      __var version = 0;
[05:44:00.310]        // -> [version <= 0x00000000]
[05:44:00.310]      __var partNum = 0;
[05:44:00.310]        // -> [partNum <= 0x00000000]
[05:44:00.310]      __var manuf = 0;
[05:44:00.310]        // -> [manuf <= 0x00000000]
[05:44:00.310]      __var isMSPM0G1X0X_G3X0X = 0;
[05:44:00.310]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[05:44:00.310]      __var isProduction = 0;
[05:44:00.310]        // -> [isProduction <= 0x00000000]
[05:44:00.310]      __var continueId = 0;
[05:44:00.310]        // -> [continueId <= 0x00000000]
[05:44:00.310]      deviceID =   Read32(0x41C40004);
[05:44:00.315]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[05:44:00.315]        // -> [deviceID <= 0x2BB8802F]
[05:44:00.315]      version = deviceID >> 28;
[05:44:00.315]        // -> [version <= 0x00000002]
[05:44:00.315]      partNum = (deviceID & 0x0FFFF000) >> 12;
[05:44:00.315]        // -> [partNum <= 0x0000BB88]
[05:44:00.315]      manuf = (deviceID & 0x00000FFE) >> 1;
[05:44:00.315]        // -> [manuf <= 0x00000017]
[05:44:00.315]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[05:44:00.315]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[05:44:00.315]      isProduction = (version > 0);
[05:44:00.315]        // -> [isProduction <= 0x00000001]
[05:44:00.315]    </block>
[05:44:00.315]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[05:44:00.315]      // if-block "!isMSPM0G1X0X_G3X0X"
[05:44:00.315]        // =>  FALSE
[05:44:00.315]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[05:44:00.315]    </control>
[05:44:00.315]    <control if="continueId == 4" while="" timeout="0" info="">
[05:44:00.315]      // if-block "continueId == 4"
[05:44:00.315]        // =>  FALSE
[05:44:00.315]      // skip if-block "continueId == 4"
[05:44:00.315]    </control>
[05:44:00.315]    <control if="!isProduction" while="" timeout="0" info="">
[05:44:00.315]      // if-block "!isProduction"
[05:44:00.315]        // =>  FALSE
[05:44:00.315]      // skip if-block "!isProduction"
[05:44:00.315]    </control>
[05:44:00.315]  </sequence>
