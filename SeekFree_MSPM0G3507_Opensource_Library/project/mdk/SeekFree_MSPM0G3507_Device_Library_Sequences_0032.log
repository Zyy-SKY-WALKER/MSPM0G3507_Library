[04:29:31.803]    __FlashLen=0x00000000
[04:29:31.803]    __FlashArg=0x00000000
[04:29:31.803]    __FlashOp=0x00000000
[04:29:31.803]    __Result=0x00000000
[04:29:31.803]  </debugvars>
[04:29:31.803]  
[04:29:31.803]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[04:29:31.803]    <block atomic="false" info="">
[04:29:31.803]      __var SW_DP_ABORT       = 0x0;
[04:29:31.803]        // -> [SW_DP_ABORT <= 0x00000000]
[04:29:31.803]      __var DP_CTRL_STAT      = 0x4;
[04:29:31.803]        // -> [DP_CTRL_STAT <= 0x00000004]
[04:29:31.803]      __var DP_SELECT         = 0x8;
[04:29:31.803]        // -> [DP_SELECT <= 0x00000008]
[04:29:31.803]      __var powered_down      = 0;
[04:29:31.803]        // -> [powered_down <= 0x00000000]
[04:29:31.803]      WriteDP(DP_SELECT, 0x00000000);
[04:29:31.803]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[04:29:31.803]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[04:29:31.808]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[04:29:31.808]        // -> [powered_down <= 0x00000001]
[04:29:31.808]    </block>
[04:29:31.808]    <control if="powered_down" while="" timeout="0" info="">
[04:29:31.808]      // if-block "powered_down"
[04:29:31.808]        // =>  TRUE
[04:29:31.808]      <block atomic="false" info="">
[04:29:31.808]        Message(0, "Debug/System power-up request sent");
[04:29:31.808]        WriteDP(DP_CTRL_STAT, 0x50000000);
[04:29:31.808]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[04:29:31.808]      </block>
[04:29:31.808]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[04:29:31.808]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[04:29:31.814]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[04:29:31.814]        // while-condition  =>  FALSE
[04:29:31.814]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[04:29:31.814]      </control>
[04:29:31.814]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[04:29:31.814]        // if-block "(__protocol & 0xFFFF) == 1"
[04:29:31.814]          // =>  FALSE
[04:29:31.814]        // skip if-block "(__protocol & 0xFFFF) == 1"
[04:29:31.814]      </control>
[04:29:31.814]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[04:29:31.814]        // if-block "(__protocol & 0xFFFF) == 2"
[04:29:31.814]          // =>  TRUE
[04:29:31.814]        <block atomic="false" info="">
[04:29:31.814]          Message(0, "executing SWD power up");
[04:29:31.814]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[04:29:31.814]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[04:29:31.814]          WriteDP(SW_DP_ABORT, 0x0000001E);
[04:29:31.819]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[04:29:31.819]        </block>
[04:29:31.819]        // end if-block "(__protocol & 0xFFFF) == 2"
[04:29:31.819]      </control>
[04:29:31.819]      // end if-block "powered_down"
[04:29:31.819]    </control>
[04:29:31.819]    <block atomic="false" info="">
[04:29:31.819]      __var DEBUG_PORT_VAL    = 0;
[04:29:31.819]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[04:29:31.819]      __var ACCESS_POINT_VAL  = 0;
[04:29:31.819]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[04:29:31.819]      __ap = 1; 
[04:29:31.819]        // -> [__ap <= 0x00000001]
