[02:15:29.269]        WriteAP(0x00, 0x190008);
[02:15:29.274]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[02:15:29.274]        WriteAP(0xF0, 0x01);
[02:15:29.274]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[02:15:29.274]      </block>
[02:15:29.274]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[02:15:29.274]    </control>
[02:15:29.274]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
[02:15:29.274]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[02:15:29.274]        // =>  FALSE
[02:15:29.274]      // skip if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[02:15:29.274]    </control>
[02:15:29.274]    <block atomic="false" info="">
[02:15:29.274]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[02:15:29.274]        // -> [ReadAP(0x00000000) => 0x0079002F]   (__dp=0x00000000, __ap=0x00000004)
[02:15:29.274]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[02:15:29.274]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
