[00:34:50.104]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[00:34:50.104]    <block atomic="false" info="">
[00:34:50.104]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[00:34:50.104]        // -> [isSWJ <= 0x00000001]
[00:34:50.104]      __var hasDormant = __protocol & 0x00020000;
