[19:57:26.818]        // -> [SW_DP_ABORT <= 0x00000000]
[19:57:26.818]      __var DP_CTRL_STAT      = 0x4;
[19:57:26.818]        // -> [DP_CTRL_STAT <= 0x00000004]
[19:57:26.818]      __var DP_SELECT         = 0x8;
[19:57:26.818]        // -> [DP_SELECT <= 0x00000008]
[19:57:26.818]      __var powered_down      = 0;
[19:57:26.818]        // -> [powered_down <= 0x00000000]
[19:57:26.818]      WriteDP(DP_SELECT, 0x00000000);
[19:57:26.818]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:57:26.818]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:57:26.825]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:57:26.825]        // -> [powered_down <= 0x00000001]
