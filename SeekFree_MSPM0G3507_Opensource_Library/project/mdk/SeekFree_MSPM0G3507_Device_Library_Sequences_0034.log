[20:36:16.984]      __var manuf = 0;
[20:36:16.984]        // -> [manuf <= 0x00000000]
[20:36:16.984]      __var isMSPM0G1X0X_G3X0X = 0;
[20:36:16.984]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:36:16.984]      __var isProduction = 0;
[20:36:16.984]        // -> [isProduction <= 0x00000000]
[20:36:16.984]      __var continueId = 0;
