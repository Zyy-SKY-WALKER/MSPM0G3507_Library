[19:04:06.783]        WriteAP(0x00, 0x190008);
[19:04:06.786]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[19:04:06.786]        WriteAP(0xF0, 0x01);
[19:04:06.790]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[19:04:06.790]      </block>
[19:04:06.790]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[19:04:06.790]    </control>
