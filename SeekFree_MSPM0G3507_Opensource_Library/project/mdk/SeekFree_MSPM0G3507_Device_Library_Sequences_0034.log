[20:36:16.894]  
[20:36:16.894]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[20:36:16.894]    <block atomic="false" info="">
[20:36:16.894]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[20:36:16.894]        // -> [isSWJ <= 0x00000001]
[20:36:16.894]      __var hasDormant = __protocol & 0x00020000;
[20:36:16.894]        // -> [hasDormant <= 0x00000000]
[20:36:16.894]      __var protType   = __protocol & 0x0000FFFF;
[20:36:16.894]        // -> [protType <= 0x00000002]
[20:36:16.894]    </block>
[20:36:16.894]    <control if="protType == 1" while="" timeout="0" info="">
[20:36:16.894]      // if-block "protType == 1"
[20:36:16.894]        // =>  FALSE
[20:36:16.894]      // skip if-block "protType == 1"
[20:36:16.894]    </control>
[20:36:16.894]    <control if="protType == 2" while="" timeout="0" info="">
[20:36:16.894]      // if-block "protType == 2"
[20:36:16.894]        // =>  TRUE
[20:36:16.894]      <control if="isSWJ" while="" timeout="0" info="">
[20:36:16.894]        // if-block "isSWJ"
[20:36:16.894]          // =>  TRUE
[20:36:16.894]        <control if="hasDormant" while="" timeout="0" info="">
[20:36:16.894]          // if-block "hasDormant"
[20:36:16.894]            // =>  FALSE
[20:36:16.894]          // skip if-block "hasDormant"
[20:36:16.894]        </control>
[20:36:16.894]        <control if="!hasDormant" while="" timeout="0" info="">
[20:36:16.894]          // if-block "!hasDormant"
[20:36:16.894]            // =>  TRUE
[20:36:16.894]          <block atomic="false" info="">
[20:36:16.894]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:36:16.894]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:36:16.894]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:36:16.900]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:36:16.900]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:36:16.904]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:36:16.904]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[20:36:16.906]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[20:36:16.906]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[20:36:16.906]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:36:16.906]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:36:16.910]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[20:36:16.910]          </block>
[20:36:16.910]          // end if-block "!hasDormant"
[20:36:16.910]        </control>
[20:36:16.910]        // end if-block "isSWJ"
[20:36:16.910]      </control>
[20:36:16.910]      <control if="!isSWJ" while="" timeout="0" info="">
[20:36:16.910]        // if-block "!isSWJ"
[20:36:16.910]          // =>  FALSE
[20:36:16.910]        // skip if-block "!isSWJ"
[20:36:16.910]      </control>
[20:36:16.910]      <block atomic="false" info="">
[20:36:16.910]        ReadDP(0x0);
[20:36:16.910]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[20:36:16.910]      </block>
[20:36:16.910]      // end if-block "protType == 2"
[20:36:16.910]    </control>
[20:36:16.910]  </sequence>
