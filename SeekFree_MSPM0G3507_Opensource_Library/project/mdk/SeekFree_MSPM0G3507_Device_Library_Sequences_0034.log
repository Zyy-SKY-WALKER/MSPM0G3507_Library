[20:23:14.126]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[20:23:14.126]    <block atomic="false" info="">
[20:23:14.126]      __var deviceID = 0;
[20:23:14.126]        // -> [deviceID <= 0x00000000]
[20:23:14.126]      __var version = 0;
[20:23:14.126]        // -> [version <= 0x00000000]
[20:23:14.126]      __var partNum = 0;
[20:23:14.126]        // -> [partNum <= 0x00000000]
[20:23:14.126]      __var manuf = 0;
[20:23:14.126]        // -> [manuf <= 0x00000000]
[20:23:14.126]      __var isMSPM0G1X0X_G3X0X = 0;
[20:23:14.126]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:23:14.126]      __var isProduction = 0;
[20:23:14.126]        // -> [isProduction <= 0x00000000]
[20:23:14.126]      __var continueId = 0;
[20:23:14.126]        // -> [continueId <= 0x00000000]
[20:23:14.126]      deviceID =   Read32(0x41C40004);
[20:23:14.134]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:23:14.134]        // -> [deviceID <= 0x2BB8802F]
[20:23:14.134]      version = deviceID >> 28;
[20:23:14.134]        // -> [version <= 0x00000002]
[20:23:14.134]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:23:14.134]        // -> [partNum <= 0x0000BB88]
[20:23:14.134]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:23:14.134]        // -> [manuf <= 0x00000017]
[20:23:14.134]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:23:14.134]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:23:14.134]      isProduction = (version > 0);
[20:23:14.134]        // -> [isProduction <= 0x00000001]
[20:23:14.134]    </block>
[20:23:14.134]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[20:23:14.134]      // if-block "!isMSPM0G1X0X_G3X0X"
[20:23:14.134]        // =>  FALSE
[20:23:14.134]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[20:23:14.134]    </control>
[20:23:14.134]    <control if="continueId == 4" while="" timeout="0" info="">
[20:23:14.134]      // if-block "continueId == 4"
[20:23:14.134]        // =>  FALSE
[20:23:14.134]      // skip if-block "continueId == 4"
[20:23:14.134]    </control>
[20:23:14.134]    <control if="!isProduction" while="" timeout="0" info="">
[20:23:14.134]      // if-block "!isProduction"
[20:23:14.134]        // =>  FALSE
[20:23:14.134]      // skip if-block "!isProduction"
[20:23:14.134]    </control>
[20:23:14.134]  </sequence>
