[19:25:33.202]    <control if="canReadPins" while="" timeout="0" info="">
[19:25:33.202]      // if-block "canReadPins"
[19:25:33.202]        // =>  TRUE
[19:25:33.202]      <control if="" while="(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0" timeout="1000000" info="">
[19:25:33.202]        // while "(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0"  (timeout="1000000")
[19:25:33.202]          // -> [DAP_SWJ_Pins(0x80, 0x80, 0) => 0x8F]   (Out: nRESET=1  =>  In: SWCLK/TCK=1, SWDIO/TMS=1, TDI=1, TDO=1, nTRST=0, nRESET=1)
[19:25:33.202]        // while-condition  =>  FALSE
[19:25:33.202]        // end while "(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0"
[19:25:33.202]      </control>
[19:25:33.202]      // end if-block "canReadPins"
[19:25:33.202]    </control>
[19:25:33.202]    <control if="!canReadPins" while="" timeout="0" info="">
[19:25:33.202]      // if-block "!canReadPins"
