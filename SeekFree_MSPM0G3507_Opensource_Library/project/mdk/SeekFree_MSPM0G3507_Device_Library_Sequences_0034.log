[21:44:06.387]          // if-block "hasDormant"
[21:44:06.387]            // =>  FALSE
[21:44:06.387]          // skip if-block "hasDormant"
[21:44:06.387]        </control>
[21:44:06.387]        <control if="!hasDormant" while="" timeout="0" info="">
[21:44:06.387]          // if-block "!hasDormant"
[21:44:06.387]            // =>  TRUE
[21:44:06.387]          <block atomic="false" info="">
[21:44:06.387]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[21:44:06.387]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[21:44:06.387]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[21:44:06.398]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[21:44:06.398]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
