[19:04:06.837]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:04:06.837]    <block atomic="false" info="">
[19:04:06.837]      __var deviceID = 0;
[19:04:06.837]        // -> [deviceID <= 0x00000000]
[19:04:06.837]      __var version = 0;
[19:04:06.837]        // -> [version <= 0x00000000]
[19:04:06.837]      __var partNum = 0;
[19:04:06.837]        // -> [partNum <= 0x00000000]
[19:04:06.837]      __var manuf = 0;
[19:04:06.837]        // -> [manuf <= 0x00000000]
[19:04:06.837]      __var isMSPM0G1X0X_G3X0X = 0;
[19:04:06.837]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:04:06.837]      __var isProduction = 0;
[19:04:06.837]        // -> [isProduction <= 0x00000000]
[19:04:06.837]      __var continueId = 0;
[19:04:06.837]        // -> [continueId <= 0x00000000]
[19:04:06.837]      deviceID =   Read32(0x41C40004);
[19:04:06.847]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:04:06.847]        // -> [deviceID <= 0x2BB8802F]
[19:04:06.847]      version = deviceID >> 28;
[19:04:06.847]        // -> [version <= 0x00000002]
[19:04:06.847]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:04:06.847]        // -> [partNum <= 0x0000BB88]
[19:04:06.847]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:04:06.847]        // -> [manuf <= 0x00000017]
[19:04:06.847]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:04:06.847]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:04:06.847]      isProduction = (version > 0);
[19:04:06.847]        // -> [isProduction <= 0x00000001]
[19:04:06.847]    </block>
[19:04:06.847]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[19:04:06.847]      // if-block "!isMSPM0G1X0X_G3X0X"
[19:04:06.847]        // =>  FALSE
