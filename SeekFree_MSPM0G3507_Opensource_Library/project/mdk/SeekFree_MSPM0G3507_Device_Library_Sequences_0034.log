[23:48:10.250]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[23:48:10.250]        // while-condition  =>  FALSE
[23:48:10.250]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[23:48:10.250]      </control>
[23:48:10.250]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[23:48:10.250]        // if-block "(__protocol & 0xFFFF) == 1"
[23:48:10.250]          // =>  FALSE
[23:48:10.250]        // skip if-block "(__protocol & 0xFFFF) == 1"
[23:48:10.250]      </control>
[23:48:10.250]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[23:48:10.250]        // if-block "(__protocol & 0xFFFF) == 2"
[23:48:10.250]          // =>  TRUE
[23:48:10.250]        <block atomic="false" info="">
[23:48:10.250]          Message(0, "executing SWD power up");
[23:48:10.250]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[23:48:10.250]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[23:48:10.255]          WriteDP(SW_DP_ABORT, 0x0000001E);
[23:48:10.255]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[23:48:10.255]        </block>
[23:48:10.255]        // end if-block "(__protocol & 0xFFFF) == 2"
[23:48:10.255]      </control>
[23:48:10.255]      // end if-block "powered_down"
[23:48:10.255]    </control>
[23:48:10.255]    <block atomic="false" info="">
[23:48:10.255]      __var DEBUG_PORT_VAL    = 0;
[23:48:10.255]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[23:48:10.255]      __var ACCESS_POINT_VAL  = 0;
[23:48:10.255]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[23:48:10.255]      __ap = 1; 
[23:48:10.255]        // -> [__ap <= 0x00000001]
[23:48:10.255]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[23:48:10.260]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[23:48:10.260]      __ap = 4;
[23:48:10.260]        // -> [__ap <= 0x00000004]
[23:48:10.260]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[23:48:10.265]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[23:48:10.265]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[23:48:10.265]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[23:48:10.269]    </block>
[23:48:10.270]    <block atomic="false" info="">
[23:48:10.270]      __var nReset = 0x80;
[23:48:10.270]        // -> [nReset <= 0x00000080]
