[20:36:50.855]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[20:36:50.855]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:36:50.855]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:36:50.855]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[20:36:50.855]          </block>
