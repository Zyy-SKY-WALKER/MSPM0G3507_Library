[19:25:33.247]  **********  Sequence "DebugDeviceUnlock"  (Context="Connect", Pname="", info="")
[19:25:33.247]  
[19:25:33.247]  <debugvars>
[19:25:33.247]    // Pre-defined
[19:25:33.247]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[19:25:33.247]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[19:25:33.247]    __dp=0x00000000
[19:25:33.247]    __ap=0x00000000
[19:25:33.247]    __traceout=0x00000000      (Trace Disabled)
[19:25:33.247]    __errorcontrol=0x00000000  (Skip Errors="False")
[19:25:33.247]    __FlashAddr=0x00000000
[19:25:33.247]    __FlashLen=0x00000000
[19:25:33.247]    __FlashArg=0x00000000
[19:25:33.247]    __FlashOp=0x00000000
[19:25:33.247]    __Result=0x00000000
[19:25:33.247]  </debugvars>
[19:25:33.247]  
[19:25:33.247]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:25:33.247]    <block atomic="false" info="">
[19:25:33.247]      __var deviceID = 0;
[19:25:33.247]        // -> [deviceID <= 0x00000000]
[19:25:33.247]      __var version = 0;
[19:25:33.247]        // -> [version <= 0x00000000]
[19:25:33.247]      __var partNum = 0;
[19:25:33.247]        // -> [partNum <= 0x00000000]
[19:25:33.247]      __var manuf = 0;
[19:25:33.247]        // -> [manuf <= 0x00000000]
[19:25:33.247]      __var isMSPM0G1X0X_G3X0X = 0;
[19:25:33.247]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:25:33.247]      __var isProduction = 0;
[19:25:33.247]        // -> [isProduction <= 0x00000000]
[19:25:33.247]      __var continueId = 0;
[19:25:33.247]        // -> [continueId <= 0x00000000]
[19:25:33.247]      deviceID =   Read32(0x41C40004);
[19:25:33.268]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:25:33.268]        // -> [deviceID <= 0x2BB8802F]
[19:25:33.268]      version = deviceID >> 28;
[19:25:33.268]        // -> [version <= 0x00000002]
[19:25:33.268]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:25:33.268]        // -> [partNum <= 0x0000BB88]
[19:25:33.268]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:25:33.268]        // -> [manuf <= 0x00000017]
[19:25:33.268]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:25:33.268]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:25:33.268]      isProduction = (version > 0);
[19:25:33.268]        // -> [isProduction <= 0x00000001]
[19:25:33.268]    </block>
[19:25:33.268]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[19:25:33.268]      // if-block "!isMSPM0G1X0X_G3X0X"
[19:25:33.268]        // =>  FALSE
[19:25:33.268]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[19:25:33.268]    </control>
[19:25:33.268]    <control if="continueId == 4" while="" timeout="0" info="">
[19:25:33.268]      // if-block "continueId == 4"
[19:25:33.268]        // =>  FALSE
[19:25:33.268]      // skip if-block "continueId == 4"
[19:25:33.268]    </control>
[19:25:33.268]    <control if="!isProduction" while="" timeout="0" info="">
[19:25:33.268]      // if-block "!isProduction"
[19:25:33.268]        // =>  FALSE
[19:25:33.268]      // skip if-block "!isProduction"
[19:25:33.268]    </control>
[19:25:33.268]  </sequence>
