[21:44:06.398]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[21:44:06.398]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[21:44:06.398]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
