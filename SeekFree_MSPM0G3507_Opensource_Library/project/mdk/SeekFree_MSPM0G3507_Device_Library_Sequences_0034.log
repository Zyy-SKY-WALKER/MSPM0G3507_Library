[20:39:50.090]            // =>  TRUE
[20:39:50.090]          <block atomic="false" info="">
[20:39:50.090]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:39:50.092]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:39:50.092]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:39:50.094]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:39:50.094]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:39:50.096]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:39:50.096]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
