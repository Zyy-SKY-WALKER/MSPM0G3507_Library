[21:51:10.012]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[21:51:10.012]    <block atomic="false" info="">
[21:51:10.012]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[21:51:10.012]        // -> [isSWJ <= 0x00000001]
[21:51:10.012]      __var hasDormant = __protocol & 0x00020000;
