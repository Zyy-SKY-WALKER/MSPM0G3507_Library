[19:25:33.202]      // skip if-block "!canReadPins"
[19:25:33.202]    </control>
[19:25:33.202]    <control if="(ACCESS_POINT_VAL & 0x00E00000) == 0" while="" timeout="0" info="">
[19:25:33.202]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[19:25:33.202]        // =>  TRUE
[19:25:33.202]      <block atomic="false" info="">
[19:25:33.205]        WriteAP(0x00, 0x190008);
[19:25:33.207]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[19:25:33.207]        WriteAP(0xF0, 0x01);
[19:25:33.214]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[19:25:33.215]      </block>
[19:25:33.215]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[19:25:33.215]    </control>
[19:25:33.215]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
[19:25:33.215]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[19:25:33.215]        // =>  FALSE
[19:25:33.215]      // skip if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[19:25:33.215]    </control>
[19:25:33.215]    <block atomic="false" info="">
[19:25:33.215]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[19:25:33.217]        // -> [ReadAP(0x00000000) => 0x0079002F]   (__dp=0x00000000, __ap=0x00000004)
[19:25:33.217]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[19:25:33.217]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[19:25:33.222]      __ap = 0; //lets make sure we reset the access point selection
[19:25:33.222]        // -> [__ap <= 0x00000000]
[19:25:33.222]    </block>
[19:25:33.222]  </sequence>
