[19:02:36.016]        <block atomic="false" info="">
[19:02:36.016]          Message(0, "executing SWD power up");
[19:02:36.016]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[19:02:36.026]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
