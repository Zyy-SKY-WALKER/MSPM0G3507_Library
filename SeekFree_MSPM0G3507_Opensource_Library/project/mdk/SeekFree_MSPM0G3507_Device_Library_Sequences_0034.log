[20:45:41.734]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[20:45:41.734]    __dp=0x00000000
[20:45:41.734]    __ap=0x00000000
[20:45:41.734]    __traceout=0x00000000      (Trace Disabled)
