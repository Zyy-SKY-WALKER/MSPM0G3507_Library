[20:36:50.847]          // if-block "hasDormant"
[20:36:50.847]            // =>  FALSE
[20:36:50.847]          // skip if-block "hasDormant"
[20:36:50.847]        </control>
[20:36:50.847]        <control if="!hasDormant" while="" timeout="0" info="">
[20:36:50.847]          // if-block "!hasDormant"
[20:36:50.847]            // =>  TRUE
[20:36:50.847]          <block atomic="false" info="">
[20:36:50.847]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:36:50.847]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:36:50.847]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:36:50.854]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:36:50.854]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:36:50.855]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:36:50.855]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
