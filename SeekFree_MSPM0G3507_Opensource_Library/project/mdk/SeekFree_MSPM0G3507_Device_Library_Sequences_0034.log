[19:02:35.987]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:02:35.987]    <block atomic="false" info="">
[19:02:35.987]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:02:35.987]        // -> [isSWJ <= 0x00000001]
[19:02:35.987]      __var hasDormant = __protocol & 0x00020000;
