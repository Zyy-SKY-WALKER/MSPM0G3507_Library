[20:23:14.126]  <debugvars>
[20:23:14.126]    // Pre-defined
[20:23:14.126]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[20:23:14.126]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[20:23:14.126]    __dp=0x00000000
