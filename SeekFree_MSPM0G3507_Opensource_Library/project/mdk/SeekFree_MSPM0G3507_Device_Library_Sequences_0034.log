[19:02:35.997]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:02:35.997]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:02:35.997]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:02:35.997]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:02:35.997]          </block>
