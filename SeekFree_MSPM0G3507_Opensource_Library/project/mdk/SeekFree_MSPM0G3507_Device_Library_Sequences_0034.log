[19:02:36.006]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[19:02:36.006]    <block atomic="false" info="">
[19:02:36.006]      __var SW_DP_ABORT       = 0x0;
[19:02:36.006]        // -> [SW_DP_ABORT <= 0x00000000]
