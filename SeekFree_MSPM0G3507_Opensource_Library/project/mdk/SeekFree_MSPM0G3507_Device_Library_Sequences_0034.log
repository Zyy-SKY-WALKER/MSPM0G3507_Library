[20:36:16.934]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[20:36:16.934]      __ap = 1; 
[20:36:16.934]        // -> [__ap <= 0x00000001]
[20:36:16.934]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[20:36:16.936]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[20:36:16.936]      __ap = 4;
[20:36:16.936]        // -> [__ap <= 0x00000004]
[20:36:16.936]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[20:36:16.940]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[20:36:16.943]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[20:36:16.943]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
