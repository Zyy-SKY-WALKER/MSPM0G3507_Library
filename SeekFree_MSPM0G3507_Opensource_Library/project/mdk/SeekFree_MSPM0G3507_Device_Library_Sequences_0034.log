[21:44:06.387]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[21:44:06.387]    <block atomic="false" info="">
[21:44:06.387]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[21:44:06.387]        // -> [isSWJ <= 0x00000001]
