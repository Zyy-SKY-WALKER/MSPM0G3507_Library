[21:51:10.012]        <control if="hasDormant" while="" timeout="0" info="">
[21:51:10.012]          // if-block "hasDormant"
[21:51:10.012]            // =>  FALSE
[21:51:10.012]          // skip if-block "hasDormant"
[21:51:10.012]        </control>
[21:51:10.012]        <control if="!hasDormant" while="" timeout="0" info="">
[21:51:10.012]          // if-block "!hasDormant"
[21:51:10.012]            // =>  TRUE
[21:51:10.012]          <block atomic="false" info="">
[21:51:10.012]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[21:51:10.012]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[21:51:10.012]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[21:51:10.012]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[21:51:10.012]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[21:51:10.022]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[21:51:10.022]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[21:51:10.022]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[21:51:10.022]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[21:51:10.022]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[21:51:10.022]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[21:51:10.022]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[21:51:10.022]          </block>
[21:51:10.022]          // end if-block "!hasDormant"
[21:51:10.022]        </control>
[21:51:10.022]        // end if-block "isSWJ"
[21:51:10.022]      </control>
