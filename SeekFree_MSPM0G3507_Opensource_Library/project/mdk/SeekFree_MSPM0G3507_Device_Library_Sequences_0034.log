[19:49:23.075]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:49:23.075]    <block atomic="false" info="">
[19:49:23.075]      __var deviceID = 0;
[19:49:23.075]        // -> [deviceID <= 0x00000000]
[19:49:23.075]      __var version = 0;
[19:49:23.075]        // -> [version <= 0x00000000]
[19:49:23.077]      __var partNum = 0;
[19:49:23.077]        // -> [partNum <= 0x00000000]
[19:49:23.077]      __var manuf = 0;
[19:49:23.077]        // -> [manuf <= 0x00000000]
[19:49:23.077]      __var isMSPM0G1X0X_G3X0X = 0;
[19:49:23.077]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:49:23.077]      __var isProduction = 0;
[19:49:23.077]        // -> [isProduction <= 0x00000000]
[19:49:23.077]      __var continueId = 0;
[19:49:23.077]        // -> [continueId <= 0x00000000]
[19:49:23.077]      deviceID =   Read32(0x41C40004);
[19:49:23.086]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:49:23.086]        // -> [deviceID <= 0x2BB8802F]
[19:49:23.086]      version = deviceID >> 28;
[19:49:23.086]        // -> [version <= 0x00000002]
[19:49:23.086]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:49:23.086]        // -> [partNum <= 0x0000BB88]
[19:49:23.086]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:49:23.086]        // -> [manuf <= 0x00000017]
[19:49:23.086]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:49:23.086]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:49:23.086]      isProduction = (version > 0);
[19:49:23.086]        // -> [isProduction <= 0x00000001]
[19:49:23.086]    </block>
