[20:45:41.701]      // skip if-block "!canReadPins"
[20:45:41.701]    </control>
[20:45:41.701]    <control if="(ACCESS_POINT_VAL & 0x00E00000) == 0" while="" timeout="0" info="">
[20:45:41.701]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[20:45:41.702]        // =>  TRUE
[20:45:41.702]      <block atomic="false" info="">
[20:45:41.702]        WriteAP(0x00, 0x190008);
[20:45:41.703]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[20:45:41.703]        WriteAP(0xF0, 0x01);
[20:45:41.707]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[20:45:41.707]      </block>
[20:45:41.707]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[20:45:41.707]    </control>
[20:45:41.707]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
[20:45:41.707]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[20:45:41.707]        // =>  FALSE
[20:45:41.707]      // skip if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[20:45:41.707]    </control>
[20:45:41.707]    <block atomic="false" info="">
[20:45:41.707]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[20:45:41.713]        // -> [ReadAP(0x00000000) => 0x0079002F]   (__dp=0x00000000, __ap=0x00000004)
[20:45:41.713]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[20:45:41.713]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[20:45:41.713]      __ap = 0; //lets make sure we reset the access point selection
[20:45:41.713]        // -> [__ap <= 0x00000000]
[20:45:41.713]    </block>
[20:45:41.713]  </sequence>
