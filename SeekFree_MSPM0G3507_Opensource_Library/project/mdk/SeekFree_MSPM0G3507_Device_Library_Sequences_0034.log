[19:57:33.669]      <block atomic="false" info="">
[19:57:33.669]        WriteAP(0x00, 0x190008);
[19:57:33.669]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[19:57:33.674]        WriteAP(0xF0, 0x01);
[19:57:33.675]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[19:57:33.675]      </block>
[19:57:33.675]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
