[20:45:41.734]      __var deviceID = 0;
[20:45:41.734]        // -> [deviceID <= 0x00000000]
[20:45:41.734]      __var version = 0;
[20:45:41.734]        // -> [version <= 0x00000000]
[20:45:41.734]      __var partNum = 0;
[20:45:41.734]        // -> [partNum <= 0x00000000]
[20:45:41.734]      __var manuf = 0;
[20:45:41.736]        // -> [manuf <= 0x00000000]
[20:45:41.736]      __var isMSPM0G1X0X_G3X0X = 0;
[20:45:41.736]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:45:41.736]      __var isProduction = 0;
[20:45:41.736]        // -> [isProduction <= 0x00000000]
[20:45:41.736]      __var continueId = 0;
[20:45:41.736]        // -> [continueId <= 0x00000000]
[20:45:41.736]      deviceID =   Read32(0x41C40004);
[20:45:41.743]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:45:41.743]        // -> [deviceID <= 0x2BB8802F]
[20:45:41.743]      version = deviceID >> 28;
[20:45:41.743]        // -> [version <= 0x00000002]
[20:45:41.743]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:45:41.743]        // -> [partNum <= 0x0000BB88]
[20:45:41.743]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:45:41.743]        // -> [manuf <= 0x00000017]
[20:45:41.743]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:45:41.743]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:45:41.743]      isProduction = (version > 0);
[20:45:41.743]        // -> [isProduction <= 0x00000001]
[20:45:41.743]    </block>
