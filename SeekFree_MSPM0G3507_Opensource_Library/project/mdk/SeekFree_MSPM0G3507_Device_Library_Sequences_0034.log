[20:23:14.044]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:23:14.044]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[20:23:14.044]          </block>
[20:23:14.044]          // end if-block "!hasDormant"
[20:23:14.044]        </control>
[20:23:14.044]        // end if-block "isSWJ"
