[19:57:26.795]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:57:26.795]        // -> [isSWJ <= 0x00000001]
[19:57:26.795]      __var hasDormant = __protocol & 0x00020000;
[19:57:26.795]        // -> [hasDormant <= 0x00000000]
[19:57:26.795]      __var protType   = __protocol & 0x0000FFFF;
