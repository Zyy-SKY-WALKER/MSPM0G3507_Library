[19:57:26.795]      // if-block "protType == 2"
[19:57:26.795]        // =>  TRUE
[19:57:26.795]      <control if="isSWJ" while="" timeout="0" info="">
[19:57:26.795]        // if-block "isSWJ"
[19:57:26.798]          // =>  TRUE
[19:57:26.798]        <control if="hasDormant" while="" timeout="0" info="">
[19:57:26.798]          // if-block "hasDormant"
[19:57:26.798]            // =>  FALSE
[19:57:26.798]          // skip if-block "hasDormant"
[19:57:26.798]        </control>
[19:57:26.798]        <control if="!hasDormant" while="" timeout="0" info="">
[19:57:26.798]          // if-block "!hasDormant"
[19:57:26.798]            // =>  TRUE
[19:57:26.798]          <block atomic="false" info="">
[19:57:26.798]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:57:26.798]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:57:26.798]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:57:26.803]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:57:26.803]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:57:26.806]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:57:26.806]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:57:26.806]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:57:26.806]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:57:26.808]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:57:26.808]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:57:26.808]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:57:26.808]          </block>
[19:57:26.808]          // end if-block "!hasDormant"
[19:57:26.808]        </control>
[19:57:26.813]        // end if-block "isSWJ"
[19:57:26.813]      </control>
