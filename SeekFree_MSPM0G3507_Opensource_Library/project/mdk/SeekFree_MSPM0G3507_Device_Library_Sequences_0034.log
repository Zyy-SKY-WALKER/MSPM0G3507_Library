[19:02:36.006]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:02:36.006]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:02:36.006]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:02:36.006]        // -> [powered_down <= 0x00000001]
