[19:39:02.325]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:39:02.329]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
