[20:36:16.914]        // -> [SW_DP_ABORT <= 0x00000000]
[20:36:16.914]      __var DP_CTRL_STAT      = 0x4;
[20:36:16.914]        // -> [DP_CTRL_STAT <= 0x00000004]
[20:36:16.914]      __var DP_SELECT         = 0x8;
[20:36:16.914]        // -> [DP_SELECT <= 0x00000008]
[20:36:16.914]      __var powered_down      = 0;
[20:36:16.914]        // -> [powered_down <= 0x00000000]
[20:36:16.914]      WriteDP(DP_SELECT, 0x00000000);
[20:36:16.914]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[20:36:16.914]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[20:36:16.920]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[20:36:16.920]        // -> [powered_down <= 0x00000001]
[20:36:16.920]    </block>
[20:36:16.920]    <control if="powered_down" while="" timeout="0" info="">
[20:36:16.920]      // if-block "powered_down"
[20:36:16.920]        // =>  TRUE
[20:36:16.920]      <block atomic="false" info="">
[20:36:16.920]        Message(0, "Debug/System power-up request sent");
[20:36:16.923]        WriteDP(DP_CTRL_STAT, 0x50000000);
[20:36:16.924]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[20:36:16.924]      </block>
[20:36:16.924]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[20:36:16.924]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[20:36:16.924]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[20:36:16.924]        // while-condition  =>  FALSE
[20:36:16.924]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[20:36:16.924]      </control>
[20:36:16.924]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[20:36:16.924]        // if-block "(__protocol & 0xFFFF) == 1"
[20:36:16.924]          // =>  FALSE
[20:36:16.924]        // skip if-block "(__protocol & 0xFFFF) == 1"
[20:36:16.924]      </control>
[20:36:16.924]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[20:36:16.924]        // if-block "(__protocol & 0xFFFF) == 2"
[20:36:16.924]          // =>  TRUE
[20:36:16.924]        <block atomic="false" info="">
[20:36:16.924]          Message(0, "executing SWD power up");
[20:36:16.924]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[20:36:16.930]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[20:36:16.930]          WriteDP(SW_DP_ABORT, 0x0000001E);
[20:36:16.933]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[20:36:16.933]        </block>
[20:36:16.934]        // end if-block "(__protocol & 0xFFFF) == 2"
[20:36:16.934]      </control>
[20:36:16.934]      // end if-block "powered_down"
[20:36:16.934]    </control>
[20:36:16.934]    <block atomic="false" info="">
[20:36:16.934]      __var DEBUG_PORT_VAL    = 0;
[20:36:16.934]        // -> [DEBUG_PORT_VAL <= 0x00000000]
