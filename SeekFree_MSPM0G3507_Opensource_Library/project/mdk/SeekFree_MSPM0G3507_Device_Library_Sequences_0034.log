[20:23:14.034]          // skip if-block "hasDormant"
[20:23:14.034]        </control>
[20:23:14.034]        <control if="!hasDormant" while="" timeout="0" info="">
[20:23:14.034]          // if-block "!hasDormant"
[20:23:14.034]            // =>  TRUE
[20:23:14.034]          <block atomic="false" info="">
[20:23:14.034]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:23:14.034]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:23:14.034]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:23:14.044]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:23:14.044]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:23:14.044]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
