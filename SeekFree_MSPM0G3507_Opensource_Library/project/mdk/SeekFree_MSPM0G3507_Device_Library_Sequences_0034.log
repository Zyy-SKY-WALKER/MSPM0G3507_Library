[19:55:19.205]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:55:19.205]    <block atomic="false" info="">
[19:55:19.205]      __var deviceID = 0;
[19:55:19.205]        // -> [deviceID <= 0x00000000]
[19:55:19.205]      __var version = 0;
[19:55:19.205]        // -> [version <= 0x00000000]
[19:55:19.205]      __var partNum = 0;
[19:55:19.205]        // -> [partNum <= 0x00000000]
[19:55:19.205]      __var manuf = 0;
[19:55:19.205]        // -> [manuf <= 0x00000000]
[19:55:19.205]      __var isMSPM0G1X0X_G3X0X = 0;
[19:55:19.205]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:55:19.205]      __var isProduction = 0;
[19:55:19.205]        // -> [isProduction <= 0x00000000]
[19:55:19.205]      __var continueId = 0;
[19:55:19.205]        // -> [continueId <= 0x00000000]
[19:55:19.205]      deviceID =   Read32(0x41C40004);
[19:55:19.214]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:55:19.214]        // -> [deviceID <= 0x2BB8802F]
[19:55:19.214]      version = deviceID >> 28;
[19:55:19.214]        // -> [version <= 0x00000002]
[19:55:19.214]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:55:19.214]        // -> [partNum <= 0x0000BB88]
[19:55:19.214]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:55:19.214]        // -> [manuf <= 0x00000017]
[19:55:19.214]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:55:19.215]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:55:19.215]      isProduction = (version > 0);
[19:55:19.215]        // -> [isProduction <= 0x00000001]
[19:55:19.215]    </block>
[19:55:19.215]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[19:55:19.216]      // if-block "!isMSPM0G1X0X_G3X0X"
[19:55:19.216]        // =>  FALSE
[19:55:19.216]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[19:55:19.216]    </control>
