[20:45:41.697]    <control if="canReadPins" while="" timeout="0" info="">
[20:45:41.697]      // if-block "canReadPins"
[20:45:41.697]        // =>  TRUE
[20:45:41.697]      <control if="" while="(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0" timeout="1000000" info="">
[20:45:41.697]        // while "(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0"  (timeout="1000000")
[20:45:41.699]          // -> [DAP_SWJ_Pins(0x80, 0x80, 0) => 0x8F]   (Out: nRESET=1  =>  In: SWCLK/TCK=1, SWDIO/TMS=1, TDI=1, TDO=1, nTRST=0, nRESET=1)
[20:45:41.699]        // while-condition  =>  FALSE
[20:45:41.699]        // end while "(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0"
[20:45:41.699]      </control>
[20:45:41.699]      // end if-block "canReadPins"
