[19:02:35.987]          // =>  TRUE
[19:02:35.987]        <control if="hasDormant" while="" timeout="0" info="">
[19:02:35.987]          // if-block "hasDormant"
[19:02:35.987]            // =>  FALSE
[19:02:35.987]          // skip if-block "hasDormant"
[19:02:35.987]        </control>
[19:02:35.987]        <control if="!hasDormant" while="" timeout="0" info="">
[19:02:35.987]          // if-block "!hasDormant"
[19:02:35.987]            // =>  TRUE
[19:02:35.987]          <block atomic="false" info="">
[19:02:35.987]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:02:35.987]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:02:35.987]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:02:35.987]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:02:35.987]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:02:35.997]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:02:35.997]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
