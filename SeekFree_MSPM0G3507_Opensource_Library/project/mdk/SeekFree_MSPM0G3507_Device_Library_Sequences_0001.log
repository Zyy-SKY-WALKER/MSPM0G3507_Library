[18:11:13.340]        // -> [partNum <= 0x00000000]
[18:11:13.340]      __var manuf = 0;
[18:11:13.340]        // -> [manuf <= 0x00000000]
[18:11:13.340]      __var isMSPM0G1X0X_G3X0X = 0;
[18:11:13.340]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[18:11:13.340]      __var isProduction = 0;
[18:11:13.340]        // -> [isProduction <= 0x00000000]
[18:11:13.340]      __var continueId = 0;
[18:11:13.340]        // -> [continueId <= 0x00000000]
[18:11:13.340]      deviceID =   Read32(0x41C40004);
[18:11:13.346]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[18:11:13.346]        // -> [deviceID <= 0x2BB8802F]
[18:11:13.346]      version = deviceID >> 28;
[18:11:13.347]        // -> [version <= 0x00000002]
[18:11:13.347]      partNum = (deviceID & 0x0FFFF000) >> 12;
[18:11:13.347]        // -> [partNum <= 0x0000BB88]
[18:11:13.347]      manuf = (deviceID & 0x00000FFE) >> 1;
[18:11:13.347]        // -> [manuf <= 0x00000017]
[18:11:13.347]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[18:11:13.347]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[18:11:13.347]      isProduction = (version > 0);
[18:11:13.347]        // -> [isProduction <= 0x00000001]
