[18:03:07.821]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:03:07.823]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:03:07.823]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:03:07.823]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:03:07.823]          </block>
