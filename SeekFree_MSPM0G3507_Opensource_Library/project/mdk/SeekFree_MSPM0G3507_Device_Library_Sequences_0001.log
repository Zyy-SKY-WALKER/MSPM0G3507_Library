[18:03:07.806]          // if-block "hasDormant"
[18:03:07.806]            // =>  FALSE
[18:03:07.806]          // skip if-block "hasDormant"
[18:03:07.806]        </control>
[18:03:07.806]        <control if="!hasDormant" while="" timeout="0" info="">
[18:03:07.806]          // if-block "!hasDormant"
[18:03:07.806]            // =>  TRUE
[18:03:07.806]          <block atomic="false" info="">
[18:03:07.806]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:03:07.812]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:03:07.812]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:03:07.816]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:03:07.816]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:03:07.816]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
