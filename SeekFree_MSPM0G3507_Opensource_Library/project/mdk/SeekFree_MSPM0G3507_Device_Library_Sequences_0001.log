[18:03:07.922]        // -> [partNum <= 0x00000000]
[18:03:07.922]      __var manuf = 0;
[18:03:07.922]        // -> [manuf <= 0x00000000]
[18:03:07.922]      __var isMSPM0G1X0X_G3X0X = 0;
[18:03:07.922]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[18:03:07.922]      __var isProduction = 0;
[18:03:07.922]        // -> [isProduction <= 0x00000000]
[18:03:07.922]      __var continueId = 0;
[18:03:07.922]        // -> [continueId <= 0x00000000]
[18:03:07.922]      deviceID =   Read32(0x41C40004);
[18:03:07.928]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[18:03:07.928]        // -> [deviceID <= 0x2BB8802F]
[18:03:07.928]      version = deviceID >> 28;
[18:03:07.928]        // -> [version <= 0x00000002]
[18:03:07.928]      partNum = (deviceID & 0x0FFFF000) >> 12;
[18:03:07.928]        // -> [partNum <= 0x0000BB88]
[18:03:07.928]      manuf = (deviceID & 0x00000FFE) >> 1;
[18:03:07.928]        // -> [manuf <= 0x00000017]
[18:03:07.928]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[18:03:07.928]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[18:03:07.928]      isProduction = (version > 0);
[18:03:07.928]        // -> [isProduction <= 0x00000001]
[18:03:07.928]    </block>
