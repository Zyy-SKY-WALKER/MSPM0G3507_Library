[18:03:07.806]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[18:03:07.806]    <block atomic="false" info="">
[18:03:07.806]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[18:03:07.806]        // -> [isSWJ <= 0x00000001]
[18:03:07.806]      __var hasDormant = __protocol & 0x00020000;
[18:03:07.806]        // -> [hasDormant <= 0x00000000]
