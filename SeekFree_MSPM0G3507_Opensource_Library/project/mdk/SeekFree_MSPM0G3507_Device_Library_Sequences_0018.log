[19:45:41.656]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:45:41.656]      __var isProduction = 0;
[19:45:41.656]        // -> [isProduction <= 0x00000000]
[19:45:41.656]      __var continueId = 0;
[19:45:41.656]        // -> [continueId <= 0x00000000]
