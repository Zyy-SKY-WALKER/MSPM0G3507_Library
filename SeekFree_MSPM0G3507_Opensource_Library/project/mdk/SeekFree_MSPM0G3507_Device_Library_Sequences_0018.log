[19:47:47.308]            // =>  TRUE
[19:47:47.308]          <block atomic="false" info="">
[19:47:47.308]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:47:47.308]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:47:47.308]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:47:47.308]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:47:47.308]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
