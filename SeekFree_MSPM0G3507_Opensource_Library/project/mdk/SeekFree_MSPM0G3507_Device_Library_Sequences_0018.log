[22:27:27.725]      // skip if-block "protType == 1"
[22:27:27.725]    </control>
[22:27:27.725]    <control if="protType == 2" while="" timeout="0" info="">
[22:27:27.725]      // if-block "protType == 2"
[22:27:27.725]        // =>  TRUE
[22:27:27.725]      <control if="isSWJ" while="" timeout="0" info="">
[22:27:27.725]        // if-block "isSWJ"
[22:27:27.725]          // =>  TRUE
[22:27:27.725]        <control if="hasDormant" while="" timeout="0" info="">
[22:27:27.725]          // if-block "hasDormant"
[22:27:27.725]            // =>  FALSE
[22:27:27.725]          // skip if-block "hasDormant"
[22:27:27.725]        </control>
[22:27:27.725]        <control if="!hasDormant" while="" timeout="0" info="">
[22:27:27.727]          // if-block "!hasDormant"
[22:27:27.727]            // =>  TRUE
[22:27:27.727]          <block atomic="false" info="">
[22:27:27.727]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[22:27:27.728]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[22:27:27.728]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[22:27:27.730]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[22:27:27.730]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[22:27:27.733]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[22:27:27.733]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[22:27:27.735]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[22:27:27.735]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[22:27:27.737]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[22:27:27.737]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[22:27:27.738]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[22:27:27.738]          </block>
[22:27:27.738]          // end if-block "!hasDormant"
[22:27:27.740]        </control>
