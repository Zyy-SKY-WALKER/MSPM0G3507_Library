[22:27:27.740]        ReadDP(0x0);
[22:27:27.742]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[22:27:27.742]      </block>
[22:27:27.742]      // end if-block "protType == 2"
[22:27:27.742]    </control>
