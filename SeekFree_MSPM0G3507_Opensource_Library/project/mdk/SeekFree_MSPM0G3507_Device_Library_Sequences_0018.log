[20:25:33.209]        ReadDP(0x0);
[20:25:33.219]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[20:25:33.219]      </block>
[20:25:33.219]      // end if-block "protType == 2"
[20:25:33.219]    </control>
