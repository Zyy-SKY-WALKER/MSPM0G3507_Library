[20:20:41.877]        // -> [partNum <= 0x00000000]
[20:20:41.877]      __var manuf = 0;
[20:20:41.877]        // -> [manuf <= 0x00000000]
[20:20:41.877]      __var isMSPM0G1X0X_G3X0X = 0;
[20:20:41.877]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:20:41.877]      __var isProduction = 0;
[20:20:41.877]        // -> [isProduction <= 0x00000000]
[20:20:41.877]      __var continueId = 0;
[20:20:41.887]        // -> [continueId <= 0x00000000]
[20:20:41.887]      deviceID =   Read32(0x41C40004);
[20:20:41.887]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:20:41.887]        // -> [deviceID <= 0x2BB8802F]
[20:20:41.887]      version = deviceID >> 28;
[20:20:41.887]        // -> [version <= 0x00000002]
[20:20:41.887]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:20:41.887]        // -> [partNum <= 0x0000BB88]
[20:20:41.887]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:20:41.887]        // -> [manuf <= 0x00000017]
[20:20:41.887]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:20:41.887]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:20:41.887]      isProduction = (version > 0);
[20:20:41.887]        // -> [isProduction <= 0x00000001]
[20:20:41.887]    </block>
[20:20:41.887]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[20:20:41.887]      // if-block "!isMSPM0G1X0X_G3X0X"
[20:20:41.887]        // =>  FALSE
[20:20:41.887]      // skip if-block "!isMSPM0G1X0X_G3X0X"
