[22:17:45.885]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[22:17:45.885]    <block atomic="false" info="">
[22:17:45.885]      __var deviceID = 0;
[22:17:45.885]        // -> [deviceID <= 0x00000000]
[22:17:45.885]      __var version = 0;
[22:17:45.885]        // -> [version <= 0x00000000]
[22:17:45.885]      __var partNum = 0;
[22:17:45.885]        // -> [partNum <= 0x00000000]
[22:17:45.885]      __var manuf = 0;
[22:17:45.885]        // -> [manuf <= 0x00000000]
[22:17:45.885]      __var isMSPM0G1X0X_G3X0X = 0;
[22:17:45.885]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[22:17:45.885]      __var isProduction = 0;
[22:17:45.885]        // -> [isProduction <= 0x00000000]
[22:17:45.885]      __var continueId = 0;
[22:17:45.885]        // -> [continueId <= 0x00000000]
[22:17:45.885]      deviceID =   Read32(0x41C40004);
[22:17:45.894]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[22:17:45.894]        // -> [deviceID <= 0x2BB8802F]
[22:17:45.894]      version = deviceID >> 28;
[22:17:45.894]        // -> [version <= 0x00000002]
[22:17:45.894]      partNum = (deviceID & 0x0FFFF000) >> 12;
[22:17:45.894]        // -> [partNum <= 0x0000BB88]
[22:17:45.894]      manuf = (deviceID & 0x00000FFE) >> 1;
[22:17:45.894]        // -> [manuf <= 0x00000017]
[22:17:45.894]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[22:17:45.894]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[22:17:45.894]      isProduction = (version > 0);
[22:17:45.894]        // -> [isProduction <= 0x00000001]
[22:17:45.894]    </block>
[22:17:45.894]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
