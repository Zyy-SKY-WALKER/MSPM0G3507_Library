[21:09:31.923]            // =>  TRUE
[21:09:31.923]          <block atomic="false" info="">
[21:09:31.923]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
