[19:40:33.080]        WriteAP(0x00, 0x190008);
[19:40:33.080]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[19:40:33.080]        WriteAP(0xF0, 0x01);
[19:40:33.090]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[19:40:33.090]      </block>
[19:40:33.090]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[19:40:33.090]    </control>
[19:40:33.090]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
