[20:25:33.219]      __var DP_CTRL_STAT      = 0x4;
[20:25:33.219]        // -> [DP_CTRL_STAT <= 0x00000004]
[20:25:33.219]      __var DP_SELECT         = 0x8;
[20:25:33.219]        // -> [DP_SELECT <= 0x00000008]
[20:25:33.219]      __var powered_down      = 0;
[20:25:33.219]        // -> [powered_down <= 0x00000000]
[20:25:33.219]      WriteDP(DP_SELECT, 0x00000000);
[20:25:33.229]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[20:25:33.229]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[20:25:33.229]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[20:25:33.229]        // -> [powered_down <= 0x00000001]
[20:25:33.229]    </block>
[20:25:33.229]    <control if="powered_down" while="" timeout="0" info="">
