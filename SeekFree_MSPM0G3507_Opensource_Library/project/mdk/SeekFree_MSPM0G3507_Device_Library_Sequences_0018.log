[19:40:33.110]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:40:33.110]    <block atomic="false" info="">
[19:40:33.110]      __var deviceID = 0;
[19:40:33.110]        // -> [deviceID <= 0x00000000]
[19:40:33.110]      __var version = 0;
[19:40:33.110]        // -> [version <= 0x00000000]
[19:40:33.110]      __var partNum = 0;
[19:40:33.110]        // -> [partNum <= 0x00000000]
[19:40:33.110]      __var manuf = 0;
[19:40:33.110]        // -> [manuf <= 0x00000000]
[19:40:33.110]      __var isMSPM0G1X0X_G3X0X = 0;
[19:40:33.110]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:40:33.110]      __var isProduction = 0;
[19:40:33.110]        // -> [isProduction <= 0x00000000]
[19:40:33.110]      __var continueId = 0;
[19:40:33.110]        // -> [continueId <= 0x00000000]
[19:40:33.110]      deviceID =   Read32(0x41C40004);
[19:40:33.125]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:40:33.125]        // -> [deviceID <= 0x2BB8802F]
[19:40:33.125]      version = deviceID >> 28;
[19:40:33.125]        // -> [version <= 0x00000002]
[19:40:33.125]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:40:33.125]        // -> [partNum <= 0x0000BB88]
[19:40:33.125]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:40:33.125]        // -> [manuf <= 0x00000017]
[19:40:33.125]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:40:33.125]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:40:33.125]      isProduction = (version > 0);
[19:40:33.125]        // -> [isProduction <= 0x00000001]
[19:40:33.125]    </block>
[19:40:33.125]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[19:40:33.125]      // if-block "!isMSPM0G1X0X_G3X0X"
[19:40:33.125]        // =>  FALSE
[19:40:33.125]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[19:40:33.125]    </control>
[19:40:33.125]    <control if="continueId == 4" while="" timeout="0" info="">
[19:40:33.125]      // if-block "continueId == 4"
[19:40:33.125]        // =>  FALSE
[19:40:33.125]      // skip if-block "continueId == 4"
[19:40:33.125]    </control>
[19:40:33.125]    <control if="!isProduction" while="" timeout="0" info="">
[19:40:33.125]      // if-block "!isProduction"
[19:40:33.125]        // =>  FALSE
[19:40:33.125]      // skip if-block "!isProduction"
[19:40:33.125]    </control>
[19:40:33.125]  </sequence>
