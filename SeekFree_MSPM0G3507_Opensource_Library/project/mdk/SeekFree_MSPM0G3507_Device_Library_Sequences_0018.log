[19:51:41.619]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:51:41.619]    <block atomic="false" info="">
[19:51:41.619]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:51:41.619]        // -> [isSWJ <= 0x00000001]
[19:51:41.619]      __var hasDormant = __protocol & 0x00020000;
[19:51:41.619]        // -> [hasDormant <= 0x00000000]
[19:51:41.619]      __var protType   = __protocol & 0x0000FFFF;
[19:51:41.619]        // -> [protType <= 0x00000002]
[19:51:41.619]    </block>
