[19:45:41.540]      // skip if-block "protType == 1"
[19:45:41.540]    </control>
[19:45:41.540]    <control if="protType == 2" while="" timeout="0" info="">
[19:45:41.540]      // if-block "protType == 2"
[19:45:41.540]        // =>  TRUE
[19:45:41.540]      <control if="isSWJ" while="" timeout="0" info="">
[19:45:41.540]        // if-block "isSWJ"
[19:45:41.540]          // =>  TRUE
[19:45:41.540]        <control if="hasDormant" while="" timeout="0" info="">
[19:45:41.540]          // if-block "hasDormant"
[19:45:41.540]            // =>  FALSE
[19:45:41.540]          // skip if-block "hasDormant"
[19:45:41.540]        </control>
[19:45:41.540]        <control if="!hasDormant" while="" timeout="0" info="">
[19:45:41.540]          // if-block "!hasDormant"
[19:45:41.540]            // =>  TRUE
[19:45:41.540]          <block atomic="false" info="">
[19:45:41.540]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:45:41.540]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:45:41.540]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:45:41.540]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:45:41.540]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:45:41.540]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:45:41.550]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:45:41.552]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:45:41.552]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:45:41.554]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:45:41.554]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:45:41.554]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:45:41.554]          </block>
[19:45:41.554]          // end if-block "!hasDormant"
[19:45:41.554]        </control>
[19:45:41.554]        // end if-block "isSWJ"
[19:45:41.554]      </control>
[19:45:41.554]      <control if="!isSWJ" while="" timeout="0" info="">
[19:45:41.554]        // if-block "!isSWJ"
[19:45:41.554]          // =>  FALSE
[19:45:41.554]        // skip if-block "!isSWJ"
[19:45:41.554]      </control>
[19:45:41.554]      <block atomic="false" info="">
[19:45:41.554]        ReadDP(0x0);
[19:45:41.554]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[19:45:41.554]      </block>
[19:45:41.554]      // end if-block "protType == 2"
[19:45:41.554]    </control>
