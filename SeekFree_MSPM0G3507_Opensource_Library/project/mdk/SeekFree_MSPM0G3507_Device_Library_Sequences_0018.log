[22:27:27.723]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[22:27:27.723]    <block atomic="false" info="">
[22:27:27.723]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[22:27:27.723]        // -> [isSWJ <= 0x00000001]
[22:27:27.723]      __var hasDormant = __protocol & 0x00020000;
[22:27:27.723]        // -> [hasDormant <= 0x00000000]
[22:27:27.723]      __var protType   = __protocol & 0x0000FFFF;
[22:27:27.725]        // -> [protType <= 0x00000002]
[22:27:27.725]    </block>
