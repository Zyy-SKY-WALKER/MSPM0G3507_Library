[19:40:33.110]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[19:40:33.110]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[19:40:33.110]    __dp=0x00000000
