[22:27:27.768]    <block atomic="false" info="">
[22:27:27.768]      __var DEBUG_PORT_VAL    = 0;
[22:27:27.768]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[22:27:27.768]      __var ACCESS_POINT_VAL  = 0;
[22:27:27.768]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[22:27:27.768]      __ap = 1; 
[22:27:27.768]        // -> [__ap <= 0x00000001]
[22:27:27.768]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[22:27:27.768]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[22:27:27.768]      __ap = 4;
[22:27:27.768]        // -> [__ap <= 0x00000004]
[22:27:27.768]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[22:27:27.778]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[22:27:27.778]        // -> [ACCESS_POINT_VAL <= 0x00080027]
