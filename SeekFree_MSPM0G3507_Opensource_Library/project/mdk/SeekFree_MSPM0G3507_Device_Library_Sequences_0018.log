[19:51:41.644]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[19:51:41.644]    <block atomic="false" info="">
[19:51:41.644]      __var SW_DP_ABORT       = 0x0;
[19:51:41.644]        // -> [SW_DP_ABORT <= 0x00000000]
[19:51:41.644]      __var DP_CTRL_STAT      = 0x4;
[19:51:41.644]        // -> [DP_CTRL_STAT <= 0x00000004]
[19:51:41.644]      __var DP_SELECT         = 0x8;
[19:51:41.644]        // -> [DP_SELECT <= 0x00000008]
[19:51:41.644]      __var powered_down      = 0;
[19:51:41.644]        // -> [powered_down <= 0x00000000]
[19:51:41.644]      WriteDP(DP_SELECT, 0x00000000);
[19:51:41.648]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:51:41.648]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:51:41.648]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:51:41.648]        // -> [powered_down <= 0x00000001]
[19:51:41.648]    </block>
[19:51:41.648]    <control if="powered_down" while="" timeout="0" info="">
[19:51:41.648]      // if-block "powered_down"
[19:51:41.648]        // =>  TRUE
[19:51:41.648]      <block atomic="false" info="">
[19:51:41.648]        Message(0, "Debug/System power-up request sent");
[19:51:41.648]        WriteDP(DP_CTRL_STAT, 0x50000000);
[19:51:41.654]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[19:51:41.654]      </block>
[19:51:41.654]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[19:51:41.654]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[19:51:41.654]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[19:51:41.654]        // while-condition  =>  FALSE
[19:51:41.654]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[19:51:41.654]      </control>
[19:51:41.654]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[19:51:41.654]        // if-block "(__protocol & 0xFFFF) == 1"
[19:51:41.654]          // =>  FALSE
[19:51:41.654]        // skip if-block "(__protocol & 0xFFFF) == 1"
[19:51:41.654]      </control>
[19:51:41.654]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[19:51:41.654]        // if-block "(__protocol & 0xFFFF) == 2"
[19:51:41.654]          // =>  TRUE
[19:51:41.654]        <block atomic="false" info="">
[19:51:41.654]          Message(0, "executing SWD power up");
[19:51:41.654]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[19:51:41.659]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[19:51:41.659]          WriteDP(SW_DP_ABORT, 0x0000001E);
[19:51:41.659]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[19:51:41.659]        </block>
[19:51:41.659]        // end if-block "(__protocol & 0xFFFF) == 2"
[19:51:41.659]      </control>
[19:51:41.659]      // end if-block "powered_down"
[19:51:41.659]    </control>
[19:51:41.659]    <block atomic="false" info="">
[19:51:41.659]      __var DEBUG_PORT_VAL    = 0;
[19:51:41.659]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[19:51:41.659]      __var ACCESS_POINT_VAL  = 0;
[19:51:41.659]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[19:51:41.659]      __ap = 1; 
[19:51:41.659]        // -> [__ap <= 0x00000001]
[19:51:41.659]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[19:51:41.664]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[19:51:41.664]      __ap = 4;
