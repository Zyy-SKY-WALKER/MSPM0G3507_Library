[20:25:33.239]        <block atomic="false" info="">
[20:25:33.239]          Message(0, "executing SWD power up");
[20:25:33.239]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[20:25:33.239]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[20:25:33.239]          WriteDP(SW_DP_ABORT, 0x0000001E);
