[19:51:41.619]      // if-block "protType == 1"
[19:51:41.619]        // =>  FALSE
[19:51:41.619]      // skip if-block "protType == 1"
[19:51:41.619]    </control>
[19:51:41.619]    <control if="protType == 2" while="" timeout="0" info="">
[19:51:41.619]      // if-block "protType == 2"
[19:51:41.619]        // =>  TRUE
[19:51:41.619]      <control if="isSWJ" while="" timeout="0" info="">
[19:51:41.619]        // if-block "isSWJ"
[19:51:41.619]          // =>  TRUE
[19:51:41.619]        <control if="hasDormant" while="" timeout="0" info="">
[19:51:41.619]          // if-block "hasDormant"
[19:51:41.619]            // =>  FALSE
[19:51:41.619]          // skip if-block "hasDormant"
[19:51:41.619]        </control>
[19:51:41.619]        <control if="!hasDormant" while="" timeout="0" info="">
[19:51:41.619]          // if-block "!hasDormant"
[19:51:41.619]            // =>  TRUE
[19:51:41.619]          <block atomic="false" info="">
[19:51:41.619]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:51:41.619]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:51:41.619]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:51:41.619]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:51:41.619]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:51:41.629]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:51:41.629]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:51:41.629]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:51:41.629]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:51:41.629]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:51:41.629]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:51:41.629]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:51:41.629]          </block>
[19:51:41.629]          // end if-block "!hasDormant"
[19:51:41.629]        </control>
[19:51:41.629]        // end if-block "isSWJ"
[19:51:41.629]      </control>
[19:51:41.629]      <control if="!isSWJ" while="" timeout="0" info="">
[19:51:41.629]        // if-block "!isSWJ"
[19:51:41.629]          // =>  FALSE
[19:51:41.629]        // skip if-block "!isSWJ"
[19:51:41.629]      </control>
[19:51:41.629]      <block atomic="false" info="">
[19:51:41.629]        ReadDP(0x0);
[19:51:41.639]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[19:51:41.639]      </block>
[19:51:41.639]      // end if-block "protType == 2"
[19:51:41.639]    </control>
[19:51:41.639]  </sequence>
