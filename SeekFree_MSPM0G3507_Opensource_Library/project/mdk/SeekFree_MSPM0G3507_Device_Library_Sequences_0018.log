[20:25:33.199]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[20:25:33.199]    <block atomic="false" info="">
[20:25:33.199]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[20:25:33.199]        // -> [isSWJ <= 0x00000001]
[20:25:33.199]      __var hasDormant = __protocol & 0x00020000;
[20:25:33.199]        // -> [hasDormant <= 0x00000000]
[20:25:33.199]      __var protType   = __protocol & 0x0000FFFF;
[20:25:33.199]        // -> [protType <= 0x00000002]
[20:25:33.199]    </block>
[20:25:33.199]    <control if="protType == 1" while="" timeout="0" info="">
[20:25:33.199]      // if-block "protType == 1"
[20:25:33.199]        // =>  FALSE
[20:25:33.199]      // skip if-block "protType == 1"
[20:25:33.199]    </control>
[20:25:33.199]    <control if="protType == 2" while="" timeout="0" info="">
[20:25:33.199]      // if-block "protType == 2"
[20:25:33.199]        // =>  TRUE
[20:25:33.199]      <control if="isSWJ" while="" timeout="0" info="">
[20:25:33.199]        // if-block "isSWJ"
[20:25:33.199]          // =>  TRUE
[20:25:33.199]        <control if="hasDormant" while="" timeout="0" info="">
[20:25:33.199]          // if-block "hasDormant"
[20:25:33.199]            // =>  FALSE
[20:25:33.199]          // skip if-block "hasDormant"
[20:25:33.199]        </control>
[20:25:33.199]        <control if="!hasDormant" while="" timeout="0" info="">
[20:25:33.199]          // if-block "!hasDormant"
[20:25:33.199]            // =>  TRUE
[20:25:33.199]          <block atomic="false" info="">
[20:25:33.199]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:25:33.199]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:25:33.199]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:25:33.199]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:25:33.199]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:25:33.199]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:25:33.199]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[20:25:33.209]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[20:25:33.209]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[20:25:33.209]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:25:33.209]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:25:33.209]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[20:25:33.209]          </block>
[20:25:33.209]          // end if-block "!hasDormant"
[20:25:33.209]        </control>
[20:25:33.209]        // end if-block "isSWJ"
[20:25:33.209]      </control>
[20:25:33.209]      <control if="!isSWJ" while="" timeout="0" info="">
[20:25:33.209]        // if-block "!isSWJ"
[20:25:33.209]          // =>  FALSE
