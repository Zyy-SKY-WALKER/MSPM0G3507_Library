[19:51:41.728]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:51:41.728]    <block atomic="false" info="">
[19:51:41.728]      __var deviceID = 0;
[19:51:41.728]        // -> [deviceID <= 0x00000000]
[19:51:41.728]      __var version = 0;
[19:51:41.728]        // -> [version <= 0x00000000]
[19:51:41.728]      __var partNum = 0;
[19:51:41.728]        // -> [partNum <= 0x00000000]
[19:51:41.728]      __var manuf = 0;
[19:51:41.728]        // -> [manuf <= 0x00000000]
[19:51:41.728]      __var isMSPM0G1X0X_G3X0X = 0;
[19:51:41.728]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:51:41.728]      __var isProduction = 0;
[19:51:41.728]        // -> [isProduction <= 0x00000000]
[19:51:41.728]      __var continueId = 0;
[19:51:41.728]        // -> [continueId <= 0x00000000]
[19:51:41.728]      deviceID =   Read32(0x41C40004);
[19:51:41.738]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:51:41.738]        // -> [deviceID <= 0x2BB8802F]
[19:51:41.738]      version = deviceID >> 28;
[19:51:41.738]        // -> [version <= 0x00000002]
[19:51:41.738]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:51:41.738]        // -> [partNum <= 0x0000BB88]
[19:51:41.738]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:51:41.738]        // -> [manuf <= 0x00000017]
[19:51:41.738]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:51:41.738]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:51:41.738]      isProduction = (version > 0);
[19:51:41.738]        // -> [isProduction <= 0x00000001]
[19:51:41.738]    </block>
[19:51:41.738]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
