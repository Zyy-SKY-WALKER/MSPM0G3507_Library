[19:45:41.540]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:45:41.540]    <block atomic="false" info="">
[19:45:41.540]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:45:41.540]        // -> [isSWJ <= 0x00000001]
[19:45:41.540]      __var hasDormant = __protocol & 0x00020000;
[19:45:41.540]        // -> [hasDormant <= 0x00000000]
[19:45:41.540]      __var protType   = __protocol & 0x0000FFFF;
[19:45:41.540]        // -> [protType <= 0x00000002]
[19:45:41.540]    </block>
[19:45:41.540]    <control if="protType == 1" while="" timeout="0" info="">
[19:45:41.540]      // if-block "protType == 1"
