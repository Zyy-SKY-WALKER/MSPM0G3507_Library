[19:45:41.662]        // -> [partNum <= 0x0000BB88]
[19:45:41.662]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:45:41.662]        // -> [manuf <= 0x00000017]
[19:45:41.662]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:45:41.662]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:45:41.662]      isProduction = (version > 0);
[19:45:41.662]        // -> [isProduction <= 0x00000001]
