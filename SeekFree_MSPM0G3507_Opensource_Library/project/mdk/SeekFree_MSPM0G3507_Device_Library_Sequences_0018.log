[22:27:27.748]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[22:27:27.748]    <block atomic="false" info="">
[22:27:27.748]      __var SW_DP_ABORT       = 0x0;
[22:27:27.748]        // -> [SW_DP_ABORT <= 0x00000000]
[22:27:27.748]      __var DP_CTRL_STAT      = 0x4;
[22:27:27.748]        // -> [DP_CTRL_STAT <= 0x00000004]
[22:27:27.748]      __var DP_SELECT         = 0x8;
[22:27:27.748]        // -> [DP_SELECT <= 0x00000008]
[22:27:27.748]      __var powered_down      = 0;
[22:27:27.748]        // -> [powered_down <= 0x00000000]
[22:27:27.748]      WriteDP(DP_SELECT, 0x00000000);
[22:27:27.748]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[22:27:27.748]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[22:27:27.753]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[22:27:27.753]        // -> [powered_down <= 0x00000001]
[22:27:27.753]    </block>
[22:27:27.753]    <control if="powered_down" while="" timeout="0" info="">
[22:27:27.753]      // if-block "powered_down"
[22:27:27.753]        // =>  TRUE
[22:27:27.753]      <block atomic="false" info="">
[22:27:27.753]        Message(0, "Debug/System power-up request sent");
[22:27:27.753]        WriteDP(DP_CTRL_STAT, 0x50000000);
[22:27:27.758]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[22:27:27.758]      </block>
[22:27:27.758]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[22:27:27.758]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[22:27:27.758]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[22:27:27.758]        // while-condition  =>  FALSE
[22:27:27.758]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[22:27:27.758]      </control>
