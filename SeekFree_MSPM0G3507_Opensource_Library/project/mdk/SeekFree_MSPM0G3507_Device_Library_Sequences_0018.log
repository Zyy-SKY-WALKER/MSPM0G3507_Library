[22:27:27.743]    // Pre-defined
[22:27:27.748]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[22:27:27.748]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
