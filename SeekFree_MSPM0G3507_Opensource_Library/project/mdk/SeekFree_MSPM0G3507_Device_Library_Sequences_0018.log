[22:27:27.758]        // skip if-block "(__protocol & 0xFFFF) == 1"
[22:27:27.758]      </control>
[22:27:27.758]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[22:27:27.758]        // if-block "(__protocol & 0xFFFF) == 2"
[22:27:27.758]          // =>  TRUE
[22:27:27.758]        <block atomic="false" info="">
[22:27:27.758]          Message(0, "executing SWD power up");
[22:27:27.763]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[22:27:27.763]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[22:27:27.763]          WriteDP(SW_DP_ABORT, 0x0000001E);
[22:27:27.768]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[22:27:27.768]        </block>
[22:27:27.768]        // end if-block "(__protocol & 0xFFFF) == 2"
[22:27:27.768]      </control>
[22:27:27.768]      // end if-block "powered_down"
