[19:47:47.411]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:47:47.411]    <block atomic="false" info="">
[19:47:47.411]      __var deviceID = 0;
[19:47:47.411]        // -> [deviceID <= 0x00000000]
[19:47:47.411]      __var version = 0;
[19:47:47.411]        // -> [version <= 0x00000000]
[19:47:47.411]      __var partNum = 0;
[19:47:47.411]        // -> [partNum <= 0x00000000]
[19:47:47.411]      __var manuf = 0;
[19:47:47.411]        // -> [manuf <= 0x00000000]
[19:47:47.411]      __var isMSPM0G1X0X_G3X0X = 0;
[19:47:47.411]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:47:47.411]      __var isProduction = 0;
[19:47:47.411]        // -> [isProduction <= 0x00000000]
[19:47:47.411]      __var continueId = 0;
[19:47:47.411]        // -> [continueId <= 0x00000000]
[19:47:47.411]      deviceID =   Read32(0x41C40004);
[19:47:47.421]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:47:47.421]        // -> [deviceID <= 0x2BB8802F]
[19:47:47.421]      version = deviceID >> 28;
[19:47:47.421]        // -> [version <= 0x00000002]
[19:47:47.421]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:47:47.421]        // -> [partNum <= 0x0000BB88]
[19:47:47.421]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:47:47.421]        // -> [manuf <= 0x00000017]
[19:47:47.421]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:47:47.421]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:47:47.421]      isProduction = (version > 0);
[19:47:47.421]        // -> [isProduction <= 0x00000001]
