[15:47:57.248]          // if-block "!hasDormant"
[15:47:57.248]            // =>  TRUE
[15:47:57.248]          <block atomic="false" info="">
[15:47:57.248]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:47:57.248]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:47:57.248]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:47:57.259]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:47:57.259]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
