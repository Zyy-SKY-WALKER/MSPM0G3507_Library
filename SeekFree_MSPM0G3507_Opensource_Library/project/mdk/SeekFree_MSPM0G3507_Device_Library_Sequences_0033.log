[17:32:49.996]        // -> [partNum <= 0x00000000]
[17:32:49.996]      __var manuf = 0;
[17:32:49.996]        // -> [manuf <= 0x00000000]
[17:32:49.996]      __var isMSPM0G1X0X_G3X0X = 0;
[17:32:49.996]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:32:49.996]      __var isProduction = 0;
[17:32:49.996]        // -> [isProduction <= 0x00000000]
[17:32:49.996]      __var continueId = 0;
[17:32:49.996]        // -> [continueId <= 0x00000000]
[17:32:49.996]      deviceID =   Read32(0x41C40004);
[17:32:49.996]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[17:32:49.996]        // -> [deviceID <= 0x2BB8802F]
[17:32:49.996]      version = deviceID >> 28;
[17:32:49.996]        // -> [version <= 0x00000002]
[17:32:49.996]      partNum = (deviceID & 0x0FFFF000) >> 12;
[17:32:49.996]        // -> [partNum <= 0x0000BB88]
[17:32:49.996]      manuf = (deviceID & 0x00000FFE) >> 1;
[17:32:49.996]        // -> [manuf <= 0x00000017]
[17:32:49.996]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:32:49.996]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:32:49.996]      isProduction = (version > 0);
[17:32:49.996]        // -> [isProduction <= 0x00000001]
[17:32:49.996]    </block>
[17:32:49.996]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
