[17:27:00.969]        // -> [__ap <= 0x00000001]
[17:27:00.969]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[17:27:00.973]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[17:27:00.973]      __ap = 4;
[17:27:00.973]        // -> [__ap <= 0x00000004]
[17:27:00.973]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[17:27:00.977]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[17:27:00.978]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[17:27:00.978]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[17:27:00.978]    </block>
[17:27:00.978]    <block atomic="false" info="">
[17:27:00.978]      __var nReset = 0x80;
