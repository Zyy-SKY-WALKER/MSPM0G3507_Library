[17:44:42.573]      __var isProduction = 0;
[17:44:42.573]        // -> [isProduction <= 0x00000000]
[17:44:42.573]      __var continueId = 0;
[17:44:42.573]        // -> [continueId <= 0x00000000]
[17:44:42.573]      deviceID =   Read32(0x41C40004);
