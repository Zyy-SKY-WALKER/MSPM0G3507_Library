[17:27:00.992]    </control>
[17:27:00.992]    <block atomic="false" info="">
[17:27:00.992]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[17:27:00.997]        // -> [ReadAP(0x00000000) => 0x0079002F]   (__dp=0x00000000, __ap=0x00000004)
[17:27:00.997]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[17:27:00.997]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[17:27:00.998]      __ap = 0; //lets make sure we reset the access point selection
