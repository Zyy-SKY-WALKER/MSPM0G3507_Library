[17:27:00.964]        <block atomic="false" info="">
[17:27:00.964]          Message(0, "executing SWD power up");
[17:27:00.966]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[17:27:00.967]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[17:27:00.968]          WriteDP(SW_DP_ABORT, 0x0000001E);
[17:27:00.969]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[17:27:00.969]        </block>
[17:27:00.969]        // end if-block "(__protocol & 0xFFFF) == 2"
[17:27:00.969]      </control>
[17:27:00.969]      // end if-block "powered_down"
[17:27:00.969]    </control>
[17:27:00.969]    <block atomic="false" info="">
[17:27:00.969]      __var DEBUG_PORT_VAL    = 0;
[17:27:00.969]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[17:27:00.969]      __var ACCESS_POINT_VAL  = 0;
[17:27:00.969]        // -> [ACCESS_POINT_VAL <= 0x00000000]
