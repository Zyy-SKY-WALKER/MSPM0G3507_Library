[17:27:00.932]      // skip if-block "protType == 1"
[17:27:00.932]    </control>
[17:27:00.932]    <control if="protType == 2" while="" timeout="0" info="">
[17:27:00.932]      // if-block "protType == 2"
[17:27:00.932]        // =>  TRUE
[17:27:00.932]      <control if="isSWJ" while="" timeout="0" info="">
[17:27:00.932]        // if-block "isSWJ"
[17:27:00.932]          // =>  TRUE
[17:27:00.932]        <control if="hasDormant" while="" timeout="0" info="">
[17:27:00.932]          // if-block "hasDormant"
[17:27:00.932]            // =>  FALSE
[17:27:00.932]          // skip if-block "hasDormant"
[17:27:00.932]        </control>
[17:27:00.932]        <control if="!hasDormant" while="" timeout="0" info="">
[17:27:00.932]          // if-block "!hasDormant"
[17:27:00.932]            // =>  TRUE
[17:27:00.932]          <block atomic="false" info="">
[17:27:00.932]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:27:00.932]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:27:00.932]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:27:00.938]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:27:00.938]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:27:00.939]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:27:00.939]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[17:27:00.941]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[17:27:00.941]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[17:27:00.943]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:27:00.943]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[17:27:00.945]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[17:27:00.945]          </block>
[17:27:00.945]          // end if-block "!hasDormant"
[17:27:00.945]        </control>
[17:27:00.945]        // end if-block "isSWJ"
[17:27:00.945]      </control>
[17:27:00.945]      <control if="!isSWJ" while="" timeout="0" info="">
[17:27:00.946]        // if-block "!isSWJ"
[17:27:00.946]          // =>  FALSE
[17:27:00.946]        // skip if-block "!isSWJ"
[17:27:00.946]      </control>
[17:27:00.946]      <block atomic="false" info="">
[17:27:00.946]        ReadDP(0x0);
[17:27:00.947]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[17:27:00.947]      </block>
[17:27:00.948]      // end if-block "protType == 2"
[17:27:00.948]    </control>
[17:27:00.948]  </sequence>
