[17:27:00.978]        // -> [canReadPins <= 0x00000001]
[17:27:00.978]    </block>
[17:27:00.978]    <control if="" while="1" timeout="200" info="">
[17:27:00.978]      // while "1"  (timeout="200")
[17:27:00.978]      // while-condition  =>  TRUE
[17:27:00.978]      // while "1"  (timeout="200")
[17:27:00.978]      // while-condition  =>  TRUE
[17:27:00.978]      // while "1"  (timeout="200")
[17:27:00.978]      // while-condition  =>  TRUE
[17:27:00.978]      // while "1"  (timeout="200")
