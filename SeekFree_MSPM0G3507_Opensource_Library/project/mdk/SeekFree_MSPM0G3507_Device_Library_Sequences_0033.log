[15:47:57.295]          // =>  FALSE
[15:47:57.295]        // skip if-block "(__protocol & 0xFFFF) == 1"
[15:47:57.295]      </control>
[15:47:57.295]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[15:47:57.295]        // if-block "(__protocol & 0xFFFF) == 2"
[15:47:57.295]          // =>  TRUE
[15:47:57.295]        <block atomic="false" info="">
[15:47:57.295]          Message(0, "executing SWD power up");
[15:47:57.295]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:47:57.300]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[15:47:57.300]          WriteDP(SW_DP_ABORT, 0x0000001E);
[15:47:57.300]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[15:47:57.300]        </block>
[15:47:57.300]        // end if-block "(__protocol & 0xFFFF) == 2"
[15:47:57.300]      </control>
