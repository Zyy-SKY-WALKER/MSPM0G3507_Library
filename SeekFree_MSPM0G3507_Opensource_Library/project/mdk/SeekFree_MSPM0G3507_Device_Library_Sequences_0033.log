[18:05:19.504]    </control>
[18:05:19.504]    <control if="protType == 2" while="" timeout="0" info="">
[18:05:19.504]      // if-block "protType == 2"
[18:05:19.504]        // =>  TRUE
[18:05:19.504]      <control if="isSWJ" while="" timeout="0" info="">
[18:05:19.504]        // if-block "isSWJ"
[18:05:19.504]          // =>  TRUE
