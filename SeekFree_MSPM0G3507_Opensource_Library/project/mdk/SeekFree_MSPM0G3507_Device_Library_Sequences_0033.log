[15:47:57.279]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[15:47:57.279]    <block atomic="false" info="">
[15:47:57.279]      __var SW_DP_ABORT       = 0x0;
[15:47:57.279]        // -> [SW_DP_ABORT <= 0x00000000]
[15:47:57.279]      __var DP_CTRL_STAT      = 0x4;
[15:47:57.279]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:47:57.279]      __var DP_SELECT         = 0x8;
[15:47:57.279]        // -> [DP_SELECT <= 0x00000008]
[15:47:57.279]      __var powered_down      = 0;
[15:47:57.279]        // -> [powered_down <= 0x00000000]
[15:47:57.279]      WriteDP(DP_SELECT, 0x00000000);
[15:47:57.284]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:47:57.284]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[15:47:57.290]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[15:47:57.290]        // -> [powered_down <= 0x00000001]
[15:47:57.290]    </block>
