[17:27:00.982]        // =>  TRUE
[17:27:00.982]      <block atomic="false" info="">
[17:27:00.982]        WriteAP(0x00, 0x190008);
[17:27:00.987]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[17:27:00.988]        WriteAP(0xF0, 0x01);
