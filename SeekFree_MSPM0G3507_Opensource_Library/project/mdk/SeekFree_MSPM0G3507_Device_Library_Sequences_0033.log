[17:43:49.437]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[17:43:49.437]        // -> [powered_down <= 0x00000001]
[17:43:49.438]    </block>
[17:43:49.438]    <control if="powered_down" while="" timeout="0" info="">
[17:43:49.438]      // if-block "powered_down"
[17:43:49.438]        // =>  TRUE
[17:43:49.438]      <block atomic="false" info="">
[17:43:49.438]        Message(0, "Debug/System power-up request sent");
[17:43:49.439]        WriteDP(DP_CTRL_STAT, 0x50000000);
