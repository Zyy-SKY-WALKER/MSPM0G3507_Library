[18:05:19.504]          // if-block "hasDormant"
[18:05:19.504]            // =>  FALSE
[18:05:19.504]          // skip if-block "hasDormant"
[18:05:19.504]        </control>
[18:05:19.504]        <control if="!hasDormant" while="" timeout="0" info="">
[18:05:19.509]          // if-block "!hasDormant"
[18:05:19.509]            // =>  TRUE
[18:05:19.509]          <block atomic="false" info="">
[18:05:19.509]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:05:19.511]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:05:19.511]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:05:19.512]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:05:19.512]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:05:19.515]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:05:19.515]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[18:05:19.517]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[18:05:19.517]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:05:19.520]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:05:19.520]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:05:19.522]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:05:19.523]          </block>
[18:05:19.523]          // end if-block "!hasDormant"
[18:05:19.523]        </control>
[18:05:19.523]        // end if-block "isSWJ"
[18:05:19.523]      </control>
