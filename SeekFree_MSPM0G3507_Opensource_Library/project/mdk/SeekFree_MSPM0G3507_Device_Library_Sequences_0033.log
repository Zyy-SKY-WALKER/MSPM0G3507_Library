[17:27:00.950]      __var powered_down      = 0;
[17:27:00.950]        // -> [powered_down <= 0x00000000]
[17:27:00.950]      WriteDP(DP_SELECT, 0x00000000);
[17:27:00.950]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[17:27:00.950]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[17:27:00.957]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[17:27:00.957]        // -> [powered_down <= 0x00000001]
[17:27:00.957]    </block>
[17:27:00.957]    <control if="powered_down" while="" timeout="0" info="">
[17:27:00.957]      // if-block "powered_down"
[17:27:00.957]        // =>  TRUE
[17:27:00.957]      <block atomic="false" info="">
[17:27:00.957]        Message(0, "Debug/System power-up request sent");
[17:27:00.959]        WriteDP(DP_CTRL_STAT, 0x50000000);
[17:27:00.961]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[17:27:00.961]      </block>
[17:27:00.961]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[17:27:00.961]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[17:27:00.963]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[17:27:00.963]        // while-condition  =>  FALSE
[17:27:00.963]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[17:27:00.963]      </control>
[17:27:00.963]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
