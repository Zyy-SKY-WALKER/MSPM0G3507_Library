[17:27:00.982]        // =>  TRUE
[17:27:00.982]      <control if="" while="(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0" timeout="1000000" info="">
[17:27:00.982]        // while "(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0"  (timeout="1000000")
[17:27:00.982]          // -> [DAP_SWJ_Pins(0x80, 0x80, 0) => 0x8F]   (Out: nRESET=1  =>  In: SWCLK/TCK=1, SWDIO/TMS=1, TDI=1, TDO=1, nTRST=0, nRESET=1)
[17:27:00.982]        // while-condition  =>  FALSE
[17:27:00.982]        // end while "(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0"
[17:27:00.982]      </control>
