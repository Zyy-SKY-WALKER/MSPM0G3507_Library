[18:10:57.429]        <control if="!hasDormant" while="" timeout="0" info="">
[18:10:57.429]          // if-block "!hasDormant"
[18:10:57.429]            // =>  TRUE
[18:10:57.429]          <block atomic="false" info="">
[18:10:57.429]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:10:57.432]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:10:57.432]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:10:57.434]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:10:57.434]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
