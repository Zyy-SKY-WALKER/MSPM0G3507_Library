[17:44:42.573]        // -> [partNum <= 0x00000000]
[17:44:42.573]      __var manuf = 0;
[17:44:42.573]        // -> [manuf <= 0x00000000]
[17:44:42.573]      __var isMSPM0G1X0X_G3X0X = 0;
