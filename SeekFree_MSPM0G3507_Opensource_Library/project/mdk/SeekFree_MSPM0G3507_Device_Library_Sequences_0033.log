[17:43:49.445]      </control>
[17:43:49.445]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[17:43:49.446]        // if-block "(__protocol & 0xFFFF) == 2"
[17:43:49.446]          // =>  TRUE
[17:43:49.446]        <block atomic="false" info="">
[17:43:49.446]          Message(0, "executing SWD power up");
[17:43:49.447]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[17:43:49.449]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[17:43:49.449]          WriteDP(SW_DP_ABORT, 0x0000001E);
