[15:47:57.290]      <block atomic="false" info="">
[15:47:57.290]        Message(0, "Debug/System power-up request sent");
[15:47:57.290]        WriteDP(DP_CTRL_STAT, 0x50000000);
[15:47:57.290]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[15:47:57.290]      </block>
[15:47:57.290]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[15:47:57.290]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[15:47:57.295]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[15:47:57.295]        // while-condition  =>  FALSE
[15:47:57.295]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[15:47:57.295]      </control>
[15:47:57.295]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
