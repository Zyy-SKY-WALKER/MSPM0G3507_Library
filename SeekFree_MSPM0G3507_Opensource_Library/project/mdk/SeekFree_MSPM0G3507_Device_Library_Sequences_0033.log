[18:05:19.504]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[18:05:19.504]    <block atomic="false" info="">
[18:05:19.504]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[18:05:19.504]        // -> [isSWJ <= 0x00000001]
[18:05:19.504]      __var hasDormant = __protocol & 0x00020000;
[18:05:19.504]        // -> [hasDormant <= 0x00000000]
