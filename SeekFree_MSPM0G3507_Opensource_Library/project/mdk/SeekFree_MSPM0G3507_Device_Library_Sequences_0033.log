[17:44:42.581]        // -> [manuf <= 0x00000017]
[17:44:42.581]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:44:42.581]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:44:42.581]      isProduction = (version > 0);
