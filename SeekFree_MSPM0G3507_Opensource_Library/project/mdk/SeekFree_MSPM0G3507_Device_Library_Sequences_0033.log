[17:27:00.932]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[17:27:00.932]    <block atomic="false" info="">
[17:27:00.932]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[17:27:00.932]        // -> [isSWJ <= 0x00000001]
[17:27:00.932]      __var hasDormant = __protocol & 0x00020000;
[17:27:00.932]        // -> [hasDormant <= 0x00000000]
