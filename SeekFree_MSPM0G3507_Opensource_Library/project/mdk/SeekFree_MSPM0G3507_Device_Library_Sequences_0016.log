[21:48:58.640]            // =>  TRUE
[21:48:58.640]          <block atomic="false" info="">
[21:48:58.640]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
