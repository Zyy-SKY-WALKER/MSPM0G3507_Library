[12:49:47.677]        // -> [partNum <= 0x00000000]
[12:49:47.677]      __var manuf = 0;
[12:49:47.677]        // -> [manuf <= 0x00000000]
[12:49:47.677]      __var isMSPM0G1X0X_G3X0X = 0;
[12:49:47.677]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[12:49:47.677]      __var isProduction = 0;
[12:49:47.677]        // -> [isProduction <= 0x00000000]
[12:49:47.677]      __var continueId = 0;
[12:49:47.677]        // -> [continueId <= 0x00000000]
[12:49:47.677]      deviceID =   Read32(0x41C40004);
[12:49:47.699]        // -> [Read32(0x41C40004) => 0x00000000]   (__dp=0x00000000, __ap=0x00000000)
[12:49:47.700]        // -> [deviceID <= 0x00000000]
[12:49:47.700]      version = deviceID >> 28;
[12:49:47.700]        // -> [version <= 0x00000000]
[12:49:47.700]      partNum = (deviceID & 0x0FFFF000) >> 12;
[12:49:47.700]        // -> [partNum <= 0x00000000]
