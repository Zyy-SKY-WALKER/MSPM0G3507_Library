[12:49:47.700]        // -> [manuf <= 0x00000000]
[12:49:47.700]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[12:49:47.700]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[12:49:47.700]      isProduction = (version > 0);
[12:49:47.700]        // -> [isProduction <= 0x00000000]
