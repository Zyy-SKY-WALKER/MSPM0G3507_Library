[19:34:19.908]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:34:19.908]    <block atomic="false" info="">
[19:34:19.908]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:34:19.908]        // -> [isSWJ <= 0x00000001]
[19:34:19.908]      __var hasDormant = __protocol & 0x00020000;
