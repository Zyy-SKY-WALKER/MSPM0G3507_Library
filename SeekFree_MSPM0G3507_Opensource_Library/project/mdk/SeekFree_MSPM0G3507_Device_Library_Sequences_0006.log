[19:41:26.252]        // -> [SW_DP_ABORT <= 0x00000000]
[19:41:26.252]      __var DP_CTRL_STAT      = 0x4;
[19:41:26.252]        // -> [DP_CTRL_STAT <= 0x00000004]
[19:41:26.252]      __var DP_SELECT         = 0x8;
[19:41:26.252]        // -> [DP_SELECT <= 0x00000008]
[19:41:26.252]      __var powered_down      = 0;
