[19:34:42.972]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:34:42.972]    <block atomic="false" info="">
[19:34:42.972]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:34:42.972]        // -> [isSWJ <= 0x00000001]
[19:34:42.972]      __var hasDormant = __protocol & 0x00020000;
[19:34:42.972]        // -> [hasDormant <= 0x00000000]
[19:34:42.972]      __var protType   = __protocol & 0x0000FFFF;
[19:34:42.972]        // -> [protType <= 0x00000002]
[19:34:42.972]    </block>
[19:34:42.972]    <control if="protType == 1" while="" timeout="0" info="">
[19:34:42.972]      // if-block "protType == 1"
[19:34:42.972]        // =>  FALSE
[19:34:42.972]      // skip if-block "protType == 1"
[19:34:42.972]    </control>
[19:34:42.972]    <control if="protType == 2" while="" timeout="0" info="">
[19:34:42.972]      // if-block "protType == 2"
[19:34:42.972]        // =>  TRUE
[19:34:42.972]      <control if="isSWJ" while="" timeout="0" info="">
[19:34:42.972]        // if-block "isSWJ"
[19:34:42.972]          // =>  TRUE
[19:34:42.972]        <control if="hasDormant" while="" timeout="0" info="">
[19:34:42.972]          // if-block "hasDormant"
[19:34:42.972]            // =>  FALSE
[19:34:42.972]          // skip if-block "hasDormant"
[19:34:42.972]        </control>
[19:34:42.972]        <control if="!hasDormant" while="" timeout="0" info="">
[19:34:42.972]          // if-block "!hasDormant"
[19:34:42.972]            // =>  TRUE
[19:34:42.972]          <block atomic="false" info="">
[19:34:42.972]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:34:42.977]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:34:42.977]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:34:42.977]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:34:42.977]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:34:42.977]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:34:42.977]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:34:42.980]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:34:42.980]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:34:42.981]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:34:42.981]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:34:42.981]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:34:42.981]          </block>
[19:34:42.981]          // end if-block "!hasDormant"
[19:34:42.981]        </control>
[19:34:42.982]        // end if-block "isSWJ"
[19:34:42.982]      </control>
[19:34:42.982]      <control if="!isSWJ" while="" timeout="0" info="">
[19:34:42.982]        // if-block "!isSWJ"
[19:34:42.982]          // =>  FALSE
[19:34:42.982]        // skip if-block "!isSWJ"
[19:34:42.982]      </control>
[19:34:42.982]      <block atomic="false" info="">
[19:34:42.982]        ReadDP(0x0);
[19:34:42.983]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[19:34:42.983]      </block>
[19:34:42.983]      // end if-block "protType == 2"
[19:34:42.983]    </control>
[19:34:42.983]  </sequence>
