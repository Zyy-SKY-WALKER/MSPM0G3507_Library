[18:35:00.853]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[18:35:00.853]    <block atomic="false" info="">
[18:35:00.853]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[18:35:00.853]        // -> [isSWJ <= 0x00000001]
[18:35:00.853]      __var hasDormant = __protocol & 0x00020000;
[18:35:00.853]        // -> [hasDormant <= 0x00000000]
[18:35:00.853]      __var protType   = __protocol & 0x0000FFFF;
[18:35:00.853]        // -> [protType <= 0x00000002]
[18:35:00.853]    </block>
[18:35:00.853]    <control if="protType == 1" while="" timeout="0" info="">
[18:35:00.853]      // if-block "protType == 1"
[18:35:00.853]        // =>  FALSE
[18:35:00.854]      // skip if-block "protType == 1"
[18:35:00.854]    </control>
[18:35:00.854]    <control if="protType == 2" while="" timeout="0" info="">
[18:35:00.854]      // if-block "protType == 2"
[18:35:00.854]        // =>  TRUE
[18:35:00.854]      <control if="isSWJ" while="" timeout="0" info="">
[18:35:00.854]        // if-block "isSWJ"
[18:35:00.854]          // =>  TRUE
[18:35:00.854]        <control if="hasDormant" while="" timeout="0" info="">
[18:35:00.854]          // if-block "hasDormant"
[18:35:00.854]            // =>  FALSE
[18:35:00.854]          // skip if-block "hasDormant"
[18:35:00.854]        </control>
[18:35:00.854]        <control if="!hasDormant" while="" timeout="0" info="">
[18:35:00.854]          // if-block "!hasDormant"
[18:35:00.854]            // =>  TRUE
[18:35:00.854]          <block atomic="false" info="">
[18:35:00.854]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:35:00.857]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:35:00.857]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:35:00.860]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:35:00.860]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:35:00.860]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:35:00.860]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[18:35:00.860]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[18:35:00.860]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:35:00.865]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:35:00.865]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:35:00.868]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:35:00.868]          </block>
[18:35:00.868]          // end if-block "!hasDormant"
[18:35:00.868]        </control>
[18:35:00.868]        // end if-block "isSWJ"
[18:35:00.869]      </control>
[18:35:00.869]      <control if="!isSWJ" while="" timeout="0" info="">
[18:35:00.869]        // if-block "!isSWJ"
[18:35:00.869]          // =>  FALSE
[18:35:00.869]        // skip if-block "!isSWJ"
