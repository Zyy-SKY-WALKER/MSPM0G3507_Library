[19:34:19.921]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:34:19.922]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:34:19.923]          </block>
[19:34:19.923]          // end if-block "!hasDormant"
