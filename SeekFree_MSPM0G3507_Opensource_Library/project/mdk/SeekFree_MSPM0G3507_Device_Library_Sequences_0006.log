[19:34:43.036]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:34:43.036]    <block atomic="false" info="">
[19:34:43.036]      __var deviceID = 0;
[19:34:43.036]        // -> [deviceID <= 0x00000000]
[19:34:43.036]      __var version = 0;
[19:34:43.036]        // -> [version <= 0x00000000]
[19:34:43.036]      __var partNum = 0;
[19:34:43.036]        // -> [partNum <= 0x00000000]
[19:34:43.036]      __var manuf = 0;
[19:34:43.036]        // -> [manuf <= 0x00000000]
[19:34:43.036]      __var isMSPM0G1X0X_G3X0X = 0;
[19:34:43.036]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:34:43.036]      __var isProduction = 0;
[19:34:43.036]        // -> [isProduction <= 0x00000000]
[19:34:43.036]      __var continueId = 0;
[19:34:43.036]        // -> [continueId <= 0x00000000]
[19:34:43.036]      deviceID =   Read32(0x41C40004);
[19:34:43.039]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:34:43.039]        // -> [deviceID <= 0x2BB8802F]
[19:34:43.039]      version = deviceID >> 28;
[19:34:43.039]        // -> [version <= 0x00000002]
[19:34:43.039]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:34:43.039]        // -> [partNum <= 0x0000BB88]
[19:34:43.039]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:34:43.039]        // -> [manuf <= 0x00000017]
[19:34:43.039]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:34:43.039]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:34:43.039]      isProduction = (version > 0);
[19:34:43.039]        // -> [isProduction <= 0x00000001]
[19:34:43.039]    </block>
