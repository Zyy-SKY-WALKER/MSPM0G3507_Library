[19:34:42.985]  **********  Sequence "DebugPortStart"  (Context="Connect", Pname="", info="")
[19:34:42.985]  
[19:34:42.985]  <debugvars>
[19:34:42.985]    // Pre-defined
[19:34:42.985]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[19:34:42.985]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
