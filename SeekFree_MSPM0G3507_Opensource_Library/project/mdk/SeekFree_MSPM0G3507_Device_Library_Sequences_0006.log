[19:23:01.563]  **********  Sequence "DebugPortStart"  (Context="Connect", Pname="", info="")
[19:23:01.563]  
[19:23:01.563]  <debugvars>
[19:23:01.563]    // Pre-defined
[19:23:01.563]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[19:23:01.563]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[19:23:01.563]    __dp=0x00000000
[19:23:01.563]    __ap=0x00000000
[19:23:01.563]    __traceout=0x00000000      (Trace Disabled)
[19:23:01.563]    __errorcontrol=0x00000000  (Skip Errors="False")
