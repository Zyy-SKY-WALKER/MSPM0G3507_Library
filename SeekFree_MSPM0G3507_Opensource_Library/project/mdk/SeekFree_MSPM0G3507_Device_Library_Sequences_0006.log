[19:23:01.563]    __FlashLen=0x00000000
[19:23:01.563]    __FlashArg=0x00000000
[19:23:01.563]    __FlashOp=0x00000000
[19:23:01.563]    __Result=0x00000000
[19:23:01.563]  </debugvars>
[19:23:01.563]  
[19:23:01.563]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[19:23:01.563]    <block atomic="false" info="">
[19:23:01.563]      __var SW_DP_ABORT       = 0x0;
[19:23:01.563]        // -> [SW_DP_ABORT <= 0x00000000]
[19:23:01.564]      __var DP_CTRL_STAT      = 0x4;
[19:23:01.564]        // -> [DP_CTRL_STAT <= 0x00000004]
[19:23:01.564]      __var DP_SELECT         = 0x8;
[19:23:01.564]        // -> [DP_SELECT <= 0x00000008]
[19:23:01.564]      __var powered_down      = 0;
[19:23:01.564]        // -> [powered_down <= 0x00000000]
[19:23:01.564]      WriteDP(DP_SELECT, 0x00000000);
[19:23:01.566]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:23:01.566]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:23:01.566]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:23:01.566]        // -> [powered_down <= 0x00000001]
[19:23:01.566]    </block>
[19:23:01.566]    <control if="powered_down" while="" timeout="0" info="">
[19:23:01.566]      // if-block "powered_down"
[19:23:01.566]        // =>  TRUE
[19:23:01.566]      <block atomic="false" info="">
[19:23:01.566]        Message(0, "Debug/System power-up request sent");
[19:23:01.566]        WriteDP(DP_CTRL_STAT, 0x50000000);
[19:23:01.572]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[19:23:01.572]      </block>
[19:23:01.572]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[19:23:01.573]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[19:23:01.575]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[19:23:01.575]        // while-condition  =>  FALSE
[19:23:01.575]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[19:23:01.575]      </control>
[19:23:01.575]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[19:23:01.575]        // if-block "(__protocol & 0xFFFF) == 1"
[19:23:01.575]          // =>  FALSE
[19:23:01.575]        // skip if-block "(__protocol & 0xFFFF) == 1"
[19:23:01.575]      </control>
[19:23:01.576]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[19:23:01.576]        // if-block "(__protocol & 0xFFFF) == 2"
[19:23:01.576]          // =>  TRUE
[19:23:01.576]        <block atomic="false" info="">
[19:23:01.576]          Message(0, "executing SWD power up");
[19:23:01.577]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[19:23:01.581]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[19:23:01.581]          WriteDP(SW_DP_ABORT, 0x0000001E);
[19:23:01.586]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[19:23:01.586]        </block>
[19:23:01.586]        // end if-block "(__protocol & 0xFFFF) == 2"
[19:23:01.586]      </control>
[19:23:01.586]      // end if-block "powered_down"
[19:23:01.586]    </control>
[19:23:01.586]    <block atomic="false" info="">
[19:23:01.586]      __var DEBUG_PORT_VAL    = 0;
[19:23:01.586]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[19:23:01.586]      __var ACCESS_POINT_VAL  = 0;
[19:23:01.586]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[19:23:01.586]      __ap = 1; 
