[19:34:09.475]        <block atomic="false" info="">
[19:34:09.475]          Message(0, "executing SWD power up");
[19:34:09.476]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[19:34:09.479]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[19:34:09.479]          WriteDP(SW_DP_ABORT, 0x0000001E);
[19:34:09.481]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[19:34:09.481]        </block>
[19:34:09.481]        // end if-block "(__protocol & 0xFFFF) == 2"
[19:34:09.481]      </control>
[19:34:09.481]      // end if-block "powered_down"
