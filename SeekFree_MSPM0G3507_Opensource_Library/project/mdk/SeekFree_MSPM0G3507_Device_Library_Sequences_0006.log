[18:05:49.171]  **********  Sequence "DebugPortSetup"  (Context="Connect", Pname="", info="")
[18:05:49.171]  
[18:05:49.171]  <debugvars>
[18:05:49.171]    // Pre-defined
[18:05:49.171]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[18:05:49.171]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[18:05:49.171]    __dp=0x00000000
[18:05:49.171]    __ap=0x00000000
[18:05:49.171]    __traceout=0x00000000      (Trace Disabled)
[18:05:49.171]    __errorcontrol=0x00000000  (Skip Errors="False")
[18:05:49.171]    __FlashAddr=0x00000000
[18:05:49.171]    __FlashLen=0x00000000
[18:05:49.171]    __FlashArg=0x00000000
[18:05:49.171]    __FlashOp=0x00000000
[18:05:49.172]    __Result=0x00000000
[18:05:49.172]  </debugvars>
[18:05:49.172]  
[18:05:49.172]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[18:05:49.172]    <block atomic="false" info="">
[18:05:49.172]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[18:05:49.172]        // -> [isSWJ <= 0x00000001]
[18:05:49.172]      __var hasDormant = __protocol & 0x00020000;
[18:05:49.172]        // -> [hasDormant <= 0x00000000]
[18:05:49.172]      __var protType   = __protocol & 0x0000FFFF;
[18:05:49.172]        // -> [protType <= 0x00000002]
[18:05:49.172]    </block>
[18:05:49.172]    <control if="protType == 1" while="" timeout="0" info="">
[18:05:49.172]      // if-block "protType == 1"
[18:05:49.172]        // =>  FALSE
[18:05:49.172]      // skip if-block "protType == 1"
[18:05:49.172]    </control>
[18:05:49.172]    <control if="protType == 2" while="" timeout="0" info="">
[18:05:49.172]      // if-block "protType == 2"
[18:05:49.172]        // =>  TRUE
[18:05:49.172]      <control if="isSWJ" while="" timeout="0" info="">
[18:05:49.172]        // if-block "isSWJ"
[18:05:49.172]          // =>  TRUE
[18:05:49.172]        <control if="hasDormant" while="" timeout="0" info="">
[18:05:49.173]          // if-block "hasDormant"
[18:05:49.173]            // =>  FALSE
[18:05:49.173]          // skip if-block "hasDormant"
[18:05:49.173]        </control>
[18:05:49.173]        <control if="!hasDormant" while="" timeout="0" info="">
[18:05:49.173]          // if-block "!hasDormant"
[18:05:49.173]            // =>  TRUE
[18:05:49.173]          <block atomic="false" info="">
[18:05:49.173]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:05:49.175]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:05:49.175]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:05:49.177]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:05:49.177]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:05:49.179]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:05:49.179]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[18:05:49.181]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[18:05:49.181]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:05:49.183]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:05:49.183]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:05:49.185]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:05:49.185]          </block>
[18:05:49.185]          // end if-block "!hasDormant"
[18:05:49.186]        </control>
[18:05:49.186]        // end if-block "isSWJ"
[18:05:49.186]      </control>
[18:05:49.186]      <control if="!isSWJ" while="" timeout="0" info="">
[18:05:49.186]        // if-block "!isSWJ"
[18:05:49.186]          // =>  FALSE
[18:05:49.186]        // skip if-block "!isSWJ"
[18:05:49.186]      </control>
[18:05:49.186]      <block atomic="false" info="">
[18:05:49.186]        ReadDP(0x0);
[18:05:49.188]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[18:05:49.188]      </block>
[18:05:49.188]      // end if-block "protType == 2"
[18:05:49.188]    </control>
[18:05:49.188]  </sequence>
[18:05:49.188]  
[18:05:49.192]  **********  Sequence "DebugPortStart"  (Context="Connect", Pname="", info="")
[18:05:49.192]  
[18:05:49.192]  <debugvars>
[18:05:49.192]    // Pre-defined
[18:05:49.192]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[18:05:49.192]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[18:05:49.192]    __dp=0x00000000
[18:05:49.192]    __ap=0x00000000
[18:05:49.192]    __traceout=0x00000000      (Trace Disabled)
[18:05:49.192]    __errorcontrol=0x00000000  (Skip Errors="False")
[18:05:49.192]    __FlashAddr=0x00000000
[18:05:49.192]    __FlashLen=0x00000000
[18:05:49.193]    __FlashArg=0x00000000
[18:05:49.193]    __FlashOp=0x00000000
[18:05:49.193]    __Result=0x00000000
[18:05:49.193]  </debugvars>
[18:05:49.193]  
[18:05:49.193]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[18:05:49.193]    <block atomic="false" info="">
[18:05:49.193]      __var SW_DP_ABORT       = 0x0;
[18:05:49.193]        // -> [SW_DP_ABORT <= 0x00000000]
[18:05:49.193]      __var DP_CTRL_STAT      = 0x4;
[18:05:49.193]        // -> [DP_CTRL_STAT <= 0x00000004]
[18:05:49.193]      __var DP_SELECT         = 0x8;
[18:05:49.193]        // -> [DP_SELECT <= 0x00000008]
[18:05:49.193]      __var powered_down      = 0;
[18:05:49.193]        // -> [powered_down <= 0x00000000]
[18:05:49.193]      WriteDP(DP_SELECT, 0x00000000);
[18:05:49.194]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[18:05:49.194]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[18:05:49.194]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[18:05:49.194]        // -> [powered_down <= 0x00000001]
[18:05:49.194]    </block>
[18:05:49.194]    <control if="powered_down" while="" timeout="0" info="">
[18:05:49.194]      // if-block "powered_down"
[18:05:49.194]        // =>  TRUE
[18:05:49.194]      <block atomic="false" info="">
[18:05:49.194]        Message(0, "Debug/System power-up request sent");
[18:05:49.199]        WriteDP(DP_CTRL_STAT, 0x50000000);
[18:05:49.201]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[18:05:49.201]      </block>
[18:05:49.201]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[18:05:49.201]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[18:05:49.204]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[18:05:49.204]        // while-condition  =>  FALSE
[18:05:49.204]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[18:05:49.204]      </control>
[18:05:49.205]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[18:05:49.205]        // if-block "(__protocol & 0xFFFF) == 1"
[18:05:49.205]          // =>  FALSE
[18:05:49.205]        // skip if-block "(__protocol & 0xFFFF) == 1"
[18:05:49.205]      </control>
[18:05:49.205]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[18:05:49.205]        // if-block "(__protocol & 0xFFFF) == 2"
[18:05:49.205]          // =>  TRUE
[18:05:49.205]        <block atomic="false" info="">
[18:05:49.205]          Message(0, "executing SWD power up");
[18:05:49.206]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[18:05:49.208]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[18:05:49.208]          WriteDP(SW_DP_ABORT, 0x0000001E);
[18:05:49.210]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[18:05:49.210]        </block>
[18:05:49.210]        // end if-block "(__protocol & 0xFFFF) == 2"
[18:05:49.210]      </control>
[18:05:49.210]      // end if-block "powered_down"
[18:05:49.211]    </control>
[18:05:49.211]    <block atomic="false" info="">
[18:05:49.211]      __var DEBUG_PORT_VAL    = 0;
[18:05:49.211]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[18:05:49.211]      __var ACCESS_POINT_VAL  = 0;
[18:05:49.211]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[18:05:49.211]      __ap = 1; 
[18:05:49.211]        // -> [__ap <= 0x00000001]
[18:05:49.211]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[18:05:49.215]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[18:05:49.215]      __ap = 4;
[18:05:49.215]        // -> [__ap <= 0x00000004]
[18:05:49.215]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[18:05:49.219]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[18:05:49.219]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[18:05:49.219]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[18:05:49.220]    </block>
[18:05:49.221]    <block atomic="false" info="">
[18:05:49.221]      __var nReset = 0x80;
[18:05:49.221]        // -> [nReset <= 0x00000080]
[18:05:49.221]      __var canReadPins = 0;
[18:05:49.221]        // -> [canReadPins <= 0x00000000]
[18:05:49.221]      canReadPins = (DAP_SWJ_Pins(0x00, nReset, 0) != 0xFFFFFFFF);
[18:05:49.223]        // -> [DAP_SWJ_Pins(0x00, 0x80, 0) => 0x0F]   (Out: nRESET=0  =>  In: SWCLK/TCK=1, SWDIO/TMS=1, TDI=1, TDO=1, nTRST=0, nRESET=0)
[18:05:49.223]        // -> [canReadPins <= 0x00000001]
[18:05:49.223]    </block>
