[19:23:01.541]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:23:01.541]    <block atomic="false" info="">
[19:23:01.541]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:23:01.541]        // -> [isSWJ <= 0x00000001]
[19:23:01.541]      __var hasDormant = __protocol & 0x00020000;
[19:23:01.541]        // -> [hasDormant <= 0x00000000]
[19:23:01.542]      __var protType   = __protocol & 0x0000FFFF;
[19:23:01.542]        // -> [protType <= 0x00000002]
[19:23:01.542]    </block>
[19:23:01.542]    <control if="protType == 1" while="" timeout="0" info="">
[19:23:01.542]      // if-block "protType == 1"
[19:23:01.542]        // =>  FALSE
[19:23:01.542]      // skip if-block "protType == 1"
[19:23:01.542]    </control>
[19:23:01.542]    <control if="protType == 2" while="" timeout="0" info="">
[19:23:01.542]      // if-block "protType == 2"
[19:23:01.542]        // =>  TRUE
[19:23:01.542]      <control if="isSWJ" while="" timeout="0" info="">
[19:23:01.542]        // if-block "isSWJ"
[19:23:01.542]          // =>  TRUE
[19:23:01.542]        <control if="hasDormant" while="" timeout="0" info="">
[19:23:01.542]          // if-block "hasDormant"
[19:23:01.542]            // =>  FALSE
[19:23:01.542]          // skip if-block "hasDormant"
[19:23:01.542]        </control>
[19:23:01.542]        <control if="!hasDormant" while="" timeout="0" info="">
[19:23:01.542]          // if-block "!hasDormant"
[19:23:01.542]            // =>  TRUE
[19:23:01.542]          <block atomic="false" info="">
[19:23:01.542]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:23:01.545]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:23:01.545]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:23:01.547]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:23:01.548]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:23:01.549]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:23:01.550]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:23:01.551]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:23:01.552]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:23:01.553]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:23:01.554]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:23:01.555]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:23:01.556]          </block>
[19:23:01.556]          // end if-block "!hasDormant"
[19:23:01.556]        </control>
[19:23:01.556]        // end if-block "isSWJ"
[19:23:01.556]      </control>
[19:23:01.556]      <control if="!isSWJ" while="" timeout="0" info="">
[19:23:01.556]        // if-block "!isSWJ"
[19:23:01.556]          // =>  FALSE
[19:23:01.556]        // skip if-block "!isSWJ"
[19:23:01.556]      </control>
[19:23:01.556]      <block atomic="false" info="">
[19:23:01.556]        ReadDP(0x0);
[19:23:01.559]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[19:23:01.559]      </block>
[19:23:01.559]      // end if-block "protType == 2"
[19:23:01.559]    </control>
[19:23:01.559]  </sequence>
