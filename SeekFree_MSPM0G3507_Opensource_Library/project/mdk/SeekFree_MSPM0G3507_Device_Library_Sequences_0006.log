[19:34:09.546]        // -> [partNum <= 0x00000000]
[19:34:09.546]      __var manuf = 0;
[19:34:09.546]        // -> [manuf <= 0x00000000]
[19:34:09.546]      __var isMSPM0G1X0X_G3X0X = 0;
[19:34:09.546]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:34:09.546]      __var isProduction = 0;
[19:34:09.546]        // -> [isProduction <= 0x00000000]
[19:34:09.546]      __var continueId = 0;
[19:34:09.546]        // -> [continueId <= 0x00000000]
[19:34:09.546]      deviceID =   Read32(0x41C40004);
[19:34:09.555]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:34:09.555]        // -> [deviceID <= 0x2BB8802F]
[19:34:09.555]      version = deviceID >> 28;
[19:34:09.555]        // -> [version <= 0x00000002]
[19:34:09.555]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:34:09.555]        // -> [partNum <= 0x0000BB88]
[19:34:09.555]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:34:09.555]        // -> [manuf <= 0x00000017]
[19:34:09.555]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:34:09.555]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:34:09.555]      isProduction = (version > 0);
[19:34:09.555]        // -> [isProduction <= 0x00000001]
