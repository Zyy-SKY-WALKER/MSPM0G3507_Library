[19:34:19.909]        // =>  TRUE
[19:34:19.909]      <control if="isSWJ" while="" timeout="0" info="">
[19:34:19.909]        // if-block "isSWJ"
[19:34:19.909]          // =>  TRUE
[19:34:19.909]        <control if="hasDormant" while="" timeout="0" info="">
[19:34:19.910]          // if-block "hasDormant"
[19:34:19.910]            // =>  FALSE
[19:34:19.910]          // skip if-block "hasDormant"
[19:34:19.910]        </control>
[19:34:19.910]        <control if="!hasDormant" while="" timeout="0" info="">
[19:34:19.910]          // if-block "!hasDormant"
[19:34:19.910]            // =>  TRUE
[19:34:19.910]          <block atomic="false" info="">
[19:34:19.910]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:34:19.912]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:34:19.913]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:34:19.914]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:34:19.914]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:34:19.916]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:34:19.916]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:34:19.918]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:34:19.918]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
