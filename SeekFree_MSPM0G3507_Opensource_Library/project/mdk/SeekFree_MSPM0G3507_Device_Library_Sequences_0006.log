[18:05:49.270]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[18:05:49.270]    <block atomic="false" info="">
[18:05:49.270]      __var deviceID = 0;
[18:05:49.270]        // -> [deviceID <= 0x00000000]
[18:05:49.270]      __var version = 0;
[18:05:49.270]        // -> [version <= 0x00000000]
[18:05:49.270]      __var partNum = 0;
[18:05:49.270]        // -> [partNum <= 0x00000000]
[18:05:49.270]      __var manuf = 0;
[18:05:49.270]        // -> [manuf <= 0x00000000]
[18:05:49.270]      __var isMSPM0G1X0X_G3X0X = 0;
[18:05:49.270]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[18:05:49.270]      __var isProduction = 0;
[18:05:49.270]        // -> [isProduction <= 0x00000000]
[18:05:49.270]      __var continueId = 0;
[18:05:49.270]        // -> [continueId <= 0x00000000]
[18:05:49.270]      deviceID =   Read32(0x41C40004);
[18:05:49.277]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[18:05:49.277]        // -> [deviceID <= 0x2BB8802F]
[18:05:49.277]      version = deviceID >> 28;
[18:05:49.277]        // -> [version <= 0x00000002]
[18:05:49.277]      partNum = (deviceID & 0x0FFFF000) >> 12;
[18:05:49.277]        // -> [partNum <= 0x0000BB88]
[18:05:49.278]      manuf = (deviceID & 0x00000FFE) >> 1;
[18:05:49.278]        // -> [manuf <= 0x00000017]
[18:05:49.278]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[18:05:49.278]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[18:05:49.278]      isProduction = (version > 0);
[18:05:49.278]        // -> [isProduction <= 0x00000001]
[18:05:49.278]    </block>
[18:05:49.278]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[18:05:49.278]      // if-block "!isMSPM0G1X0X_G3X0X"
[18:05:49.278]        // =>  FALSE
[18:05:49.278]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[18:05:49.278]    </control>
[18:05:49.278]    <control if="continueId == 4" while="" timeout="0" info="">
[18:05:49.278]      // if-block "continueId == 4"
[18:05:49.278]        // =>  FALSE
[18:05:49.278]      // skip if-block "continueId == 4"
[18:05:49.278]    </control>
[18:05:49.278]    <control if="!isProduction" while="" timeout="0" info="">
