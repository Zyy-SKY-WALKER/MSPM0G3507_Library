[19:34:42.985]        // -> [SW_DP_ABORT <= 0x00000000]
[19:34:42.985]      __var DP_CTRL_STAT      = 0x4;
[19:34:42.985]        // -> [DP_CTRL_STAT <= 0x00000004]
[19:34:42.985]      __var DP_SELECT         = 0x8;
[19:34:42.985]        // -> [DP_SELECT <= 0x00000008]
[19:34:42.985]      __var powered_down      = 0;
[19:34:42.986]        // -> [powered_down <= 0x00000000]
[19:34:42.988]      WriteDP(DP_SELECT, 0x00000000);
[19:34:42.989]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:34:42.989]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:34:42.990]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:34:42.990]        // -> [powered_down <= 0x00000001]
[19:34:42.990]    </block>
[19:34:42.990]    <control if="powered_down" while="" timeout="0" info="">
[19:34:42.990]      // if-block "powered_down"
[19:34:42.990]        // =>  TRUE
[19:34:42.990]      <block atomic="false" info="">
[19:34:42.990]        Message(0, "Debug/System power-up request sent");
[19:34:42.992]        WriteDP(DP_CTRL_STAT, 0x50000000);
[19:34:42.994]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[19:34:42.994]      </block>
[19:34:42.994]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[19:34:42.994]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[19:34:42.995]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[19:34:42.995]        // while-condition  =>  FALSE
[19:34:42.995]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[19:34:42.995]      </control>
[19:34:42.995]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[19:34:42.995]        // if-block "(__protocol & 0xFFFF) == 1"
[19:34:42.995]          // =>  FALSE
[19:34:42.995]        // skip if-block "(__protocol & 0xFFFF) == 1"
[19:34:42.995]      </control>
[19:34:42.995]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[19:34:42.995]        // if-block "(__protocol & 0xFFFF) == 2"
[19:34:42.995]          // =>  TRUE
[19:34:42.995]        <block atomic="false" info="">
[19:34:42.995]          Message(0, "executing SWD power up");
[19:34:42.997]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[19:34:42.997]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[19:34:42.998]          WriteDP(SW_DP_ABORT, 0x0000001E);
[19:34:42.998]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[19:34:42.998]        </block>
[19:34:42.998]        // end if-block "(__protocol & 0xFFFF) == 2"
[19:34:42.998]      </control>
[19:34:42.998]      // end if-block "powered_down"
[19:34:42.999]    </control>
[19:34:42.999]    <block atomic="false" info="">
[19:34:42.999]      __var DEBUG_PORT_VAL    = 0;
[19:34:42.999]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[19:34:42.999]      __var ACCESS_POINT_VAL  = 0;
[19:34:42.999]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[19:34:42.999]      __ap = 1; 
[19:34:42.999]        // -> [__ap <= 0x00000001]
[19:34:42.999]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[19:34:43.000]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[19:34:43.000]      __ap = 4;
[19:34:43.000]        // -> [__ap <= 0x00000004]
[19:34:43.000]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[19:34:43.002]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[19:34:43.002]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[19:34:43.002]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[19:34:43.003]    </block>
