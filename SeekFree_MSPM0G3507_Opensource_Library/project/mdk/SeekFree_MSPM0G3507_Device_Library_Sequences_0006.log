[19:35:12.728]      __var manuf = 0;
[19:35:12.728]        // -> [manuf <= 0x00000000]
[19:35:12.728]      __var isMSPM0G1X0X_G3X0X = 0;
[19:35:12.728]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:35:12.728]      __var isProduction = 0;
[19:35:12.728]        // -> [isProduction <= 0x00000000]
[19:35:12.728]      __var continueId = 0;
[19:35:12.728]        // -> [continueId <= 0x00000000]
[19:35:12.728]      deviceID =   Read32(0x41C40004);
[19:35:12.736]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:35:12.736]        // -> [deviceID <= 0x2BB8802F]
[19:35:12.736]      version = deviceID >> 28;
[19:35:12.736]        // -> [version <= 0x00000002]
[19:35:12.736]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:35:12.736]        // -> [partNum <= 0x0000BB88]
[19:35:12.736]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:35:12.736]        // -> [manuf <= 0x00000017]
[19:35:12.736]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:35:12.737]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:35:12.737]      isProduction = (version > 0);
[19:35:12.737]        // -> [isProduction <= 0x00000001]
[19:35:12.737]    </block>
[19:35:12.737]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[19:35:12.737]      // if-block "!isMSPM0G1X0X_G3X0X"
[19:35:12.737]        // =>  FALSE
[19:35:12.737]      // skip if-block "!isMSPM0G1X0X_G3X0X"
