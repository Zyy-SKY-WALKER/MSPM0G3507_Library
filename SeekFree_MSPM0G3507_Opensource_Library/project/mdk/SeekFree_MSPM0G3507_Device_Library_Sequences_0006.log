[19:34:09.440]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:34:09.440]    <block atomic="false" info="">
[19:34:09.440]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:34:09.440]        // -> [isSWJ <= 0x00000001]
[19:34:09.440]      __var hasDormant = __protocol & 0x00020000;
[19:34:09.440]        // -> [hasDormant <= 0x00000000]
[19:34:09.440]      __var protType   = __protocol & 0x0000FFFF;
[19:34:09.440]        // -> [protType <= 0x00000002]
[19:34:09.440]    </block>
[19:34:09.440]    <control if="protType == 1" while="" timeout="0" info="">
[19:34:09.440]      // if-block "protType == 1"
[19:34:09.440]        // =>  FALSE
[19:34:09.440]      // skip if-block "protType == 1"
[19:34:09.440]    </control>
[19:34:09.440]    <control if="protType == 2" while="" timeout="0" info="">
[19:34:09.440]      // if-block "protType == 2"
[19:34:09.440]        // =>  TRUE
[19:34:09.440]      <control if="isSWJ" while="" timeout="0" info="">
[19:34:09.440]        // if-block "isSWJ"
[19:34:09.440]          // =>  TRUE
[19:34:09.440]        <control if="hasDormant" while="" timeout="0" info="">
[19:34:09.440]          // if-block "hasDormant"
[19:34:09.440]            // =>  FALSE
[19:34:09.440]          // skip if-block "hasDormant"
[19:34:09.440]        </control>
[19:34:09.440]        <control if="!hasDormant" while="" timeout="0" info="">
[19:34:09.440]          // if-block "!hasDormant"
[19:34:09.440]            // =>  TRUE
[19:34:09.440]          <block atomic="false" info="">
[19:34:09.440]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:34:09.444]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:34:09.444]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:34:09.446]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:34:09.446]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:34:09.448]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:34:09.448]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:34:09.450]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:34:09.450]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:34:09.452]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:34:09.452]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:34:09.454]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:34:09.454]          </block>
[19:34:09.454]          // end if-block "!hasDormant"
[19:34:09.454]        </control>
[19:34:09.455]        // end if-block "isSWJ"
[19:34:09.455]      </control>
[19:34:09.455]      <control if="!isSWJ" while="" timeout="0" info="">
[19:34:09.455]        // if-block "!isSWJ"
[19:34:09.455]          // =>  FALSE
[19:34:09.455]        // skip if-block "!isSWJ"
[19:34:09.455]      </control>
[19:34:09.455]      <block atomic="false" info="">
[19:34:09.455]        ReadDP(0x0);
[19:34:09.458]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[19:34:09.458]      </block>
[19:34:09.458]      // end if-block "protType == 2"
[19:34:09.458]    </control>
