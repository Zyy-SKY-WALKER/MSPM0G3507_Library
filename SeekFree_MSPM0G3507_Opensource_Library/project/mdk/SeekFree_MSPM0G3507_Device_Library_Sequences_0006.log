[19:23:01.540]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[19:23:01.540]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[19:23:01.540]    __dp=0x00000000
