[19:41:26.229]  
[19:41:26.229]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:41:26.229]    <block atomic="false" info="">
[19:41:26.229]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:41:26.229]        // -> [isSWJ <= 0x00000001]
[19:41:26.229]      __var hasDormant = __protocol & 0x00020000;
[19:41:26.229]        // -> [hasDormant <= 0x00000000]
[19:41:26.229]      __var protType   = __protocol & 0x0000FFFF;
[19:41:26.229]        // -> [protType <= 0x00000002]
[19:41:26.229]    </block>
[19:41:26.229]    <control if="protType == 1" while="" timeout="0" info="">
[19:41:26.229]      // if-block "protType == 1"
[19:41:26.229]        // =>  FALSE
[19:41:26.229]      // skip if-block "protType == 1"
[19:41:26.229]    </control>
[19:41:26.229]    <control if="protType == 2" while="" timeout="0" info="">
[19:41:26.229]      // if-block "protType == 2"
[19:41:26.230]        // =>  TRUE
[19:41:26.230]      <control if="isSWJ" while="" timeout="0" info="">
[19:41:26.230]        // if-block "isSWJ"
[19:41:26.230]          // =>  TRUE
[19:41:26.230]        <control if="hasDormant" while="" timeout="0" info="">
[19:41:26.230]          // if-block "hasDormant"
[19:41:26.230]            // =>  FALSE
[19:41:26.230]          // skip if-block "hasDormant"
[19:41:26.230]        </control>
[19:41:26.230]        <control if="!hasDormant" while="" timeout="0" info="">
[19:41:26.230]          // if-block "!hasDormant"
[19:41:26.230]            // =>  TRUE
[19:41:26.230]          <block atomic="false" info="">
[19:41:26.230]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:41:26.232]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:41:26.232]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:41:26.234]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:41:26.234]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:41:26.236]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:41:26.236]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:41:26.238]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:41:26.238]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:41:26.241]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:41:26.241]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:41:26.243]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:41:26.243]          </block>
[19:41:26.243]          // end if-block "!hasDormant"
[19:41:26.243]        </control>
[19:41:26.245]        // end if-block "isSWJ"
[19:41:26.245]      </control>
[19:41:26.245]      <control if="!isSWJ" while="" timeout="0" info="">
[19:41:26.245]        // if-block "!isSWJ"
[19:41:26.245]          // =>  FALSE
[19:41:26.245]        // skip if-block "!isSWJ"
[19:41:26.245]      </control>
