[19:41:26.265]        <block atomic="false" info="">
[19:41:26.265]          Message(0, "executing SWD power up");
[19:41:26.266]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[19:41:26.269]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[19:41:26.269]          WriteDP(SW_DP_ABORT, 0x0000001E);
[19:41:26.271]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[19:41:26.272]        </block>
[19:41:26.272]        // end if-block "(__protocol & 0xFFFF) == 2"
[19:41:26.272]      </control>
[19:41:26.272]      // end if-block "powered_down"
[19:41:26.272]    </control>
[19:41:26.272]    <block atomic="false" info="">
