[18:35:00.960]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[18:35:00.960]    <block atomic="false" info="">
[18:35:00.960]      __var deviceID = 0;
[18:35:00.960]        // -> [deviceID <= 0x00000000]
[18:35:00.960]      __var version = 0;
[18:35:00.960]        // -> [version <= 0x00000000]
[18:35:00.960]      __var partNum = 0;
[18:35:00.960]        // -> [partNum <= 0x00000000]
[18:35:00.960]      __var manuf = 0;
[18:35:00.960]        // -> [manuf <= 0x00000000]
[18:35:00.960]      __var isMSPM0G1X0X_G3X0X = 0;
[18:35:00.960]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[18:35:00.960]      __var isProduction = 0;
[18:35:00.960]        // -> [isProduction <= 0x00000000]
[18:35:00.960]      __var continueId = 0;
[18:35:00.960]        // -> [continueId <= 0x00000000]
[18:35:00.960]      deviceID =   Read32(0x41C40004);
[18:35:00.972]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[18:35:00.972]        // -> [deviceID <= 0x2BB8802F]
[18:35:00.972]      version = deviceID >> 28;
[18:35:00.972]        // -> [version <= 0x00000002]
[18:35:00.972]      partNum = (deviceID & 0x0FFFF000) >> 12;
[18:35:00.972]        // -> [partNum <= 0x0000BB88]
[18:35:00.972]      manuf = (deviceID & 0x00000FFE) >> 1;
[18:35:00.973]        // -> [manuf <= 0x00000017]
[18:35:00.973]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[18:35:00.973]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[18:35:00.973]      isProduction = (version > 0);
[18:35:00.973]        // -> [isProduction <= 0x00000001]
[18:35:00.973]    </block>
[18:35:00.973]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[18:35:00.973]      // if-block "!isMSPM0G1X0X_G3X0X"
[18:35:00.973]        // =>  FALSE
[18:35:00.973]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[18:35:00.973]    </control>
[18:35:00.973]    <control if="continueId == 4" while="" timeout="0" info="">
[18:35:00.973]      // if-block "continueId == 4"
[18:35:00.973]        // =>  FALSE
[18:35:00.973]      // skip if-block "continueId == 4"
[18:35:00.973]    </control>
[18:35:00.973]    <control if="!isProduction" while="" timeout="0" info="">
