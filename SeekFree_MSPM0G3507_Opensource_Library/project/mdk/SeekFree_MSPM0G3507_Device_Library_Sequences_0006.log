[19:35:23.870]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:35:23.871]    <block atomic="false" info="">
[19:35:23.871]      __var deviceID = 0;
[19:35:23.871]        // -> [deviceID <= 0x00000000]
[19:35:23.871]      __var version = 0;
[19:35:23.871]        // -> [version <= 0x00000000]
[19:35:23.871]      __var partNum = 0;
[19:35:23.871]        // -> [partNum <= 0x00000000]
[19:35:23.871]      __var manuf = 0;
[19:35:23.871]        // -> [manuf <= 0x00000000]
[19:35:23.871]      __var isMSPM0G1X0X_G3X0X = 0;
[19:35:23.871]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:35:23.871]      __var isProduction = 0;
[19:35:23.871]        // -> [isProduction <= 0x00000000]
[19:35:23.871]      __var continueId = 0;
[19:35:23.871]        // -> [continueId <= 0x00000000]
[19:35:23.871]      deviceID =   Read32(0x41C40004);
[19:35:23.879]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:35:23.880]        // -> [deviceID <= 0x2BB8802F]
[19:35:23.880]      version = deviceID >> 28;
[19:35:23.880]        // -> [version <= 0x00000002]
[19:35:23.880]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:35:23.880]        // -> [partNum <= 0x0000BB88]
[19:35:23.880]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:35:23.880]        // -> [manuf <= 0x00000017]
[19:35:23.880]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:35:23.880]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:35:23.880]      isProduction = (version > 0);
[19:35:23.880]        // -> [isProduction <= 0x00000001]
[19:35:23.880]    </block>
[19:35:23.880]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[19:35:23.881]      // if-block "!isMSPM0G1X0X_G3X0X"
[19:35:23.881]        // =>  FALSE
[19:35:23.881]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[19:35:23.881]    </control>
