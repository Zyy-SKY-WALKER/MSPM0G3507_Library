[19:35:23.765]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:35:23.765]    <block atomic="false" info="">
[19:35:23.765]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:35:23.765]        // -> [isSWJ <= 0x00000001]
[19:35:23.765]      __var hasDormant = __protocol & 0x00020000;
[19:35:23.765]        // -> [hasDormant <= 0x00000000]
[19:35:23.765]      __var protType   = __protocol & 0x0000FFFF;
[19:35:23.765]        // -> [protType <= 0x00000002]
[19:35:23.767]    </block>
[19:35:23.767]    <control if="protType == 1" while="" timeout="0" info="">
