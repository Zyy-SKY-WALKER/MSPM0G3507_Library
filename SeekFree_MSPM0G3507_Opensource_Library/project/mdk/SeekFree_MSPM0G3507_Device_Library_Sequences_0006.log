[19:34:19.930]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[19:34:19.930]    <block atomic="false" info="">
[19:34:19.930]      __var SW_DP_ABORT       = 0x0;
[19:34:19.930]        // -> [SW_DP_ABORT <= 0x00000000]
[19:34:19.930]      __var DP_CTRL_STAT      = 0x4;
[19:34:19.930]        // -> [DP_CTRL_STAT <= 0x00000004]
[19:34:19.930]      __var DP_SELECT         = 0x8;
[19:34:19.931]        // -> [DP_SELECT <= 0x00000008]
[19:34:19.931]      __var powered_down      = 0;
[19:34:19.931]        // -> [powered_down <= 0x00000000]
[19:34:19.931]      WriteDP(DP_SELECT, 0x00000000);
[19:34:19.932]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:34:19.932]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:34:19.934]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:34:19.934]        // -> [powered_down <= 0x00000001]
