[19:34:46.742]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:34:46.746]    <block atomic="false" info="">
[19:34:46.746]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:34:46.746]        // -> [isSWJ <= 0x00000001]
[19:34:46.746]      __var hasDormant = __protocol & 0x00020000;
[19:34:46.746]        // -> [hasDormant <= 0x00000000]
[19:34:46.746]      __var protType   = __protocol & 0x0000FFFF;
[19:34:46.746]        // -> [protType <= 0x00000002]
[19:34:46.746]    </block>
[19:34:46.746]    <control if="protType == 1" while="" timeout="0" info="">
[19:34:46.746]      // if-block "protType == 1"
[19:34:46.746]        // =>  FALSE
[19:34:46.746]      // skip if-block "protType == 1"
[19:34:46.746]    </control>
[19:34:46.746]    <control if="protType == 2" while="" timeout="0" info="">
[19:34:46.746]      // if-block "protType == 2"
[19:34:46.746]        // =>  TRUE
[19:34:46.746]      <control if="isSWJ" while="" timeout="0" info="">
[19:34:46.746]        // if-block "isSWJ"
[19:34:46.746]          // =>  TRUE
[19:34:46.746]        <control if="hasDormant" while="" timeout="0" info="">
[19:34:46.747]          // if-block "hasDormant"
[19:34:46.747]            // =>  FALSE
[19:34:46.747]          // skip if-block "hasDormant"
[19:34:46.747]        </control>
[19:34:46.747]        <control if="!hasDormant" while="" timeout="0" info="">
[19:34:46.747]          // if-block "!hasDormant"
[19:34:46.747]            // =>  TRUE
[19:34:46.747]          <block atomic="false" info="">
[19:34:46.747]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:34:46.749]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:34:46.749]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:34:46.751]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:34:46.751]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:34:46.754]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:34:46.754]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:34:46.756]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:34:46.756]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:34:46.759]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:34:46.759]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:34:46.760]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:34:46.760]          </block>
[19:34:46.760]          // end if-block "!hasDormant"
[19:34:46.761]        </control>
[19:34:46.761]        // end if-block "isSWJ"
[19:34:46.761]      </control>
