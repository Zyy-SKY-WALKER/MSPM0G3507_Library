[19:34:46.761]        // skip if-block "!isSWJ"
[19:34:46.761]      </control>
[19:34:46.761]      <block atomic="false" info="">
[19:34:46.761]        ReadDP(0x0);
[19:34:46.763]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[19:34:46.764]      </block>
[19:34:46.764]      // end if-block "protType == 2"
[19:34:46.764]    </control>
