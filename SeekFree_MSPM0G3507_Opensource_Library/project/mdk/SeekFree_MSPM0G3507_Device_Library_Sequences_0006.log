[19:34:09.462]        // -> [SW_DP_ABORT <= 0x00000000]
[19:34:09.462]      __var DP_CTRL_STAT      = 0x4;
[19:34:09.462]        // -> [DP_CTRL_STAT <= 0x00000004]
[19:34:09.462]      __var DP_SELECT         = 0x8;
[19:34:09.462]        // -> [DP_SELECT <= 0x00000008]
[19:34:09.462]      __var powered_down      = 0;
[19:34:09.462]        // -> [powered_down <= 0x00000000]
[19:34:09.462]      WriteDP(DP_SELECT, 0x00000000);
[19:34:09.464]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:34:09.464]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:34:09.466]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:34:09.466]        // -> [powered_down <= 0x00000001]
[19:34:09.467]    </block>
[19:34:09.467]    <control if="powered_down" while="" timeout="0" info="">
