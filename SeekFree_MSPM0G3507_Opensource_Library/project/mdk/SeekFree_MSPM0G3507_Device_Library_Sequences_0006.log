[19:34:46.770]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[19:34:46.770]    <block atomic="false" info="">
[19:34:46.770]      __var SW_DP_ABORT       = 0x0;
[19:34:46.770]        // -> [SW_DP_ABORT <= 0x00000000]
[19:34:46.770]      __var DP_CTRL_STAT      = 0x4;
[19:34:46.770]        // -> [DP_CTRL_STAT <= 0x00000004]
[19:34:46.770]      __var DP_SELECT         = 0x8;
[19:34:46.771]        // -> [DP_SELECT <= 0x00000008]
[19:34:46.771]      __var powered_down      = 0;
[19:34:46.771]        // -> [powered_down <= 0x00000000]
[19:34:46.771]      WriteDP(DP_SELECT, 0x00000000);
[19:34:46.771]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:34:46.771]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:34:46.776]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:34:46.776]        // -> [powered_down <= 0x00000001]
[19:34:46.776]    </block>
[19:34:46.776]    <control if="powered_down" while="" timeout="0" info="">
[19:34:46.776]      // if-block "powered_down"
[19:34:46.776]        // =>  TRUE
[19:34:46.776]      <block atomic="false" info="">
[19:34:46.776]        Message(0, "Debug/System power-up request sent");
[19:34:46.776]        WriteDP(DP_CTRL_STAT, 0x50000000);
[19:34:46.781]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[19:34:46.781]      </block>
[19:34:46.781]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[19:34:46.781]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[19:34:46.783]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[19:34:46.783]        // while-condition  =>  FALSE
[19:34:46.783]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[19:34:46.783]      </control>
[19:34:46.783]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[19:34:46.783]        // if-block "(__protocol & 0xFFFF) == 1"
[19:34:46.783]          // =>  FALSE
[19:34:46.783]        // skip if-block "(__protocol & 0xFFFF) == 1"
[19:34:46.783]      </control>
[19:34:46.783]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[19:34:46.783]        // if-block "(__protocol & 0xFFFF) == 2"
[19:34:46.783]          // =>  TRUE
[19:34:46.783]        <block atomic="false" info="">
[19:34:46.783]          Message(0, "executing SWD power up");
[19:34:46.784]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[19:34:46.787]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[19:34:46.787]          WriteDP(SW_DP_ABORT, 0x0000001E);
[19:34:46.789]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[19:34:46.789]        </block>
[19:34:46.789]        // end if-block "(__protocol & 0xFFFF) == 2"
[19:34:46.789]      </control>
[19:34:46.789]      // end if-block "powered_down"
[19:34:46.789]    </control>
[19:34:46.789]    <block atomic="false" info="">
[19:34:46.789]      __var DEBUG_PORT_VAL    = 0;
[19:34:46.789]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[19:34:46.789]      __var ACCESS_POINT_VAL  = 0;
[19:34:46.789]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[19:34:46.789]      __ap = 1; 
