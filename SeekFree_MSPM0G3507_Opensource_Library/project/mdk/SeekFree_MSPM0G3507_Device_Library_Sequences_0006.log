[19:41:26.228]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[19:41:26.228]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[19:41:26.228]    __dp=0x00000000
