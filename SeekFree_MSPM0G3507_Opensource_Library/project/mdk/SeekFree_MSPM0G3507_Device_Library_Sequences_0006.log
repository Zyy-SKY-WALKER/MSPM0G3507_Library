[19:41:26.252]      WriteDP(DP_SELECT, 0x00000000);
[19:41:26.256]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:41:26.256]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:41:26.258]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:41:26.259]        // -> [powered_down <= 0x00000001]
