[19:35:23.767]      // skip if-block "protType == 1"
[19:35:23.767]    </control>
[19:35:23.767]    <control if="protType == 2" while="" timeout="0" info="">
[19:35:23.767]      // if-block "protType == 2"
[19:35:23.767]        // =>  TRUE
[19:35:23.767]      <control if="isSWJ" while="" timeout="0" info="">
[19:35:23.767]        // if-block "isSWJ"
[19:35:23.767]          // =>  TRUE
[19:35:23.767]        <control if="hasDormant" while="" timeout="0" info="">
[19:35:23.767]          // if-block "hasDormant"
[19:35:23.767]            // =>  FALSE
[19:35:23.767]          // skip if-block "hasDormant"
[19:35:23.767]        </control>
[19:35:23.767]        <control if="!hasDormant" while="" timeout="0" info="">
[19:35:23.767]          // if-block "!hasDormant"
[19:35:23.767]            // =>  TRUE
[19:35:23.767]          <block atomic="false" info="">
[19:35:23.767]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:35:23.772]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:35:23.772]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:35:23.774]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:35:23.774]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:35:23.777]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:35:23.778]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:35:23.779]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:35:23.779]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:35:23.781]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:35:23.781]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:35:23.783]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:35:23.784]          </block>
[19:35:23.784]          // end if-block "!hasDormant"
[19:35:23.784]        </control>
[19:35:23.784]        // end if-block "isSWJ"
[19:35:23.784]      </control>
[19:35:23.784]      <control if="!isSWJ" while="" timeout="0" info="">
[19:35:23.784]        // if-block "!isSWJ"
[19:35:23.784]          // =>  FALSE
[19:35:23.784]        // skip if-block "!isSWJ"
[19:35:23.784]      </control>
[19:35:23.784]      <block atomic="false" info="">
[19:35:23.784]        ReadDP(0x0);
[19:35:23.784]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[19:35:23.784]      </block>
[19:35:23.784]      // end if-block "protType == 2"
[19:35:23.784]    </control>
