[14:57:25.901]          <block atomic="false" info="">
[14:57:25.901]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[14:57:25.907]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
