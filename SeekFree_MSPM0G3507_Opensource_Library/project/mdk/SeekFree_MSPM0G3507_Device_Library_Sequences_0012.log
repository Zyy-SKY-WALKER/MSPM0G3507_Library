[14:55:13.943]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[14:55:13.943]    <block atomic="false" info="">
[14:55:13.943]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[14:55:13.943]        // -> [isSWJ <= 0x00000001]
[14:55:13.943]      __var hasDormant = __protocol & 0x00020000;
[14:55:13.943]        // -> [hasDormant <= 0x00000000]
