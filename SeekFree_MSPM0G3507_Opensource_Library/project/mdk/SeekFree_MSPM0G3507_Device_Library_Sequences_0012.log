[14:17:56.650]          // if-block "!hasDormant"
[14:17:56.650]            // =>  TRUE
[14:17:56.650]          <block atomic="false" info="">
[14:17:56.650]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[14:17:56.650]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[14:17:56.650]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[14:17:56.656]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[14:17:56.656]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
