[14:29:08.514]            // =>  TRUE
[14:29:08.514]          <block atomic="false" info="">
[14:29:08.514]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
