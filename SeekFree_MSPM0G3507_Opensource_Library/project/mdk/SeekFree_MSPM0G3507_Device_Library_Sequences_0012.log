[14:17:56.650]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[14:17:56.650]    <block atomic="false" info="">
[14:17:56.650]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[14:17:56.650]        // -> [isSWJ <= 0x00000001]
