[14:55:13.943]          // if-block "hasDormant"
[14:55:13.943]            // =>  FALSE
[14:55:13.943]          // skip if-block "hasDormant"
[14:55:13.943]        </control>
[14:55:13.943]        <control if="!hasDormant" while="" timeout="0" info="">
[14:55:13.943]          // if-block "!hasDormant"
[14:55:13.943]            // =>  TRUE
[14:55:13.943]          <block atomic="false" info="">
[14:55:13.943]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[14:55:13.948]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[14:55:13.948]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[14:55:13.949]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[14:55:13.949]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
