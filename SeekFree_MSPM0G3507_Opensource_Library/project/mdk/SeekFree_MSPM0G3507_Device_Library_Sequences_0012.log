[14:06:11.927]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[14:06:11.927]    <block atomic="false" info="">
[14:06:11.927]      __var deviceID = 0;
[14:06:11.927]        // -> [deviceID <= 0x00000000]
[14:06:11.927]      __var version = 0;
[14:06:11.927]        // -> [version <= 0x00000000]
[14:06:11.927]      __var partNum = 0;
[14:06:11.927]        // -> [partNum <= 0x00000000]
[14:06:11.927]      __var manuf = 0;
[14:06:11.927]        // -> [manuf <= 0x00000000]
[14:06:11.927]      __var isMSPM0G1X0X_G3X0X = 0;
[14:06:11.927]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[14:06:11.927]      __var isProduction = 0;
[14:06:11.927]        // -> [isProduction <= 0x00000000]
[14:06:11.927]      __var continueId = 0;
[14:06:11.927]        // -> [continueId <= 0x00000000]
[14:06:11.927]      deviceID =   Read32(0x41C40004);
[14:06:11.934]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[14:06:11.934]        // -> [deviceID <= 0x2BB8802F]
[14:06:11.934]      version = deviceID >> 28;
[14:06:11.934]        // -> [version <= 0x00000002]
[14:06:11.934]      partNum = (deviceID & 0x0FFFF000) >> 12;
[14:06:11.934]        // -> [partNum <= 0x0000BB88]
[14:06:11.934]      manuf = (deviceID & 0x00000FFE) >> 1;
[14:06:11.934]        // -> [manuf <= 0x00000017]
[14:06:11.934]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[14:06:11.934]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[14:06:11.934]      isProduction = (version > 0);
[14:06:11.934]        // -> [isProduction <= 0x00000001]
[14:06:11.935]    </block>
[14:06:11.935]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[14:06:11.935]      // if-block "!isMSPM0G1X0X_G3X0X"
[14:06:11.935]        // =>  FALSE
[14:06:11.935]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[14:06:11.935]    </control>
[14:06:11.935]    <control if="continueId == 4" while="" timeout="0" info="">
[14:06:11.935]      // if-block "continueId == 4"
[14:06:11.935]        // =>  FALSE
[14:06:11.935]      // skip if-block "continueId == 4"
[14:06:11.935]    </control>
[14:06:11.935]    <control if="!isProduction" while="" timeout="0" info="">
[14:06:11.935]      // if-block "!isProduction"
[14:06:11.935]        // =>  FALSE
[14:06:11.935]      // skip if-block "!isProduction"
[14:06:11.935]    </control>
