[14:55:13.955]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[14:55:13.957]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[14:55:13.957]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
