[14:52:55.572]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[14:52:55.572]    <block atomic="false" info="">
[14:52:55.572]      __var deviceID = 0;
[14:52:55.572]        // -> [deviceID <= 0x00000000]
[14:52:55.572]      __var version = 0;
[14:52:55.572]        // -> [version <= 0x00000000]
