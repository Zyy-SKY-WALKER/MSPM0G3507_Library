[14:52:55.572]        // -> [partNum <= 0x00000000]
[14:52:55.572]      __var manuf = 0;
[14:52:55.572]        // -> [manuf <= 0x00000000]
[14:52:55.572]      __var isMSPM0G1X0X_G3X0X = 0;
[14:52:55.572]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[14:52:55.572]      __var isProduction = 0;
[14:52:55.572]        // -> [isProduction <= 0x00000000]
[14:52:55.572]      __var continueId = 0;
[14:52:55.572]        // -> [continueId <= 0x00000000]
[14:52:55.572]      deviceID =   Read32(0x41C40004);
[14:52:55.578]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[14:52:55.578]        // -> [deviceID <= 0x2BB8802F]
[14:52:55.578]      version = deviceID >> 28;
[14:52:55.578]        // -> [version <= 0x00000002]
[14:52:55.578]      partNum = (deviceID & 0x0FFFF000) >> 12;
[14:52:55.578]        // -> [partNum <= 0x0000BB88]
[14:52:55.578]      manuf = (deviceID & 0x00000FFE) >> 1;
[14:52:55.578]        // -> [manuf <= 0x00000017]
[14:52:55.578]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[14:52:55.578]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[14:52:55.578]      isProduction = (version > 0);
[14:52:55.578]        // -> [isProduction <= 0x00000001]
[14:52:55.578]    </block>
[14:52:55.583]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[14:52:55.583]      // if-block "!isMSPM0G1X0X_G3X0X"
