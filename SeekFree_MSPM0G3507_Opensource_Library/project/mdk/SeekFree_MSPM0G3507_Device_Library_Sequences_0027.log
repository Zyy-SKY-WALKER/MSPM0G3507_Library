[17:33:10.330]      manuf = (deviceID & 0x00000FFE) >> 1;
[17:33:10.330]        // -> [manuf <= 0x00000017]
[17:33:10.330]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
