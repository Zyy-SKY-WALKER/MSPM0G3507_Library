[15:52:28.363]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:52:28.363]    <block atomic="false" info="">
[15:52:28.363]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:52:28.363]        // -> [isSWJ <= 0x00000001]
[15:52:28.363]      __var hasDormant = __protocol & 0x00020000;
