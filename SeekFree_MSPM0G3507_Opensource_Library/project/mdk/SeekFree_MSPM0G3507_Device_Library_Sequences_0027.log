[15:59:39.657]        WriteAP(0x00, 0x190008);
[15:59:39.657]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[15:59:39.657]        WriteAP(0xF0, 0x01);
[15:59:39.665]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[15:59:39.665]      </block>
[15:59:39.665]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[15:59:39.665]    </control>
