[15:15:02.290]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:15:02.290]    <block atomic="false" info="">
[15:15:02.290]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:15:02.290]        // -> [isSWJ <= 0x00000001]
[15:15:02.290]      __var hasDormant = __protocol & 0x00020000;
[15:15:02.290]        // -> [hasDormant <= 0x00000000]
[15:15:02.290]      __var protType   = __protocol & 0x0000FFFF;
[15:15:02.290]        // -> [protType <= 0x00000002]
[15:15:02.290]    </block>
[15:15:02.290]    <control if="protType == 1" while="" timeout="0" info="">
[15:15:02.290]      // if-block "protType == 1"
[15:15:02.290]        // =>  FALSE
[15:15:02.290]      // skip if-block "protType == 1"
[15:15:02.290]    </control>
[15:15:02.290]    <control if="protType == 2" while="" timeout="0" info="">
[15:15:02.290]      // if-block "protType == 2"
[15:15:02.290]        // =>  TRUE
[15:15:02.290]      <control if="isSWJ" while="" timeout="0" info="">
[15:15:02.290]        // if-block "isSWJ"
[15:15:02.290]          // =>  TRUE
[15:15:02.290]        <control if="hasDormant" while="" timeout="0" info="">
[15:15:02.290]          // if-block "hasDormant"
[15:15:02.290]            // =>  FALSE
[15:15:02.290]          // skip if-block "hasDormant"
[15:15:02.290]        </control>
[15:15:02.290]        <control if="!hasDormant" while="" timeout="0" info="">
[15:15:02.290]          // if-block "!hasDormant"
[15:15:02.290]            // =>  TRUE
[15:15:02.290]          <block atomic="false" info="">
[15:15:02.290]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:15:02.295]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:15:02.296]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:15:02.297]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:15:02.297]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:15:02.307]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:15:02.307]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:15:02.311]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:15:02.311]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:15:02.315]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:15:02.315]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:15:02.318]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:15:02.318]          </block>
[15:15:02.318]          // end if-block "!hasDormant"
[15:15:02.318]        </control>
[15:15:02.318]        // end if-block "isSWJ"
[15:15:02.318]      </control>
[15:15:02.318]      <control if="!isSWJ" while="" timeout="0" info="">
[15:15:02.318]        // if-block "!isSWJ"
[15:15:02.318]          // =>  FALSE
[15:15:02.318]        // skip if-block "!isSWJ"
[15:15:02.318]      </control>
