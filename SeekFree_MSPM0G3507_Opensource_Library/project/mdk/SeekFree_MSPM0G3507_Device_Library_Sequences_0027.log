[17:05:17.055]        // -> [partNum <= 0x00000000]
[17:05:17.055]      __var manuf = 0;
[17:05:17.055]        // -> [manuf <= 0x00000000]
[17:05:17.055]      __var isMSPM0G1X0X_G3X0X = 0;
[17:05:17.055]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:05:17.055]      __var isProduction = 0;
[17:05:17.056]        // -> [isProduction <= 0x00000000]
[17:05:17.056]      __var continueId = 0;
[17:05:17.056]        // -> [continueId <= 0x00000000]
[17:05:17.056]      deviceID =   Read32(0x41C40004);
