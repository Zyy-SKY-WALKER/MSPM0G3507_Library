[17:04:53.532]        <control if="!hasDormant" while="" timeout="0" info="">
[17:04:53.532]          // if-block "!hasDormant"
[17:04:53.532]            // =>  TRUE
[17:04:53.532]          <block atomic="false" info="">
[17:04:53.532]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:04:53.537]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:04:53.537]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:04:53.537]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:04:53.537]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:04:53.542]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
