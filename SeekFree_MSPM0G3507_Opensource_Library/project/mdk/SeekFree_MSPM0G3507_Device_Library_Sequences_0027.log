[17:27:14.916]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[17:27:14.916]    <block atomic="false" info="">
[17:27:14.916]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[17:27:14.916]        // -> [isSWJ <= 0x00000001]
[17:27:14.916]      __var hasDormant = __protocol & 0x00020000;
[17:27:14.916]        // -> [hasDormant <= 0x00000000]
[17:27:14.916]      __var protType   = __protocol & 0x0000FFFF;
[17:27:14.916]        // -> [protType <= 0x00000002]
[17:27:14.916]    </block>
