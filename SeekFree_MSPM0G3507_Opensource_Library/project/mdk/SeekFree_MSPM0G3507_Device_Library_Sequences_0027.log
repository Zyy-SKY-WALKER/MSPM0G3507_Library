[17:26:19.268]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[17:26:19.268]    <block atomic="false" info="">
[17:26:19.268]      __var deviceID = 0;
[17:26:19.268]        // -> [deviceID <= 0x00000000]
[17:26:19.268]      __var version = 0;
[17:26:19.268]        // -> [version <= 0x00000000]
[17:26:19.268]      __var partNum = 0;
[17:26:19.268]        // -> [partNum <= 0x00000000]
[17:26:19.268]      __var manuf = 0;
[17:26:19.268]        // -> [manuf <= 0x00000000]
[17:26:19.268]      __var isMSPM0G1X0X_G3X0X = 0;
[17:26:19.268]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:26:19.268]      __var isProduction = 0;
[17:26:19.268]        // -> [isProduction <= 0x00000000]
[17:26:19.268]      __var continueId = 0;
[17:26:19.268]        // -> [continueId <= 0x00000000]
[17:26:19.268]      deviceID =   Read32(0x41C40004);
[17:26:19.273]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[17:26:19.273]        // -> [deviceID <= 0x2BB8802F]
[17:26:19.273]      version = deviceID >> 28;
[17:26:19.273]        // -> [version <= 0x00000002]
[17:26:19.273]      partNum = (deviceID & 0x0FFFF000) >> 12;
[17:26:19.273]        // -> [partNum <= 0x0000BB88]
[17:26:19.273]      manuf = (deviceID & 0x00000FFE) >> 1;
[17:26:19.273]        // -> [manuf <= 0x00000017]
[17:26:19.273]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:26:19.273]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:26:19.273]      isProduction = (version > 0);
[17:26:19.273]        // -> [isProduction <= 0x00000001]
[17:26:19.273]    </block>
[17:26:19.273]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[17:26:19.273]      // if-block "!isMSPM0G1X0X_G3X0X"
[17:26:19.273]        // =>  FALSE
[17:26:19.273]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[17:26:19.273]    </control>
[17:26:19.273]    <control if="continueId == 4" while="" timeout="0" info="">
[17:26:19.273]      // if-block "continueId == 4"
[17:26:19.273]        // =>  FALSE
[17:26:19.273]      // skip if-block "continueId == 4"
[17:26:19.273]    </control>
[17:26:19.273]    <control if="!isProduction" while="" timeout="0" info="">
[17:26:19.278]      // if-block "!isProduction"
[17:26:19.278]        // =>  FALSE
[17:26:19.278]      // skip if-block "!isProduction"
[17:26:19.278]    </control>
[17:26:19.278]  </sequence>
