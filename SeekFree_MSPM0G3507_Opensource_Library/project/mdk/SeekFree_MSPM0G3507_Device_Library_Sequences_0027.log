[17:49:34.388]          // =>  TRUE
[17:49:34.388]        <block atomic="false" info="">
[17:49:34.388]          Message(0, "executing SWD power up");
[17:49:34.388]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[17:49:34.393]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
