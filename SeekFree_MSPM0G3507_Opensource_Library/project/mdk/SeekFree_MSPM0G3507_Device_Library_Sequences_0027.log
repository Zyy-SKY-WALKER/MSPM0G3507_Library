[17:36:09.923]        // -> [isProduction <= 0x00000000]
[17:36:09.923]      __var continueId = 0;
[17:36:09.923]        // -> [continueId <= 0x00000000]
[17:36:09.923]      deviceID =   Read32(0x41C40004);
