[17:30:07.744]          // if-block "hasDormant"
[17:30:07.744]            // =>  FALSE
[17:30:07.744]          // skip if-block "hasDormant"
[17:30:07.744]        </control>
[17:30:07.744]        <control if="!hasDormant" while="" timeout="0" info="">
[17:30:07.744]          // if-block "!hasDormant"
[17:30:07.744]            // =>  TRUE
[17:30:07.744]          <block atomic="false" info="">
[17:30:07.744]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:30:07.749]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:30:07.749]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:30:07.749]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:30:07.749]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:30:07.755]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:30:07.755]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[17:30:07.755]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[17:30:07.755]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[17:30:07.760]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:30:07.760]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[17:30:07.765]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[17:30:07.765]          </block>
