[15:00:01.729]  <debugvars>
[15:00:01.730]    // Pre-defined
[15:00:01.730]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[15:00:01.730]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[15:00:01.730]    __dp=0x00000000
[15:00:01.730]    __ap=0x00000000
[15:00:01.730]    __traceout=0x00000000      (Trace Disabled)
[15:00:01.730]    __errorcontrol=0x00000000  (Skip Errors="False")
