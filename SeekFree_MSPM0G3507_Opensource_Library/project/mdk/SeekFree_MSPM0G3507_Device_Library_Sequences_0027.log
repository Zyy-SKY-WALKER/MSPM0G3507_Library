[17:20:17.927]      __var SW_DP_ABORT       = 0x0;
[17:20:17.927]        // -> [SW_DP_ABORT <= 0x00000000]
[17:20:17.927]      __var DP_CTRL_STAT      = 0x4;
[17:20:17.927]        // -> [DP_CTRL_STAT <= 0x00000004]
