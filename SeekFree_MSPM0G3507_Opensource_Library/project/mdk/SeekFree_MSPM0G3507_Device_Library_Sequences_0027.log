[17:34:02.142]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[17:34:02.142]    <block atomic="false" info="">
[17:34:02.142]      __var SW_DP_ABORT       = 0x0;
[17:34:02.142]        // -> [SW_DP_ABORT <= 0x00000000]
