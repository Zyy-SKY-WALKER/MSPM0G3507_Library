[16:11:29.276]        // -> [manuf <= 0x00000017]
[16:11:29.276]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[16:11:29.276]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[16:11:29.276]      isProduction = (version > 0);
