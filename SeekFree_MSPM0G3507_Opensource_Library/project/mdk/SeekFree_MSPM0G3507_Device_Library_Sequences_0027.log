[16:05:26.284]        ReadDP(0x0);
[16:05:26.284]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[16:05:26.284]      </block>
[16:05:26.284]      // end if-block "protType == 2"
[16:05:26.284]    </control>
[16:05:26.284]  </sequence>
