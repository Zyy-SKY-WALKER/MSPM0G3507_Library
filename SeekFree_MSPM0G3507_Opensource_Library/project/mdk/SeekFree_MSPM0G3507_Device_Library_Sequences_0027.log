[16:05:26.266]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[16:05:26.266]    <block atomic="false" info="">
[16:05:26.266]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[16:05:26.266]        // -> [isSWJ <= 0x00000001]
[16:05:26.266]      __var hasDormant = __protocol & 0x00020000;
[16:05:26.269]        // -> [hasDormant <= 0x00000000]
[16:05:26.269]      __var protType   = __protocol & 0x0000FFFF;
[16:05:26.269]        // -> [protType <= 0x00000002]
[16:05:26.269]    </block>
[16:05:26.269]    <control if="protType == 1" while="" timeout="0" info="">
