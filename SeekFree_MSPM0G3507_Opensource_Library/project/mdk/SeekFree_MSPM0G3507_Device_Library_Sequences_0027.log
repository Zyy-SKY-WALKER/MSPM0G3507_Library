[17:04:53.563]        // -> [DP_CTRL_STAT <= 0x00000004]
[17:04:53.563]      __var DP_SELECT         = 0x8;
[17:04:53.563]        // -> [DP_SELECT <= 0x00000008]
[17:04:53.563]      __var powered_down      = 0;
