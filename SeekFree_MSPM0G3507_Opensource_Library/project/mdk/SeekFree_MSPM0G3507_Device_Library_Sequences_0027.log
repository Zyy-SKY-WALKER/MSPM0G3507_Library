[15:18:05.693]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:18:05.693]    <block atomic="false" info="">
[15:18:05.693]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:18:05.693]        // -> [isSWJ <= 0x00000001]
[15:18:05.693]      __var hasDormant = __protocol & 0x00020000;
[15:18:05.693]        // -> [hasDormant <= 0x00000000]
[15:18:05.693]      __var protType   = __protocol & 0x0000FFFF;
[15:18:05.693]        // -> [protType <= 0x00000002]
[15:18:05.693]    </block>
[15:18:05.693]    <control if="protType == 1" while="" timeout="0" info="">
[15:18:05.693]      // if-block "protType == 1"
[15:18:05.693]        // =>  FALSE
[15:18:05.693]      // skip if-block "protType == 1"
[15:18:05.693]    </control>
[15:18:05.693]    <control if="protType == 2" while="" timeout="0" info="">
[15:18:05.693]      // if-block "protType == 2"
[15:18:05.693]        // =>  TRUE
[15:18:05.693]      <control if="isSWJ" while="" timeout="0" info="">
[15:18:05.693]        // if-block "isSWJ"
[15:18:05.693]          // =>  TRUE
[15:18:05.693]        <control if="hasDormant" while="" timeout="0" info="">
[15:18:05.693]          // if-block "hasDormant"
[15:18:05.693]            // =>  FALSE
[15:18:05.693]          // skip if-block "hasDormant"
[15:18:05.693]        </control>
[15:18:05.693]        <control if="!hasDormant" while="" timeout="0" info="">
[15:18:05.693]          // if-block "!hasDormant"
[15:18:05.693]            // =>  TRUE
[15:18:05.693]          <block atomic="false" info="">
[15:18:05.693]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:18:05.695]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:18:05.695]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:18:05.695]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:18:05.695]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:18:05.700]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:18:05.700]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:18:05.700]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:18:05.700]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:18:05.705]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:18:05.705]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:18:05.705]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:18:05.705]          </block>
[15:18:05.705]          // end if-block "!hasDormant"
[15:18:05.705]        </control>
[15:18:05.705]        // end if-block "isSWJ"
[15:18:05.705]      </control>
[15:18:05.705]      <control if="!isSWJ" while="" timeout="0" info="">
[15:18:05.705]        // if-block "!isSWJ"
[15:18:05.705]          // =>  FALSE
[15:18:05.705]        // skip if-block "!isSWJ"
[15:18:05.705]      </control>
[15:18:05.705]      <block atomic="false" info="">
[15:18:05.705]        ReadDP(0x0);
[15:18:05.710]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[15:18:05.710]      </block>
[15:18:05.710]      // end if-block "protType == 2"
[15:18:05.710]    </control>
[15:18:05.710]  </sequence>
