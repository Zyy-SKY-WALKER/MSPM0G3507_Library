[17:56:35.628]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[17:56:35.628]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:56:35.628]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[17:56:35.628]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[17:56:35.628]          </block>
[17:56:35.628]          // end if-block "!hasDormant"
