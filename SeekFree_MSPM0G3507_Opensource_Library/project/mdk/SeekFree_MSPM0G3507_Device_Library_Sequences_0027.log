[15:15:02.348]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[15:15:02.355]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[15:15:02.355]      __ap = 4;
