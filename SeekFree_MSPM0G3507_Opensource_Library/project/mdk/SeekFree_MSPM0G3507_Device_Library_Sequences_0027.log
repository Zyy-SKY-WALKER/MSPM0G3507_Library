[17:26:19.180]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[17:26:19.180]      </block>
[17:26:19.180]      // end if-block "protType == 2"
[17:26:19.180]    </control>
