[17:20:17.915]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[17:20:17.917]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:20:17.917]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[17:20:17.920]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[17:20:17.920]          </block>
