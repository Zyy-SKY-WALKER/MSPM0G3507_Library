[15:59:39.567]        // =>  TRUE
[15:59:39.567]      <control if="isSWJ" while="" timeout="0" info="">
[15:59:39.567]        // if-block "isSWJ"
[15:59:39.567]          // =>  TRUE
[15:59:39.567]        <control if="hasDormant" while="" timeout="0" info="">
[15:59:39.567]          // if-block "hasDormant"
[15:59:39.567]            // =>  FALSE
[15:59:39.567]          // skip if-block "hasDormant"
[15:59:39.567]        </control>
[15:59:39.567]        <control if="!hasDormant" while="" timeout="0" info="">
[15:59:39.567]          // if-block "!hasDormant"
[15:59:39.567]            // =>  TRUE
[15:59:39.567]          <block atomic="false" info="">
[15:59:39.567]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:59:39.567]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:59:39.567]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:59:39.573]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:59:39.573]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:59:39.578]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:59:39.578]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:59:39.578]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:59:39.578]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:59:39.586]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:59:39.586]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:59:39.587]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:59:39.587]          </block>
[15:59:39.587]          // end if-block "!hasDormant"
[15:59:39.587]        </control>
[15:59:39.587]        // end if-block "isSWJ"
[15:59:39.587]      </control>
