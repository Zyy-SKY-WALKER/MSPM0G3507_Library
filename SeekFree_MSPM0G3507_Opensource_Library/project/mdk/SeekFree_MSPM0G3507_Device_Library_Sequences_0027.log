[17:34:02.116]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[17:34:02.116]    <block atomic="false" info="">
[17:34:02.116]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[17:34:02.116]        // -> [isSWJ <= 0x00000001]
[17:34:02.116]      __var hasDormant = __protocol & 0x00020000;
