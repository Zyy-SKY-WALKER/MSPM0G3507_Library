[15:59:39.615]        <block atomic="false" info="">
[15:59:39.615]          Message(0, "executing SWD power up");
[15:59:39.615]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:59:39.620]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
