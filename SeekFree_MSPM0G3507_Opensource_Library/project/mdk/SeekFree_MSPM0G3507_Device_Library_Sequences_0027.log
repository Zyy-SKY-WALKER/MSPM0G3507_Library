[15:52:28.363]        // =>  TRUE
[15:52:28.363]      <control if="isSWJ" while="" timeout="0" info="">
[15:52:28.363]        // if-block "isSWJ"
[15:52:28.363]          // =>  TRUE
[15:52:28.363]        <control if="hasDormant" while="" timeout="0" info="">
[15:52:28.363]          // if-block "hasDormant"
[15:52:28.363]            // =>  FALSE
[15:52:28.363]          // skip if-block "hasDormant"
[15:52:28.363]        </control>
[15:52:28.363]        <control if="!hasDormant" while="" timeout="0" info="">
[15:52:28.363]          // if-block "!hasDormant"
[15:52:28.363]            // =>  TRUE
[15:52:28.363]          <block atomic="false" info="">
[15:52:28.363]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:52:28.373]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:52:28.373]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:52:28.374]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:52:28.374]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:52:28.377]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:52:28.377]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:52:28.378]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:52:28.378]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:52:28.380]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:52:28.380]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:52:28.387]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:52:28.388]          </block>
[15:52:28.388]          // end if-block "!hasDormant"
[15:52:28.388]        </control>
[15:52:28.388]        // end if-block "isSWJ"
[15:52:28.388]      </control>
[15:52:28.388]      <control if="!isSWJ" while="" timeout="0" info="">
[15:52:28.389]        // if-block "!isSWJ"
[15:52:28.389]          // =>  FALSE
[15:52:28.389]        // skip if-block "!isSWJ"
[15:52:28.389]      </control>
