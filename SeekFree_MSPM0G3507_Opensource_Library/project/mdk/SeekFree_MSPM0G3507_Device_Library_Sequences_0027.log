[17:14:41.203]        // -> [partNum <= 0x0000BB88]
[17:14:41.203]      manuf = (deviceID & 0x00000FFE) >> 1;
[17:14:41.203]        // -> [manuf <= 0x00000017]
[17:14:41.203]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:14:41.203]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:14:41.203]      isProduction = (version > 0);
[17:14:41.203]        // -> [isProduction <= 0x00000001]
