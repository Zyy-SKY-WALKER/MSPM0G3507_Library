[15:15:02.345]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[15:15:02.345]        // while-condition  =>  FALSE
[15:15:02.345]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[15:15:02.345]      </control>
[15:15:02.345]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
