[17:20:17.927]      WriteDP(DP_SELECT, 0x00000000);
[17:20:17.930]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[17:20:17.930]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[17:20:17.933]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[17:20:17.933]        // -> [powered_down <= 0x00000001]
