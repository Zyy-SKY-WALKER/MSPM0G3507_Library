[15:09:59.112]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:09:59.114]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:09:59.114]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:09:59.116]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
