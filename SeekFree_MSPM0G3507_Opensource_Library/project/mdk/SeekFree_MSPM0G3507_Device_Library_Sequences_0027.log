[17:05:17.058]        // -> [partNum <= 0x0000BB88]
[17:05:17.058]      manuf = (deviceID & 0x00000FFE) >> 1;
[17:05:17.058]        // -> [manuf <= 0x00000017]
[17:05:17.058]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:05:17.058]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:05:17.058]      isProduction = (version > 0);
[17:05:17.058]        // -> [isProduction <= 0x00000001]
