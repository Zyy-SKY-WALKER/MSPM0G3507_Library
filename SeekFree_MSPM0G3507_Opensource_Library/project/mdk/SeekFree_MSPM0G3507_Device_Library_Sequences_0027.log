[15:02:56.103]        // -> [partNum <= 0x00000000]
[15:02:56.103]      __var manuf = 0;
[15:02:56.103]        // -> [manuf <= 0x00000000]
[15:02:56.103]      __var isMSPM0G1X0X_G3X0X = 0;
[15:02:56.103]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:02:56.103]      __var isProduction = 0;
[15:02:56.103]        // -> [isProduction <= 0x00000000]
[15:02:56.103]      __var continueId = 0;
[15:02:56.103]        // -> [continueId <= 0x00000000]
[15:02:56.103]      deviceID =   Read32(0x41C40004);
[15:02:56.108]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:02:56.108]        // -> [deviceID <= 0x2BB8802F]
[15:02:56.108]      version = deviceID >> 28;
[15:02:56.108]        // -> [version <= 0x00000002]
