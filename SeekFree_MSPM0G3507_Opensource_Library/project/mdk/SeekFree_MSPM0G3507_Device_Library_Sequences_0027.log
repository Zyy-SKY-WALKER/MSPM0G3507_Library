[17:14:41.196]        // -> [partNum <= 0x00000000]
[17:14:41.196]      __var manuf = 0;
[17:14:41.196]        // -> [manuf <= 0x00000000]
[17:14:41.196]      __var isMSPM0G1X0X_G3X0X = 0;
[17:14:41.198]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:14:41.198]      __var isProduction = 0;
[17:14:41.198]        // -> [isProduction <= 0x00000000]
[17:14:41.198]      __var continueId = 0;
[17:14:41.198]        // -> [continueId <= 0x00000000]
[17:14:41.198]      deviceID =   Read32(0x41C40004);
[17:14:41.203]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[17:14:41.203]        // -> [deviceID <= 0x2BB8802F]
[17:14:41.203]      version = deviceID >> 28;
[17:14:41.203]        // -> [version <= 0x00000002]
