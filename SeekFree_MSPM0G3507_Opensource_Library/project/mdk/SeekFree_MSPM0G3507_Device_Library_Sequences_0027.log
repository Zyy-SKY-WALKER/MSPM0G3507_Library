[17:49:34.356]          // if-block "!hasDormant"
[17:49:34.356]            // =>  TRUE
[17:49:34.356]          <block atomic="false" info="">
[17:49:34.356]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:49:34.358]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:49:34.358]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:49:34.359]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:49:34.359]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
