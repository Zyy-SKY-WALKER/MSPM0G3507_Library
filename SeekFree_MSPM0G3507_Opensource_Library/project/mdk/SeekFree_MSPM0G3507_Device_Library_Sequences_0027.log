[15:51:55.660]    // Pre-defined
[15:51:55.660]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[15:51:55.660]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
