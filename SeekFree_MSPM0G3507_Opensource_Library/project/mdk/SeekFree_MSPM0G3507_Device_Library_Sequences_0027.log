[17:40:34.998]      // skip if-block "protType == 1"
[17:40:34.998]    </control>
[17:40:34.998]    <control if="protType == 2" while="" timeout="0" info="">
[17:40:34.998]      // if-block "protType == 2"
[17:40:34.998]        // =>  TRUE
[17:40:34.998]      <control if="isSWJ" while="" timeout="0" info="">
[17:40:34.998]        // if-block "isSWJ"
[17:40:34.998]          // =>  TRUE
[17:40:34.998]        <control if="hasDormant" while="" timeout="0" info="">
[17:40:34.998]          // if-block "hasDormant"
[17:40:34.998]            // =>  FALSE
[17:40:34.998]          // skip if-block "hasDormant"
[17:40:34.998]        </control>
[17:40:34.998]        <control if="!hasDormant" while="" timeout="0" info="">
[17:40:34.998]          // if-block "!hasDormant"
[17:40:34.998]            // =>  TRUE
[17:40:34.998]          <block atomic="false" info="">
[17:40:34.998]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:40:34.998]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:40:34.998]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:40:35.005]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:40:35.005]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:40:35.005]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:40:35.005]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[17:40:35.009]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[17:40:35.009]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[17:40:35.010]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:40:35.012]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[17:40:35.014]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[17:40:35.014]          </block>
