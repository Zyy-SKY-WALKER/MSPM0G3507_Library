[17:36:09.933]        // -> [manuf <= 0x00000017]
[17:36:09.933]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:36:09.933]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:36:09.933]      isProduction = (version > 0);
[17:36:09.933]        // -> [isProduction <= 0x00000001]
