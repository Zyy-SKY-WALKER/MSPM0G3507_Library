[15:51:55.638]      // skip if-block "protType == 1"
[15:51:55.638]    </control>
[15:51:55.638]    <control if="protType == 2" while="" timeout="0" info="">
[15:51:55.638]      // if-block "protType == 2"
[15:51:55.638]        // =>  TRUE
[15:51:55.638]      <control if="isSWJ" while="" timeout="0" info="">
[15:51:55.638]        // if-block "isSWJ"
[15:51:55.638]          // =>  TRUE
[15:51:55.638]        <control if="hasDormant" while="" timeout="0" info="">
[15:51:55.638]          // if-block "hasDormant"
[15:51:55.638]            // =>  FALSE
[15:51:55.638]          // skip if-block "hasDormant"
[15:51:55.638]        </control>
[15:51:55.638]        <control if="!hasDormant" while="" timeout="0" info="">
[15:51:55.638]          // if-block "!hasDormant"
[15:51:55.638]            // =>  TRUE
[15:51:55.639]          <block atomic="false" info="">
[15:51:55.639]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:51:55.640]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:51:55.640]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:51:55.643]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:51:55.643]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:51:55.645]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:51:55.645]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:51:55.647]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:51:55.647]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:51:55.649]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:51:55.649]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:51:55.650]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:51:55.650]          </block>
[15:51:55.650]          // end if-block "!hasDormant"
[15:51:55.650]        </control>
[15:51:55.650]        // end if-block "isSWJ"
[15:51:55.650]      </control>
[15:51:55.650]      <control if="!isSWJ" while="" timeout="0" info="">
[15:51:55.650]        // if-block "!isSWJ"
[15:51:55.650]          // =>  FALSE
[15:51:55.651]        // skip if-block "!isSWJ"
[15:51:55.651]      </control>
[15:51:55.651]      <block atomic="false" info="">
[15:51:55.651]        ReadDP(0x0);
[15:51:55.655]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[15:51:55.655]      </block>
[15:51:55.655]      // end if-block "protType == 2"
[15:51:55.655]    </control>
[15:51:55.655]  </sequence>
