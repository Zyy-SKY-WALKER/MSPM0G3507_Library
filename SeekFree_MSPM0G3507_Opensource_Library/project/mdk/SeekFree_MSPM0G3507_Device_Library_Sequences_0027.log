[17:02:58.984]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:02:58.984]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:02:58.984]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[17:02:58.989]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[17:02:58.989]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[17:02:58.989]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:02:58.989]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
