[14:24:14.684]          // -> [DAP_SWJ_Pins(0x80, 0x80, 0) => 0x8F]   (Out: nRESET=1  =>  In: SWCLK/TCK=1, SWDIO/TMS=1, TDI=1, TDO=1, nTRST=0, nRESET=1)
[14:24:14.684]        // while-condition  =>  FALSE
[14:24:14.684]        // end while "(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0"
