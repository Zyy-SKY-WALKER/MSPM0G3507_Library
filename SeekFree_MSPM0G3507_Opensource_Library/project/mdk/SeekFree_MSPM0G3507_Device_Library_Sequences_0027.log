[17:04:26.969]      __var isProduction = 0;
[17:04:26.969]        // -> [isProduction <= 0x00000000]
[17:04:26.969]      __var continueId = 0;
[17:04:26.969]        // -> [continueId <= 0x00000000]
[17:04:26.969]      deviceID =   Read32(0x41C40004);
