[15:00:01.611]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:00:01.611]    <block atomic="false" info="">
[15:00:01.611]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:00:01.611]        // -> [isSWJ <= 0x00000001]
[15:00:01.611]      __var hasDormant = __protocol & 0x00020000;
[15:00:01.611]        // -> [hasDormant <= 0x00000000]
[15:00:01.611]      __var protType   = __protocol & 0x0000FFFF;
[15:00:01.611]        // -> [protType <= 0x00000002]
[15:00:01.611]    </block>
[15:00:01.611]    <control if="protType == 1" while="" timeout="0" info="">
[15:00:01.611]      // if-block "protType == 1"
[15:00:01.611]        // =>  FALSE
[15:00:01.611]      // skip if-block "protType == 1"
[15:00:01.611]    </control>
[15:00:01.611]    <control if="protType == 2" while="" timeout="0" info="">
[15:00:01.611]      // if-block "protType == 2"
[15:00:01.611]        // =>  TRUE
[15:00:01.612]      <control if="isSWJ" while="" timeout="0" info="">
[15:00:01.612]        // if-block "isSWJ"
[15:00:01.612]          // =>  TRUE
[15:00:01.612]        <control if="hasDormant" while="" timeout="0" info="">
[15:00:01.612]          // if-block "hasDormant"
[15:00:01.612]            // =>  FALSE
[15:00:01.612]          // skip if-block "hasDormant"
[15:00:01.612]        </control>
[15:00:01.612]        <control if="!hasDormant" while="" timeout="0" info="">
[15:00:01.612]          // if-block "!hasDormant"
[15:00:01.612]            // =>  TRUE
[15:00:01.612]          <block atomic="false" info="">
[15:00:01.612]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:00:01.615]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:00:01.615]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:00:01.617]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:00:01.617]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:00:01.618]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:00:01.618]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:00:01.618]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:00:01.618]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:00:01.618]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:00:01.623]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:00:01.625]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:00:01.625]          </block>
[15:00:01.625]          // end if-block "!hasDormant"
[15:00:01.625]        </control>
[15:00:01.625]        // end if-block "isSWJ"
[15:00:01.625]      </control>
[15:00:01.625]      <control if="!isSWJ" while="" timeout="0" info="">
[15:00:01.625]        // if-block "!isSWJ"
[15:00:01.626]          // =>  FALSE
[15:00:01.626]        // skip if-block "!isSWJ"
[15:00:01.626]      </control>
[15:00:01.626]      <block atomic="false" info="">
[15:00:01.626]        ReadDP(0x0);
[15:00:01.628]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[15:00:01.628]      </block>
[15:00:01.628]      // end if-block "protType == 2"
[15:00:01.628]    </control>
[15:00:01.628]  </sequence>
