[14:49:10.579]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[14:49:10.579]    <block atomic="false" info="">
[14:49:10.579]      __var deviceID = 0;
[14:49:10.579]        // -> [deviceID <= 0x00000000]
[14:49:10.579]      __var version = 0;
[14:49:10.579]        // -> [version <= 0x00000000]
[14:49:10.579]      __var partNum = 0;
[14:49:10.579]        // -> [partNum <= 0x00000000]
[14:49:10.579]      __var manuf = 0;
[14:49:10.579]        // -> [manuf <= 0x00000000]
[14:49:10.579]      __var isMSPM0G1X0X_G3X0X = 0;
[14:49:10.579]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[14:49:10.579]      __var isProduction = 0;
[14:49:10.579]        // -> [isProduction <= 0x00000000]
[14:49:10.579]      __var continueId = 0;
[14:49:10.579]        // -> [continueId <= 0x00000000]
[14:49:10.579]      deviceID =   Read32(0x41C40004);
[14:49:10.585]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[14:49:10.585]        // -> [deviceID <= 0x2BB8802F]
[14:49:10.585]      version = deviceID >> 28;
[14:49:10.585]        // -> [version <= 0x00000002]
[14:49:10.585]      partNum = (deviceID & 0x0FFFF000) >> 12;
[14:49:10.585]        // -> [partNum <= 0x0000BB88]
[14:49:10.585]      manuf = (deviceID & 0x00000FFE) >> 1;
[14:49:10.585]        // -> [manuf <= 0x00000017]
[14:49:10.585]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[14:49:10.585]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[14:49:10.585]      isProduction = (version > 0);
[14:49:10.585]        // -> [isProduction <= 0x00000001]
[14:49:10.585]    </block>
[14:49:10.585]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[14:49:10.585]      // if-block "!isMSPM0G1X0X_G3X0X"
[14:49:10.585]        // =>  FALSE
[14:49:10.585]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[14:49:10.585]    </control>
