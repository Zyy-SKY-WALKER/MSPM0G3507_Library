[15:02:55.983]        // =>  TRUE
[15:02:55.983]      <control if="isSWJ" while="" timeout="0" info="">
[15:02:55.983]        // if-block "isSWJ"
[15:02:55.983]          // =>  TRUE
[15:02:55.983]        <control if="hasDormant" while="" timeout="0" info="">
[15:02:55.983]          // if-block "hasDormant"
[15:02:55.983]            // =>  FALSE
[15:02:55.983]          // skip if-block "hasDormant"
[15:02:55.984]        </control>
[15:02:55.984]        <control if="!hasDormant" while="" timeout="0" info="">
[15:02:55.984]          // if-block "!hasDormant"
[15:02:55.984]            // =>  TRUE
[15:02:55.984]          <block atomic="false" info="">
[15:02:55.984]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:02:55.986]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:02:55.986]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:02:55.991]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:02:55.991]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:02:55.991]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:02:55.991]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:02:55.998]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:02:55.998]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:02:56.001]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:02:56.001]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:02:56.001]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:02:56.001]          </block>
[15:02:56.001]          // end if-block "!hasDormant"
[15:02:56.001]        </control>
