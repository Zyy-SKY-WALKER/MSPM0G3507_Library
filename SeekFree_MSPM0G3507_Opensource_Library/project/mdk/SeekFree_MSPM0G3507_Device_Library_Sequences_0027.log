[17:20:17.905]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[17:20:17.905]    <block atomic="false" info="">
[17:20:17.905]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[17:20:17.905]        // -> [isSWJ <= 0x00000001]
[17:20:17.905]      __var hasDormant = __protocol & 0x00020000;
[17:20:17.905]        // -> [hasDormant <= 0x00000000]
[17:20:17.905]      __var protType   = __protocol & 0x0000FFFF;
[17:20:17.905]        // -> [protType <= 0x00000002]
[17:20:17.905]    </block>
