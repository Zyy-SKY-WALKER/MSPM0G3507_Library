[15:54:30.839]        // =>  TRUE
[15:54:30.839]      <block atomic="false" info="">
[15:54:30.839]        Message(0, "Debug/System power-up request sent");
[15:54:30.839]        WriteDP(DP_CTRL_STAT, 0x50000000);
[15:54:30.839]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[15:54:30.839]      </block>
[15:54:30.839]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[15:54:30.839]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[15:54:30.846]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[15:54:30.846]        // while-condition  =>  FALSE
[15:54:30.846]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[15:54:30.846]      </control>
[15:54:30.846]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[15:54:30.846]        // if-block "(__protocol & 0xFFFF) == 1"
