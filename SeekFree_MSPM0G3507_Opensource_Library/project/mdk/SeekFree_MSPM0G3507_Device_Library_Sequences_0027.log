[17:26:19.165]      // skip if-block "protType == 1"
[17:26:19.165]    </control>
[17:26:19.165]    <control if="protType == 2" while="" timeout="0" info="">
[17:26:19.165]      // if-block "protType == 2"
[17:26:19.165]        // =>  TRUE
[17:26:19.165]      <control if="isSWJ" while="" timeout="0" info="">
[17:26:19.165]        // if-block "isSWJ"
[17:26:19.165]          // =>  TRUE
