[15:09:59.103]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:09:59.103]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:09:59.108]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
