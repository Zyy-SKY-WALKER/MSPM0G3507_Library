[15:28:48.307]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[15:28:48.307]    <block atomic="false" info="">
[15:28:48.307]      __var deviceID = 0;
[15:28:48.307]        // -> [deviceID <= 0x00000000]
[15:28:48.307]      __var version = 0;
[15:28:48.307]        // -> [version <= 0x00000000]
[15:28:48.307]      __var partNum = 0;
[15:28:48.307]        // -> [partNum <= 0x00000000]
[15:28:48.307]      __var manuf = 0;
[15:28:48.307]        // -> [manuf <= 0x00000000]
[15:28:48.307]      __var isMSPM0G1X0X_G3X0X = 0;
[15:28:48.307]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:28:48.307]      __var isProduction = 0;
[15:28:48.307]        // -> [isProduction <= 0x00000000]
[15:28:48.307]      __var continueId = 0;
[15:28:48.307]        // -> [continueId <= 0x00000000]
[15:28:48.307]      deviceID =   Read32(0x41C40004);
[15:28:48.318]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:28:48.318]        // -> [deviceID <= 0x2BB8802F]
[15:28:48.318]      version = deviceID >> 28;
[15:28:48.318]        // -> [version <= 0x00000002]
[15:28:48.318]      partNum = (deviceID & 0x0FFFF000) >> 12;
[15:28:48.319]        // -> [partNum <= 0x0000BB88]
[15:28:48.319]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:28:48.319]        // -> [manuf <= 0x00000017]
[15:28:48.319]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:28:48.319]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:28:48.319]      isProduction = (version > 0);
[15:28:48.319]        // -> [isProduction <= 0x00000001]
[15:28:48.319]    </block>
