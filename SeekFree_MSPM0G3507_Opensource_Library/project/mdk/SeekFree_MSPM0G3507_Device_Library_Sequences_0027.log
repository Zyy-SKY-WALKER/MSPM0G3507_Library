[17:34:02.116]      // skip if-block "protType == 1"
[17:34:02.116]    </control>
[17:34:02.116]    <control if="protType == 2" while="" timeout="0" info="">
[17:34:02.116]      // if-block "protType == 2"
[17:34:02.116]        // =>  TRUE
[17:34:02.116]      <control if="isSWJ" while="" timeout="0" info="">
[17:34:02.116]        // if-block "isSWJ"
[17:34:02.116]          // =>  TRUE
[17:34:02.116]        <control if="hasDormant" while="" timeout="0" info="">
[17:34:02.116]          // if-block "hasDormant"
[17:34:02.116]            // =>  FALSE
[17:34:02.116]          // skip if-block "hasDormant"
[17:34:02.116]        </control>
[17:34:02.116]        <control if="!hasDormant" while="" timeout="0" info="">
[17:34:02.116]          // if-block "!hasDormant"
[17:34:02.116]            // =>  TRUE
[17:34:02.116]          <block atomic="false" info="">
[17:34:02.116]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:34:02.120]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:34:02.120]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:34:02.120]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:34:02.120]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:34:02.126]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:34:02.126]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[17:34:02.126]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[17:34:02.126]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[17:34:02.130]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:34:02.130]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[17:34:02.130]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[17:34:02.130]          </block>
[17:34:02.130]          // end if-block "!hasDormant"
[17:34:02.130]        </control>
[17:34:02.130]        // end if-block "isSWJ"
[17:34:02.135]      </control>
