[17:08:48.209]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[17:08:48.209]    <block atomic="false" info="">
[17:08:48.209]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[17:08:48.209]        // -> [isSWJ <= 0x00000001]
