[15:28:09.621]        // =>  TRUE
[15:28:09.621]      <block atomic="false" info="">
[15:28:09.622]        Message(0, "Debug/System power-up request sent");
[15:28:09.623]        WriteDP(DP_CTRL_STAT, 0x50000000);
[15:28:09.624]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[15:28:09.624]      </block>
[15:28:09.624]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[15:28:09.624]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[15:28:09.626]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[15:28:09.626]        // while-condition  =>  FALSE
[15:28:09.626]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[15:28:09.626]      </control>
[15:28:09.626]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[15:28:09.626]        // if-block "(__protocol & 0xFFFF) == 1"
[15:28:09.626]          // =>  FALSE
[15:28:09.626]        // skip if-block "(__protocol & 0xFFFF) == 1"
[15:28:09.626]      </control>
[15:28:09.626]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[15:28:09.626]        // if-block "(__protocol & 0xFFFF) == 2"
[15:28:09.626]          // =>  TRUE
[15:28:09.626]        <block atomic="false" info="">
[15:28:09.626]          Message(0, "executing SWD power up");
[15:28:09.629]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:28:09.632]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[15:28:09.632]          WriteDP(SW_DP_ABORT, 0x0000001E);
[15:28:09.634]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[15:28:09.634]        </block>
[15:28:09.634]        // end if-block "(__protocol & 0xFFFF) == 2"
[15:28:09.634]      </control>
[15:28:09.634]      // end if-block "powered_down"
[15:28:09.634]    </control>
[15:28:09.634]    <block atomic="false" info="">
[15:28:09.634]      __var DEBUG_PORT_VAL    = 0;
[15:28:09.634]        // -> [DEBUG_PORT_VAL <= 0x00000000]
