[15:02:22.368]  
[15:02:22.368]  <debugvars>
[15:02:22.368]    // Pre-defined
[15:02:22.368]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[15:02:22.368]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[15:02:22.373]    __dp=0x00000000
[15:02:22.373]    __ap=0x00000000
[15:02:22.373]    __traceout=0x00000000      (Trace Disabled)
[15:02:22.373]    __errorcontrol=0x00000000  (Skip Errors="False")
