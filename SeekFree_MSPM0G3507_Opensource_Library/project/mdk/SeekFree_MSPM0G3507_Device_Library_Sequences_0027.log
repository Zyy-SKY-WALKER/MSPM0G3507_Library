[16:10:43.375]        // =>  TRUE
[16:10:43.375]      <block atomic="false" info="">
[16:10:43.375]        Message(0, "Debug/System power-up request sent");
[16:10:43.378]        WriteDP(DP_CTRL_STAT, 0x50000000);
[16:10:43.378]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[16:10:43.378]      </block>
[16:10:43.378]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[16:10:43.378]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[16:10:43.383]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[16:10:43.383]        // while-condition  =>  FALSE
[16:10:43.383]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[16:10:43.383]      </control>
[16:10:43.383]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[16:10:43.383]        // if-block "(__protocol & 0xFFFF) == 1"
[16:10:43.383]          // =>  FALSE
[16:10:43.383]        // skip if-block "(__protocol & 0xFFFF) == 1"
[16:10:43.383]      </control>
[16:10:43.383]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[16:10:43.383]        // if-block "(__protocol & 0xFFFF) == 2"
[16:10:43.383]          // =>  TRUE
[16:10:43.383]        <block atomic="false" info="">
[16:10:43.383]          Message(0, "executing SWD power up");
[16:10:43.383]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[16:10:43.383]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[16:10:43.383]          WriteDP(SW_DP_ABORT, 0x0000001E);
[16:10:43.388]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
