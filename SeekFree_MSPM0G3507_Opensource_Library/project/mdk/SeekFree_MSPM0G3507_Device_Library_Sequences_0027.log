[15:15:02.336]      <block atomic="false" info="">
[15:15:02.336]        Message(0, "Debug/System power-up request sent");
[15:15:02.338]        WriteDP(DP_CTRL_STAT, 0x50000000);
[15:15:02.338]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[15:15:02.338]      </block>
[15:15:02.338]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
