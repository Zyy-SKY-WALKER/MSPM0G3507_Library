[17:05:17.015]        WriteAP(0x00, 0x190008);
[17:05:17.017]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[17:05:17.017]        WriteAP(0xF0, 0x01);
[17:05:17.017]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[17:05:17.021]      </block>
[17:05:17.021]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[17:05:17.021]    </control>
