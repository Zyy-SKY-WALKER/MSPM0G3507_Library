[15:18:05.716]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[15:18:05.716]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[15:18:05.716]    __dp=0x00000000
[15:18:05.716]    __ap=0x00000000
