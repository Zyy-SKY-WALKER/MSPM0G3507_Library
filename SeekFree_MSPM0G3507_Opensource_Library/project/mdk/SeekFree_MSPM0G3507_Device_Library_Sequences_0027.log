[16:20:30.719]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[16:20:30.719]        // -> [isSWJ <= 0x00000001]
[16:20:30.719]      __var hasDormant = __protocol & 0x00020000;
[16:20:30.719]        // -> [hasDormant <= 0x00000000]
