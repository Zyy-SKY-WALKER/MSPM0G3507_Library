[17:02:58.980]          // if-block "!hasDormant"
[17:02:58.980]            // =>  TRUE
[17:02:58.980]          <block atomic="false" info="">
[17:02:58.980]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:02:58.984]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:02:58.984]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
