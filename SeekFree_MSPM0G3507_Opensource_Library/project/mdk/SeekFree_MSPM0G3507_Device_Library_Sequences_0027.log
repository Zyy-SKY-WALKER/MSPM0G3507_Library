[16:11:51.795]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[16:11:51.795]    <block atomic="false" info="">
[16:11:51.795]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[16:11:51.795]        // -> [isSWJ <= 0x00000001]
[16:11:51.795]      __var hasDormant = __protocol & 0x00020000;
[16:11:51.795]        // -> [hasDormant <= 0x00000000]
[16:11:51.795]      __var protType   = __protocol & 0x0000FFFF;
[16:11:51.795]        // -> [protType <= 0x00000002]
[16:11:51.795]    </block>
[16:11:51.795]    <control if="protType == 1" while="" timeout="0" info="">
[16:11:51.795]      // if-block "protType == 1"
[16:11:51.795]        // =>  FALSE
[16:11:51.795]      // skip if-block "protType == 1"
[16:11:51.795]    </control>
[16:11:51.795]    <control if="protType == 2" while="" timeout="0" info="">
[16:11:51.795]      // if-block "protType == 2"
[16:11:51.795]        // =>  TRUE
[16:11:51.795]      <control if="isSWJ" while="" timeout="0" info="">
[16:11:51.795]        // if-block "isSWJ"
[16:11:51.795]          // =>  TRUE
[16:11:51.795]        <control if="hasDormant" while="" timeout="0" info="">
[16:11:51.795]          // if-block "hasDormant"
[16:11:51.795]            // =>  FALSE
[16:11:51.795]          // skip if-block "hasDormant"
[16:11:51.795]        </control>
[16:11:51.795]        <control if="!hasDormant" while="" timeout="0" info="">
[16:11:51.795]          // if-block "!hasDormant"
[16:11:51.795]            // =>  TRUE
[16:11:51.795]          <block atomic="false" info="">
[16:11:51.795]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[16:11:51.799]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:11:51.799]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[16:11:51.804]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[16:11:51.804]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[16:11:51.805]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:11:51.805]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[16:11:51.809]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[16:11:51.809]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[16:11:51.816]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:11:51.816]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[16:11:51.824]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[16:11:51.824]          </block>
[16:11:51.825]          // end if-block "!hasDormant"
[16:11:51.825]        </control>
[16:11:51.825]        // end if-block "isSWJ"
[16:11:51.825]      </control>
