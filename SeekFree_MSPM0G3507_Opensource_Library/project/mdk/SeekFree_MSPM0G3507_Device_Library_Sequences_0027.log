[15:15:02.327]        // -> [SW_DP_ABORT <= 0x00000000]
[15:15:02.327]      __var DP_CTRL_STAT      = 0x4;
[15:15:02.327]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:15:02.327]      __var DP_SELECT         = 0x8;
[15:15:02.327]        // -> [DP_SELECT <= 0x00000008]
[15:15:02.327]      __var powered_down      = 0;
[15:15:02.327]        // -> [powered_down <= 0x00000000]
[15:15:02.327]      WriteDP(DP_SELECT, 0x00000000);
[15:15:02.334]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:15:02.334]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[15:15:02.336]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[15:15:02.336]        // -> [powered_down <= 0x00000001]
[15:15:02.336]    </block>
[15:15:02.336]    <control if="powered_down" while="" timeout="0" info="">
