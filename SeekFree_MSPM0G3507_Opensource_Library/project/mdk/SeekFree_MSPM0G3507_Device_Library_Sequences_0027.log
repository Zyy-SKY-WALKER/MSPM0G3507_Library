[15:18:05.716]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[15:18:05.716]    <block atomic="false" info="">
[15:18:05.716]      __var SW_DP_ABORT       = 0x0;
[15:18:05.716]        // -> [SW_DP_ABORT <= 0x00000000]
[15:18:05.716]      __var DP_CTRL_STAT      = 0x4;
[15:18:05.716]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:18:05.716]      __var DP_SELECT         = 0x8;
[15:18:05.716]        // -> [DP_SELECT <= 0x00000008]
[15:18:05.716]      __var powered_down      = 0;
[15:18:05.716]        // -> [powered_down <= 0x00000000]
[15:18:05.716]      WriteDP(DP_SELECT, 0x00000000);
[15:18:05.716]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:18:05.716]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[15:18:05.721]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[15:18:05.721]        // -> [powered_down <= 0x00000001]
[15:18:05.721]    </block>
[15:18:05.721]    <control if="powered_down" while="" timeout="0" info="">
[15:18:05.721]      // if-block "powered_down"
[15:18:05.721]        // =>  TRUE
[15:18:05.721]      <block atomic="false" info="">
[15:18:05.721]        Message(0, "Debug/System power-up request sent");
[15:18:05.725]        WriteDP(DP_CTRL_STAT, 0x50000000);
[15:18:05.727]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[15:18:05.727]      </block>
[15:18:05.727]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[15:18:05.727]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[15:18:05.730]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[15:18:05.730]        // while-condition  =>  FALSE
[15:18:05.730]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[15:18:05.730]      </control>
[15:18:05.730]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[15:18:05.730]        // if-block "(__protocol & 0xFFFF) == 1"
[15:18:05.730]          // =>  FALSE
[15:18:05.730]        // skip if-block "(__protocol & 0xFFFF) == 1"
[15:18:05.730]      </control>
[15:18:05.730]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[15:18:05.730]        // if-block "(__protocol & 0xFFFF) == 2"
[15:18:05.730]          // =>  TRUE
[15:18:05.730]        <block atomic="false" info="">
[15:18:05.730]          Message(0, "executing SWD power up");
[15:18:05.731]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:18:05.733]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[15:18:05.733]          WriteDP(SW_DP_ABORT, 0x0000001E);
[15:18:05.736]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[15:18:05.736]        </block>
[15:18:05.736]        // end if-block "(__protocol & 0xFFFF) == 2"
[15:18:05.736]      </control>
[15:18:05.736]      // end if-block "powered_down"
[15:18:05.736]    </control>
[15:18:05.736]    <block atomic="false" info="">
[15:18:05.736]      __var DEBUG_PORT_VAL    = 0;
