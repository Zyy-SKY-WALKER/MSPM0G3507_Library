[17:18:55.329]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[17:18:55.329]    <block atomic="false" info="">
[17:18:55.329]      __var deviceID = 0;
[17:18:55.329]        // -> [deviceID <= 0x00000000]
[17:18:55.329]      __var version = 0;
[17:18:55.329]        // -> [version <= 0x00000000]
[17:18:55.329]      __var partNum = 0;
[17:18:55.329]        // -> [partNum <= 0x00000000]
[17:18:55.329]      __var manuf = 0;
[17:18:55.329]        // -> [manuf <= 0x00000000]
[17:18:55.329]      __var isMSPM0G1X0X_G3X0X = 0;
[17:18:55.329]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:18:55.329]      __var isProduction = 0;
[17:18:55.329]        // -> [isProduction <= 0x00000000]
[17:18:55.329]      __var continueId = 0;
[17:18:55.329]        // -> [continueId <= 0x00000000]
[17:18:55.329]      deviceID =   Read32(0x41C40004);
[17:18:55.336]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[17:18:55.336]        // -> [deviceID <= 0x2BB8802F]
[17:18:55.336]      version = deviceID >> 28;
[17:18:55.336]        // -> [version <= 0x00000002]
[17:18:55.336]      partNum = (deviceID & 0x0FFFF000) >> 12;
[17:18:55.336]        // -> [partNum <= 0x0000BB88]
[17:18:55.336]      manuf = (deviceID & 0x00000FFE) >> 1;
[17:18:55.337]        // -> [manuf <= 0x00000017]
[17:18:55.337]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:18:55.337]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:18:55.337]      isProduction = (version > 0);
[17:18:55.337]        // -> [isProduction <= 0x00000001]
[17:18:55.337]    </block>
[17:18:55.337]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[17:18:55.337]      // if-block "!isMSPM0G1X0X_G3X0X"
[17:18:55.337]        // =>  FALSE
[17:18:55.337]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[17:18:55.337]    </control>
