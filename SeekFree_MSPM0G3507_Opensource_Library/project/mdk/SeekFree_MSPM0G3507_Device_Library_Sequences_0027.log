[16:10:43.369]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[16:10:43.369]    <block atomic="false" info="">
[16:10:43.369]      __var SW_DP_ABORT       = 0x0;
[16:10:43.369]        // -> [SW_DP_ABORT <= 0x00000000]
[16:10:43.369]      __var DP_CTRL_STAT      = 0x4;
[16:10:43.369]        // -> [DP_CTRL_STAT <= 0x00000004]
[16:10:43.369]      __var DP_SELECT         = 0x8;
[16:10:43.369]        // -> [DP_SELECT <= 0x00000008]
[16:10:43.369]      __var powered_down      = 0;
[16:10:43.369]        // -> [powered_down <= 0x00000000]
[16:10:43.369]      WriteDP(DP_SELECT, 0x00000000);
[16:10:43.375]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[16:10:43.375]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[16:10:43.375]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[16:10:43.375]        // -> [powered_down <= 0x00000001]
[16:10:43.375]    </block>
[16:10:43.375]    <control if="powered_down" while="" timeout="0" info="">
