[17:26:19.175]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[17:26:19.175]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:26:19.175]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[17:26:19.175]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[17:26:19.175]          </block>
[17:26:19.175]          // end if-block "!hasDormant"
[17:26:19.180]        </control>
