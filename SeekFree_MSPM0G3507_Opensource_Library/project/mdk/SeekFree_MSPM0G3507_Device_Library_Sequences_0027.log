[16:20:30.719]      // skip if-block "protType == 1"
[16:20:30.719]    </control>
[16:20:30.719]    <control if="protType == 2" while="" timeout="0" info="">
[16:20:30.719]      // if-block "protType == 2"
[16:20:30.719]        // =>  TRUE
[16:20:30.719]      <control if="isSWJ" while="" timeout="0" info="">
[16:20:30.719]        // if-block "isSWJ"
[16:20:30.719]          // =>  TRUE
