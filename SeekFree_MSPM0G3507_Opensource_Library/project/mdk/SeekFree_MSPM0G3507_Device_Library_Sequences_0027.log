[15:30:48.055]      // skip if-block "protType == 1"
[15:30:48.055]    </control>
[15:30:48.055]    <control if="protType == 2" while="" timeout="0" info="">
[15:30:48.055]      // if-block "protType == 2"
[15:30:48.055]        // =>  TRUE
[15:30:48.055]      <control if="isSWJ" while="" timeout="0" info="">
[15:30:48.055]        // if-block "isSWJ"
[15:30:48.055]          // =>  TRUE
[15:30:48.055]        <control if="hasDormant" while="" timeout="0" info="">
[15:30:48.055]          // if-block "hasDormant"
[15:30:48.055]            // =>  FALSE
[15:30:48.055]          // skip if-block "hasDormant"
[15:30:48.055]        </control>
[15:30:48.055]        <control if="!hasDormant" while="" timeout="0" info="">
[15:30:48.055]          // if-block "!hasDormant"
[15:30:48.055]            // =>  TRUE
[15:30:48.055]          <block atomic="false" info="">
[15:30:48.055]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:30:48.060]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:30:48.060]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:30:48.064]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:30:48.064]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:30:48.064]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:30:48.064]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:30:48.064]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:30:48.064]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:30:48.064]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:30:48.064]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:30:48.074]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:30:48.074]          </block>
[15:30:48.074]          // end if-block "!hasDormant"
[15:30:48.074]        </control>
[15:30:48.074]        // end if-block "isSWJ"
[15:30:48.074]      </control>
[15:30:48.074]      <control if="!isSWJ" while="" timeout="0" info="">
[15:30:48.074]        // if-block "!isSWJ"
