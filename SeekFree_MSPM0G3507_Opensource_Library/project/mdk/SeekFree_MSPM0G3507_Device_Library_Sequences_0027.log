[15:00:01.643]        <block atomic="false" info="">
[15:00:01.643]          Message(0, "executing SWD power up");
[15:00:01.643]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:00:01.643]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
