[15:00:01.633]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:00:01.633]      __var DP_SELECT         = 0x8;
[15:00:01.633]        // -> [DP_SELECT <= 0x00000008]
[15:00:01.633]      __var powered_down      = 0;
[15:00:01.633]        // -> [powered_down <= 0x00000000]
[15:00:01.633]      WriteDP(DP_SELECT, 0x00000000);
[15:00:01.633]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:00:01.633]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[15:00:01.638]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[15:00:01.638]        // -> [powered_down <= 0x00000001]
