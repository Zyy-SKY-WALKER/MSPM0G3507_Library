[15:28:09.594]    </control>
[15:28:09.594]    <control if="protType == 2" while="" timeout="0" info="">
[15:28:09.594]      // if-block "protType == 2"
[15:28:09.594]        // =>  TRUE
[15:28:09.594]      <control if="isSWJ" while="" timeout="0" info="">
[15:28:09.594]        // if-block "isSWJ"
[15:28:09.595]          // =>  TRUE
[15:28:09.595]        <control if="hasDormant" while="" timeout="0" info="">
[15:28:09.595]          // if-block "hasDormant"
[15:28:09.595]            // =>  FALSE
[15:28:09.595]          // skip if-block "hasDormant"
[15:28:09.595]        </control>
[15:28:09.595]        <control if="!hasDormant" while="" timeout="0" info="">
[15:28:09.595]          // if-block "!hasDormant"
[15:28:09.595]            // =>  TRUE
[15:28:09.595]          <block atomic="false" info="">
[15:28:09.595]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:28:09.597]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:28:09.597]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:28:09.598]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:28:09.598]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:28:09.601]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:28:09.601]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:28:09.602]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:28:09.602]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:28:09.605]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:28:09.605]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:28:09.606]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:28:09.606]          </block>
[15:28:09.607]          // end if-block "!hasDormant"
