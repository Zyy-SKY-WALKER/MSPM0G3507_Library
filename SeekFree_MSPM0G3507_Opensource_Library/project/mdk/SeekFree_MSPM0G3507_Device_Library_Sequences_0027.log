[17:56:35.614]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[17:56:35.614]    <block atomic="false" info="">
[17:56:35.614]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[17:56:35.614]        // -> [isSWJ <= 0x00000001]
[17:56:35.614]      __var hasDormant = __protocol & 0x00020000;
[17:56:35.614]        // -> [hasDormant <= 0x00000000]
