[15:06:03.030]      // skip if-block "protType == 1"
[15:06:03.030]    </control>
[15:06:03.030]    <control if="protType == 2" while="" timeout="0" info="">
[15:06:03.030]      // if-block "protType == 2"
[15:06:03.030]        // =>  TRUE
[15:06:03.030]      <control if="isSWJ" while="" timeout="0" info="">
[15:06:03.030]        // if-block "isSWJ"
[15:06:03.030]          // =>  TRUE
[15:06:03.030]        <control if="hasDormant" while="" timeout="0" info="">
[15:06:03.030]          // if-block "hasDormant"
[15:06:03.030]            // =>  FALSE
[15:06:03.030]          // skip if-block "hasDormant"
[15:06:03.030]        </control>
[15:06:03.030]        <control if="!hasDormant" while="" timeout="0" info="">
[15:06:03.030]          // if-block "!hasDormant"
[15:06:03.030]            // =>  TRUE
[15:06:03.030]          <block atomic="false" info="">
[15:06:03.030]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:06:03.032]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:06:03.032]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:06:03.035]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:06:03.035]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:06:03.037]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:06:03.037]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:06:03.039]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:06:03.039]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:06:03.040]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:06:03.040]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:06:03.042]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:06:03.042]          </block>
[15:06:03.042]          // end if-block "!hasDormant"
[15:06:03.042]        </control>
[15:06:03.042]        // end if-block "isSWJ"
[15:06:03.042]      </control>
[15:06:03.042]      <control if="!isSWJ" while="" timeout="0" info="">
[15:06:03.042]        // if-block "!isSWJ"
[15:06:03.042]          // =>  FALSE
[15:06:03.042]        // skip if-block "!isSWJ"
