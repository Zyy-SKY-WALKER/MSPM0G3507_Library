[17:40:34.998]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[17:40:34.998]    <block atomic="false" info="">
[17:40:34.998]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[17:40:34.998]        // -> [isSWJ <= 0x00000001]
[17:40:34.998]      __var hasDormant = __protocol & 0x00020000;
[17:40:34.998]        // -> [hasDormant <= 0x00000000]
