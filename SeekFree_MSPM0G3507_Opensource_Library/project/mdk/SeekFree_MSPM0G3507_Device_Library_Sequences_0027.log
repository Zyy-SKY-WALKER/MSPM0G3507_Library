[15:18:05.736]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[15:18:05.737]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[15:18:05.742]      __ap = 4;
[15:18:05.742]        // -> [__ap <= 0x00000004]
[15:18:05.742]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[15:18:05.747]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[15:18:05.747]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[15:18:05.747]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
