[16:10:43.331]        </control>
[16:10:43.331]        <control if="!hasDormant" while="" timeout="0" info="">
[16:10:43.331]          // if-block "!hasDormant"
[16:10:43.331]            // =>  TRUE
[16:10:43.331]          <block atomic="false" info="">
[16:10:43.331]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[16:10:43.331]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:10:43.331]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[16:10:43.331]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[16:10:43.331]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
