[17:34:02.217]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[17:34:02.217]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[17:34:02.217]      __ap = 0; //lets make sure we reset the access point selection
[17:34:02.217]        // -> [__ap <= 0x00000000]
[17:34:02.217]    </block>
