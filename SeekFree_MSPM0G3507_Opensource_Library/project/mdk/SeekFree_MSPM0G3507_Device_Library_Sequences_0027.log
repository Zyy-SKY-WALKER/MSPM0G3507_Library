[17:22:18.870]            // =>  TRUE
[17:22:18.870]          <block atomic="false" info="">
[17:22:18.870]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:22:18.870]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
