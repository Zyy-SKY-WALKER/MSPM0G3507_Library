[15:00:01.731]    __FlashOp=0x00000000
[15:00:01.731]    __Result=0x00000000
[15:00:01.731]  </debugvars>
[15:00:01.731]  
[15:00:01.731]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[15:00:01.731]    <block atomic="false" info="">
[15:00:01.731]      __var deviceID = 0;
[15:00:01.731]        // -> [deviceID <= 0x00000000]
[15:00:01.731]      __var version = 0;
[15:00:01.731]        // -> [version <= 0x00000000]
[15:00:01.731]      __var partNum = 0;
[15:00:01.731]        // -> [partNum <= 0x00000000]
[15:00:01.731]      __var manuf = 0;
[15:00:01.731]        // -> [manuf <= 0x00000000]
[15:00:01.731]      __var isMSPM0G1X0X_G3X0X = 0;
[15:00:01.731]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:00:01.732]      __var isProduction = 0;
[15:00:01.732]        // -> [isProduction <= 0x00000000]
[15:00:01.732]      __var continueId = 0;
[15:00:01.732]        // -> [continueId <= 0x00000000]
[15:00:01.732]      deviceID =   Read32(0x41C40004);
[15:00:01.738]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:00:01.738]        // -> [deviceID <= 0x2BB8802F]
[15:00:01.738]      version = deviceID >> 28;
[15:00:01.738]        // -> [version <= 0x00000002]
[15:00:01.738]      partNum = (deviceID & 0x0FFFF000) >> 12;
[15:00:01.738]        // -> [partNum <= 0x0000BB88]
[15:00:01.738]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:00:01.738]        // -> [manuf <= 0x00000017]
[15:00:01.738]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:00:01.738]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:00:01.738]      isProduction = (version > 0);
[15:00:01.738]        // -> [isProduction <= 0x00000001]
[15:00:01.738]    </block>
[15:00:01.738]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[15:00:01.738]      // if-block "!isMSPM0G1X0X_G3X0X"
[15:00:01.738]        // =>  FALSE
[15:00:01.738]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[15:00:01.738]    </control>
[15:00:01.738]    <control if="continueId == 4" while="" timeout="0" info="">
[15:00:01.738]      // if-block "continueId == 4"
[15:00:01.738]        // =>  FALSE
[15:00:01.738]      // skip if-block "continueId == 4"
[15:00:01.738]    </control>
[15:00:01.738]    <control if="!isProduction" while="" timeout="0" info="">
[15:00:01.738]      // if-block "!isProduction"
[15:00:01.738]        // =>  FALSE
[15:00:01.742]      // skip if-block "!isProduction"
[15:00:01.742]    </control>
[15:00:01.742]  </sequence>
