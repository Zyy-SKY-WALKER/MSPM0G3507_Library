[15:28:09.593]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:28:09.593]    <block atomic="false" info="">
[15:28:09.593]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:28:09.593]        // -> [isSWJ <= 0x00000001]
[15:28:09.593]      __var hasDormant = __protocol & 0x00020000;
[15:28:09.593]        // -> [hasDormant <= 0x00000000]
