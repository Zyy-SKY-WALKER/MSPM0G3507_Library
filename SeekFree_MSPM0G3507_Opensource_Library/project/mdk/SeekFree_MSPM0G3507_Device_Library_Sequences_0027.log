[15:59:39.776]      __var deviceID = 0;
[15:59:39.776]        // -> [deviceID <= 0x00000000]
[15:59:39.776]      __var version = 0;
[15:59:39.776]        // -> [version <= 0x00000000]
[15:59:39.776]      __var partNum = 0;
[15:59:39.776]        // -> [partNum <= 0x00000000]
[15:59:39.776]      __var manuf = 0;
[15:59:39.776]        // -> [manuf <= 0x00000000]
[15:59:39.776]      __var isMSPM0G1X0X_G3X0X = 0;
[15:59:39.776]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:59:39.776]      __var isProduction = 0;
[15:59:39.776]        // -> [isProduction <= 0x00000000]
[15:59:39.776]      __var continueId = 0;
[15:59:39.776]        // -> [continueId <= 0x00000000]
[15:59:39.776]      deviceID =   Read32(0x41C40004);
[15:59:39.781]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:59:39.781]        // -> [deviceID <= 0x2BB8802F]
[15:59:39.781]      version = deviceID >> 28;
[15:59:39.781]        // -> [version <= 0x00000002]
[15:59:39.781]      partNum = (deviceID & 0x0FFFF000) >> 12;
[15:59:39.781]        // -> [partNum <= 0x0000BB88]
[15:59:39.781]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:59:39.781]        // -> [manuf <= 0x00000017]
[15:59:39.781]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:59:39.781]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:59:39.781]      isProduction = (version > 0);
[15:59:39.781]        // -> [isProduction <= 0x00000001]
[15:59:39.781]    </block>
