[15:54:30.807]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:54:30.807]    <block atomic="false" info="">
[15:54:30.807]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:54:30.807]        // -> [isSWJ <= 0x00000001]
[15:54:30.807]      __var hasDormant = __protocol & 0x00020000;
[15:54:30.807]        // -> [hasDormant <= 0x00000000]
