[15:02:22.483]        // -> [manuf <= 0x00000000]
[15:02:22.483]      __var isMSPM0G1X0X_G3X0X = 0;
[15:02:22.483]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:02:22.483]      __var isProduction = 0;
[15:02:22.483]        // -> [isProduction <= 0x00000000]
[15:02:22.483]      __var continueId = 0;
[15:02:22.483]        // -> [continueId <= 0x00000000]
[15:02:22.483]      deviceID =   Read32(0x41C40004);
