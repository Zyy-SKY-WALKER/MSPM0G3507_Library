[15:10:49.871]      // skip if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[15:10:49.871]    </control>
[15:10:49.871]    <block atomic="false" info="">
[15:10:49.871]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[15:10:49.876]        // -> [ReadAP(0x00000000) => 0x0079002F]   (__dp=0x00000000, __ap=0x00000004)
[15:10:49.877]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[15:10:49.877]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
