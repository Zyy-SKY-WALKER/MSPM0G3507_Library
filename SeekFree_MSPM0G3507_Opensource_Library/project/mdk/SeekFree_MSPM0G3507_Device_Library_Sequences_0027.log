[16:08:07.520]            // =>  TRUE
[16:08:07.520]          <block atomic="false" info="">
[16:08:07.520]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[16:08:07.526]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:08:07.526]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[16:08:07.526]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[16:08:07.526]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
