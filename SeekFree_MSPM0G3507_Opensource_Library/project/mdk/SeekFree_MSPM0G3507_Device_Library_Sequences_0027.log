[15:30:48.055]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:30:48.055]    <block atomic="false" info="">
[15:30:48.055]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:30:48.055]        // -> [isSWJ <= 0x00000001]
[15:30:48.055]      __var hasDormant = __protocol & 0x00020000;
[15:30:48.055]        // -> [hasDormant <= 0x00000000]
[15:30:48.055]      __var protType   = __protocol & 0x0000FFFF;
[15:30:48.055]        // -> [protType <= 0x00000002]
