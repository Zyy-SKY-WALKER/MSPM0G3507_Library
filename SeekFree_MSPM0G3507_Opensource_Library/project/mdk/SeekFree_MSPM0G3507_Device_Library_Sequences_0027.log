[17:56:35.614]          // if-block "!hasDormant"
[17:56:35.614]            // =>  TRUE
[17:56:35.614]          <block atomic="false" info="">
[17:56:35.614]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:56:35.617]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:56:35.617]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:56:35.619]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:56:35.619]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
