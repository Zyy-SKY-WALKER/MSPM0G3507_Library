[17:27:14.932]          // =>  FALSE
[17:27:14.932]        // skip if-block "!isSWJ"
[17:27:14.932]      </control>
[17:27:14.932]      <block atomic="false" info="">
[17:27:14.932]        ReadDP(0x0);
[17:27:14.932]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[17:27:14.932]      </block>
[17:27:14.932]      // end if-block "protType == 2"
[17:27:14.932]    </control>
[17:27:14.932]  </sequence>
