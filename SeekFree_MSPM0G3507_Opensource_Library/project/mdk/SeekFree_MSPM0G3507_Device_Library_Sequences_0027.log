[15:54:30.846]        // skip if-block "(__protocol & 0xFFFF) == 1"
[15:54:30.846]      </control>
[15:54:30.846]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[15:54:30.846]        // if-block "(__protocol & 0xFFFF) == 2"
[15:54:30.846]          // =>  TRUE
[15:54:30.846]        <block atomic="false" info="">
[15:54:30.846]          Message(0, "executing SWD power up");
[15:54:30.846]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:54:30.846]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[15:54:30.846]          WriteDP(SW_DP_ABORT, 0x0000001E);
