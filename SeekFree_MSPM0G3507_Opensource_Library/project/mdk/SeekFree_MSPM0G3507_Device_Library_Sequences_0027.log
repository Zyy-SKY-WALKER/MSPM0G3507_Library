[15:30:48.084]      __var DP_CTRL_STAT      = 0x4;
[15:30:48.084]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:30:48.084]      __var DP_SELECT         = 0x8;
[15:30:48.084]        // -> [DP_SELECT <= 0x00000008]
[15:30:48.084]      __var powered_down      = 0;
[15:30:48.084]        // -> [powered_down <= 0x00000000]
[15:30:48.084]      WriteDP(DP_SELECT, 0x00000000);
[15:30:48.084]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:30:48.084]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
