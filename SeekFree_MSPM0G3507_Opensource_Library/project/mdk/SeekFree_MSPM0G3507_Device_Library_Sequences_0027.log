[17:25:26.183]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[17:25:26.183]    <block atomic="false" info="">
[17:25:26.183]      __var deviceID = 0;
[17:25:26.183]        // -> [deviceID <= 0x00000000]
[17:25:26.183]      __var version = 0;
[17:25:26.183]        // -> [version <= 0x00000000]
[17:25:26.183]      __var partNum = 0;
[17:25:26.183]        // -> [partNum <= 0x00000000]
[17:25:26.183]      __var manuf = 0;
[17:25:26.183]        // -> [manuf <= 0x00000000]
[17:25:26.183]      __var isMSPM0G1X0X_G3X0X = 0;
[17:25:26.183]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:25:26.183]      __var isProduction = 0;
[17:25:26.183]        // -> [isProduction <= 0x00000000]
[17:25:26.183]      __var continueId = 0;
[17:25:26.183]        // -> [continueId <= 0x00000000]
[17:25:26.183]      deviceID =   Read32(0x41C40004);
[17:25:26.193]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[17:25:26.193]        // -> [deviceID <= 0x2BB8802F]
[17:25:26.193]      version = deviceID >> 28;
[17:25:26.193]        // -> [version <= 0x00000002]
[17:25:26.193]      partNum = (deviceID & 0x0FFFF000) >> 12;
[17:25:26.193]        // -> [partNum <= 0x0000BB88]
[17:25:26.193]      manuf = (deviceID & 0x00000FFE) >> 1;
[17:25:26.193]        // -> [manuf <= 0x00000017]
[17:25:26.193]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:25:26.193]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:25:26.193]      isProduction = (version > 0);
[17:25:26.193]        // -> [isProduction <= 0x00000001]
[17:25:26.193]    </block>
[17:25:26.193]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
