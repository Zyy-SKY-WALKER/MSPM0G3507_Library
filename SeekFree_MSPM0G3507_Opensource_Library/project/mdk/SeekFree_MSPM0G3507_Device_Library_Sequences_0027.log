[15:52:28.393]      __var SW_DP_ABORT       = 0x0;
[15:52:28.393]        // -> [SW_DP_ABORT <= 0x00000000]
[15:52:28.393]      __var DP_CTRL_STAT      = 0x4;
[15:52:28.393]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:52:28.393]      __var DP_SELECT         = 0x8;
[15:52:28.393]        // -> [DP_SELECT <= 0x00000008]
[15:52:28.393]      __var powered_down      = 0;
[15:52:28.393]        // -> [powered_down <= 0x00000000]
[15:52:28.393]      WriteDP(DP_SELECT, 0x00000000);
[15:52:28.398]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:52:28.398]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
