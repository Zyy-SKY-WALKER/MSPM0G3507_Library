[17:33:10.322]        // -> [partNum <= 0x00000000]
[17:33:10.322]      __var manuf = 0;
[17:33:10.322]        // -> [manuf <= 0x00000000]
[17:33:10.322]      __var isMSPM0G1X0X_G3X0X = 0;
[17:33:10.322]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:33:10.322]      __var isProduction = 0;
[17:33:10.322]        // -> [isProduction <= 0x00000000]
[17:33:10.322]      __var continueId = 0;
[17:33:10.322]        // -> [continueId <= 0x00000000]
[17:33:10.322]      deviceID =   Read32(0x41C40004);
