[15:00:01.685]    <control if="(ACCESS_POINT_VAL & 0x00E00000) == 0" while="" timeout="0" info="">
[15:00:01.685]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[15:00:01.685]        // =>  TRUE
[15:00:01.685]      <block atomic="false" info="">
[15:00:01.685]        WriteAP(0x00, 0x190008);
[15:00:01.690]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[15:00:01.690]        WriteAP(0xF0, 0x01);
[15:00:01.697]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[15:00:01.697]      </block>
[15:00:01.697]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[15:00:01.697]    </control>
[15:00:01.697]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
[15:00:01.697]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[15:00:01.697]        // =>  FALSE
[15:00:01.697]      // skip if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[15:00:01.697]    </control>
[15:00:01.697]    <block atomic="false" info="">
[15:00:01.698]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[15:00:01.701]        // -> [ReadAP(0x00000000) => 0x0079002F]   (__dp=0x00000000, __ap=0x00000004)
[15:00:01.701]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[15:00:01.701]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[15:00:01.701]      __ap = 0; //lets make sure we reset the access point selection
[15:00:01.704]        // -> [__ap <= 0x00000000]
[15:00:01.704]    </block>
[15:00:01.704]  </sequence>
