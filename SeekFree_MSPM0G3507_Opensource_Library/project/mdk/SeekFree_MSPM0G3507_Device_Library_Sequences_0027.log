[16:11:51.825]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[16:11:51.825]      </block>
[16:11:51.825]      // end if-block "protType == 2"
[16:11:51.825]    </control>
[16:11:51.825]  </sequence>
