[14:49:10.461]        // if-block "isSWJ"
[14:49:10.461]          // =>  TRUE
[14:49:10.461]        <control if="hasDormant" while="" timeout="0" info="">
[14:49:10.461]          // if-block "hasDormant"
[14:49:10.461]            // =>  FALSE
[14:49:10.461]          // skip if-block "hasDormant"
[14:49:10.461]        </control>
[14:49:10.461]        <control if="!hasDormant" while="" timeout="0" info="">
[14:49:10.461]          // if-block "!hasDormant"
[14:49:10.461]            // =>  TRUE
[14:49:10.462]          <block atomic="false" info="">
[14:49:10.462]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[14:49:10.463]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[14:49:10.463]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[14:49:10.465]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[14:49:10.465]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[14:49:10.467]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[14:49:10.467]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[14:49:10.469]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[14:49:10.469]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[14:49:10.470]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[14:49:10.470]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[14:49:10.470]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[14:49:10.470]          </block>
[14:49:10.470]          // end if-block "!hasDormant"
[14:49:10.470]        </control>
[14:49:10.470]        // end if-block "isSWJ"
[14:49:10.470]      </control>
