[17:28:53.961]        // -> [manuf <= 0x00000017]
[17:28:53.961]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:28:53.961]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
