[17:20:17.905]      // skip if-block "protType == 1"
[17:20:17.905]    </control>
[17:20:17.905]    <control if="protType == 2" while="" timeout="0" info="">
[17:20:17.905]      // if-block "protType == 2"
[17:20:17.905]        // =>  TRUE
[17:20:17.905]      <control if="isSWJ" while="" timeout="0" info="">
[17:20:17.905]        // if-block "isSWJ"
[17:20:17.905]          // =>  TRUE
[17:20:17.905]        <control if="hasDormant" while="" timeout="0" info="">
[17:20:17.905]          // if-block "hasDormant"
[17:20:17.905]            // =>  FALSE
[17:20:17.905]          // skip if-block "hasDormant"
[17:20:17.905]        </control>
[17:20:17.905]        <control if="!hasDormant" while="" timeout="0" info="">
[17:20:17.905]          // if-block "!hasDormant"
[17:20:17.905]            // =>  TRUE
[17:20:17.905]          <block atomic="false" info="">
[17:20:17.905]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:20:17.907]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:20:17.907]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:20:17.910]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:20:17.911]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:20:17.913]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:20:17.913]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
