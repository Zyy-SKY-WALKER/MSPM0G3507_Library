[14:24:14.689]        // =>  FALSE
[14:24:14.689]      // skip if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[14:24:14.689]    </control>
[14:24:14.689]    <block atomic="false" info="">
[14:24:14.689]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[14:24:14.695]        // -> [ReadAP(0x00000000) => 0x0079002F]   (__dp=0x00000000, __ap=0x00000004)
[14:24:14.695]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[14:24:14.695]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
