[15:52:28.405]        <block atomic="false" info="">
[15:52:28.405]          Message(0, "executing SWD power up");
[15:52:28.409]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:52:28.409]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[15:52:28.409]          WriteDP(SW_DP_ABORT, 0x0000001E);
