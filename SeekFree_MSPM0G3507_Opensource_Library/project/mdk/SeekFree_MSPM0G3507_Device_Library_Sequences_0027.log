[15:06:03.029]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:06:03.029]    <block atomic="false" info="">
[15:06:03.029]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:06:03.029]        // -> [isSWJ <= 0x00000001]
[15:06:03.029]      __var hasDormant = __protocol & 0x00020000;
[15:06:03.029]        // -> [hasDormant <= 0x00000000]
