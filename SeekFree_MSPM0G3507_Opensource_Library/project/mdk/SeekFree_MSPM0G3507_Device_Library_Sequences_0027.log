[17:38:01.687]        // -> [manuf <= 0x00000000]
[17:38:01.687]      __var isMSPM0G1X0X_G3X0X = 0;
[17:38:01.687]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:38:01.687]      __var isProduction = 0;
[17:38:01.687]        // -> [isProduction <= 0x00000000]
[17:38:01.687]      __var continueId = 0;
