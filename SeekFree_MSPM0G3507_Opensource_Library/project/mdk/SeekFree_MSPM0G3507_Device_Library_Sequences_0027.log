[17:53:53.839]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[17:53:53.839]    <block atomic="false" info="">
[17:53:53.839]      __var deviceID = 0;
[17:53:53.839]        // -> [deviceID <= 0x00000000]
[17:53:53.839]      __var version = 0;
[17:53:53.839]        // -> [version <= 0x00000000]
[17:53:53.839]      __var partNum = 0;
[17:53:53.839]        // -> [partNum <= 0x00000000]
[17:53:53.839]      __var manuf = 0;
[17:53:53.839]        // -> [manuf <= 0x00000000]
[17:53:53.839]      __var isMSPM0G1X0X_G3X0X = 0;
[17:53:53.839]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:53:53.839]      __var isProduction = 0;
[17:53:53.839]        // -> [isProduction <= 0x00000000]
[17:53:53.839]      __var continueId = 0;
[17:53:53.839]        // -> [continueId <= 0x00000000]
[17:53:53.839]      deviceID =   Read32(0x41C40004);
[17:53:53.846]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[17:53:53.846]        // -> [deviceID <= 0x2BB8802F]
[17:53:53.846]      version = deviceID >> 28;
[17:53:53.846]        // -> [version <= 0x00000002]
[17:53:53.846]      partNum = (deviceID & 0x0FFFF000) >> 12;
[17:53:53.846]        // -> [partNum <= 0x0000BB88]
[17:53:53.846]      manuf = (deviceID & 0x00000FFE) >> 1;
[17:53:53.846]        // -> [manuf <= 0x00000017]
[17:53:53.846]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:53:53.846]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:53:53.846]      isProduction = (version > 0);
[17:53:53.846]        // -> [isProduction <= 0x00000001]
[17:53:53.846]    </block>
[17:53:53.846]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[17:53:53.846]      // if-block "!isMSPM0G1X0X_G3X0X"
[17:53:53.846]        // =>  FALSE
[17:53:53.846]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[17:53:53.846]    </control>
[17:53:53.846]    <control if="continueId == 4" while="" timeout="0" info="">
[17:53:53.846]      // if-block "continueId == 4"
[17:53:53.846]        // =>  FALSE
[17:53:53.846]      // skip if-block "continueId == 4"
[17:53:53.846]    </control>
[17:53:53.846]    <control if="!isProduction" while="" timeout="0" info="">
[17:53:53.846]      // if-block "!isProduction"
[17:53:53.846]        // =>  FALSE
