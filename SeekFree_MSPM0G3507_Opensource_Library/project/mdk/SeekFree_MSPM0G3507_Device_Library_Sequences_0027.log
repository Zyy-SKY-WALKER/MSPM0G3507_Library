[14:37:39.667]      __var isProduction = 0;
[14:37:39.667]        // -> [isProduction <= 0x00000000]
[14:37:39.667]      __var continueId = 0;
[14:37:39.667]        // -> [continueId <= 0x00000000]
[14:37:39.667]      deviceID =   Read32(0x41C40004);
[14:37:39.678]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[14:37:39.678]        // -> [deviceID <= 0x2BB8802F]
[14:37:39.678]      version = deviceID >> 28;
[14:37:39.678]        // -> [version <= 0x00000002]
[14:37:39.678]      partNum = (deviceID & 0x0FFFF000) >> 12;
[14:37:39.678]        // -> [partNum <= 0x0000BB88]
[14:37:39.678]      manuf = (deviceID & 0x00000FFE) >> 1;
[14:37:39.678]        // -> [manuf <= 0x00000017]
[14:37:39.678]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[14:37:39.678]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[14:37:39.678]      isProduction = (version > 0);
[14:37:39.678]        // -> [isProduction <= 0x00000001]
[14:37:39.678]    </block>
[14:37:39.678]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
