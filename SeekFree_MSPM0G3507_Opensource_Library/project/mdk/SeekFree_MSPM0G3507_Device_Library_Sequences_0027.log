[17:26:19.165]        </control>
[17:26:19.165]        <control if="!hasDormant" while="" timeout="0" info="">
[17:26:19.165]          // if-block "!hasDormant"
[17:26:19.165]            // =>  TRUE
[17:26:19.165]          <block atomic="false" info="">
[17:26:19.165]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:26:19.165]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:26:19.170]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:26:19.170]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:26:19.170]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:26:19.170]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:26:19.170]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
