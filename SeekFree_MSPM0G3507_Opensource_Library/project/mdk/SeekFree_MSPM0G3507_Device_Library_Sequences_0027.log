[17:25:26.077]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:25:26.077]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
