[17:34:02.135]        // skip if-block "!isSWJ"
[17:34:02.135]      </control>
[17:34:02.135]      <block atomic="false" info="">
[17:34:02.135]        ReadDP(0x0);
[17:34:02.137]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[17:34:02.137]      </block>
[17:34:02.137]      // end if-block "protType == 2"
[17:34:02.137]    </control>
