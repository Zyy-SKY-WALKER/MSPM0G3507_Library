[15:51:55.763]        // -> [deviceID <= 0x2BB8802F]
[15:51:55.763]      version = deviceID >> 28;
[15:51:55.763]        // -> [version <= 0x00000002]
[15:51:55.763]      partNum = (deviceID & 0x0FFFF000) >> 12;
[15:51:55.763]        // -> [partNum <= 0x0000BB88]
[15:51:55.763]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:51:55.763]        // -> [manuf <= 0x00000017]
[15:51:55.763]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:51:55.763]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:51:55.763]      isProduction = (version > 0);
[15:51:55.763]        // -> [isProduction <= 0x00000001]
[15:51:55.763]    </block>
[15:51:55.763]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
