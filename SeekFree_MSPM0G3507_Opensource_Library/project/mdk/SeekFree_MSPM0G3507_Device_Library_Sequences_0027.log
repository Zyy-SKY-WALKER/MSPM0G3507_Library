[15:51:55.637]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:51:55.637]    <block atomic="false" info="">
[15:51:55.637]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:51:55.637]        // -> [isSWJ <= 0x00000001]
[15:51:55.637]      __var hasDormant = __protocol & 0x00020000;
[15:51:55.637]        // -> [hasDormant <= 0x00000000]
