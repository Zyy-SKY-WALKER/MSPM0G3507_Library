[17:50:40.200]      __var powered_down      = 0;
[17:50:40.200]        // -> [powered_down <= 0x00000000]
[17:50:40.200]      WriteDP(DP_SELECT, 0x00000000);
[17:50:40.200]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[17:50:40.200]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[17:50:40.205]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[17:50:40.205]        // -> [powered_down <= 0x00000001]
[17:50:40.205]    </block>
[17:50:40.205]    <control if="powered_down" while="" timeout="0" info="">
[17:50:40.205]      // if-block "powered_down"
[17:50:40.205]        // =>  TRUE
[17:50:40.205]      <block atomic="false" info="">
[17:50:40.205]        Message(0, "Debug/System power-up request sent");
[17:50:40.205]        WriteDP(DP_CTRL_STAT, 0x50000000);
[17:50:40.205]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[17:50:40.205]      </block>
[17:50:40.205]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[17:50:40.205]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[17:50:40.210]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[17:50:40.210]        // while-condition  =>  FALSE
[17:50:40.210]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[17:50:40.210]      </control>
[17:50:40.210]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[17:50:40.210]        // if-block "(__protocol & 0xFFFF) == 1"
[17:50:40.210]          // =>  FALSE
[17:50:40.210]        // skip if-block "(__protocol & 0xFFFF) == 1"
[17:50:40.210]      </control>
[17:50:40.210]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[17:50:40.210]        // if-block "(__protocol & 0xFFFF) == 2"
[17:50:40.210]          // =>  TRUE
[17:50:40.210]        <block atomic="false" info="">
[17:50:40.210]          Message(0, "executing SWD power up");
[17:50:40.210]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[17:50:40.210]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[17:50:40.210]          WriteDP(SW_DP_ABORT, 0x0000001E);
[17:50:40.215]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[17:50:40.215]        </block>
[17:50:40.215]        // end if-block "(__protocol & 0xFFFF) == 2"
[17:50:40.215]      </control>
[17:50:40.215]      // end if-block "powered_down"
[17:50:40.215]    </control>
[17:50:40.215]    <block atomic="false" info="">
[17:50:40.215]      __var DEBUG_PORT_VAL    = 0;
[17:50:40.215]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[17:50:40.215]      __var ACCESS_POINT_VAL  = 0;
[17:50:40.215]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[17:50:40.215]      __ap = 1; 
[17:50:40.215]        // -> [__ap <= 0x00000001]
[17:50:40.215]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[17:50:40.220]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[17:50:40.220]      __ap = 4;
[17:50:40.220]        // -> [__ap <= 0x00000004]
[17:50:40.220]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[17:50:40.220]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[17:50:40.220]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[17:50:40.220]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[17:50:40.220]    </block>
[17:50:40.220]    <block atomic="false" info="">
[17:50:40.220]      __var nReset = 0x80;
[17:50:40.220]        // -> [nReset <= 0x00000080]
