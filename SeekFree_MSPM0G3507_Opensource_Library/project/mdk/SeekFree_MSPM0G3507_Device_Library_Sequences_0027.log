[15:02:22.493]        // -> [partNum <= 0x0000BB88]
[15:02:22.493]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:02:22.493]        // -> [manuf <= 0x00000017]
[15:02:22.493]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
