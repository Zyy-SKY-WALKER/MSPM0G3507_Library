[17:49:34.377]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[17:49:34.377]    <block atomic="false" info="">
[17:49:34.377]      __var SW_DP_ABORT       = 0x0;
[17:49:34.377]        // -> [SW_DP_ABORT <= 0x00000000]
[17:49:34.377]      __var DP_CTRL_STAT      = 0x4;
[17:49:34.377]        // -> [DP_CTRL_STAT <= 0x00000004]
[17:49:34.377]      __var DP_SELECT         = 0x8;
[17:49:34.377]        // -> [DP_SELECT <= 0x00000008]
[17:49:34.377]      __var powered_down      = 0;
[17:49:34.377]        // -> [powered_down <= 0x00000000]
[17:49:34.377]      WriteDP(DP_SELECT, 0x00000000);
[17:49:34.379]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[17:49:34.379]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[17:49:34.384]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[17:49:34.384]        // -> [powered_down <= 0x00000001]
