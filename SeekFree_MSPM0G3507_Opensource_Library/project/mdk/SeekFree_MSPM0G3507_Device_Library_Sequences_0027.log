[17:08:48.209]          // if-block "!hasDormant"
[17:08:48.209]            // =>  TRUE
[17:08:48.209]          <block atomic="false" info="">
[17:08:48.209]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:08:48.216]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:08:48.216]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:08:48.218]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:08:48.218]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:08:48.220]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:08:48.220]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[17:08:48.222]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[17:08:48.222]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[17:08:48.223]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:08:48.224]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[17:08:48.228]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[17:08:48.228]          </block>
