[16:20:30.750]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[16:20:30.750]    <block atomic="false" info="">
[16:20:30.750]      __var SW_DP_ABORT       = 0x0;
[16:20:30.750]        // -> [SW_DP_ABORT <= 0x00000000]
[16:20:30.750]      __var DP_CTRL_STAT      = 0x4;
[16:20:30.750]        // -> [DP_CTRL_STAT <= 0x00000004]
[16:20:30.750]      __var DP_SELECT         = 0x8;
[16:20:30.750]        // -> [DP_SELECT <= 0x00000008]
[16:20:30.750]      __var powered_down      = 0;
[16:20:30.750]        // -> [powered_down <= 0x00000000]
[16:20:30.750]      WriteDP(DP_SELECT, 0x00000000);
[16:20:30.750]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[16:20:30.754]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[16:20:30.755]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[16:20:30.755]        // -> [powered_down <= 0x00000001]
[16:20:30.755]    </block>
[16:20:30.755]    <control if="powered_down" while="" timeout="0" info="">
[16:20:30.755]      // if-block "powered_down"
[16:20:30.755]        // =>  TRUE
[16:20:30.755]      <block atomic="false" info="">
[16:20:30.755]        Message(0, "Debug/System power-up request sent");
[16:20:30.755]        WriteDP(DP_CTRL_STAT, 0x50000000);
[16:20:30.760]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[16:20:30.760]      </block>
[16:20:30.760]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[16:20:30.760]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[16:20:30.760]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[16:20:30.760]        // while-condition  =>  FALSE
[16:20:30.760]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[16:20:30.760]      </control>
[16:20:30.760]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[16:20:30.760]        // if-block "(__protocol & 0xFFFF) == 1"
[16:20:30.760]          // =>  FALSE
[16:20:30.760]        // skip if-block "(__protocol & 0xFFFF) == 1"
[16:20:30.760]      </control>
[16:20:30.760]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[16:20:30.760]        // if-block "(__protocol & 0xFFFF) == 2"
[16:20:30.760]          // =>  TRUE
[16:20:30.760]        <block atomic="false" info="">
[16:20:30.760]          Message(0, "executing SWD power up");
[16:20:30.765]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[16:20:30.765]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[16:20:30.765]          WriteDP(SW_DP_ABORT, 0x0000001E);
[16:20:30.765]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[16:20:30.765]        </block>
[16:20:30.765]        // end if-block "(__protocol & 0xFFFF) == 2"
[16:20:30.765]      </control>
[16:20:30.765]      // end if-block "powered_down"
[16:20:30.765]    </control>
[16:20:30.765]    <block atomic="false" info="">
[16:20:30.765]      __var DEBUG_PORT_VAL    = 0;
[16:20:30.765]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[16:20:30.765]      __var ACCESS_POINT_VAL  = 0;
[16:20:30.765]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[16:20:30.765]      __ap = 1; 
[16:20:30.765]        // -> [__ap <= 0x00000001]
[16:20:30.765]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[16:20:30.770]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[16:20:30.770]      __ap = 4;
[16:20:30.770]        // -> [__ap <= 0x00000004]
[16:20:30.770]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[16:20:30.775]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[16:20:30.790]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[16:20:30.805]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[16:20:30.805]    </block>
[16:20:30.805]    <block atomic="false" info="">
[16:20:30.805]      __var nReset = 0x80;
[16:20:30.805]        // -> [nReset <= 0x00000080]
[16:20:30.805]      __var canReadPins = 0;
[16:20:30.805]        // -> [canReadPins <= 0x00000000]
[16:20:30.805]      canReadPins = (DAP_SWJ_Pins(0x00, nReset, 0) != 0xFFFFFFFF);
[16:20:30.805]        // -> [DAP_SWJ_Pins(0x00, 0x80, 0) => 0x0F]   (Out: nRESET=0  =>  In: SWCLK/TCK=1, SWDIO/TMS=1, TDI=1, TDO=1, nTRST=0, nRESET=0)
[16:20:30.805]        // -> [canReadPins <= 0x00000001]
[16:20:30.805]    </block>
[16:20:30.805]    <control if="" while="1" timeout="200" info="">
[16:20:30.805]      // while "1"  (timeout="200")
[16:20:30.805]      // while-condition  =>  TRUE
[16:20:30.814]      // while "1"  (timeout="200")
[16:20:30.814]      // while  =>  TIMEOUT
[16:20:30.814]      // end while "1"
[16:20:30.814]    </control>
[16:20:30.814]    <control if="canReadPins" while="" timeout="0" info="">
[16:20:30.814]      // if-block "canReadPins"
[16:20:30.814]        // =>  TRUE
[16:20:30.814]      <control if="" while="(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0" timeout="1000000" info="">
[16:20:30.814]        // while "(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0"  (timeout="1000000")
[16:20:30.816]          // -> [DAP_SWJ_Pins(0x80, 0x80, 0) => 0x8F]   (Out: nRESET=1  =>  In: SWCLK/TCK=1, SWDIO/TMS=1, TDI=1, TDO=1, nTRST=0, nRESET=1)
[16:20:30.816]        // while-condition  =>  FALSE
[16:20:30.816]        // end while "(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0"
[16:20:30.816]      </control>
[16:20:30.816]      // end if-block "canReadPins"
[16:20:30.816]    </control>
[16:20:30.816]    <control if="!canReadPins" while="" timeout="0" info="">
[16:20:30.816]      // if-block "!canReadPins"
[16:20:30.816]        // =>  FALSE
[16:20:30.816]      // skip if-block "!canReadPins"
[16:20:30.816]    </control>
[16:20:30.816]    <control if="(ACCESS_POINT_VAL & 0x00E00000) == 0" while="" timeout="0" info="">
[16:20:30.816]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[16:20:30.816]        // =>  TRUE
[16:20:30.816]      <block atomic="false" info="">
[16:20:30.816]        WriteAP(0x00, 0x190008);
[16:20:30.819]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[16:20:30.819]        WriteAP(0xF0, 0x01);
[16:20:30.819]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[16:20:30.819]      </block>
[16:20:30.819]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[16:20:30.819]    </control>
[16:20:30.819]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
[16:20:30.819]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[16:20:30.819]        // =>  FALSE
[16:20:30.819]      // skip if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[16:20:30.819]    </control>
[16:20:30.819]    <block atomic="false" info="">
[16:20:30.819]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[16:20:30.826]        // -> [ReadAP(0x00000000) => 0x0079002F]   (__dp=0x00000000, __ap=0x00000004)
[16:20:30.826]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[16:20:30.826]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[16:20:30.826]      __ap = 0; //lets make sure we reset the access point selection
[16:20:30.826]        // -> [__ap <= 0x00000000]
[16:20:30.826]    </block>
[16:20:30.826]  </sequence>
