[15:59:39.567]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:59:39.567]    <block atomic="false" info="">
[15:59:39.567]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:59:39.567]        // -> [isSWJ <= 0x00000001]
[15:59:39.567]      __var hasDormant = __protocol & 0x00020000;
[15:59:39.567]        // -> [hasDormant <= 0x00000000]
