[17:34:02.237]      __var deviceID = 0;
[17:34:02.237]        // -> [deviceID <= 0x00000000]
[17:34:02.237]      __var version = 0;
[17:34:02.237]        // -> [version <= 0x00000000]
[17:34:02.237]      __var partNum = 0;
[17:34:02.237]        // -> [partNum <= 0x00000000]
[17:34:02.237]      __var manuf = 0;
[17:34:02.237]        // -> [manuf <= 0x00000000]
[17:34:02.237]      __var isMSPM0G1X0X_G3X0X = 0;
[17:34:02.237]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:34:02.237]      __var isProduction = 0;
[17:34:02.237]        // -> [isProduction <= 0x00000000]
[17:34:02.237]      __var continueId = 0;
[17:34:02.242]        // -> [continueId <= 0x00000000]
[17:34:02.242]      deviceID =   Read32(0x41C40004);
[17:34:02.248]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[17:34:02.248]        // -> [deviceID <= 0x2BB8802F]
[17:34:02.248]      version = deviceID >> 28;
[17:34:02.248]        // -> [version <= 0x00000002]
[17:34:02.248]      partNum = (deviceID & 0x0FFFF000) >> 12;
[17:34:02.248]        // -> [partNum <= 0x0000BB88]
[17:34:02.251]      manuf = (deviceID & 0x00000FFE) >> 1;
[17:34:02.251]        // -> [manuf <= 0x00000017]
[17:34:02.251]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:34:02.251]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:34:02.251]      isProduction = (version > 0);
[17:34:02.251]        // -> [isProduction <= 0x00000001]
[17:34:02.251]    </block>
[17:34:02.251]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
