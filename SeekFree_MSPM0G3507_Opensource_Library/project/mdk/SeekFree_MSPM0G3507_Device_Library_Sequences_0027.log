[15:10:49.899]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[15:10:49.899]    <block atomic="false" info="">
[15:10:49.899]      __var deviceID = 0;
[15:10:49.900]        // -> [deviceID <= 0x00000000]
[15:10:49.900]      __var version = 0;
[15:10:49.900]        // -> [version <= 0x00000000]
[15:10:49.900]      __var partNum = 0;
[15:10:49.900]        // -> [partNum <= 0x00000000]
[15:10:49.900]      __var manuf = 0;
[15:10:49.900]        // -> [manuf <= 0x00000000]
[15:10:49.900]      __var isMSPM0G1X0X_G3X0X = 0;
[15:10:49.901]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:10:49.901]      __var isProduction = 0;
[15:10:49.901]        // -> [isProduction <= 0x00000000]
[15:10:49.901]      __var continueId = 0;
[15:10:49.901]        // -> [continueId <= 0x00000000]
[15:10:49.901]      deviceID =   Read32(0x41C40004);
[15:10:49.920]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:10:49.920]        // -> [deviceID <= 0x2BB8802F]
[15:10:49.920]      version = deviceID >> 28;
[15:10:49.920]        // -> [version <= 0x00000002]
[15:10:49.920]      partNum = (deviceID & 0x0FFFF000) >> 12;
[15:10:49.920]        // -> [partNum <= 0x0000BB88]
[15:10:49.920]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:10:49.920]        // -> [manuf <= 0x00000017]
[15:10:49.920]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:10:49.920]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:10:49.920]      isProduction = (version > 0);
[15:10:49.920]        // -> [isProduction <= 0x00000001]
