[13:58:10.786]        // -> [partNum <= 0x00000000]
[13:58:10.786]      __var manuf = 0;
[13:58:10.786]        // -> [manuf <= 0x00000000]
[13:58:10.786]      __var isMSPM0G1X0X_G3X0X = 0;
[13:58:10.786]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[13:58:10.786]      __var isProduction = 0;
[13:58:10.787]        // -> [isProduction <= 0x00000000]
[13:58:10.787]      __var continueId = 0;
