[15:02:22.373]  
[15:02:22.373]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:02:22.373]    <block atomic="false" info="">
[15:02:22.373]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:02:22.373]        // -> [isSWJ <= 0x00000001]
[15:02:22.373]      __var hasDormant = __protocol & 0x00020000;
[15:02:22.373]        // -> [hasDormant <= 0x00000000]
[15:02:22.373]      __var protType   = __protocol & 0x0000FFFF;
[15:02:22.373]        // -> [protType <= 0x00000002]
[15:02:22.373]    </block>
[15:02:22.373]    <control if="protType == 1" while="" timeout="0" info="">
[15:02:22.373]      // if-block "protType == 1"
[15:02:22.373]        // =>  FALSE
[15:02:22.373]      // skip if-block "protType == 1"
[15:02:22.373]    </control>
[15:02:22.373]    <control if="protType == 2" while="" timeout="0" info="">
[15:02:22.373]      // if-block "protType == 2"
[15:02:22.373]        // =>  TRUE
[15:02:22.373]      <control if="isSWJ" while="" timeout="0" info="">
[15:02:22.373]        // if-block "isSWJ"
[15:02:22.373]          // =>  TRUE
[15:02:22.373]        <control if="hasDormant" while="" timeout="0" info="">
[15:02:22.373]          // if-block "hasDormant"
[15:02:22.373]            // =>  FALSE
[15:02:22.373]          // skip if-block "hasDormant"
[15:02:22.373]        </control>
[15:02:22.373]        <control if="!hasDormant" while="" timeout="0" info="">
[15:02:22.373]          // if-block "!hasDormant"
[15:02:22.373]            // =>  TRUE
[15:02:22.373]          <block atomic="false" info="">
[15:02:22.373]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:02:22.373]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:02:22.373]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:02:22.378]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:02:22.378]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:02:22.378]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:02:22.378]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:02:22.378]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:02:22.384]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:02:22.384]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:02:22.384]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:02:22.384]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:02:22.384]          </block>
