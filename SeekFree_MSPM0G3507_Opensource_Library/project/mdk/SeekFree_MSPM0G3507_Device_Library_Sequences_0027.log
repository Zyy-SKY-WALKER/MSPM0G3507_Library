[14:24:14.684]    <control if="(ACCESS_POINT_VAL & 0x00E00000) == 0" while="" timeout="0" info="">
[14:24:14.684]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[14:24:14.684]        // =>  TRUE
[14:24:14.684]      <block atomic="false" info="">
[14:24:14.684]        WriteAP(0x00, 0x190008);
[14:24:14.689]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[14:24:14.689]        WriteAP(0xF0, 0x01);
[14:24:14.689]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[14:24:14.689]      </block>
[14:24:14.689]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[14:24:14.689]    </control>
[14:24:14.689]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
