[17:30:07.744]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[17:30:07.744]    <block atomic="false" info="">
[17:30:07.744]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[17:30:07.744]        // -> [isSWJ <= 0x00000001]
[17:30:07.744]      __var hasDormant = __protocol & 0x00020000;
[17:30:07.744]        // -> [hasDormant <= 0x00000000]
