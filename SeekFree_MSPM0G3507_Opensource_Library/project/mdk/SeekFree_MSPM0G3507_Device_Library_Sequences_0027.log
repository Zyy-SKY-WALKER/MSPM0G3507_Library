[17:49:34.458]      __var isProduction = 0;
[17:49:34.458]        // -> [isProduction <= 0x00000000]
[17:49:34.458]      __var continueId = 0;
[17:49:34.458]        // -> [continueId <= 0x00000000]
[17:49:34.458]      deviceID =   Read32(0x41C40004);
