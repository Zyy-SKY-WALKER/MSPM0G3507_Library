[16:20:30.719]          // if-block "hasDormant"
[16:20:30.719]            // =>  FALSE
[16:20:30.724]          // skip if-block "hasDormant"
[16:20:30.724]        </control>
[16:20:30.724]        <control if="!hasDormant" while="" timeout="0" info="">
[16:20:30.724]          // if-block "!hasDormant"
[16:20:30.724]            // =>  TRUE
[16:20:30.724]          <block atomic="false" info="">
[16:20:30.724]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[16:20:30.726]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:20:30.726]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[16:20:30.726]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[16:20:30.726]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[16:20:30.730]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:20:30.730]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[16:20:30.730]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[16:20:30.730]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[16:20:30.734]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:20:30.734]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[16:20:30.735]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[16:20:30.735]          </block>
[16:20:30.735]          // end if-block "!hasDormant"
[16:20:30.735]        </control>
[16:20:30.735]        // end if-block "isSWJ"
[16:20:30.735]      </control>
[16:20:30.735]      <control if="!isSWJ" while="" timeout="0" info="">
[16:20:30.735]        // if-block "!isSWJ"
[16:20:30.735]          // =>  FALSE
[16:20:30.735]        // skip if-block "!isSWJ"
[16:20:30.735]      </control>
[16:20:30.735]      <block atomic="false" info="">
[16:20:30.735]        ReadDP(0x0);
[16:20:30.739]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[16:20:30.745]      </block>
[16:20:30.745]      // end if-block "protType == 2"
[16:20:30.745]    </control>
[16:20:30.745]  </sequence>
