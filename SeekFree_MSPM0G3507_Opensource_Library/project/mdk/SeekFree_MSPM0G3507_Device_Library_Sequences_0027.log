[15:51:55.661]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[15:51:55.661]    <block atomic="false" info="">
[15:51:55.661]      __var SW_DP_ABORT       = 0x0;
[15:51:55.661]        // -> [SW_DP_ABORT <= 0x00000000]
[15:51:55.661]      __var DP_CTRL_STAT      = 0x4;
[15:51:55.661]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:51:55.661]      __var DP_SELECT         = 0x8;
[15:51:55.661]        // -> [DP_SELECT <= 0x00000008]
[15:51:55.661]      __var powered_down      = 0;
[15:51:55.661]        // -> [powered_down <= 0x00000000]
[15:51:55.661]      WriteDP(DP_SELECT, 0x00000000);
[15:51:55.661]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:51:55.661]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[15:51:55.668]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[15:51:55.668]        // -> [powered_down <= 0x00000001]
[15:51:55.668]    </block>
[15:51:55.668]    <control if="powered_down" while="" timeout="0" info="">
[15:51:55.668]      // if-block "powered_down"
[15:51:55.668]        // =>  TRUE
[15:51:55.668]      <block atomic="false" info="">
[15:51:55.668]        Message(0, "Debug/System power-up request sent");
[15:51:55.670]        WriteDP(DP_CTRL_STAT, 0x50000000);
[15:51:55.672]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[15:51:55.672]      </block>
[15:51:55.672]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[15:51:55.672]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[15:51:55.676]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[15:51:55.676]        // while-condition  =>  FALSE
[15:51:55.676]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[15:51:55.676]      </control>
[15:51:55.676]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[15:51:55.676]        // if-block "(__protocol & 0xFFFF) == 1"
[15:51:55.676]          // =>  FALSE
[15:51:55.676]        // skip if-block "(__protocol & 0xFFFF) == 1"
[15:51:55.676]      </control>
[15:51:55.676]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[15:51:55.676]        // if-block "(__protocol & 0xFFFF) == 2"
[15:51:55.676]          // =>  TRUE
[15:51:55.676]        <block atomic="false" info="">
[15:51:55.676]          Message(0, "executing SWD power up");
[15:51:55.676]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:51:55.682]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[15:51:55.682]          WriteDP(SW_DP_ABORT, 0x0000001E);
[15:51:55.682]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[15:51:55.682]        </block>
[15:51:55.682]        // end if-block "(__protocol & 0xFFFF) == 2"
[15:51:55.682]      </control>
[15:51:55.686]      // end if-block "powered_down"
[15:51:55.686]    </control>
[15:51:55.687]    <block atomic="false" info="">
[15:51:55.687]      __var DEBUG_PORT_VAL    = 0;
[15:51:55.687]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[15:51:55.687]      __var ACCESS_POINT_VAL  = 0;
[15:51:55.687]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[15:51:55.687]      __ap = 1; 
[15:51:55.687]        // -> [__ap <= 0x00000001]
[15:51:55.687]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[15:51:55.690]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[15:51:55.690]      __ap = 4;
[15:51:55.690]        // -> [__ap <= 0x00000004]
[15:51:55.690]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[15:51:55.693]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[15:51:55.693]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[15:51:55.693]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[15:51:55.693]    </block>
[15:51:55.693]    <block atomic="false" info="">
[15:51:55.693]      __var nReset = 0x80;
[15:51:55.693]        // -> [nReset <= 0x00000080]
[15:51:55.693]      __var canReadPins = 0;
[15:51:55.693]        // -> [canReadPins <= 0x00000000]
[15:51:55.693]      canReadPins = (DAP_SWJ_Pins(0x00, nReset, 0) != 0xFFFFFFFF);
[15:51:55.698]        // -> [DAP_SWJ_Pins(0x00, 0x80, 0) => 0x0F]   (Out: nRESET=0  =>  In: SWCLK/TCK=1, SWDIO/TMS=1, TDI=1, TDO=1, nTRST=0, nRESET=0)
