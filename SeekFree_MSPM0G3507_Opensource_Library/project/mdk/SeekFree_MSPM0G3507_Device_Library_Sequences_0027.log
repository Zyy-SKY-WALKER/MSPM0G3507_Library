[15:09:59.100]          // if-block "!hasDormant"
[15:09:59.100]            // =>  TRUE
[15:09:59.100]          <block atomic="false" info="">
[15:09:59.100]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:09:59.101]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
