[16:05:26.380]    <block atomic="false" info="">
[16:05:26.380]      __var deviceID = 0;
[16:05:26.380]        // -> [deviceID <= 0x00000000]
[16:05:26.380]      __var version = 0;
[16:05:26.380]        // -> [version <= 0x00000000]
