[15:54:30.807]        // =>  TRUE
[15:54:30.807]      <control if="isSWJ" while="" timeout="0" info="">
[15:54:30.807]        // if-block "isSWJ"
[15:54:30.807]          // =>  TRUE
[15:54:30.807]        <control if="hasDormant" while="" timeout="0" info="">
[15:54:30.807]          // if-block "hasDormant"
[15:54:30.807]            // =>  FALSE
[15:54:30.807]          // skip if-block "hasDormant"
[15:54:30.807]        </control>
[15:54:30.807]        <control if="!hasDormant" while="" timeout="0" info="">
[15:54:30.807]          // if-block "!hasDormant"
[15:54:30.807]            // =>  TRUE
[15:54:30.807]          <block atomic="false" info="">
[15:54:30.807]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:54:30.812]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:54:30.812]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:54:30.817]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:54:30.817]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:54:30.817]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:54:30.817]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:54:30.817]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:54:30.817]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
