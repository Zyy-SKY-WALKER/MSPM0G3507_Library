[15:15:02.345]          // =>  FALSE
[15:15:02.345]        // skip if-block "(__protocol & 0xFFFF) == 1"
[15:15:02.345]      </control>
[15:15:02.345]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[15:15:02.345]        // if-block "(__protocol & 0xFFFF) == 2"
[15:15:02.345]          // =>  TRUE
[15:15:02.345]        <block atomic="false" info="">
[15:15:02.345]          Message(0, "executing SWD power up");
[15:15:02.345]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[15:15:02.348]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[15:15:02.348]          WriteDP(SW_DP_ABORT, 0x0000001E);
[15:15:02.348]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[15:15:02.348]        </block>
[15:15:02.348]        // end if-block "(__protocol & 0xFFFF) == 2"
[15:15:02.348]      </control>
[15:15:02.348]      // end if-block "powered_down"
[15:15:02.348]    </control>
[15:15:02.348]    <block atomic="false" info="">
