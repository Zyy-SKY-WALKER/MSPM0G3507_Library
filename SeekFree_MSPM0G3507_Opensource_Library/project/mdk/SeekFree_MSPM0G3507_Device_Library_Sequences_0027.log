[16:05:26.380]        // -> [partNum <= 0x00000000]
[16:05:26.380]      __var manuf = 0;
[16:05:26.380]        // -> [manuf <= 0x00000000]
[16:05:26.380]      __var isMSPM0G1X0X_G3X0X = 0;
[16:05:26.380]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[16:05:26.380]      __var isProduction = 0;
[16:05:26.380]        // -> [isProduction <= 0x00000000]
[16:05:26.380]      __var continueId = 0;
[16:05:26.384]        // -> [continueId <= 0x00000000]
[16:05:26.384]      deviceID =   Read32(0x41C40004);
[16:05:26.390]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[16:05:26.390]        // -> [deviceID <= 0x2BB8802F]
[16:05:26.390]      version = deviceID >> 28;
[16:05:26.390]        // -> [version <= 0x00000002]
[16:05:26.390]      partNum = (deviceID & 0x0FFFF000) >> 12;
[16:05:26.390]        // -> [partNum <= 0x0000BB88]
[16:05:26.390]      manuf = (deviceID & 0x00000FFE) >> 1;
[16:05:26.390]        // -> [manuf <= 0x00000017]
[16:05:26.392]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
