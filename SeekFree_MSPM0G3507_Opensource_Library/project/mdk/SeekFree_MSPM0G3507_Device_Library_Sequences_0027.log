[16:11:29.267]        // -> [partNum <= 0x00000000]
[16:11:29.267]      __var manuf = 0;
[16:11:29.267]        // -> [manuf <= 0x00000000]
[16:11:29.267]      __var isMSPM0G1X0X_G3X0X = 0;
[16:11:29.267]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[16:11:29.267]      __var isProduction = 0;
[16:11:29.267]        // -> [isProduction <= 0x00000000]
[16:11:29.267]      __var continueId = 0;
[16:11:29.267]        // -> [continueId <= 0x00000000]
[16:11:29.267]      deviceID =   Read32(0x41C40004);
[16:11:29.276]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[16:11:29.276]        // -> [deviceID <= 0x2BB8802F]
[16:11:29.276]      version = deviceID >> 28;
