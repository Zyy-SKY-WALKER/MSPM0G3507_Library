[15:28:09.617]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[15:28:09.617]    <block atomic="false" info="">
[15:28:09.617]      __var SW_DP_ABORT       = 0x0;
[15:28:09.617]        // -> [SW_DP_ABORT <= 0x00000000]
[15:28:09.617]      __var DP_CTRL_STAT      = 0x4;
[15:28:09.617]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:28:09.617]      __var DP_SELECT         = 0x8;
[15:28:09.617]        // -> [DP_SELECT <= 0x00000008]
[15:28:09.617]      __var powered_down      = 0;
[15:28:09.618]        // -> [powered_down <= 0x00000000]
[15:28:09.618]      WriteDP(DP_SELECT, 0x00000000);
[15:28:09.619]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:28:09.619]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[15:28:09.621]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[15:28:09.621]        // -> [powered_down <= 0x00000001]
[15:28:09.621]    </block>
[15:28:09.621]    <control if="powered_down" while="" timeout="0" info="">
