[17:27:14.918]      // if-block "protType == 2"
[17:27:14.918]        // =>  TRUE
[17:27:14.918]      <control if="isSWJ" while="" timeout="0" info="">
[17:27:14.918]        // if-block "isSWJ"
[17:27:14.918]          // =>  TRUE
[17:27:14.918]        <control if="hasDormant" while="" timeout="0" info="">
[17:27:14.918]          // if-block "hasDormant"
[17:27:14.918]            // =>  FALSE
[17:27:14.918]          // skip if-block "hasDormant"
[17:27:14.918]        </control>
[17:27:14.918]        <control if="!hasDormant" while="" timeout="0" info="">
[17:27:14.918]          // if-block "!hasDormant"
[17:27:14.918]            // =>  TRUE
[17:27:14.918]          <block atomic="false" info="">
[17:27:14.918]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:27:14.921]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:27:14.921]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:27:14.921]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:27:14.921]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:27:14.921]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:27:14.921]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[17:27:14.926]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[17:27:14.926]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[17:27:14.926]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:27:14.926]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[17:27:14.932]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[17:27:14.932]          </block>
[17:27:14.932]          // end if-block "!hasDormant"
[17:27:14.932]        </control>
[17:27:14.932]        // end if-block "isSWJ"
[17:27:14.932]      </control>
[17:27:14.932]      <control if="!isSWJ" while="" timeout="0" info="">
