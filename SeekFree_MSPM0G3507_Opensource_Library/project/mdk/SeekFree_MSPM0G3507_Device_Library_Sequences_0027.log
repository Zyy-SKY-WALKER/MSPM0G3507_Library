[15:54:30.835]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[15:54:30.835]    <block atomic="false" info="">
[15:54:30.835]      __var SW_DP_ABORT       = 0x0;
[15:54:30.835]        // -> [SW_DP_ABORT <= 0x00000000]
[15:54:30.835]      __var DP_CTRL_STAT      = 0x4;
[15:54:30.835]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:54:30.835]      __var DP_SELECT         = 0x8;
[15:54:30.835]        // -> [DP_SELECT <= 0x00000008]
[15:54:30.835]      __var powered_down      = 0;
[15:54:30.835]        // -> [powered_down <= 0x00000000]
[15:54:30.835]      WriteDP(DP_SELECT, 0x00000000);
[15:54:30.839]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:54:30.839]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[15:54:30.839]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[15:54:30.839]        // -> [powered_down <= 0x00000001]
[15:54:30.839]    </block>
[15:54:30.839]    <control if="powered_down" while="" timeout="0" info="">
