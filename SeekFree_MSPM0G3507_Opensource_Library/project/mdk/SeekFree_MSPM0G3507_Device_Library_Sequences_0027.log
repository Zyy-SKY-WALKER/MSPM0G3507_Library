[17:24:02.801]    <control if="protType == 2" while="" timeout="0" info="">
[17:24:02.801]      // if-block "protType == 2"
[17:24:02.801]        // =>  TRUE
[17:24:02.801]      <control if="isSWJ" while="" timeout="0" info="">
[17:24:02.801]        // if-block "isSWJ"
[17:24:02.801]          // =>  TRUE
[17:24:02.801]        <control if="hasDormant" while="" timeout="0" info="">
[17:24:02.801]          // if-block "hasDormant"
[17:24:02.801]            // =>  FALSE
[17:24:02.801]          // skip if-block "hasDormant"
[17:24:02.801]        </control>
[17:24:02.801]        <control if="!hasDormant" while="" timeout="0" info="">
[17:24:02.801]          // if-block "!hasDormant"
[17:24:02.805]            // =>  TRUE
[17:24:02.805]          <block atomic="false" info="">
[17:24:02.805]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[17:24:02.805]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:24:02.805]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[17:24:02.805]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[17:24:02.805]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[17:24:02.810]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:24:02.810]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[17:24:02.816]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[17:24:02.816]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[17:24:02.816]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[17:24:02.816]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[17:24:02.820]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[17:24:02.820]          </block>
[17:24:02.820]          // end if-block "!hasDormant"
[17:24:02.820]        </control>
[17:24:02.820]        // end if-block "isSWJ"
[17:24:02.820]      </control>
[17:24:02.820]      <control if="!isSWJ" while="" timeout="0" info="">
[17:24:02.820]        // if-block "!isSWJ"
