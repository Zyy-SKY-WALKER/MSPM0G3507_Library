[15:02:56.108]        // -> [partNum <= 0x0000BB88]
[15:02:56.108]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:02:56.108]        // -> [manuf <= 0x00000017]
[15:02:56.108]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:02:56.108]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:02:56.108]      isProduction = (version > 0);
