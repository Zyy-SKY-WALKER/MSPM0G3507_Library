[15:15:02.318]        ReadDP(0x0);
[15:15:02.322]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[15:15:02.322]      </block>
[15:15:02.322]      // end if-block "protType == 2"
[15:15:02.322]    </control>
[15:15:02.324]  </sequence>
