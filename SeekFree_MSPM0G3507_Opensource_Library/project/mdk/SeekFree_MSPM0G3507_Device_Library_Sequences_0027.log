[17:28:53.818]        WriteDP(DP_CTRL_STAT, 0x50000000);
[17:28:53.823]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[17:28:53.823]      </block>
[17:28:53.823]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[17:28:53.823]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[17:28:53.828]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[17:28:53.828]        // while-condition  =>  FALSE
[17:28:53.828]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[17:28:53.828]      </control>
[17:28:53.828]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[17:28:53.828]        // if-block "(__protocol & 0xFFFF) == 1"
[17:28:53.828]          // =>  FALSE
[17:28:53.828]        // skip if-block "(__protocol & 0xFFFF) == 1"
[17:28:53.828]      </control>
[17:28:53.828]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[17:28:53.828]        // if-block "(__protocol & 0xFFFF) == 2"
[17:28:53.828]          // =>  TRUE
[17:28:53.828]        <block atomic="false" info="">
[17:28:53.828]          Message(0, "executing SWD power up");
[17:28:53.828]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[17:28:53.833]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[17:28:53.833]          WriteDP(SW_DP_ABORT, 0x0000001E);
[17:28:53.833]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[17:28:53.833]        </block>
[17:28:53.833]        // end if-block "(__protocol & 0xFFFF) == 2"
[17:28:53.833]      </control>
[17:28:53.833]      // end if-block "powered_down"
