[17:24:38.525]        // -> [partNum <= 0x00000000]
[17:24:38.525]      __var manuf = 0;
[17:24:38.525]        // -> [manuf <= 0x00000000]
[17:24:38.525]      __var isMSPM0G1X0X_G3X0X = 0;
[17:24:38.525]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[17:24:38.525]      __var isProduction = 0;
[17:24:38.525]        // -> [isProduction <= 0x00000000]
[17:24:38.525]      __var continueId = 0;
[17:24:38.525]        // -> [continueId <= 0x00000000]
[17:24:38.525]      deviceID =   Read32(0x41C40004);
