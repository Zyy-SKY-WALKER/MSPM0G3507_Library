[15:54:30.851]    </control>
[15:54:30.851]    <block atomic="false" info="">
[15:54:30.851]      __var DEBUG_PORT_VAL    = 0;
[15:54:30.851]        // -> [DEBUG_PORT_VAL <= 0x00000000]
