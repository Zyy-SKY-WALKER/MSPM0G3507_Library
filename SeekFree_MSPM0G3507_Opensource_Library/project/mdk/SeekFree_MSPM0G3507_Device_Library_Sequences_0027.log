[14:24:14.730]        // -> [partNum <= 0x0000BB88]
[14:24:14.730]      manuf = (deviceID & 0x00000FFE) >> 1;
[14:24:14.730]        // -> [manuf <= 0x00000017]
[14:24:14.730]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[14:24:14.730]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[14:24:14.730]      isProduction = (version > 0);
[14:24:14.730]        // -> [isProduction <= 0x00000001]
[14:24:14.730]    </block>
