[15:46:19.083]      __var deviceID = 0;
[15:46:19.083]        // -> [deviceID <= 0x00000000]
[15:46:19.083]      __var version = 0;
[15:46:19.083]        // -> [version <= 0x00000000]
[15:46:19.083]      __var partNum = 0;
[15:46:19.083]        // -> [partNum <= 0x00000000]
[15:46:19.083]      __var manuf = 0;
[15:46:19.083]        // -> [manuf <= 0x00000000]
[15:46:19.083]      __var isMSPM0G1X0X_G3X0X = 0;
[15:46:19.083]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:46:19.083]      __var isProduction = 0;
[15:46:19.083]        // -> [isProduction <= 0x00000000]
[15:46:19.083]      __var continueId = 0;
[15:46:19.083]        // -> [continueId <= 0x00000000]
[15:46:19.083]      deviceID =   Read32(0x41C40004);
[15:46:19.092]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:46:19.092]        // -> [deviceID <= 0x2BB8802F]
[15:46:19.092]      version = deviceID >> 28;
[15:46:19.092]        // -> [version <= 0x00000002]
[15:46:19.092]      partNum = (deviceID & 0x0FFFF000) >> 12;
[15:46:19.092]        // -> [partNum <= 0x0000BB88]
[15:46:19.092]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:46:19.092]        // -> [manuf <= 0x00000017]
[15:46:19.092]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:46:19.092]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:46:19.092]      isProduction = (version > 0);
[15:46:19.092]        // -> [isProduction <= 0x00000001]
[15:46:19.092]    </block>
[15:46:19.092]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
