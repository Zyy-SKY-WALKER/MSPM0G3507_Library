[17:02:58.980]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[17:02:58.980]    <block atomic="false" info="">
[17:02:58.980]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[17:02:58.980]        // -> [isSWJ <= 0x00000001]
