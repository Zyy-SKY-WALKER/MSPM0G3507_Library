[15:10:49.861]    <control if="(ACCESS_POINT_VAL & 0x00E00000) == 0" while="" timeout="0" info="">
[15:10:49.861]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[15:10:49.861]        // =>  TRUE
[15:10:49.864]      <block atomic="false" info="">
[15:10:49.864]        WriteAP(0x00, 0x190008);
[15:10:49.867]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[15:10:49.868]        WriteAP(0xF0, 0x01);
[15:10:49.871]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[15:10:49.871]      </block>
[15:10:49.871]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[15:10:49.871]    </control>
[15:10:49.871]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
