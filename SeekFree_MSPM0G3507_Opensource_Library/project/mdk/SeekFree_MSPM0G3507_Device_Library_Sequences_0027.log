[16:11:51.835]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[16:11:51.835]    <block atomic="false" info="">
[16:11:51.835]      __var SW_DP_ABORT       = 0x0;
[16:11:51.839]        // -> [SW_DP_ABORT <= 0x00000000]
[16:11:51.839]      __var DP_CTRL_STAT      = 0x4;
[16:11:51.839]        // -> [DP_CTRL_STAT <= 0x00000004]
[16:11:51.839]      __var DP_SELECT         = 0x8;
[16:11:51.839]        // -> [DP_SELECT <= 0x00000008]
[16:11:51.839]      __var powered_down      = 0;
[16:11:51.839]        // -> [powered_down <= 0x00000000]
[16:11:51.839]      WriteDP(DP_SELECT, 0x00000000);
[16:11:51.844]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[16:11:51.844]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[16:11:51.845]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[16:11:51.845]        // -> [powered_down <= 0x00000001]
[16:11:51.845]    </block>
[16:11:51.845]    <control if="powered_down" while="" timeout="0" info="">
[16:11:51.845]      // if-block "powered_down"
[16:11:51.845]        // =>  TRUE
[16:11:51.845]      <block atomic="false" info="">
[16:11:51.845]        Message(0, "Debug/System power-up request sent");
[16:11:51.847]        WriteDP(DP_CTRL_STAT, 0x50000000);
[16:11:51.851]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[16:11:51.851]      </block>
[16:11:51.851]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[16:11:51.851]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[16:11:51.854]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[16:11:51.854]        // while-condition  =>  FALSE
[16:11:51.854]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[16:11:51.854]      </control>
[16:11:51.854]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[16:11:51.854]        // if-block "(__protocol & 0xFFFF) == 1"
[16:11:51.854]          // =>  FALSE
[16:11:51.854]        // skip if-block "(__protocol & 0xFFFF) == 1"
[16:11:51.854]      </control>
[16:11:51.854]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[16:11:51.854]        // if-block "(__protocol & 0xFFFF) == 2"
[16:11:51.854]          // =>  TRUE
[16:11:51.854]        <block atomic="false" info="">
[16:11:51.854]          Message(0, "executing SWD power up");
[16:11:51.855]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[16:11:51.856]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[16:11:51.856]          WriteDP(SW_DP_ABORT, 0x0000001E);
[16:11:51.859]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[16:11:51.861]        </block>
[16:11:51.861]        // end if-block "(__protocol & 0xFFFF) == 2"
[16:11:51.861]      </control>
[16:11:51.861]      // end if-block "powered_down"
[16:11:51.861]    </control>
[16:11:51.861]    <block atomic="false" info="">
