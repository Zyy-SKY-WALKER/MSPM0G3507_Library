[16:05:26.269]        // =>  FALSE
[16:05:26.269]      // skip if-block "protType == 1"
[16:05:26.269]    </control>
[16:05:26.269]    <control if="protType == 2" while="" timeout="0" info="">
[16:05:26.269]      // if-block "protType == 2"
[16:05:26.269]        // =>  TRUE
[16:05:26.269]      <control if="isSWJ" while="" timeout="0" info="">
[16:05:26.269]        // if-block "isSWJ"
[16:05:26.269]          // =>  TRUE
[16:05:26.269]        <control if="hasDormant" while="" timeout="0" info="">
[16:05:26.269]          // if-block "hasDormant"
[16:05:26.269]            // =>  FALSE
[16:05:26.269]          // skip if-block "hasDormant"
[16:05:26.269]        </control>
[16:05:26.269]        <control if="!hasDormant" while="" timeout="0" info="">
[16:05:26.269]          // if-block "!hasDormant"
[16:05:26.269]            // =>  TRUE
[16:05:26.269]          <block atomic="false" info="">
[16:05:26.269]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[16:05:26.269]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:05:26.269]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[16:05:26.275]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[16:05:26.275]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[16:05:26.275]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:05:26.275]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[16:05:26.280]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[16:05:26.280]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[16:05:26.280]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[16:05:26.280]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[16:05:26.283]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[16:05:26.283]          </block>
[16:05:26.283]          // end if-block "!hasDormant"
[16:05:26.283]        </control>
[16:05:26.283]        // end if-block "isSWJ"
[16:05:26.283]      </control>
[16:05:26.283]      <control if="!isSWJ" while="" timeout="0" info="">
[16:05:26.283]        // if-block "!isSWJ"
[16:05:26.284]          // =>  FALSE
[16:05:26.284]        // skip if-block "!isSWJ"
