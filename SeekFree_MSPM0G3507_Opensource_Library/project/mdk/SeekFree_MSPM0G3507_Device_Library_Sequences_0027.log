[17:49:34.463]        // -> [manuf <= 0x00000017]
[17:49:34.463]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[17:49:34.463]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[17:49:34.463]      isProduction = (version > 0);
[17:49:34.463]        // -> [isProduction <= 0x00000001]
