[00:54:08.723]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[00:54:08.723]    <block atomic="false" info="">
[00:54:08.723]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[00:54:08.723]        // -> [isSWJ <= 0x00000001]
[00:54:08.723]      __var hasDormant = __protocol & 0x00020000;
[00:54:08.723]        // -> [hasDormant <= 0x00000000]
[00:54:08.723]      __var protType   = __protocol & 0x0000FFFF;
[00:54:08.723]        // -> [protType <= 0x00000002]
[00:54:08.723]    </block>
[00:54:08.723]    <control if="protType == 1" while="" timeout="0" info="">
[00:54:08.723]      // if-block "protType == 1"
[00:54:08.723]        // =>  FALSE
[00:54:08.723]      // skip if-block "protType == 1"
[00:54:08.723]    </control>
[00:54:08.723]    <control if="protType == 2" while="" timeout="0" info="">
[00:54:08.723]      // if-block "protType == 2"
[00:54:08.723]        // =>  TRUE
[00:54:08.723]      <control if="isSWJ" while="" timeout="0" info="">
[00:54:08.723]        // if-block "isSWJ"
[00:54:08.723]          // =>  TRUE
[00:54:08.723]        <control if="hasDormant" while="" timeout="0" info="">
[00:54:08.723]          // if-block "hasDormant"
[00:54:08.723]            // =>  FALSE
[00:54:08.723]          // skip if-block "hasDormant"
[00:54:08.723]        </control>
[00:54:08.723]        <control if="!hasDormant" while="" timeout="0" info="">
[00:54:08.723]          // if-block "!hasDormant"
[00:54:08.723]            // =>  TRUE
[00:54:08.723]          <block atomic="false" info="">
[00:54:08.723]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:54:08.723]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:54:08.723]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[00:54:08.723]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[00:54:08.723]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[00:54:08.723]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:54:08.723]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[00:54:08.723]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[00:54:08.723]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[00:54:08.728]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:54:08.728]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[00:54:08.728]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[00:54:08.728]          </block>
[00:54:08.728]          // end if-block "!hasDormant"
[00:54:08.728]        </control>
[00:54:08.728]        // end if-block "isSWJ"
[00:54:08.728]      </control>
[00:54:08.728]      <control if="!isSWJ" while="" timeout="0" info="">
[00:54:08.728]        // if-block "!isSWJ"
[00:54:08.728]          // =>  FALSE
[00:54:08.728]        // skip if-block "!isSWJ"
[00:54:08.728]      </control>
[00:54:08.728]      <block atomic="false" info="">
[00:54:08.728]        ReadDP(0x0);
[00:54:08.728]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[00:54:08.728]      </block>
[00:54:08.728]      // end if-block "protType == 2"
[00:54:08.731]    </control>
[00:54:08.731]  </sequence>
