[00:48:38.276]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[00:48:38.276]    <block atomic="false" info="">
[00:48:38.276]      __var deviceID = 0;
[00:48:38.276]        // -> [deviceID <= 0x00000000]
[00:48:38.276]      __var version = 0;
[00:48:38.276]        // -> [version <= 0x00000000]
[00:48:38.276]      __var partNum = 0;
[00:48:38.276]        // -> [partNum <= 0x00000000]
[00:48:38.276]      __var manuf = 0;
[00:48:38.276]        // -> [manuf <= 0x00000000]
[00:48:38.276]      __var isMSPM0G1X0X_G3X0X = 0;
[00:48:38.276]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[00:48:38.276]      __var isProduction = 0;
[00:48:38.276]        // -> [isProduction <= 0x00000000]
[00:48:38.276]      __var continueId = 0;
[00:48:38.276]        // -> [continueId <= 0x00000000]
[00:48:38.276]      deviceID =   Read32(0x41C40004);
[00:48:38.281]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[00:48:38.281]        // -> [deviceID <= 0x2BB8802F]
[00:48:38.281]      version = deviceID >> 28;
[00:48:38.281]        // -> [version <= 0x00000002]
[00:48:38.281]      partNum = (deviceID & 0x0FFFF000) >> 12;
[00:48:38.281]        // -> [partNum <= 0x0000BB88]
[00:48:38.281]      manuf = (deviceID & 0x00000FFE) >> 1;
[00:48:38.281]        // -> [manuf <= 0x00000017]
[00:48:38.281]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[00:48:38.281]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[00:48:38.281]      isProduction = (version > 0);
[00:48:38.281]        // -> [isProduction <= 0x00000001]
[00:48:38.281]    </block>
[00:48:38.281]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[00:48:38.281]      // if-block "!isMSPM0G1X0X_G3X0X"
[00:48:38.281]        // =>  FALSE
[00:48:38.281]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[00:48:38.281]    </control>
