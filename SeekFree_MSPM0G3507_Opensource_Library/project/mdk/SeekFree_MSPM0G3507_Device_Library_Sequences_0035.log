[00:54:08.739]        // skip if-block "(__protocol & 0xFFFF) == 1"
[00:54:08.739]      </control>
[00:54:08.739]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[00:54:08.739]        // if-block "(__protocol & 0xFFFF) == 2"
[00:54:08.739]          // =>  TRUE
[00:54:08.739]        <block atomic="false" info="">
[00:54:08.739]          Message(0, "executing SWD power up");
[00:54:08.741]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[00:54:08.741]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[00:54:08.741]          WriteDP(SW_DP_ABORT, 0x0000001E);
[00:54:08.741]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[00:54:08.741]        </block>
[00:54:08.741]        // end if-block "(__protocol & 0xFFFF) == 2"
[00:54:08.741]      </control>
[00:54:08.741]      // end if-block "powered_down"
[00:54:08.741]    </control>
