[00:46:23.662]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[00:46:23.662]    <block atomic="false" info="">
[00:46:23.662]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[00:46:23.662]        // -> [isSWJ <= 0x00000001]
