[00:46:23.662]      // if-block "protType == 2"
[00:46:23.662]        // =>  TRUE
[00:46:23.662]      <control if="isSWJ" while="" timeout="0" info="">
[00:46:23.662]        // if-block "isSWJ"
[00:46:23.662]          // =>  TRUE
[00:46:23.662]        <control if="hasDormant" while="" timeout="0" info="">
[00:46:23.662]          // if-block "hasDormant"
[00:46:23.662]            // =>  FALSE
[00:46:23.662]          // skip if-block "hasDormant"
[00:46:23.662]        </control>
[00:46:23.662]        <control if="!hasDormant" while="" timeout="0" info="">
[00:46:23.662]          // if-block "!hasDormant"
[00:46:23.662]            // =>  TRUE
[00:46:23.662]          <block atomic="false" info="">
[00:46:23.662]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:46:23.666]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:46:23.666]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[00:46:23.671]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[00:46:23.671]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[00:46:23.676]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:46:23.676]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[00:46:23.676]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[00:46:23.676]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
