[02:19:18.700]          // if-block "hasDormant"
[02:19:18.700]            // =>  FALSE
[02:19:18.700]          // skip if-block "hasDormant"
[02:19:18.700]        </control>
[02:19:18.700]        <control if="!hasDormant" while="" timeout="0" info="">
[02:19:18.700]          // if-block "!hasDormant"
[02:19:18.700]            // =>  TRUE
[02:19:18.700]          <block atomic="false" info="">
[02:19:18.700]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[02:19:18.726]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:19:18.726]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[02:19:18.728]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[02:19:18.728]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[02:19:18.731]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:19:18.731]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[02:19:18.731]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[02:19:18.731]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[02:19:18.736]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:19:18.736]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[02:19:18.742]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[02:19:18.742]          </block>
[02:19:18.742]          // end if-block "!hasDormant"
[02:19:18.742]        </control>
[02:19:18.742]        // end if-block "isSWJ"
[02:19:18.742]      </control>
[02:19:18.742]      <control if="!isSWJ" while="" timeout="0" info="">
[02:19:18.742]        // if-block "!isSWJ"
[02:19:18.742]          // =>  FALSE
[02:19:18.742]        // skip if-block "!isSWJ"
