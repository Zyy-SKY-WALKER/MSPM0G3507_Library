[00:03:54.354]        ReadDP(0x0);
[00:03:54.373]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[00:03:54.373]      </block>
[00:03:54.373]      // end if-block "protType == 2"
[00:03:54.373]    </control>
