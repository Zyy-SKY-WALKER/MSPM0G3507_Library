[00:46:23.722]      __var DP_SELECT         = 0x8;
[00:46:23.722]        // -> [DP_SELECT <= 0x00000008]
[00:46:23.722]      __var powered_down      = 0;
[00:46:23.722]        // -> [powered_down <= 0x00000000]
[00:46:23.722]      WriteDP(DP_SELECT, 0x00000000);
[00:46:23.731]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[00:46:23.731]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
