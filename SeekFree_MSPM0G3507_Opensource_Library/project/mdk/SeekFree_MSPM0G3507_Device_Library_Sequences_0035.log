[02:11:26.194]          // =>  FALSE
[02:11:26.194]        // skip if-block "(__protocol & 0xFFFF) == 1"
[02:11:26.194]      </control>
[02:11:26.194]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[02:11:26.194]        // if-block "(__protocol & 0xFFFF) == 2"
[02:11:26.194]          // =>  TRUE
[02:11:26.194]        <block atomic="false" info="">
[02:11:26.194]          Message(0, "executing SWD power up");
[02:11:26.197]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[02:11:26.197]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[02:11:26.197]          WriteDP(SW_DP_ABORT, 0x0000001E);
[02:11:26.197]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[02:11:26.197]        </block>
[02:11:26.202]        // end if-block "(__protocol & 0xFFFF) == 2"
[02:11:26.202]      </control>
[02:11:26.202]      // end if-block "powered_down"
[02:11:26.202]    </control>
[02:11:26.202]    <block atomic="false" info="">
