[00:08:47.009]        // if-block "isSWJ"
[00:08:47.009]          // =>  TRUE
[00:08:47.009]        <control if="hasDormant" while="" timeout="0" info="">
[00:08:47.009]          // if-block "hasDormant"
[00:08:47.009]            // =>  FALSE
[00:08:47.009]          // skip if-block "hasDormant"
[00:08:47.009]        </control>
[00:08:47.012]        <control if="!hasDormant" while="" timeout="0" info="">
[00:08:47.012]          // if-block "!hasDormant"
[00:08:47.012]            // =>  TRUE
[00:08:47.012]          <block atomic="false" info="">
[00:08:47.012]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:08:47.013]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:08:47.013]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[00:08:47.015]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[00:08:47.015]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[00:08:47.015]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:08:47.015]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[00:08:47.020]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[00:08:47.020]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[00:08:47.023]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:08:47.023]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[00:08:47.031]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[00:08:47.031]          </block>
[00:08:47.031]          // end if-block "!hasDormant"
[00:08:47.031]        </control>
[00:08:47.031]        // end if-block "isSWJ"
[00:08:47.031]      </control>
[00:08:47.031]      <control if="!isSWJ" while="" timeout="0" info="">
[00:08:47.031]        // if-block "!isSWJ"
[00:08:47.031]          // =>  FALSE
