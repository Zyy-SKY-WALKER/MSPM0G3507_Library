[00:51:30.345]  **********  Sequence "DebugPortSetup"  (Context="Connect", Pname="", info="")
[00:51:30.345]  
[00:51:30.345]  <debugvars>
[00:51:30.345]    // Pre-defined
[00:51:30.345]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[00:51:30.345]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[00:51:30.345]    __dp=0x00000000
