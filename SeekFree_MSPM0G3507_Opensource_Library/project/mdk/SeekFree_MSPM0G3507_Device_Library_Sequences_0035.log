[00:03:54.406]      <block atomic="false" info="">
[00:03:54.406]        Message(0, "Debug/System power-up request sent");
[00:03:54.406]        WriteDP(DP_CTRL_STAT, 0x50000000);
[00:03:54.416]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[00:03:54.421]      </block>
[00:03:54.421]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[00:03:54.422]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[00:03:54.426]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[00:03:54.426]        // while-condition  =>  FALSE
[00:03:54.426]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[00:03:54.426]      </control>
[00:03:54.426]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[00:03:54.431]        // if-block "(__protocol & 0xFFFF) == 1"
[00:03:54.431]          // =>  FALSE
[00:03:54.431]        // skip if-block "(__protocol & 0xFFFF) == 1"
[00:03:54.431]      </control>
[00:03:54.431]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[00:03:54.431]        // if-block "(__protocol & 0xFFFF) == 2"
[00:03:54.431]          // =>  TRUE
[00:03:54.431]        <block atomic="false" info="">
[00:03:54.431]          Message(0, "executing SWD power up");
[00:03:54.432]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[00:03:54.436]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[00:03:54.436]          WriteDP(SW_DP_ABORT, 0x0000001E);
[00:03:54.442]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[00:03:54.442]        </block>
[00:03:54.442]        // end if-block "(__protocol & 0xFFFF) == 2"
[00:03:54.442]      </control>
[00:03:54.442]      // end if-block "powered_down"
[00:03:54.442]    </control>
[00:03:54.442]    <block atomic="false" info="">
[00:03:54.442]      __var DEBUG_PORT_VAL    = 0;
[00:03:54.442]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[00:03:54.442]      __var ACCESS_POINT_VAL  = 0;
[00:03:54.442]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[00:03:54.442]      __ap = 1; 
[00:03:54.442]        // -> [__ap <= 0x00000001]
[00:03:54.442]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[00:03:54.447]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[00:03:54.447]      __ap = 4;
