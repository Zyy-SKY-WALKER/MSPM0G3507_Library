[00:54:08.739]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[00:54:08.739]        // while-condition  =>  FALSE
[00:54:08.739]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[00:54:08.739]      </control>
