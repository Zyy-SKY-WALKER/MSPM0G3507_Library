[00:51:30.381]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[00:51:30.381]    <block atomic="false" info="">
[00:51:30.381]      __var SW_DP_ABORT       = 0x0;
[00:51:30.381]        // -> [SW_DP_ABORT <= 0x00000000]
[00:51:30.381]      __var DP_CTRL_STAT      = 0x4;
[00:51:30.381]        // -> [DP_CTRL_STAT <= 0x00000004]
[00:51:30.381]      __var DP_SELECT         = 0x8;
[00:51:30.381]        // -> [DP_SELECT <= 0x00000008]
[00:51:30.381]      __var powered_down      = 0;
[00:51:30.383]        // -> [powered_down <= 0x00000000]
[00:51:30.383]      WriteDP(DP_SELECT, 0x00000000);
[00:51:30.384]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[00:51:30.384]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[00:51:30.391]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[00:51:30.391]        // -> [powered_down <= 0x00000001]
[00:51:30.391]    </block>
[00:51:30.391]    <control if="powered_down" while="" timeout="0" info="">
[00:51:30.391]      // if-block "powered_down"
[00:51:30.391]        // =>  TRUE
[00:51:30.391]      <block atomic="false" info="">
[00:51:30.391]        Message(0, "Debug/System power-up request sent");
[00:51:30.394]        WriteDP(DP_CTRL_STAT, 0x50000000);
[00:51:30.400]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[00:51:30.400]      </block>
[00:51:30.400]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[00:51:30.400]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[00:51:30.402]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[00:51:30.402]        // while-condition  =>  FALSE
[00:51:30.402]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[00:51:30.402]      </control>
[00:51:30.402]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
