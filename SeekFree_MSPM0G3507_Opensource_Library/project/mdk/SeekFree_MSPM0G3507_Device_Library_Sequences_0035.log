[00:54:08.733]      <block atomic="false" info="">
[00:54:08.733]        Message(0, "Debug/System power-up request sent");
[00:54:08.733]        WriteDP(DP_CTRL_STAT, 0x50000000);
[00:54:08.733]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[00:54:08.733]      </block>
[00:54:08.733]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
