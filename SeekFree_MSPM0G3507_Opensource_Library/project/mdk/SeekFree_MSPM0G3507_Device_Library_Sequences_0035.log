[00:51:30.410]      __ap = 1; 
[00:51:30.410]        // -> [__ap <= 0x00000001]
[00:51:30.410]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[00:51:30.433]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[00:51:30.433]      __ap = 4;
