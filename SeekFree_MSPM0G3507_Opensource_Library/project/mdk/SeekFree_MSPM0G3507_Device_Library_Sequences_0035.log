[02:15:57.386]        WriteAP(0x00, 0x190008);
[02:15:57.404]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[02:15:57.404]        WriteAP(0xF0, 0x01);
[02:15:57.430]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[02:15:57.430]      </block>
[02:15:57.430]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[02:15:57.430]    </control>
