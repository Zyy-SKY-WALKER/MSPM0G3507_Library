[02:31:08.396]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[02:31:08.396]    <block atomic="false" info="">
[02:31:08.396]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[02:31:08.396]        // -> [isSWJ <= 0x00000001]
[02:31:08.396]      __var hasDormant = __protocol & 0x00020000;
[02:31:08.396]        // -> [hasDormant <= 0x00000000]
