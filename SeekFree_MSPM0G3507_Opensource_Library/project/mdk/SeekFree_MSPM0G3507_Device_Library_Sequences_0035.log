[00:03:54.393]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[00:03:54.393]    <block atomic="false" info="">
[00:03:54.393]      __var SW_DP_ABORT       = 0x0;
[00:03:54.393]        // -> [SW_DP_ABORT <= 0x00000000]
[00:03:54.393]      __var DP_CTRL_STAT      = 0x4;
[00:03:54.393]        // -> [DP_CTRL_STAT <= 0x00000004]
[00:03:54.393]      __var DP_SELECT         = 0x8;
[00:03:54.393]        // -> [DP_SELECT <= 0x00000008]
[00:03:54.393]      __var powered_down      = 0;
[00:03:54.393]        // -> [powered_down <= 0x00000000]
[00:03:54.393]      WriteDP(DP_SELECT, 0x00000000);
[00:03:54.396]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[00:03:54.396]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[00:03:54.406]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[00:03:54.406]        // -> [powered_down <= 0x00000001]
[00:03:54.406]    </block>
[00:03:54.406]    <control if="powered_down" while="" timeout="0" info="">
