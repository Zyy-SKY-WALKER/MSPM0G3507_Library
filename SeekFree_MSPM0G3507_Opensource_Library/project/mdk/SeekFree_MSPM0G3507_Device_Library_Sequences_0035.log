[00:03:54.323]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[00:03:54.323]    <block atomic="false" info="">
[00:03:54.323]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[00:03:54.323]        // -> [isSWJ <= 0x00000001]
[00:03:54.323]      __var hasDormant = __protocol & 0x00020000;
[00:03:54.323]        // -> [hasDormant <= 0x00000000]
