[00:46:23.987]        // -> [manuf <= 0x00000017]
[00:46:23.987]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[00:46:23.987]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[00:46:23.987]      isProduction = (version > 0);
