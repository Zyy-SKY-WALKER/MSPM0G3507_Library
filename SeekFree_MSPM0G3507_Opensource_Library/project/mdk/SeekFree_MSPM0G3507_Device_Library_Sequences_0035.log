[00:51:30.515]        // -> [partNum <= 0x00000000]
[00:51:30.515]      __var manuf = 0;
[00:51:30.515]        // -> [manuf <= 0x00000000]
[00:51:30.515]      __var isMSPM0G1X0X_G3X0X = 0;
[00:51:30.515]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[00:51:30.515]      __var isProduction = 0;
[00:51:30.515]        // -> [isProduction <= 0x00000000]
[00:51:30.515]      __var continueId = 0;
[00:51:30.515]        // -> [continueId <= 0x00000000]
[00:51:30.515]      deviceID =   Read32(0x41C40004);
[00:51:30.525]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[00:51:30.525]        // -> [deviceID <= 0x2BB8802F]
[00:51:30.525]      version = deviceID >> 28;
[00:51:30.525]        // -> [version <= 0x00000002]
[00:51:30.525]      partNum = (deviceID & 0x0FFFF000) >> 12;
[00:51:30.525]        // -> [partNum <= 0x0000BB88]
[00:51:30.525]      manuf = (deviceID & 0x00000FFE) >> 1;
[00:51:30.525]        // -> [manuf <= 0x00000017]
[00:51:30.525]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[00:51:30.525]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[00:51:30.525]      isProduction = (version > 0);
[00:51:30.525]        // -> [isProduction <= 0x00000001]
[00:51:30.525]    </block>
