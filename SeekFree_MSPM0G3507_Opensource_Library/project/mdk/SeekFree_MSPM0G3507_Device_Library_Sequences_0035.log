[00:54:08.721]  <debugvars>
[00:54:08.721]    // Pre-defined
[00:54:08.721]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[00:54:08.721]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
