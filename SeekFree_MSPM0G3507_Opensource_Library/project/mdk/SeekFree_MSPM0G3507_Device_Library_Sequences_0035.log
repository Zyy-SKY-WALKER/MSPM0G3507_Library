[23:58:04.364]      __var deviceID = 0;
[23:58:04.364]        // -> [deviceID <= 0x00000000]
[23:58:04.364]      __var version = 0;
[23:58:04.364]        // -> [version <= 0x00000000]
[23:58:04.364]      __var partNum = 0;
[23:58:04.364]        // -> [partNum <= 0x00000000]
[23:58:04.364]      __var manuf = 0;
[23:58:04.364]        // -> [manuf <= 0x00000000]
[23:58:04.364]      __var isMSPM0G1X0X_G3X0X = 0;
[23:58:04.364]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[23:58:04.364]      __var isProduction = 0;
[23:58:04.364]        // -> [isProduction <= 0x00000000]
[23:58:04.364]      __var continueId = 0;
[23:58:04.364]        // -> [continueId <= 0x00000000]
[23:58:04.364]      deviceID =   Read32(0x41C40004);
[23:58:04.376]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[23:58:04.376]        // -> [deviceID <= 0x2BB8802F]
[23:58:04.376]      version = deviceID >> 28;
[23:58:04.376]        // -> [version <= 0x00000002]
[23:58:04.376]      partNum = (deviceID & 0x0FFFF000) >> 12;
[23:58:04.376]        // -> [partNum <= 0x0000BB88]
[23:58:04.376]      manuf = (deviceID & 0x00000FFE) >> 1;
[23:58:04.376]        // -> [manuf <= 0x00000017]
[23:58:04.376]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[23:58:04.376]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[23:58:04.376]      isProduction = (version > 0);
[23:58:04.376]        // -> [isProduction <= 0x00000001]
[23:58:04.376]    </block>
[23:58:04.376]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
