[01:09:25.716]          // if-block "!hasDormant"
[01:09:25.716]            // =>  TRUE
[01:09:25.716]          <block atomic="false" info="">
[01:09:25.716]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[01:09:25.718]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[01:09:25.718]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[01:09:25.725]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[01:09:25.725]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[01:09:25.733]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[01:09:25.733]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
