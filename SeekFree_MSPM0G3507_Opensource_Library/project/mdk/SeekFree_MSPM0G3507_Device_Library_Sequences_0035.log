[02:21:14.452]          // if-block "hasDormant"
[02:21:14.452]            // =>  FALSE
[02:21:14.452]          // skip if-block "hasDormant"
[02:21:14.452]        </control>
[02:21:14.452]        <control if="!hasDormant" while="" timeout="0" info="">
[02:21:14.452]          // if-block "!hasDormant"
[02:21:14.452]            // =>  TRUE
[02:21:14.452]          <block atomic="false" info="">
[02:21:14.452]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[02:21:14.462]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:21:14.462]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[02:21:14.462]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[02:21:14.462]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
