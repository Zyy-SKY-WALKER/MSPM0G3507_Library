[00:46:23.926]        // -> [manuf <= 0x00000000]
[00:46:23.926]      __var isMSPM0G1X0X_G3X0X = 0;
[00:46:23.926]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[00:46:23.926]      __var isProduction = 0;
[00:46:23.926]        // -> [isProduction <= 0x00000000]
[00:46:23.926]      __var continueId = 0;
[00:46:23.926]        // -> [continueId <= 0x00000000]
[00:46:23.926]      deviceID =   Read32(0x41C40004);
