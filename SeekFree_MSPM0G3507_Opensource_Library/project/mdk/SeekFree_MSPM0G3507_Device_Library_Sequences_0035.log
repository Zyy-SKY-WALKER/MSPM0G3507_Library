[00:51:30.345]    __Result=0x00000000
[00:51:30.345]  </debugvars>
[00:51:30.345]  
[00:51:30.345]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[00:51:30.345]    <block atomic="false" info="">
[00:51:30.349]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[00:51:30.349]        // -> [isSWJ <= 0x00000001]
[00:51:30.349]      __var hasDormant = __protocol & 0x00020000;
[00:51:30.349]        // -> [hasDormant <= 0x00000000]
[00:51:30.349]      __var protType   = __protocol & 0x0000FFFF;
[00:51:30.349]        // -> [protType <= 0x00000002]
[00:51:30.349]    </block>
[00:51:30.349]    <control if="protType == 1" while="" timeout="0" info="">
[00:51:30.349]      // if-block "protType == 1"
[00:51:30.349]        // =>  FALSE
[00:51:30.349]      // skip if-block "protType == 1"
[00:51:30.349]    </control>
[00:51:30.349]    <control if="protType == 2" while="" timeout="0" info="">
[00:51:30.349]      // if-block "protType == 2"
[00:51:30.349]        // =>  TRUE
[00:51:30.349]      <control if="isSWJ" while="" timeout="0" info="">
[00:51:30.349]        // if-block "isSWJ"
[00:51:30.349]          // =>  TRUE
[00:51:30.349]        <control if="hasDormant" while="" timeout="0" info="">
[00:51:30.349]          // if-block "hasDormant"
[00:51:30.349]            // =>  FALSE
[00:51:30.349]          // skip if-block "hasDormant"
[00:51:30.349]        </control>
[00:51:30.349]        <control if="!hasDormant" while="" timeout="0" info="">
[00:51:30.349]          // if-block "!hasDormant"
[00:51:30.349]            // =>  TRUE
[00:51:30.349]          <block atomic="false" info="">
[00:51:30.349]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:51:30.354]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:51:30.354]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[00:51:30.355]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[00:51:30.355]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[00:51:30.359]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:51:30.359]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[00:51:30.365]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[00:51:30.365]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[00:51:30.369]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:51:30.369]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[00:51:30.369]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[00:51:30.369]          </block>
[00:51:30.369]          // end if-block "!hasDormant"
[00:51:30.369]        </control>
[00:51:30.369]        // end if-block "isSWJ"
[00:51:30.369]      </control>
[00:51:30.369]      <control if="!isSWJ" while="" timeout="0" info="">
[00:51:30.369]        // if-block "!isSWJ"
[00:51:30.369]          // =>  FALSE
[00:51:30.369]        // skip if-block "!isSWJ"
[00:51:30.369]      </control>
[00:51:30.369]      <block atomic="false" info="">
[00:51:30.369]        ReadDP(0x0);
[00:51:30.376]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[00:51:30.376]      </block>
[00:51:30.377]      // end if-block "protType == 2"
[00:51:30.377]    </control>
[00:51:30.377]  </sequence>
