[02:19:18.948]  
[02:19:18.948]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[02:19:18.948]    <block atomic="false" info="">
[02:19:18.948]      __var deviceID = 0;
[02:19:18.948]        // -> [deviceID <= 0x00000000]
[02:19:18.948]      __var version = 0;
[02:19:18.948]        // -> [version <= 0x00000000]
[02:19:18.948]      __var partNum = 0;
[02:19:18.948]        // -> [partNum <= 0x00000000]
[02:19:18.948]      __var manuf = 0;
[02:19:18.948]        // -> [manuf <= 0x00000000]
[02:19:18.948]      __var isMSPM0G1X0X_G3X0X = 0;
[02:19:18.948]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[02:19:18.948]      __var isProduction = 0;
[02:19:18.948]        // -> [isProduction <= 0x00000000]
[02:19:18.948]      __var continueId = 0;
[02:19:18.948]        // -> [continueId <= 0x00000000]
[02:19:18.948]      deviceID =   Read32(0x41C40004);
[02:19:18.962]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[02:19:18.962]        // -> [deviceID <= 0x2BB8802F]
[02:19:18.962]      version = deviceID >> 28;
[02:19:18.962]        // -> [version <= 0x00000002]
[02:19:18.962]      partNum = (deviceID & 0x0FFFF000) >> 12;
[02:19:18.962]        // -> [partNum <= 0x0000BB88]
[02:19:18.962]      manuf = (deviceID & 0x00000FFE) >> 1;
[02:19:18.962]        // -> [manuf <= 0x00000017]
[02:19:18.962]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[02:19:18.962]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[02:19:18.962]      isProduction = (version > 0);
[02:19:18.962]        // -> [isProduction <= 0x00000001]
[02:19:18.962]    </block>
[02:19:18.962]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[02:19:18.962]      // if-block "!isMSPM0G1X0X_G3X0X"
[02:19:18.962]        // =>  FALSE
[02:19:18.962]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[02:19:18.962]    </control>
[02:19:18.962]    <control if="continueId == 4" while="" timeout="0" info="">
[02:19:18.962]      // if-block "continueId == 4"
[02:19:18.962]        // =>  FALSE
[02:19:18.962]      // skip if-block "continueId == 4"
[02:19:18.962]    </control>
[02:19:18.962]    <control if="!isProduction" while="" timeout="0" info="">
[02:19:18.962]      // if-block "!isProduction"
[02:19:18.962]        // =>  FALSE
[02:19:18.962]      // skip if-block "!isProduction"
[02:19:18.962]    </control>
[02:19:18.962]  </sequence>
