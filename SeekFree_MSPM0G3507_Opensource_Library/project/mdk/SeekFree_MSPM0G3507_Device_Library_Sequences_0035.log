[00:57:04.509]        // =>  TRUE
[00:57:04.509]      <block atomic="false" info="">
[00:57:04.509]        Message(0, "Debug/System power-up request sent");
[00:57:04.510]        WriteDP(DP_CTRL_STAT, 0x50000000);
