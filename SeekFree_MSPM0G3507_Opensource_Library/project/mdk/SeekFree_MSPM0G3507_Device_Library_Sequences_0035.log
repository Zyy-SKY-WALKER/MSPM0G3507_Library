[00:03:54.323]      // skip if-block "protType == 1"
[00:03:54.323]    </control>
[00:03:54.323]    <control if="protType == 2" while="" timeout="0" info="">
[00:03:54.323]      // if-block "protType == 2"
[00:03:54.323]        // =>  TRUE
[00:03:54.323]      <control if="isSWJ" while="" timeout="0" info="">
[00:03:54.323]        // if-block "isSWJ"
[00:03:54.323]          // =>  TRUE
[00:03:54.323]        <control if="hasDormant" while="" timeout="0" info="">
[00:03:54.323]          // if-block "hasDormant"
[00:03:54.323]            // =>  FALSE
[00:03:54.323]          // skip if-block "hasDormant"
[00:03:54.329]        </control>
[00:03:54.329]        <control if="!hasDormant" while="" timeout="0" info="">
[00:03:54.329]          // if-block "!hasDormant"
[00:03:54.329]            // =>  TRUE
[00:03:54.329]          <block atomic="false" info="">
[00:03:54.329]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:03:54.329]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:03:54.329]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[00:03:54.334]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[00:03:54.334]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[00:03:54.339]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:03:54.339]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[00:03:54.344]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[00:03:54.344]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[00:03:54.347]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:03:54.347]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[00:03:54.354]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[00:03:54.354]          </block>
[00:03:54.354]          // end if-block "!hasDormant"
[00:03:54.354]        </control>
[00:03:54.354]        // end if-block "isSWJ"
[00:03:54.354]      </control>
