[02:11:26.185]    <block atomic="false" info="">
[02:11:26.185]      __var SW_DP_ABORT       = 0x0;
[02:11:26.185]        // -> [SW_DP_ABORT <= 0x00000000]
[02:11:26.185]      __var DP_CTRL_STAT      = 0x4;
[02:11:26.185]        // -> [DP_CTRL_STAT <= 0x00000004]
[02:11:26.185]      __var DP_SELECT         = 0x8;
[02:11:26.185]        // -> [DP_SELECT <= 0x00000008]
[02:11:26.185]      __var powered_down      = 0;
[02:11:26.185]        // -> [powered_down <= 0x00000000]
[02:11:26.185]      WriteDP(DP_SELECT, 0x00000000);
[02:11:26.187]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[02:11:26.187]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[02:11:26.189]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[02:11:26.189]        // -> [powered_down <= 0x00000001]
[02:11:26.189]    </block>
[02:11:26.189]    <control if="powered_down" while="" timeout="0" info="">
[02:11:26.189]      // if-block "powered_down"
[02:11:26.189]        // =>  TRUE
[02:11:26.189]      <block atomic="false" info="">
[02:11:26.189]        Message(0, "Debug/System power-up request sent");
[02:11:26.191]        WriteDP(DP_CTRL_STAT, 0x50000000);
[02:11:26.192]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[02:11:26.192]      </block>
[02:11:26.192]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[02:11:26.192]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[02:11:26.194]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[02:11:26.194]        // while-condition  =>  FALSE
[02:11:26.194]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[02:11:26.194]      </control>
[02:11:26.194]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
