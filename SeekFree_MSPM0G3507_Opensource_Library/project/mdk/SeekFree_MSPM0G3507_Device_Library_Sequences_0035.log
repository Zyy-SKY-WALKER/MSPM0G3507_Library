[00:54:08.732]        // -> [SW_DP_ABORT <= 0x00000000]
[00:54:08.732]      __var DP_CTRL_STAT      = 0x4;
[00:54:08.732]        // -> [DP_CTRL_STAT <= 0x00000004]
[00:54:08.732]      __var DP_SELECT         = 0x8;
[00:54:08.732]        // -> [DP_SELECT <= 0x00000008]
[00:54:08.732]      __var powered_down      = 0;
[00:54:08.732]        // -> [powered_down <= 0x00000000]
[00:54:08.732]      WriteDP(DP_SELECT, 0x00000000);
[00:54:08.733]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[00:54:08.733]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[00:54:08.733]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[00:54:08.733]        // -> [powered_down <= 0x00000001]
