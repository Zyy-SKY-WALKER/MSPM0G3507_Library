[02:11:26.202]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[02:11:26.205]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[02:11:26.207]      __ap = 4;
[02:11:26.207]        // -> [__ap <= 0x00000004]
[02:11:26.207]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[02:11:26.207]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[02:11:26.207]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[02:11:26.207]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
