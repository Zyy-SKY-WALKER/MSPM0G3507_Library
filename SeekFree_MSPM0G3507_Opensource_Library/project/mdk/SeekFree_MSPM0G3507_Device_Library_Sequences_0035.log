[02:21:14.472]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[02:21:14.477]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:21:14.477]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[02:21:14.480]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[02:21:14.481]          </block>
[02:21:14.481]          // end if-block "!hasDormant"
[02:21:14.481]        </control>
