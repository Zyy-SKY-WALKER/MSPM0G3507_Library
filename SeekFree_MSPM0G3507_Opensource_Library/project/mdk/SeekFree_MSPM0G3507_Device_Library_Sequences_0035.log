[02:19:18.946]  <debugvars>
[02:19:18.946]    // Pre-defined
[02:19:18.946]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[02:19:18.946]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[02:19:18.946]    __dp=0x00000000
