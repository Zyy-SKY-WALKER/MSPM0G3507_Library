[00:51:30.402]        // skip if-block "(__protocol & 0xFFFF) == 1"
[00:51:30.402]      </control>
[00:51:30.402]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[00:51:30.402]        // if-block "(__protocol & 0xFFFF) == 2"
[00:51:30.402]          // =>  TRUE
[00:51:30.402]        <block atomic="false" info="">
[00:51:30.402]          Message(0, "executing SWD power up");
[00:51:30.404]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[00:51:30.406]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[00:51:30.406]          WriteDP(SW_DP_ABORT, 0x0000001E);
[00:51:30.410]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[00:51:30.410]        </block>
[00:51:30.410]        // end if-block "(__protocol & 0xFFFF) == 2"
[00:51:30.410]      </control>
[00:51:30.410]      // end if-block "powered_down"
[00:51:30.410]    </control>
[00:51:30.410]    <block atomic="false" info="">
