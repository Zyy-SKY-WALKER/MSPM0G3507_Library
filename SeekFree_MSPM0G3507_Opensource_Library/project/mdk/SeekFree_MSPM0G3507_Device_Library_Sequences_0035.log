[02:11:26.117]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[02:11:26.117]    <block atomic="false" info="">
[02:11:26.117]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[02:11:26.117]        // -> [isSWJ <= 0x00000001]
[02:11:26.117]      __var hasDormant = __protocol & 0x00020000;
[02:11:26.117]        // -> [hasDormant <= 0x00000000]
[02:11:26.117]      __var protType   = __protocol & 0x0000FFFF;
[02:11:26.117]        // -> [protType <= 0x00000002]
[02:11:26.117]    </block>
[02:11:26.117]    <control if="protType == 1" while="" timeout="0" info="">
[02:11:26.117]      // if-block "protType == 1"
[02:11:26.117]        // =>  FALSE
[02:11:26.117]      // skip if-block "protType == 1"
[02:11:26.117]    </control>
[02:11:26.117]    <control if="protType == 2" while="" timeout="0" info="">
[02:11:26.117]      // if-block "protType == 2"
[02:11:26.117]        // =>  TRUE
[02:11:26.117]      <control if="isSWJ" while="" timeout="0" info="">
[02:11:26.117]        // if-block "isSWJ"
[02:11:26.117]          // =>  TRUE
[02:11:26.117]        <control if="hasDormant" while="" timeout="0" info="">
[02:11:26.117]          // if-block "hasDormant"
[02:11:26.117]            // =>  FALSE
[02:11:26.117]          // skip if-block "hasDormant"
[02:11:26.117]        </control>
[02:11:26.117]        <control if="!hasDormant" while="" timeout="0" info="">
[02:11:26.117]          // if-block "!hasDormant"
[02:11:26.117]            // =>  TRUE
[02:11:26.117]          <block atomic="false" info="">
[02:11:26.117]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[02:11:26.122]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:11:26.122]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[02:11:26.124]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[02:11:26.124]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[02:11:26.127]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:11:26.127]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[02:11:26.127]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[02:11:26.143]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[02:11:26.167]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:11:26.170]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[02:11:26.170]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[02:11:26.170]          </block>
[02:11:26.170]          // end if-block "!hasDormant"
[02:11:26.170]        </control>
[02:11:26.174]        // end if-block "isSWJ"
[02:11:26.174]      </control>
[02:11:26.174]      <control if="!isSWJ" while="" timeout="0" info="">
[02:11:26.174]        // if-block "!isSWJ"
[02:11:26.174]          // =>  FALSE
[02:11:26.174]        // skip if-block "!isSWJ"
[02:11:26.174]      </control>
[02:11:26.174]      <block atomic="false" info="">
[02:11:26.174]        ReadDP(0x0);
[02:11:26.175]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[02:11:26.175]      </block>
[02:11:26.175]      // end if-block "protType == 2"
[02:11:26.175]    </control>
[02:11:26.175]  </sequence>
