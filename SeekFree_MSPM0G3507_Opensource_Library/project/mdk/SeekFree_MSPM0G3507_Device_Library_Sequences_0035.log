[00:54:08.741]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[00:54:08.741]      __ap = 1; 
[00:54:08.741]        // -> [__ap <= 0x00000001]
[00:54:08.741]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[00:54:08.744]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[00:54:08.744]      __ap = 4;
