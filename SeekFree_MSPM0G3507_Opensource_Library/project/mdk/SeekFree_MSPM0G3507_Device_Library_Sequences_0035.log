[02:26:30.042]      __var deviceID = 0;
[02:26:30.042]        // -> [deviceID <= 0x00000000]
[02:26:30.042]      __var version = 0;
[02:26:30.042]        // -> [version <= 0x00000000]
[02:26:30.042]      __var partNum = 0;
[02:26:30.042]        // -> [partNum <= 0x00000000]
[02:26:30.042]      __var manuf = 0;
[02:26:30.042]        // -> [manuf <= 0x00000000]
[02:26:30.042]      __var isMSPM0G1X0X_G3X0X = 0;
[02:26:30.043]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[02:26:30.043]      __var isProduction = 0;
[02:26:30.043]        // -> [isProduction <= 0x00000000]
[02:26:30.043]      __var continueId = 0;
[02:26:30.043]        // -> [continueId <= 0x00000000]
[02:26:30.043]      deviceID =   Read32(0x41C40004);
[02:26:30.062]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[02:26:30.062]        // -> [deviceID <= 0x2BB8802F]
[02:26:30.062]      version = deviceID >> 28;
[02:26:30.062]        // -> [version <= 0x00000002]
[02:26:30.062]      partNum = (deviceID & 0x0FFFF000) >> 12;
[02:26:30.062]        // -> [partNum <= 0x0000BB88]
[02:26:30.062]      manuf = (deviceID & 0x00000FFE) >> 1;
[02:26:30.062]        // -> [manuf <= 0x00000017]
[02:26:30.062]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[02:26:30.062]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[02:26:30.062]      isProduction = (version > 0);
[02:26:30.062]        // -> [isProduction <= 0x00000001]
[02:26:30.062]    </block>
[02:26:30.062]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[02:26:30.062]      // if-block "!isMSPM0G1X0X_G3X0X"
[02:26:30.062]        // =>  FALSE
[02:26:30.062]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[02:26:30.062]    </control>
