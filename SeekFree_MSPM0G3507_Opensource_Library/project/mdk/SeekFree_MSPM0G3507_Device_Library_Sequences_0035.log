[02:19:18.700]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[02:19:18.700]    <block atomic="false" info="">
[02:19:18.700]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[02:19:18.700]        // -> [isSWJ <= 0x00000001]
[02:19:18.700]      __var hasDormant = __protocol & 0x00020000;
