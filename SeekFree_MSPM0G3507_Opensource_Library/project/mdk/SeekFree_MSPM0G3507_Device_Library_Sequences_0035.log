[01:09:25.712]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[01:09:25.712]    <block atomic="false" info="">
[01:09:25.712]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[01:09:25.712]        // -> [isSWJ <= 0x00000001]
