[02:21:14.452]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[02:21:14.452]    <block atomic="false" info="">
[02:21:14.452]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[02:21:14.452]        // -> [isSWJ <= 0x00000001]
[02:21:14.452]      __var hasDormant = __protocol & 0x00020000;
[02:21:14.452]        // -> [hasDormant <= 0x00000000]
