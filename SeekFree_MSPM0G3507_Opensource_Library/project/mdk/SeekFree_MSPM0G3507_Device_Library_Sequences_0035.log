[02:31:08.396]          // if-block "!hasDormant"
[02:31:08.396]            // =>  TRUE
[02:31:08.396]          <block atomic="false" info="">
[02:31:08.396]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[02:31:08.401]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[02:31:08.401]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
