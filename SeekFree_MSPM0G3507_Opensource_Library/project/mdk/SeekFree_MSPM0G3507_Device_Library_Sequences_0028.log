[20:50:17.635]      // skip if-block "protType == 1"
[20:50:17.635]    </control>
[20:50:17.635]    <control if="protType == 2" while="" timeout="0" info="">
[20:50:17.635]      // if-block "protType == 2"
[20:50:17.635]        // =>  TRUE
[20:50:17.635]      <control if="isSWJ" while="" timeout="0" info="">
[20:50:17.635]        // if-block "isSWJ"
[20:50:17.635]          // =>  TRUE
[20:50:17.635]        <control if="hasDormant" while="" timeout="0" info="">
[20:50:17.635]          // if-block "hasDormant"
[20:50:17.635]            // =>  FALSE
[20:50:17.635]          // skip if-block "hasDormant"
[20:50:17.635]        </control>
[20:50:17.635]        <control if="!hasDormant" while="" timeout="0" info="">
[20:50:17.635]          // if-block "!hasDormant"
[20:50:17.635]            // =>  TRUE
[20:50:17.635]          <block atomic="false" info="">
[20:50:17.635]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:50:17.637]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:50:17.637]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:50:17.637]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:50:17.637]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:50:17.642]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:50:17.642]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[20:50:17.647]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[20:50:17.647]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[20:50:17.649]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:50:17.649]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:50:17.650]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[20:50:17.650]          </block>
[20:50:17.650]          // end if-block "!hasDormant"
[20:50:17.650]        </control>
[20:50:17.650]        // end if-block "isSWJ"
[20:50:17.650]      </control>
