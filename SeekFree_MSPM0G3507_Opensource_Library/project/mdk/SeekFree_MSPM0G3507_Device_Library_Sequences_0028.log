[20:54:49.236]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[20:54:49.236]      </block>
[20:54:49.236]      // end if-block "protType == 2"
[20:54:49.236]    </control>
