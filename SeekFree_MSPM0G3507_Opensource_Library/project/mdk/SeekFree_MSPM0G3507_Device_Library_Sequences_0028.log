[20:50:17.657]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[20:50:17.657]    <block atomic="false" info="">
[20:50:17.657]      __var SW_DP_ABORT       = 0x0;
[20:50:17.657]        // -> [SW_DP_ABORT <= 0x00000000]
[20:50:17.657]      __var DP_CTRL_STAT      = 0x4;
[20:50:17.657]        // -> [DP_CTRL_STAT <= 0x00000004]
[20:50:17.657]      __var DP_SELECT         = 0x8;
[20:50:17.657]        // -> [DP_SELECT <= 0x00000008]
[20:50:17.657]      __var powered_down      = 0;
[20:50:17.657]        // -> [powered_down <= 0x00000000]
[20:50:17.657]      WriteDP(DP_SELECT, 0x00000000);
[20:50:17.657]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[20:50:17.657]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[20:50:17.661]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[20:50:17.661]        // -> [powered_down <= 0x00000001]
[20:50:17.661]    </block>
[20:50:17.661]    <control if="powered_down" while="" timeout="0" info="">
[20:50:17.661]      // if-block "powered_down"
[20:50:17.661]        // =>  TRUE
[20:50:17.661]      <block atomic="false" info="">
[20:50:17.661]        Message(0, "Debug/System power-up request sent");
[20:50:17.667]        WriteDP(DP_CTRL_STAT, 0x50000000);
[20:50:17.671]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[20:50:17.671]      </block>
[20:50:17.671]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[20:50:17.671]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[20:50:17.673]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[20:50:17.673]        // while-condition  =>  FALSE
[20:50:17.673]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[20:50:17.673]      </control>
[20:50:17.673]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[20:50:17.673]        // if-block "(__protocol & 0xFFFF) == 1"
[20:50:17.673]          // =>  FALSE
[20:50:17.673]        // skip if-block "(__protocol & 0xFFFF) == 1"
[20:50:17.673]      </control>
[20:50:17.673]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[20:50:17.673]        // if-block "(__protocol & 0xFFFF) == 2"
[20:50:17.673]          // =>  TRUE
[20:50:17.673]        <block atomic="false" info="">
[20:50:17.673]          Message(0, "executing SWD power up");
[20:50:17.673]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[20:50:17.681]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[20:50:17.681]          WriteDP(SW_DP_ABORT, 0x0000001E);
[20:50:17.681]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[20:50:17.681]        </block>
[20:50:17.681]        // end if-block "(__protocol & 0xFFFF) == 2"
[20:50:17.681]      </control>
[20:50:17.681]      // end if-block "powered_down"
[20:50:17.681]    </control>
