[19:36:23.527]      // if-block "protType == 1"
[19:36:23.527]        // =>  FALSE
[19:36:23.527]      // skip if-block "protType == 1"
[19:36:23.527]    </control>
[19:36:23.527]    <control if="protType == 2" while="" timeout="0" info="">
[19:36:23.527]      // if-block "protType == 2"
[19:36:23.527]        // =>  TRUE
[19:36:23.527]      <control if="isSWJ" while="" timeout="0" info="">
[19:36:23.527]        // if-block "isSWJ"
[19:36:23.527]          // =>  TRUE
[19:36:23.527]        <control if="hasDormant" while="" timeout="0" info="">
[19:36:23.527]          // if-block "hasDormant"
[19:36:23.527]            // =>  FALSE
[19:36:23.527]          // skip if-block "hasDormant"
[19:36:23.527]        </control>
[19:36:23.527]        <control if="!hasDormant" while="" timeout="0" info="">
[19:36:23.527]          // if-block "!hasDormant"
[19:36:23.527]            // =>  TRUE
[19:36:23.527]          <block atomic="false" info="">
[19:36:23.527]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:36:23.527]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:36:23.527]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:36:23.527]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:36:23.533]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:36:23.535]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:36:23.535]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:36:23.537]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:36:23.537]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:36:23.537]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:36:23.537]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:36:23.537]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:36:23.543]          </block>
[19:36:23.543]          // end if-block "!hasDormant"
[19:36:23.543]        </control>
[19:36:23.543]        // end if-block "isSWJ"
[19:36:23.543]      </control>
[19:36:23.543]      <control if="!isSWJ" while="" timeout="0" info="">
[19:36:23.543]        // if-block "!isSWJ"
[19:36:23.543]          // =>  FALSE
[19:36:23.543]        // skip if-block "!isSWJ"
[19:36:23.543]      </control>
