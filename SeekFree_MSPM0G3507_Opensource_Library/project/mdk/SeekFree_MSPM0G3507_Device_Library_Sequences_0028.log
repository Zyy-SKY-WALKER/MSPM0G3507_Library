[19:46:15.057]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:46:15.058]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:46:15.058]          </block>
[19:46:15.058]          // end if-block "!hasDormant"
