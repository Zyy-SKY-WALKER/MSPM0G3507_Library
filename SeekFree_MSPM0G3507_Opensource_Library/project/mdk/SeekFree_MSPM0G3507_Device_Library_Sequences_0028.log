[20:54:49.227]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[20:54:49.227]    <block atomic="false" info="">
[20:54:49.227]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[20:54:49.227]        // -> [isSWJ <= 0x00000001]
