[19:26:59.930]        // -> [partNum <= 0x0000BB88]
[19:26:59.930]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:26:59.930]        // -> [manuf <= 0x00000017]
[19:26:59.930]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:26:59.930]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:26:59.930]      isProduction = (version > 0);
