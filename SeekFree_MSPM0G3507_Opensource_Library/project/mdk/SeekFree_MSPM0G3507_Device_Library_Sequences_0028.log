[20:50:17.631]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[20:50:17.631]    <block atomic="false" info="">
[20:50:17.631]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[20:50:17.631]        // -> [isSWJ <= 0x00000001]
[20:50:17.631]      __var hasDormant = __protocol & 0x00020000;
[20:50:17.631]        // -> [hasDormant <= 0x00000000]
[20:50:17.631]      __var protType   = __protocol & 0x0000FFFF;
[20:50:17.631]        // -> [protType <= 0x00000002]
[20:50:17.635]    </block>
[20:50:17.635]    <control if="protType == 1" while="" timeout="0" info="">
