[19:36:23.631]  **********  Sequence "DebugDeviceUnlock"  (Context="Connect", Pname="", info="")
[19:36:23.631]  
[19:36:23.631]  <debugvars>
[19:36:23.631]    // Pre-defined
[19:36:23.632]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[19:36:23.632]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[19:36:23.632]    __dp=0x00000000
