[20:45:04.012]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[20:45:04.012]    <block atomic="false" info="">
[20:45:04.012]      __var deviceID = 0;
[20:45:04.012]        // -> [deviceID <= 0x00000000]
[20:45:04.012]      __var version = 0;
[20:45:04.012]        // -> [version <= 0x00000000]
[20:45:04.012]      __var partNum = 0;
[20:45:04.012]        // -> [partNum <= 0x00000000]
[20:45:04.012]      __var manuf = 0;
[20:45:04.012]        // -> [manuf <= 0x00000000]
[20:45:04.012]      __var isMSPM0G1X0X_G3X0X = 0;
[20:45:04.012]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:45:04.012]      __var isProduction = 0;
[20:45:04.012]        // -> [isProduction <= 0x00000000]
[20:45:04.012]      __var continueId = 0;
[20:45:04.012]        // -> [continueId <= 0x00000000]
[20:45:04.012]      deviceID =   Read32(0x41C40004);
[20:45:04.022]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:45:04.022]        // -> [deviceID <= 0x2BB8802F]
[20:45:04.022]      version = deviceID >> 28;
[20:45:04.022]        // -> [version <= 0x00000002]
[20:45:04.022]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:45:04.022]        // -> [partNum <= 0x0000BB88]
[20:45:04.022]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:45:04.022]        // -> [manuf <= 0x00000017]
[20:45:04.022]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:45:04.022]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:45:04.022]      isProduction = (version > 0);
[20:45:04.022]        // -> [isProduction <= 0x00000001]
[20:45:04.022]    </block>
[20:45:04.022]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[20:45:04.022]      // if-block "!isMSPM0G1X0X_G3X0X"
[20:45:04.022]        // =>  FALSE
[20:45:04.022]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[20:45:04.022]    </control>
[20:45:04.022]    <control if="continueId == 4" while="" timeout="0" info="">
[20:45:04.022]      // if-block "continueId == 4"
[20:45:04.022]        // =>  FALSE
[20:45:04.022]      // skip if-block "continueId == 4"
[20:45:04.022]    </control>
[20:45:04.022]    <control if="!isProduction" while="" timeout="0" info="">
