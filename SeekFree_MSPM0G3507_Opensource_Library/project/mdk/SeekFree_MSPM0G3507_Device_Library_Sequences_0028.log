[19:36:23.527]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:36:23.527]    <block atomic="false" info="">
[19:36:23.527]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:36:23.527]        // -> [isSWJ <= 0x00000001]
[19:36:23.527]      __var hasDormant = __protocol & 0x00020000;
[19:36:23.527]        // -> [hasDormant <= 0x00000000]
[19:36:23.527]      __var protType   = __protocol & 0x0000FFFF;
[19:36:23.527]        // -> [protType <= 0x00000002]
[19:36:23.527]    </block>
