[20:50:17.652]        ReadDP(0x0);
[20:50:17.652]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[20:50:17.652]      </block>
[20:50:17.652]      // end if-block "protType == 2"
[20:50:17.652]    </control>
