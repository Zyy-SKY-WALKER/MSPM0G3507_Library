[19:26:59.919]        // -> [deviceID <= 0x00000000]
[19:26:59.919]      __var version = 0;
[19:26:59.919]        // -> [version <= 0x00000000]
[19:26:59.919]      __var partNum = 0;
[19:26:59.919]        // -> [partNum <= 0x00000000]
[19:26:59.919]      __var manuf = 0;
[19:26:59.919]        // -> [manuf <= 0x00000000]
[19:26:59.919]      __var isMSPM0G1X0X_G3X0X = 0;
[19:26:59.919]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:26:59.919]      __var isProduction = 0;
[19:26:59.919]        // -> [isProduction <= 0x00000000]
[19:26:59.919]      __var continueId = 0;
[19:26:59.919]        // -> [continueId <= 0x00000000]
[19:26:59.919]      deviceID =   Read32(0x41C40004);
