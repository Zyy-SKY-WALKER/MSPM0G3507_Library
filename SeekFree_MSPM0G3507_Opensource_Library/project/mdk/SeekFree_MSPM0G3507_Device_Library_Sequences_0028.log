[19:46:15.043]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:46:15.043]    <block atomic="false" info="">
[19:46:15.043]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:46:15.043]        // -> [isSWJ <= 0x00000001]
[19:46:15.043]      __var hasDormant = __protocol & 0x00020000;
[19:46:15.043]        // -> [hasDormant <= 0x00000000]
