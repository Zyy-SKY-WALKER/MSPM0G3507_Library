[19:46:15.069]      __var powered_down      = 0;
[19:46:15.069]        // -> [powered_down <= 0x00000000]
[19:46:15.069]      WriteDP(DP_SELECT, 0x00000000);
[19:46:15.073]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:46:15.073]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:46:15.075]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:46:15.075]        // -> [powered_down <= 0x00000001]
[19:46:15.075]    </block>
[19:46:15.075]    <control if="powered_down" while="" timeout="0" info="">
[19:46:15.075]      // if-block "powered_down"
[19:46:15.075]        // =>  TRUE
[19:46:15.075]      <block atomic="false" info="">
[19:46:15.075]        Message(0, "Debug/System power-up request sent");
[19:46:15.076]        WriteDP(DP_CTRL_STAT, 0x50000000);
[19:46:15.080]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[19:46:15.080]      </block>
[19:46:15.080]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[19:46:15.080]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[19:46:15.083]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[19:46:15.083]        // while-condition  =>  FALSE
[19:46:15.083]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[19:46:15.083]      </control>
[19:46:15.083]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[19:46:15.083]        // if-block "(__protocol & 0xFFFF) == 1"
[19:46:15.083]          // =>  FALSE
[19:46:15.083]        // skip if-block "(__protocol & 0xFFFF) == 1"
[19:46:15.083]      </control>
[19:46:15.083]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[19:46:15.083]        // if-block "(__protocol & 0xFFFF) == 2"
[19:46:15.083]          // =>  TRUE
[19:46:15.083]        <block atomic="false" info="">
[19:46:15.083]          Message(0, "executing SWD power up");
[19:46:15.085]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[19:46:15.091]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[19:46:15.091]          WriteDP(SW_DP_ABORT, 0x0000001E);
[19:46:15.094]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[19:46:15.094]        </block>
[19:46:15.094]        // end if-block "(__protocol & 0xFFFF) == 2"
[19:46:15.094]      </control>
[19:46:15.094]      // end if-block "powered_down"
[19:46:15.094]    </control>
[19:46:15.094]    <block atomic="false" info="">
[19:46:15.094]      __var DEBUG_PORT_VAL    = 0;
[19:46:15.094]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[19:46:15.094]      __var ACCESS_POINT_VAL  = 0;
[19:46:15.094]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[19:46:15.094]      __ap = 1; 
[19:46:15.094]        // -> [__ap <= 0x00000001]
[19:46:15.094]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[19:46:15.098]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[19:46:15.098]      __ap = 4;
[19:46:15.099]        // -> [__ap <= 0x00000004]
[19:46:15.099]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[19:46:15.102]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[19:46:15.102]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[19:46:15.102]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[19:46:15.103]    </block>
[19:46:15.103]    <block atomic="false" info="">
[19:46:15.103]      __var nReset = 0x80;
[19:46:15.103]        // -> [nReset <= 0x00000080]
