[19:46:15.043]          // if-block "hasDormant"
[19:46:15.043]            // =>  FALSE
[19:46:15.043]          // skip if-block "hasDormant"
[19:46:15.043]        </control>
[19:46:15.043]        <control if="!hasDormant" while="" timeout="0" info="">
[19:46:15.043]          // if-block "!hasDormant"
[19:46:15.043]            // =>  TRUE
[19:46:15.043]          <block atomic="false" info="">
[19:46:15.043]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:46:15.049]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:46:15.050]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:46:15.051]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:46:15.051]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
