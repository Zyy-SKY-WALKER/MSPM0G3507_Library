[19:36:23.632]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:36:23.632]    <block atomic="false" info="">
[19:36:23.632]      __var deviceID = 0;
[19:36:23.632]        // -> [deviceID <= 0x00000000]
[19:36:23.632]      __var version = 0;
[19:36:23.632]        // -> [version <= 0x00000000]
[19:36:23.632]      __var partNum = 0;
[19:36:23.632]        // -> [partNum <= 0x00000000]
[19:36:23.632]      __var manuf = 0;
[19:36:23.632]        // -> [manuf <= 0x00000000]
[19:36:23.632]      __var isMSPM0G1X0X_G3X0X = 0;
[19:36:23.633]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:36:23.633]      __var isProduction = 0;
[19:36:23.633]        // -> [isProduction <= 0x00000000]
[19:36:23.633]      __var continueId = 0;
[19:36:23.633]        // -> [continueId <= 0x00000000]
[19:36:23.633]      deviceID =   Read32(0x41C40004);
[19:36:23.635]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:36:23.635]        // -> [deviceID <= 0x2BB8802F]
[19:36:23.635]      version = deviceID >> 28;
[19:36:23.635]        // -> [version <= 0x00000002]
[19:36:23.635]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:36:23.635]        // -> [partNum <= 0x0000BB88]
[19:36:23.635]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:36:23.635]        // -> [manuf <= 0x00000017]
[19:36:23.635]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:36:23.635]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:36:23.635]      isProduction = (version > 0);
[19:36:23.635]        // -> [isProduction <= 0x00000001]
[19:36:23.635]    </block>
[19:36:23.635]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[19:36:23.635]      // if-block "!isMSPM0G1X0X_G3X0X"
[19:36:23.635]        // =>  FALSE
[19:36:23.635]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[19:36:23.635]    </control>
[19:36:23.635]    <control if="continueId == 4" while="" timeout="0" info="">
[19:36:23.635]      // if-block "continueId == 4"
[19:36:23.635]        // =>  FALSE
[19:36:23.635]      // skip if-block "continueId == 4"
[19:36:23.635]    </control>
[19:36:23.635]    <control if="!isProduction" while="" timeout="0" info="">
[19:36:23.635]      // if-block "!isProduction"
[19:36:23.635]        // =>  FALSE
[19:36:23.635]      // skip if-block "!isProduction"
[19:36:23.635]    </control>
[19:36:23.635]  </sequence>
