[20:54:49.242]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[20:54:49.242]    <block atomic="false" info="">
[20:54:49.242]      __var SW_DP_ABORT       = 0x0;
[20:54:49.242]        // -> [SW_DP_ABORT <= 0x00000000]
[20:54:49.242]      __var DP_CTRL_STAT      = 0x4;
[20:54:49.242]        // -> [DP_CTRL_STAT <= 0x00000004]
