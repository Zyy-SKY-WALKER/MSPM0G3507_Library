[20:54:49.247]        // skip if-block "(__protocol & 0xFFFF) == 1"
[20:54:49.247]      </control>
[20:54:49.247]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[20:54:49.247]        // if-block "(__protocol & 0xFFFF) == 2"
[20:54:49.247]          // =>  TRUE
[20:54:49.247]        <block atomic="false" info="">
[20:54:49.247]          Message(0, "executing SWD power up");
[20:54:49.247]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[20:54:49.247]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[20:54:49.247]          WriteDP(SW_DP_ABORT, 0x0000001E);
