[20:45:03.929]          WriteDP(SW_DP_ABORT, 0x0000001E);
[20:45:03.929]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[20:45:03.929]        </block>
[20:45:03.929]        // end if-block "(__protocol & 0xFFFF) == 2"
[20:45:03.929]      </control>
[20:45:03.929]      // end if-block "powered_down"
