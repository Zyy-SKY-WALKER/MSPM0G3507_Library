[20:50:17.742]      __var isMSPM0G1X0X_G3X0X = 0;
[20:50:17.742]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:50:17.742]      __var isProduction = 0;
[20:50:17.742]        // -> [isProduction <= 0x00000000]
[20:50:17.742]      __var continueId = 0;
[20:50:17.742]        // -> [continueId <= 0x00000000]
[20:50:17.742]      deviceID =   Read32(0x41C40004);
