[20:45:03.917]      <block atomic="false" info="">
[20:45:03.917]        Message(0, "Debug/System power-up request sent");
[20:45:03.917]        WriteDP(DP_CTRL_STAT, 0x50000000);
[20:45:03.923]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[20:45:03.923]      </block>
[20:45:03.923]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[20:45:03.923]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[20:45:03.923]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[20:45:03.923]        // while-condition  =>  FALSE
[20:45:03.923]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[20:45:03.923]      </control>
[20:45:03.923]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[20:45:03.923]        // if-block "(__protocol & 0xFFFF) == 1"
[20:45:03.923]          // =>  FALSE
[20:45:03.923]        // skip if-block "(__protocol & 0xFFFF) == 1"
[20:45:03.923]      </control>
[20:45:03.923]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[20:45:03.923]        // if-block "(__protocol & 0xFFFF) == 2"
[20:45:03.923]          // =>  TRUE
[20:45:03.923]        <block atomic="false" info="">
[20:45:03.923]          Message(0, "executing SWD power up");
[20:45:03.923]          WriteDP(DP_CTRL_STAT, 0x50000F00);
