[14:40:50.767]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[14:40:50.767]    <block atomic="false" info="">
[14:40:50.767]      __var deviceID = 0;
[14:40:50.767]        // -> [deviceID <= 0x00000000]
[14:40:50.767]      __var version = 0;
[14:40:50.767]        // -> [version <= 0x00000000]
[14:40:50.767]      __var partNum = 0;
[14:40:50.767]        // -> [partNum <= 0x00000000]
[14:40:50.767]      __var manuf = 0;
[14:40:50.767]        // -> [manuf <= 0x00000000]
[14:40:50.767]      __var isMSPM0G1X0X_G3X0X = 0;
[14:40:50.767]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[14:40:50.767]      __var isProduction = 0;
[14:40:50.767]        // -> [isProduction <= 0x00000000]
[14:40:50.767]      __var continueId = 0;
[14:40:50.767]        // -> [continueId <= 0x00000000]
[14:40:50.767]      deviceID =   Read32(0x41C40004);
[14:40:50.767]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[14:40:50.767]        // -> [deviceID <= 0x2BB8802F]
[14:40:50.767]      version = deviceID >> 28;
[14:40:50.767]        // -> [version <= 0x00000002]
[14:40:50.777]      partNum = (deviceID & 0x0FFFF000) >> 12;
[14:40:50.777]        // -> [partNum <= 0x0000BB88]
[14:40:50.777]      manuf = (deviceID & 0x00000FFE) >> 1;
[14:40:50.777]        // -> [manuf <= 0x00000017]
[14:40:50.777]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[14:40:50.777]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[14:40:50.777]      isProduction = (version > 0);
[14:40:50.777]        // -> [isProduction <= 0x00000001]
[14:40:50.777]    </block>
[14:40:50.777]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[14:40:50.777]      // if-block "!isMSPM0G1X0X_G3X0X"
[14:40:50.777]        // =>  FALSE
[14:40:50.777]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[14:40:50.777]    </control>
[14:40:50.777]    <control if="continueId == 4" while="" timeout="0" info="">
[14:40:50.777]      // if-block "continueId == 4"
[14:40:50.777]        // =>  FALSE
[14:40:50.777]      // skip if-block "continueId == 4"
[14:40:50.777]    </control>
[14:40:50.777]    <control if="!isProduction" while="" timeout="0" info="">
