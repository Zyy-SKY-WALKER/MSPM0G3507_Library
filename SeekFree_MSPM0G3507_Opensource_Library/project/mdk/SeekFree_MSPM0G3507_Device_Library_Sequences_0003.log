[14:40:50.689]        // if-block "(__protocol & 0xFFFF) == 2"
[14:40:50.689]          // =>  TRUE
[14:40:50.689]        <block atomic="false" info="">
[14:40:50.689]          Message(0, "executing SWD power up");
[14:40:50.689]          WriteDP(DP_CTRL_STAT, 0x50000F00);
