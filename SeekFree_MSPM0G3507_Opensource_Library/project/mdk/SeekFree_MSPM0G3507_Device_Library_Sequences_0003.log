[15:45:40.293]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[15:45:40.293]    <block atomic="false" info="">
[15:45:40.293]      __var deviceID = 0;
[15:45:40.293]        // -> [deviceID <= 0x00000000]
[15:45:40.293]      __var version = 0;
[15:45:40.293]        // -> [version <= 0x00000000]
[15:45:40.293]      __var partNum = 0;
[15:45:40.293]        // -> [partNum <= 0x00000000]
[15:45:40.293]      __var manuf = 0;
[15:45:40.293]        // -> [manuf <= 0x00000000]
[15:45:40.293]      __var isMSPM0G1X0X_G3X0X = 0;
[15:45:40.293]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[15:45:40.293]      __var isProduction = 0;
[15:45:40.293]        // -> [isProduction <= 0x00000000]
[15:45:40.293]      __var continueId = 0;
[15:45:40.293]        // -> [continueId <= 0x00000000]
[15:45:40.293]      deviceID =   Read32(0x41C40004);
[15:45:40.304]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[15:45:40.305]        // -> [deviceID <= 0x2BB8802F]
[15:45:40.305]      version = deviceID >> 28;
[15:45:40.305]        // -> [version <= 0x00000002]
[15:45:40.305]      partNum = (deviceID & 0x0FFFF000) >> 12;
[15:45:40.305]        // -> [partNum <= 0x0000BB88]
[15:45:40.305]      manuf = (deviceID & 0x00000FFE) >> 1;
[15:45:40.305]        // -> [manuf <= 0x00000017]
[15:45:40.305]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[15:45:40.305]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[15:45:40.305]      isProduction = (version > 0);
[15:45:40.305]        // -> [isProduction <= 0x00000001]
[15:45:40.305]    </block>
[15:45:40.305]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[15:45:40.306]      // if-block "!isMSPM0G1X0X_G3X0X"
[15:45:40.306]        // =>  FALSE
[15:45:40.306]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[15:45:40.306]    </control>
[15:45:40.306]    <control if="continueId == 4" while="" timeout="0" info="">
[15:45:40.306]      // if-block "continueId == 4"
[15:45:40.306]        // =>  FALSE
[15:45:40.306]      // skip if-block "continueId == 4"
[15:45:40.306]    </control>
[15:45:40.306]    <control if="!isProduction" while="" timeout="0" info="">
