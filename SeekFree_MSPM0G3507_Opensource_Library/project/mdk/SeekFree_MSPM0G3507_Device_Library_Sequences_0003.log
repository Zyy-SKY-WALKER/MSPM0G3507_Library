[15:45:40.214]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[15:45:40.214]    <block atomic="false" info="">
[15:45:40.214]      __var SW_DP_ABORT       = 0x0;
[15:45:40.214]        // -> [SW_DP_ABORT <= 0x00000000]
[15:45:40.214]      __var DP_CTRL_STAT      = 0x4;
[15:45:40.214]        // -> [DP_CTRL_STAT <= 0x00000004]
[15:45:40.214]      __var DP_SELECT         = 0x8;
[15:45:40.214]        // -> [DP_SELECT <= 0x00000008]
[15:45:40.214]      __var powered_down      = 0;
[15:45:40.214]        // -> [powered_down <= 0x00000000]
[15:45:40.214]      WriteDP(DP_SELECT, 0x00000000);
[15:45:40.216]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[15:45:40.216]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[15:45:40.218]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[15:45:40.218]        // -> [powered_down <= 0x00000001]
