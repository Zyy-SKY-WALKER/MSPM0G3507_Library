[15:45:40.218]      <block atomic="false" info="">
[15:45:40.219]        Message(0, "Debug/System power-up request sent");
[15:45:40.220]        WriteDP(DP_CTRL_STAT, 0x50000000);
[15:45:40.225]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[15:45:40.225]      </block>
[15:45:40.225]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[15:45:40.225]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[15:45:40.227]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[15:45:40.227]        // while-condition  =>  FALSE
[15:45:40.227]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[15:45:40.227]      </control>
[15:45:40.227]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
