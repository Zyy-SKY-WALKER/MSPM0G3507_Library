[15:45:40.190]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:45:40.190]    <block atomic="false" info="">
[15:45:40.190]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:45:40.190]        // -> [isSWJ <= 0x00000001]
[15:45:40.190]      __var hasDormant = __protocol & 0x00020000;
[15:45:40.190]        // -> [hasDormant <= 0x00000000]
[15:45:40.190]      __var protType   = __protocol & 0x0000FFFF;
[15:45:40.190]        // -> [protType <= 0x00000002]
[15:45:40.190]    </block>
[15:45:40.190]    <control if="protType == 1" while="" timeout="0" info="">
[15:45:40.191]      // if-block "protType == 1"
[15:45:40.191]        // =>  FALSE
[15:45:40.191]      // skip if-block "protType == 1"
[15:45:40.191]    </control>
[15:45:40.191]    <control if="protType == 2" while="" timeout="0" info="">
[15:45:40.191]      // if-block "protType == 2"
[15:45:40.191]        // =>  TRUE
[15:45:40.191]      <control if="isSWJ" while="" timeout="0" info="">
[15:45:40.191]        // if-block "isSWJ"
[15:45:40.191]          // =>  TRUE
[15:45:40.191]        <control if="hasDormant" while="" timeout="0" info="">
[15:45:40.191]          // if-block "hasDormant"
[15:45:40.191]            // =>  FALSE
[15:45:40.191]          // skip if-block "hasDormant"
[15:45:40.191]        </control>
[15:45:40.191]        <control if="!hasDormant" while="" timeout="0" info="">
[15:45:40.191]          // if-block "!hasDormant"
[15:45:40.191]            // =>  TRUE
[15:45:40.191]          <block atomic="false" info="">
[15:45:40.191]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:45:40.193]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:45:40.193]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:45:40.193]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:45:40.193]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:45:40.198]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:45:40.198]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:45:40.201]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:45:40.201]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:45:40.204]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:45:40.204]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:45:40.206]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:45:40.206]          </block>
[15:45:40.206]          // end if-block "!hasDormant"
[15:45:40.206]        </control>
[15:45:40.206]        // end if-block "isSWJ"
[15:45:40.206]      </control>
[15:45:40.206]      <control if="!isSWJ" while="" timeout="0" info="">
[15:45:40.206]        // if-block "!isSWJ"
[15:45:40.206]          // =>  FALSE
[15:45:40.206]        // skip if-block "!isSWJ"
[15:45:40.206]      </control>
[15:45:40.206]      <block atomic="false" info="">
[15:45:40.206]        ReadDP(0x0);
[15:45:40.209]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[15:45:40.209]      </block>
[15:45:40.209]      // end if-block "protType == 2"
[15:45:40.209]    </control>
[15:45:40.209]  </sequence>
