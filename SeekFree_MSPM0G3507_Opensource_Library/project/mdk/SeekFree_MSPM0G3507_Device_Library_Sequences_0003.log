[14:36:05.648]      <block atomic="false" info="">
[14:36:05.648]        WriteAP(0x00, 0x190008);
[14:36:05.652]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[14:36:05.652]        WriteAP(0xF0, 0x01);
[14:36:05.658]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[14:36:05.658]      </block>
[14:36:05.658]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[14:36:05.658]    </control>
[14:36:05.658]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
