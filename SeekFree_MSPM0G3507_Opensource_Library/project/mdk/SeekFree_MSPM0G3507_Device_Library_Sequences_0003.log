[14:36:05.689]        // -> [partNum <= 0x00000000]
[14:36:05.689]      __var manuf = 0;
[14:36:05.689]        // -> [manuf <= 0x00000000]
[14:36:05.689]      __var isMSPM0G1X0X_G3X0X = 0;
[14:36:05.689]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[14:36:05.689]      __var isProduction = 0;
[14:36:05.689]        // -> [isProduction <= 0x00000000]
[14:36:05.689]      __var continueId = 0;
[14:36:05.689]        // -> [continueId <= 0x00000000]
[14:36:05.689]      deviceID =   Read32(0x41C40004);
[14:36:05.697]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[14:36:05.698]        // -> [deviceID <= 0x2BB8802F]
[14:36:05.698]      version = deviceID >> 28;
[14:36:05.698]        // -> [version <= 0x00000002]
[14:36:05.698]      partNum = (deviceID & 0x0FFFF000) >> 12;
[14:36:05.698]        // -> [partNum <= 0x0000BB88]
[14:36:05.698]      manuf = (deviceID & 0x00000FFE) >> 1;
[14:36:05.698]        // -> [manuf <= 0x00000017]
[14:36:05.698]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[14:36:05.698]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[14:36:05.698]      isProduction = (version > 0);
[14:36:05.698]        // -> [isProduction <= 0x00000001]
[14:36:05.698]    </block>
[14:36:05.698]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
