[15:49:15.805]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[15:49:15.805]    <block atomic="false" info="">
[15:49:15.805]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[15:49:15.805]        // -> [isSWJ <= 0x00000001]
[15:49:15.805]      __var hasDormant = __protocol & 0x00020000;
[15:49:15.805]        // -> [hasDormant <= 0x00000000]
[15:49:15.805]      __var protType   = __protocol & 0x0000FFFF;
[15:49:15.805]        // -> [protType <= 0x00000002]
[15:49:15.805]    </block>
[15:49:15.805]    <control if="protType == 1" while="" timeout="0" info="">
[15:49:15.805]      // if-block "protType == 1"
[15:49:15.805]        // =>  FALSE
[15:49:15.805]      // skip if-block "protType == 1"
[15:49:15.805]    </control>
[15:49:15.805]    <control if="protType == 2" while="" timeout="0" info="">
[15:49:15.805]      // if-block "protType == 2"
[15:49:15.805]        // =>  TRUE
[15:49:15.806]      <control if="isSWJ" while="" timeout="0" info="">
[15:49:15.806]        // if-block "isSWJ"
[15:49:15.806]          // =>  TRUE
[15:49:15.806]        <control if="hasDormant" while="" timeout="0" info="">
[15:49:15.806]          // if-block "hasDormant"
[15:49:15.806]            // =>  FALSE
[15:49:15.806]          // skip if-block "hasDormant"
[15:49:15.806]        </control>
[15:49:15.806]        <control if="!hasDormant" while="" timeout="0" info="">
[15:49:15.806]          // if-block "!hasDormant"
[15:49:15.806]            // =>  TRUE
[15:49:15.806]          <block atomic="false" info="">
[15:49:15.806]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[15:49:15.811]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:49:15.811]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[15:49:15.812]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[15:49:15.812]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[15:49:15.814]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:49:15.814]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[15:49:15.819]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[15:49:15.819]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[15:49:15.822]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[15:49:15.822]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[15:49:15.825]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[15:49:15.825]          </block>
[15:49:15.825]          // end if-block "!hasDormant"
[15:49:15.825]        </control>
