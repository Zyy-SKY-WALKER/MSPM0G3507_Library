[14:40:50.649]          <block atomic="false" info="">
[14:40:50.649]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[14:40:50.659]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
