[10:37:47.689]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[10:37:47.690]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[10:37:47.690]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[10:37:47.690]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[10:37:47.690]          </block>
