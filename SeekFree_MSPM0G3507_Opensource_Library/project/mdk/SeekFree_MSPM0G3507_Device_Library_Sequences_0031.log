[10:39:05.470]        // -> [partNum <= 0x00000000]
[10:39:05.470]      __var manuf = 0;
[10:39:05.470]        // -> [manuf <= 0x00000000]
[10:39:05.470]      __var isMSPM0G1X0X_G3X0X = 0;
[10:39:05.470]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[10:39:05.470]      __var isProduction = 0;
[10:39:05.470]        // -> [isProduction <= 0x00000000]
[10:39:05.470]      __var continueId = 0;
[10:39:05.470]        // -> [continueId <= 0x00000000]
[10:39:05.470]      deviceID =   Read32(0x41C40004);
