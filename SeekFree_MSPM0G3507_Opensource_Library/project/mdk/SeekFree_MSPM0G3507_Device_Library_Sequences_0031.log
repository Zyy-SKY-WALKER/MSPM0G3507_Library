[11:13:41.267]            // =>  TRUE
[11:13:41.267]          <block atomic="false" info="">
[11:13:41.267]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
