[10:37:47.696]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[10:37:47.696]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
