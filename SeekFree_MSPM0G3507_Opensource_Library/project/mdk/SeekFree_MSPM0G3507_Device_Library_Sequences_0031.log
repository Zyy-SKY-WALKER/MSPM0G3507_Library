[10:39:05.480]        // -> [partNum <= 0x0000BB88]
[10:39:05.480]      manuf = (deviceID & 0x00000FFE) >> 1;
[10:39:05.480]        // -> [manuf <= 0x00000017]
[10:39:05.480]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[10:39:05.480]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[10:39:05.480]      isProduction = (version > 0);
[10:39:05.480]        // -> [isProduction <= 0x00000001]
