[10:37:47.711]        <block atomic="false" info="">
[10:37:47.711]          Message(0, "executing SWD power up");
[10:37:47.711]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[10:37:47.717]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
