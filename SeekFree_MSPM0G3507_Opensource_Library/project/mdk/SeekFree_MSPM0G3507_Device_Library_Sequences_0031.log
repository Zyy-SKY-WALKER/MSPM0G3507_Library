[10:37:47.675]          // if-block "hasDormant"
[10:37:47.675]            // =>  FALSE
[10:37:47.675]          // skip if-block "hasDormant"
[10:37:47.675]        </control>
[10:37:47.675]        <control if="!hasDormant" while="" timeout="0" info="">
[10:37:47.675]          // if-block "!hasDormant"
[10:37:47.675]            // =>  TRUE
[10:37:47.675]          <block atomic="false" info="">
[10:37:47.675]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[10:37:47.675]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[10:37:47.675]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[10:37:47.675]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[10:37:47.675]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[10:37:47.687]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[10:37:47.687]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
