[10:37:47.718]        // -> [__ap <= 0x00000001]
[10:37:47.718]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[10:37:47.718]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[10:37:47.718]      __ap = 4;
