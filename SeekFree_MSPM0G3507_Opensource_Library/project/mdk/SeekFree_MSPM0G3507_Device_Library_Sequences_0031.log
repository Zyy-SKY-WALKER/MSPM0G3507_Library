[10:16:01.743]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[10:16:01.743]      __var isProduction = 0;
[10:16:01.743]        // -> [isProduction <= 0x00000000]
[10:16:01.743]      __var continueId = 0;
[10:16:01.743]        // -> [continueId <= 0x00000000]
