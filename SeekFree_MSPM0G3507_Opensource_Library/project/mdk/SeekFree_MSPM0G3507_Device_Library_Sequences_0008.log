[20:44:41.789]        // =>  FALSE
[20:44:41.789]      // skip if-block "(ACCESS_POINT_VAL & 0x00E00000) != 0"
[20:44:41.789]    </control>
[20:44:41.789]    <block atomic="false" info="">
[20:44:41.789]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[20:44:41.789]        // -> [ReadAP(0x00000000) => 0x0079002F]   (__dp=0x00000000, __ap=0x00000004)
[20:44:41.789]        // -> [ACCESS_POINT_VAL <= 0x0079002F]
[20:44:41.789]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);
[20:44:41.789]      __ap = 0; //lets make sure we reset the access point selection
[20:44:41.789]        // -> [__ap <= 0x00000000]
[20:44:41.789]    </block>
