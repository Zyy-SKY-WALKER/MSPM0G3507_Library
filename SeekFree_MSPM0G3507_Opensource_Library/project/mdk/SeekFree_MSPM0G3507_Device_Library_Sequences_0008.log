[20:44:41.706]            // =>  TRUE
[20:44:41.706]          <block atomic="false" info="">
[20:44:41.706]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:44:41.706]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
