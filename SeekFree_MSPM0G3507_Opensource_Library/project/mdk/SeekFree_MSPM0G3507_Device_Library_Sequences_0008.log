[20:44:41.781]    <control if="(ACCESS_POINT_VAL & 0x00E00000) == 0" while="" timeout="0" info="">
[20:44:41.781]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[20:44:41.781]        // =>  TRUE
[20:44:41.781]      <block atomic="false" info="">
[20:44:41.781]        WriteAP(0x00, 0x190008);
[20:44:41.783]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[20:44:41.783]        WriteAP(0xF0, 0x01);
[20:44:41.789]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[20:44:41.789]      </block>
[20:44:41.789]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[20:44:41.789]    </control>
[20:44:41.789]    <control if="(ACCESS_POINT_VAL & 0x00E00000) != 0" while="" timeout="0" info="">
