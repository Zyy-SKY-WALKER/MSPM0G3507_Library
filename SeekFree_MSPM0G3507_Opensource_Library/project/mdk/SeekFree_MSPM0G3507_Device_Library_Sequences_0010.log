[19:43:19.557]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:43:19.557]    <block atomic="false" info="">
[19:43:19.557]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:43:19.557]        // -> [isSWJ <= 0x00000001]
