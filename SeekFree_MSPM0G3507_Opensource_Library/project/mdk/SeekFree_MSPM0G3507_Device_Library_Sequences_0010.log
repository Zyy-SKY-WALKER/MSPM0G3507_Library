[18:51:17.815]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[18:51:17.815]    <block atomic="false" info="">
[18:51:17.815]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[18:51:17.815]        // -> [isSWJ <= 0x00000001]
[18:51:17.815]      __var hasDormant = __protocol & 0x00020000;
[18:51:17.815]        // -> [hasDormant <= 0x00000000]
[18:51:17.815]      __var protType   = __protocol & 0x0000FFFF;
[18:51:17.815]        // -> [protType <= 0x00000002]
[18:51:17.815]    </block>
[18:51:17.815]    <control if="protType == 1" while="" timeout="0" info="">
