[18:10:53.757]      // skip if-block "protType == 1"
[18:10:53.757]    </control>
[18:10:53.757]    <control if="protType == 2" while="" timeout="0" info="">
[18:10:53.759]      // if-block "protType == 2"
[18:10:53.759]        // =>  TRUE
[18:10:53.759]      <control if="isSWJ" while="" timeout="0" info="">
[18:10:53.759]        // if-block "isSWJ"
[18:10:53.759]          // =>  TRUE
