[20:51:08.399]        // -> [SW_DP_ABORT <= 0x00000000]
[20:51:08.399]      __var DP_CTRL_STAT      = 0x4;
[20:51:08.399]        // -> [DP_CTRL_STAT <= 0x00000004]
[20:51:08.400]      __var DP_SELECT         = 0x8;
[20:51:08.400]        // -> [DP_SELECT <= 0x00000008]
[20:51:08.400]      __var powered_down      = 0;
[20:51:08.400]        // -> [powered_down <= 0x00000000]
[20:51:08.400]      WriteDP(DP_SELECT, 0x00000000);
[20:51:08.401]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[20:51:08.401]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
