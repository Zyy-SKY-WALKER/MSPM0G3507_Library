[20:51:08.373]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[20:51:08.373]    <block atomic="false" info="">
[20:51:08.373]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[20:51:08.373]        // -> [isSWJ <= 0x00000001]
