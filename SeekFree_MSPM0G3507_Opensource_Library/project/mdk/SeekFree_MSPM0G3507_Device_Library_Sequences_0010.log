[19:12:29.426]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:12:29.426]    <block atomic="false" info="">
[19:12:29.426]      __var deviceID = 0;
[19:12:29.426]        // -> [deviceID <= 0x00000000]
[19:12:29.426]      __var version = 0;
[19:12:29.426]        // -> [version <= 0x00000000]
[19:12:29.426]      __var partNum = 0;
[19:12:29.426]        // -> [partNum <= 0x00000000]
[19:12:29.426]      __var manuf = 0;
[19:12:29.426]        // -> [manuf <= 0x00000000]
[19:12:29.426]      __var isMSPM0G1X0X_G3X0X = 0;
[19:12:29.426]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:12:29.426]      __var isProduction = 0;
[19:12:29.426]        // -> [isProduction <= 0x00000000]
[19:12:29.426]      __var continueId = 0;
[19:12:29.427]        // -> [continueId <= 0x00000000]
[19:12:29.427]      deviceID =   Read32(0x41C40004);
[19:12:29.433]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:12:29.433]        // -> [deviceID <= 0x2BB8802F]
[19:12:29.433]      version = deviceID >> 28;
[19:12:29.433]        // -> [version <= 0x00000002]
[19:12:29.433]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:12:29.433]        // -> [partNum <= 0x0000BB88]
[19:12:29.433]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:12:29.433]        // -> [manuf <= 0x00000017]
[19:12:29.433]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:12:29.433]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:12:29.433]      isProduction = (version > 0);
[19:12:29.433]        // -> [isProduction <= 0x00000001]
[19:12:29.433]    </block>
[19:12:29.433]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[19:12:29.434]      // if-block "!isMSPM0G1X0X_G3X0X"
[19:12:29.434]        // =>  FALSE
[19:12:29.434]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[19:12:29.434]    </control>
