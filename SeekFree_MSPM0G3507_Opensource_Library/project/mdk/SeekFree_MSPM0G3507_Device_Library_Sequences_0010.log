[19:58:55.190]      WriteDP(DP_SELECT, 0x00000000);
[19:58:55.193]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:58:55.193]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:58:55.195]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:58:55.195]        // -> [powered_down <= 0x00000001]
