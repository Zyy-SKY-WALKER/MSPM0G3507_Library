[21:01:19.931]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[21:01:19.931]      __var isProduction = 0;
[21:01:19.931]        // -> [isProduction <= 0x00000000]
[21:01:19.931]      __var continueId = 0;
[21:01:19.931]        // -> [continueId <= 0x00000000]
[21:01:19.931]      deviceID =   Read32(0x41C40004);
[21:01:19.935]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
