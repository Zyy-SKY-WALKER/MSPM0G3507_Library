[20:52:25.404]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[20:52:25.404]    <block atomic="false" info="">
[20:52:25.404]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[20:52:25.404]        // -> [isSWJ <= 0x00000001]
[20:52:25.404]      __var hasDormant = __protocol & 0x00020000;
[20:52:25.404]        // -> [hasDormant <= 0x00000000]
