[20:39:24.242]      __var deviceID = 0;
[20:39:24.242]        // -> [deviceID <= 0x00000000]
[20:39:24.242]      __var version = 0;
[20:39:24.242]        // -> [version <= 0x00000000]
[20:39:24.242]      __var partNum = 0;
[20:39:24.242]        // -> [partNum <= 0x00000000]
[20:39:24.242]      __var manuf = 0;
[20:39:24.242]        // -> [manuf <= 0x00000000]
[20:39:24.242]      __var isMSPM0G1X0X_G3X0X = 0;
[20:39:24.242]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:39:24.242]      __var isProduction = 0;
[20:39:24.243]        // -> [isProduction <= 0x00000000]
[20:39:24.243]      __var continueId = 0;
[20:39:24.243]        // -> [continueId <= 0x00000000]
[20:39:24.243]      deviceID =   Read32(0x41C40004);
[20:39:24.248]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:39:24.248]        // -> [deviceID <= 0x2BB8802F]
[20:39:24.248]      version = deviceID >> 28;
[20:39:24.248]        // -> [version <= 0x00000002]
[20:39:24.248]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:39:24.249]        // -> [partNum <= 0x0000BB88]
[20:39:24.249]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:39:24.249]        // -> [manuf <= 0x00000017]
[20:39:24.249]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:39:24.249]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:39:24.249]      isProduction = (version > 0);
[20:39:24.249]        // -> [isProduction <= 0x00000001]
[20:39:24.249]    </block>
[20:39:24.249]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
