[19:58:55.158]      // skip if-block "protType == 1"
[19:58:55.158]    </control>
[19:58:55.158]    <control if="protType == 2" while="" timeout="0" info="">
[19:58:55.158]      // if-block "protType == 2"
[19:58:55.158]        // =>  TRUE
[19:58:55.158]      <control if="isSWJ" while="" timeout="0" info="">
[19:58:55.158]        // if-block "isSWJ"
[19:58:55.160]          // =>  TRUE
[19:58:55.160]        <control if="hasDormant" while="" timeout="0" info="">
[19:58:55.160]          // if-block "hasDormant"
[19:58:55.160]            // =>  FALSE
[19:58:55.160]          // skip if-block "hasDormant"
[19:58:55.160]        </control>
[19:58:55.160]        <control if="!hasDormant" while="" timeout="0" info="">
[19:58:55.161]          // if-block "!hasDormant"
[19:58:55.161]            // =>  TRUE
[19:58:55.161]          <block atomic="false" info="">
[19:58:55.161]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:58:55.166]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:58:55.166]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:58:55.169]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:58:55.169]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:58:55.172]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:58:55.172]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:58:55.175]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:58:55.175]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:58:55.176]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:58:55.176]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:58:55.178]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:58:55.178]          </block>
[19:58:55.178]          // end if-block "!hasDormant"
[19:58:55.178]        </control>
[19:58:55.178]        // end if-block "isSWJ"
[19:58:55.178]      </control>
[19:58:55.180]      <control if="!isSWJ" while="" timeout="0" info="">
[19:58:55.180]        // if-block "!isSWJ"
[19:58:55.180]          // =>  FALSE
[19:58:55.180]        // skip if-block "!isSWJ"
[19:58:55.180]      </control>
[19:58:55.180]      <block atomic="false" info="">
[19:58:55.180]        ReadDP(0x0);
[19:58:55.183]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[19:58:55.183]      </block>
[19:58:55.183]      // end if-block "protType == 2"
[19:58:55.183]    </control>
[19:58:55.183]  </sequence>
