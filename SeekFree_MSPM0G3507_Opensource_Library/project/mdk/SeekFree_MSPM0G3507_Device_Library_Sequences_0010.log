[20:40:05.802]      // skip if-block "protType == 1"
[20:40:05.802]    </control>
[20:40:05.802]    <control if="protType == 2" while="" timeout="0" info="">
[20:40:05.802]      // if-block "protType == 2"
[20:40:05.802]        // =>  TRUE
[20:40:05.802]      <control if="isSWJ" while="" timeout="0" info="">
[20:40:05.802]        // if-block "isSWJ"
[20:40:05.802]          // =>  TRUE
[20:40:05.802]        <control if="hasDormant" while="" timeout="0" info="">
[20:40:05.802]          // if-block "hasDormant"
[20:40:05.802]            // =>  FALSE
[20:40:05.802]          // skip if-block "hasDormant"
[20:40:05.802]        </control>
[20:40:05.802]        <control if="!hasDormant" while="" timeout="0" info="">
[20:40:05.802]          // if-block "!hasDormant"
[20:40:05.802]            // =>  TRUE
[20:40:05.802]          <block atomic="false" info="">
[20:40:05.802]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:40:05.804]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:40:05.804]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:40:05.809]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:40:05.809]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:40:05.811]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:40:05.811]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[20:40:05.813]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[20:40:05.813]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[20:40:05.813]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:40:05.813]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:40:05.818]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[20:40:05.819]          </block>
[20:40:05.819]          // end if-block "!hasDormant"
[20:40:05.819]        </control>
[20:40:05.819]        // end if-block "isSWJ"
[20:40:05.819]      </control>
