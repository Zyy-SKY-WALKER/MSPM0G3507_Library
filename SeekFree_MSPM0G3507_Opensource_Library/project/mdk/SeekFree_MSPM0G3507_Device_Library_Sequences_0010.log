[18:51:17.840]      __var SW_DP_ABORT       = 0x0;
[18:51:17.840]        // -> [SW_DP_ABORT <= 0x00000000]
[18:51:17.840]      __var DP_CTRL_STAT      = 0x4;
[18:51:17.840]        // -> [DP_CTRL_STAT <= 0x00000004]
[18:51:17.840]      __var DP_SELECT         = 0x8;
[18:51:17.840]        // -> [DP_SELECT <= 0x00000008]
