[19:58:55.190]        // -> [SW_DP_ABORT <= 0x00000000]
[19:58:55.190]      __var DP_CTRL_STAT      = 0x4;
[19:58:55.190]        // -> [DP_CTRL_STAT <= 0x00000004]
[19:58:55.190]      __var DP_SELECT         = 0x8;
[19:58:55.190]        // -> [DP_SELECT <= 0x00000008]
[19:58:55.190]      __var powered_down      = 0;
