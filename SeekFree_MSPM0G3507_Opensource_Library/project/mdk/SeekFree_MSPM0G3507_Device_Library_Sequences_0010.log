[18:10:53.860]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[18:10:53.860]    <block atomic="false" info="">
[18:10:53.861]      __var deviceID = 0;
[18:10:53.861]        // -> [deviceID <= 0x00000000]
[18:10:53.861]      __var version = 0;
[18:10:53.861]        // -> [version <= 0x00000000]
[18:10:53.861]      __var partNum = 0;
[18:10:53.861]        // -> [partNum <= 0x00000000]
[18:10:53.861]      __var manuf = 0;
[18:10:53.861]        // -> [manuf <= 0x00000000]
[18:10:53.861]      __var isMSPM0G1X0X_G3X0X = 0;
[18:10:53.861]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[18:10:53.861]      __var isProduction = 0;
[18:10:53.861]        // -> [isProduction <= 0x00000000]
[18:10:53.861]      __var continueId = 0;
[18:10:53.861]        // -> [continueId <= 0x00000000]
[18:10:53.861]      deviceID =   Read32(0x41C40004);
[18:10:53.867]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[18:10:53.867]        // -> [deviceID <= 0x2BB8802F]
[18:10:53.867]      version = deviceID >> 28;
[18:10:53.867]        // -> [version <= 0x00000002]
[18:10:53.868]      partNum = (deviceID & 0x0FFFF000) >> 12;
[18:10:53.869]        // -> [partNum <= 0x0000BB88]
[18:10:53.869]      manuf = (deviceID & 0x00000FFE) >> 1;
[18:10:53.869]        // -> [manuf <= 0x00000017]
[18:10:53.869]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[18:10:53.869]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[18:10:53.869]      isProduction = (version > 0);
[18:10:53.869]        // -> [isProduction <= 0x00000001]
[18:10:53.869]    </block>
[18:10:53.869]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
