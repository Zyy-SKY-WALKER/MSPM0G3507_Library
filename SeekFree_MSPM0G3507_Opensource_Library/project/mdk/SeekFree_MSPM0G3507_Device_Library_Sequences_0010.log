[20:59:25.192]        // -> [manuf <= 0x00000000]
[20:59:25.192]      __var isMSPM0G1X0X_G3X0X = 0;
[20:59:25.192]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:59:25.192]      __var isProduction = 0;
