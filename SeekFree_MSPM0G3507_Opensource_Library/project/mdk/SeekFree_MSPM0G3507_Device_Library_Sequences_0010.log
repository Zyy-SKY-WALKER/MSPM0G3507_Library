[20:40:05.799]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[20:40:05.799]    <block atomic="false" info="">
[20:40:05.799]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[20:40:05.799]        // -> [isSWJ <= 0x00000001]
[20:40:05.799]      __var hasDormant = __protocol & 0x00020000;
[20:40:05.799]        // -> [hasDormant <= 0x00000000]
