[20:51:45.637]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[20:51:45.637]    <block atomic="false" info="">
[20:51:45.637]      __var deviceID = 0;
[20:51:45.637]        // -> [deviceID <= 0x00000000]
[20:51:45.637]      __var version = 0;
[20:51:45.637]        // -> [version <= 0x00000000]
[20:51:45.637]      __var partNum = 0;
[20:51:45.637]        // -> [partNum <= 0x00000000]
[20:51:45.637]      __var manuf = 0;
[20:51:45.637]        // -> [manuf <= 0x00000000]
[20:51:45.637]      __var isMSPM0G1X0X_G3X0X = 0;
[20:51:45.637]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:51:45.637]      __var isProduction = 0;
[20:51:45.637]        // -> [isProduction <= 0x00000000]
[20:51:45.637]      __var continueId = 0;
[20:51:45.637]        // -> [continueId <= 0x00000000]
[20:51:45.637]      deviceID =   Read32(0x41C40004);
[20:51:45.644]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:51:45.644]        // -> [deviceID <= 0x2BB8802F]
[20:51:45.644]      version = deviceID >> 28;
[20:51:45.644]        // -> [version <= 0x00000002]
[20:51:45.644]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:51:45.644]        // -> [partNum <= 0x0000BB88]
[20:51:45.647]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:51:45.647]        // -> [manuf <= 0x00000017]
[20:51:45.647]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:51:45.647]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:51:45.647]      isProduction = (version > 0);
[20:51:45.647]        // -> [isProduction <= 0x00000001]
[20:51:45.647]    </block>
[20:51:45.647]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[20:51:45.647]      // if-block "!isMSPM0G1X0X_G3X0X"
[20:51:45.647]        // =>  FALSE
[20:51:45.647]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[20:51:45.647]    </control>
[20:51:45.647]    <control if="continueId == 4" while="" timeout="0" info="">
[20:51:45.647]      // if-block "continueId == 4"
[20:51:45.647]        // =>  FALSE
[20:51:45.647]      // skip if-block "continueId == 4"
[20:51:45.647]    </control>
[20:51:45.647]    <control if="!isProduction" while="" timeout="0" info="">
