[19:43:19.577]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[19:43:19.577]    <block atomic="false" info="">
[19:43:19.577]      __var SW_DP_ABORT       = 0x0;
[19:43:19.577]        // -> [SW_DP_ABORT <= 0x00000000]
[19:43:19.577]      __var DP_CTRL_STAT      = 0x4;
[19:43:19.577]        // -> [DP_CTRL_STAT <= 0x00000004]
[19:43:19.577]      __var DP_SELECT         = 0x8;
[19:43:19.577]        // -> [DP_SELECT <= 0x00000008]
[19:43:19.577]      __var powered_down      = 0;
[19:43:19.577]        // -> [powered_down <= 0x00000000]
[19:43:19.577]      WriteDP(DP_SELECT, 0x00000000);
[19:43:19.577]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:43:19.577]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:43:19.586]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:43:19.586]        // -> [powered_down <= 0x00000001]
