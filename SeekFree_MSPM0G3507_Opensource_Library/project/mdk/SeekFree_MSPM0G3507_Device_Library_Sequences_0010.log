[21:01:19.935]        // -> [version <= 0x00000002]
[21:01:19.935]      partNum = (deviceID & 0x0FFFF000) >> 12;
[21:01:19.935]        // -> [partNum <= 0x0000BB88]
[21:01:19.935]      manuf = (deviceID & 0x00000FFE) >> 1;
[21:01:19.935]        // -> [manuf <= 0x00000017]
[21:01:19.935]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[21:01:19.935]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[21:01:19.935]      isProduction = (version > 0);
[21:01:19.935]        // -> [isProduction <= 0x00000001]
