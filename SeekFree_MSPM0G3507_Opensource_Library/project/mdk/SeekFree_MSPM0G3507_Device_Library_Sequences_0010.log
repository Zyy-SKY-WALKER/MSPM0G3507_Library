[20:59:57.763]          // if-block "hasDormant"
[20:59:57.763]            // =>  FALSE
[20:59:57.763]          // skip if-block "hasDormant"
[20:59:57.763]        </control>
[20:59:57.763]        <control if="!hasDormant" while="" timeout="0" info="">
[20:59:57.763]          // if-block "!hasDormant"
[20:59:57.763]            // =>  TRUE
[20:59:57.763]          <block atomic="false" info="">
[20:59:57.763]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:59:57.763]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:59:57.763]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:59:57.768]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:59:57.768]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:59:57.770]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:59:57.770]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[20:59:57.770]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[20:59:57.770]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
