[20:40:05.826]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[20:40:05.826]    <block atomic="false" info="">
[20:40:05.826]      __var SW_DP_ABORT       = 0x0;
[20:40:05.826]        // -> [SW_DP_ABORT <= 0x00000000]
[20:40:05.826]      __var DP_CTRL_STAT      = 0x4;
[20:40:05.826]        // -> [DP_CTRL_STAT <= 0x00000004]
[20:40:05.826]      __var DP_SELECT         = 0x8;
[20:40:05.826]        // -> [DP_SELECT <= 0x00000008]
[20:40:05.826]      __var powered_down      = 0;
[20:40:05.826]        // -> [powered_down <= 0x00000000]
[20:40:05.826]      WriteDP(DP_SELECT, 0x00000000);
[20:40:05.828]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[20:40:05.828]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[20:40:05.830]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[20:40:05.831]        // -> [powered_down <= 0x00000001]
[20:40:05.831]    </block>
[20:40:05.831]    <control if="powered_down" while="" timeout="0" info="">
