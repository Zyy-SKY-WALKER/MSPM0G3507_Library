[19:43:19.558]      // skip if-block "protType == 1"
[19:43:19.558]    </control>
[19:43:19.558]    <control if="protType == 2" while="" timeout="0" info="">
[19:43:19.558]      // if-block "protType == 2"
[19:43:19.558]        // =>  TRUE
[19:43:19.558]      <control if="isSWJ" while="" timeout="0" info="">
[19:43:19.558]        // if-block "isSWJ"
[19:43:19.558]          // =>  TRUE
[19:43:19.558]        <control if="hasDormant" while="" timeout="0" info="">
[19:43:19.558]          // if-block "hasDormant"
[19:43:19.558]            // =>  FALSE
[19:43:19.558]          // skip if-block "hasDormant"
[19:43:19.558]        </control>
[19:43:19.558]        <control if="!hasDormant" while="" timeout="0" info="">
[19:43:19.558]          // if-block "!hasDormant"
[19:43:19.558]            // =>  TRUE
[19:43:19.558]          <block atomic="false" info="">
[19:43:19.559]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:43:19.562]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:43:19.562]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:43:19.564]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:43:19.564]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:43:19.566]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:43:19.566]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:43:19.568]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:43:19.568]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:43:19.570]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:43:19.570]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:43:19.572]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:43:19.572]          </block>
[19:43:19.572]          // end if-block "!hasDormant"
[19:43:19.572]        </control>
[19:43:19.572]        // end if-block "isSWJ"
[19:43:19.572]      </control>
[19:43:19.572]      <control if="!isSWJ" while="" timeout="0" info="">
[19:43:19.572]        // if-block "!isSWJ"
[19:43:19.572]          // =>  FALSE
[19:43:19.572]        // skip if-block "!isSWJ"
[19:43:19.572]      </control>
[19:43:19.572]      <block atomic="false" info="">
[19:43:19.572]        ReadDP(0x0);
[19:43:19.574]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[19:43:19.574]      </block>
[19:43:19.575]      // end if-block "protType == 2"
[19:43:19.575]    </control>
[19:43:19.575]  </sequence>
