[20:46:26.193]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[20:46:26.193]    <block atomic="false" info="">
[20:46:26.193]      __var deviceID = 0;
[20:46:26.193]        // -> [deviceID <= 0x00000000]
[20:46:26.193]      __var version = 0;
[20:46:26.194]        // -> [version <= 0x00000000]
[20:46:26.194]      __var partNum = 0;
[20:46:26.194]        // -> [partNum <= 0x00000000]
[20:46:26.194]      __var manuf = 0;
[20:46:26.194]        // -> [manuf <= 0x00000000]
[20:46:26.194]      __var isMSPM0G1X0X_G3X0X = 0;
[20:46:26.194]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:46:26.194]      __var isProduction = 0;
[20:46:26.194]        // -> [isProduction <= 0x00000000]
[20:46:26.194]      __var continueId = 0;
[20:46:26.194]        // -> [continueId <= 0x00000000]
[20:46:26.194]      deviceID =   Read32(0x41C40004);
[20:46:26.202]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:46:26.203]        // -> [deviceID <= 0x2BB8802F]
[20:46:26.203]      version = deviceID >> 28;
[20:46:26.203]        // -> [version <= 0x00000002]
[20:46:26.203]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:46:26.203]        // -> [partNum <= 0x0000BB88]
[20:46:26.203]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:46:26.203]        // -> [manuf <= 0x00000017]
[20:46:26.203]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:46:26.203]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:46:26.203]      isProduction = (version > 0);
[20:46:26.203]        // -> [isProduction <= 0x00000001]
[20:46:26.204]    </block>
[20:46:26.204]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
