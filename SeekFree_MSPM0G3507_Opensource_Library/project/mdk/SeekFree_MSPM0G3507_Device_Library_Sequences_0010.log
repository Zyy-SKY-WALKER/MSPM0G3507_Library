[18:51:17.815]      // skip if-block "protType == 1"
[18:51:17.815]    </control>
[18:51:17.815]    <control if="protType == 2" while="" timeout="0" info="">
[18:51:17.815]      // if-block "protType == 2"
[18:51:17.815]        // =>  TRUE
[18:51:17.815]      <control if="isSWJ" while="" timeout="0" info="">
[18:51:17.815]        // if-block "isSWJ"
[18:51:17.815]          // =>  TRUE
[18:51:17.815]        <control if="hasDormant" while="" timeout="0" info="">
[18:51:17.815]          // if-block "hasDormant"
[18:51:17.815]            // =>  FALSE
[18:51:17.815]          // skip if-block "hasDormant"
[18:51:17.815]        </control>
[18:51:17.815]        <control if="!hasDormant" while="" timeout="0" info="">
[18:51:17.815]          // if-block "!hasDormant"
[18:51:17.815]            // =>  TRUE
[18:51:17.815]          <block atomic="false" info="">
[18:51:17.815]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:51:17.815]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:51:17.815]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:51:17.824]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:51:17.824]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:51:17.824]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:51:17.824]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[18:51:17.824]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[18:51:17.824]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:51:17.824]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:51:17.824]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:51:17.832]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:51:17.832]          </block>
[18:51:17.832]          // end if-block "!hasDormant"
