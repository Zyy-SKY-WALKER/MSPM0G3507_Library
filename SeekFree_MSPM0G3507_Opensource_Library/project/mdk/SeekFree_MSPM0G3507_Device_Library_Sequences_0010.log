[20:40:05.831]        // =>  TRUE
[20:40:05.831]      <block atomic="false" info="">
[20:40:05.831]        Message(0, "Debug/System power-up request sent");
[20:40:05.833]        WriteDP(DP_CTRL_STAT, 0x50000000);
[20:40:05.833]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[20:40:05.833]      </block>
[20:40:05.833]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[20:40:05.833]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[20:40:05.833]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[20:40:05.833]        // while-condition  =>  FALSE
[20:40:05.833]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[20:40:05.833]      </control>
[20:40:05.833]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
[20:40:05.833]        // if-block "(__protocol & 0xFFFF) == 1"
[20:40:05.833]          // =>  FALSE
[20:40:05.833]        // skip if-block "(__protocol & 0xFFFF) == 1"
[20:40:05.833]      </control>
[20:40:05.833]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[20:40:05.833]        // if-block "(__protocol & 0xFFFF) == 2"
[20:40:05.833]          // =>  TRUE
[20:40:05.833]        <block atomic="false" info="">
[20:40:05.833]          Message(0, "executing SWD power up");
[20:40:05.833]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[20:40:05.839]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[20:40:05.839]          WriteDP(SW_DP_ABORT, 0x0000001E);
[20:40:05.843]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[20:40:05.843]        </block>
[20:40:05.843]        // end if-block "(__protocol & 0xFFFF) == 2"
[20:40:05.844]      </control>
[20:40:05.844]      // end if-block "powered_down"
