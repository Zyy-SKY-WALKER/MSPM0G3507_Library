[20:59:25.085]          // if-block "hasDormant"
[20:59:25.085]            // =>  FALSE
[20:59:25.085]          // skip if-block "hasDormant"
[20:59:25.085]        </control>
[20:59:25.085]        <control if="!hasDormant" while="" timeout="0" info="">
[20:59:25.085]          // if-block "!hasDormant"
[20:59:25.085]            // =>  TRUE
[20:59:25.085]          <block atomic="false" info="">
[20:59:25.085]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:59:25.087]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:59:25.087]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:59:25.089]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:59:25.089]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:59:25.092]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:59:25.092]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[20:59:25.093]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[20:59:25.093]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[20:59:25.093]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:59:25.093]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:59:25.093]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[20:59:25.093]          </block>
[20:59:25.093]          // end if-block "!hasDormant"
[20:59:25.093]        </control>
