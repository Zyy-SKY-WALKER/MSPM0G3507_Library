[18:10:53.757]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[18:10:53.757]    <block atomic="false" info="">
[18:10:53.757]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[18:10:53.757]        // -> [isSWJ <= 0x00000001]
[18:10:53.757]      __var hasDormant = __protocol & 0x00020000;
[18:10:53.757]        // -> [hasDormant <= 0x00000000]
