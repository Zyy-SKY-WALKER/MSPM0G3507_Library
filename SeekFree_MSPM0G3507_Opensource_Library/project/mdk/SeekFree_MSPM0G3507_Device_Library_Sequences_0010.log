[19:43:19.595]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[19:43:19.598]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[19:43:19.598]          WriteDP(SW_DP_ABORT, 0x0000001E);
