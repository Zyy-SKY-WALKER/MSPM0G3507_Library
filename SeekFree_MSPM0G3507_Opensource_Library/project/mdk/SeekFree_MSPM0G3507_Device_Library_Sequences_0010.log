[20:51:45.597]        WriteAP(0x00, 0x190008);
[20:51:45.597]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[20:51:45.597]        WriteAP(0xF0, 0x01);
[20:51:45.604]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[20:51:45.604]      </block>
[20:51:45.604]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
