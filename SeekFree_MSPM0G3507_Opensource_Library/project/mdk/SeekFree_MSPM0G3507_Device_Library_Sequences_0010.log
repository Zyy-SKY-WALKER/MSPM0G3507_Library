[20:40:05.819]        ReadDP(0x0);
[20:40:05.821]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[20:40:05.822]      </block>
[20:40:05.822]      // end if-block "protType == 2"
[20:40:05.822]    </control>
