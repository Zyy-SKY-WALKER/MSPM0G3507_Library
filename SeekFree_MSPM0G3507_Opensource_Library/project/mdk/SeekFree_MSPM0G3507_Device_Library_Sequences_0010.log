[19:43:19.661]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:43:19.661]    <block atomic="false" info="">
[19:43:19.662]      __var deviceID = 0;
[19:43:19.662]        // -> [deviceID <= 0x00000000]
[19:43:19.662]      __var version = 0;
[19:43:19.662]        // -> [version <= 0x00000000]
[19:43:19.662]      __var partNum = 0;
[19:43:19.662]        // -> [partNum <= 0x00000000]
[19:43:19.662]      __var manuf = 0;
[19:43:19.662]        // -> [manuf <= 0x00000000]
[19:43:19.662]      __var isMSPM0G1X0X_G3X0X = 0;
[19:43:19.662]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:43:19.662]      __var isProduction = 0;
[19:43:19.662]        // -> [isProduction <= 0x00000000]
[19:43:19.662]      __var continueId = 0;
[19:43:19.662]        // -> [continueId <= 0x00000000]
[19:43:19.662]      deviceID =   Read32(0x41C40004);
[19:43:19.669]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:43:19.669]        // -> [deviceID <= 0x2BB8802F]
[19:43:19.669]      version = deviceID >> 28;
[19:43:19.669]        // -> [version <= 0x00000002]
[19:43:19.669]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:43:19.669]        // -> [partNum <= 0x0000BB88]
[19:43:19.669]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:43:19.669]        // -> [manuf <= 0x00000017]
[19:43:19.670]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:43:19.670]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:43:19.670]      isProduction = (version > 0);
[19:43:19.670]        // -> [isProduction <= 0x00000001]
[19:43:19.670]    </block>
[19:43:19.670]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[19:43:19.670]      // if-block "!isMSPM0G1X0X_G3X0X"
[19:43:19.670]        // =>  FALSE
[19:43:19.670]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[19:43:19.670]    </control>
[19:43:19.670]    <control if="continueId == 4" while="" timeout="0" info="">
[19:43:19.670]      // if-block "continueId == 4"
[19:43:19.670]        // =>  FALSE
[19:43:19.671]      // skip if-block "continueId == 4"
[19:43:19.671]    </control>
[19:43:19.671]    <control if="!isProduction" while="" timeout="0" info="">
[19:43:19.671]      // if-block "!isProduction"
[19:43:19.671]        // =>  FALSE
[19:43:19.671]      // skip if-block "!isProduction"
[19:43:19.671]    </control>
[19:43:19.671]  </sequence>
