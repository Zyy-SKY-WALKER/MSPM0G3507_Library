[20:51:08.379]        </control>
[20:51:08.379]        <control if="!hasDormant" while="" timeout="0" info="">
[20:51:08.379]          // if-block "!hasDormant"
[20:51:08.379]            // =>  TRUE
[20:51:08.379]          <block atomic="false" info="">
[20:51:08.379]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:51:08.381]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:51:08.381]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:51:08.381]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:51:08.381]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:51:08.381]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:51:08.381]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[20:51:08.386]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[20:51:08.386]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
