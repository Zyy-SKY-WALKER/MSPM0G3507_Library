[18:10:53.759]          // if-block "hasDormant"
[18:10:53.759]            // =>  FALSE
[18:10:53.759]          // skip if-block "hasDormant"
[18:10:53.759]        </control>
[18:10:53.759]        <control if="!hasDormant" while="" timeout="0" info="">
[18:10:53.759]          // if-block "!hasDormant"
[18:10:53.759]            // =>  TRUE
[18:10:53.759]          <block atomic="false" info="">
[18:10:53.759]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:10:53.761]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:10:53.761]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:10:53.763]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:10:53.763]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:10:53.766]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:10:53.766]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[18:10:53.768]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[18:10:53.768]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:10:53.771]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:10:53.771]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:10:53.773]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:10:53.773]          </block>
