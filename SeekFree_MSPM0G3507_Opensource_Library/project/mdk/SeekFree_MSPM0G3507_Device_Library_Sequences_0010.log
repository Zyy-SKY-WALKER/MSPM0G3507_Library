[20:52:25.405]        </control>
[20:52:25.405]        <control if="!hasDormant" while="" timeout="0" info="">
[20:52:25.405]          // if-block "!hasDormant"
[20:52:25.405]            // =>  TRUE
[20:52:25.405]          <block atomic="false" info="">
[20:52:25.405]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:52:25.409]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:52:25.411]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:52:25.413]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:52:25.413]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
