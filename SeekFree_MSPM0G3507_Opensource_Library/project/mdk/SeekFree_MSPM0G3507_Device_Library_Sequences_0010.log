[20:51:08.389]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:51:08.391]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[20:51:08.391]          </block>
[20:51:08.391]          // end if-block "!hasDormant"
[20:51:08.391]        </control>
[20:51:08.391]        // end if-block "isSWJ"
[20:51:08.391]      </control>
