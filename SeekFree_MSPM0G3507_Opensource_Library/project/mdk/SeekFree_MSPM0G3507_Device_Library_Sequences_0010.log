[20:46:26.078]            // =>  TRUE
[20:46:26.078]          <block atomic="false" info="">
[20:46:26.078]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:46:26.081]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:46:26.081]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:46:26.084]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:46:26.084]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
