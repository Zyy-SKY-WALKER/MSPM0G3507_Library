[19:58:55.150]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:58:55.150]    <block atomic="false" info="">
[19:58:55.150]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:58:55.150]        // -> [isSWJ <= 0x00000001]
[19:58:55.150]      __var hasDormant = __protocol & 0x00020000;
[19:58:55.150]        // -> [hasDormant <= 0x00000000]
[19:58:55.150]      __var protType   = __protocol & 0x0000FFFF;
[19:58:55.150]        // -> [protType <= 0x00000002]
[19:58:55.158]    </block>
[19:58:55.158]    <control if="protType == 1" while="" timeout="0" info="">
