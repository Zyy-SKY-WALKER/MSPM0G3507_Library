[13:29:40.379]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[13:29:40.379]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
