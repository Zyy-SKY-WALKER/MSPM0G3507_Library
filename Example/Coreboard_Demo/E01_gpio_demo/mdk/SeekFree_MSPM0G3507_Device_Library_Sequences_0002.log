[13:29:40.391]        <block atomic="false" info="">
[13:29:40.391]          Message(0, "executing SWD power up");
[13:29:40.392]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[13:29:40.393]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[13:29:40.393]          WriteDP(SW_DP_ABORT, 0x0000001E);
