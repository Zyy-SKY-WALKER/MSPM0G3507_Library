[13:29:40.421]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[13:29:40.421]      </block>
[13:29:40.421]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
